# Parasol Insurance - parasol-notifications (Node, zero dependencies)
#
# Builds the node/ implementation into the SHARED prebuilt image the workshop-config
# BuildConfig publishes as ogsr-parasol-images/parasol-notifications:1.0. That image exists for
# entry states and solve end states that need the service RUNNING without waiting on a build
# (build-deliver's `ws solve`); the module labs themselves still S2I-build it from the attendee's
# fork, which is the lesson.
#
# Single stage on purpose: the node/ service uses only the Node standard library (no package
# lockfile, nothing to install), so a build stage would compile nothing and only add a layer to
# discard. Base image pinned like every other app here (ubi9/nodejs-22-minimal:9.7) — the runtime
# matches the nodejs:22-ubi9 S2I builder the lab picks, so the shared image and the attendee's own
# build run the same Node major.
#
# Runs as the base image's non-root UID 1001 under OpenShift's restricted-v2 SCC (arbitrary UID,
# GID 0): the app writes nothing to disk (its notification store is in-memory), and the copied
# sources are group-0 readable so an injected random UID can still read them.
FROM registry.access.redhat.com/ubi9/nodejs-22-minimal:9.7

WORKDIR /opt/app-root/src

# Only the Node implementation ships in the image; python/ is the alternative the lab offers, built
# by its own S2I import, and README/catalog-info are repo documentation.
COPY --chown=1001:0 node/ ./

EXPOSE 8080
USER 1001

CMD ["node", "server.js"]
