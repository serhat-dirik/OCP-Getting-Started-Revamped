# Parasol Insurance - parasol-claims (Quarkus, JVM fast-jar)
#
# Multi-stage, UBI9-based. Builds fully in-cluster via either the binary Docker
# build used to publish the prebuilt image or the chart-owned Git BuildConfig in
# gitops/workshop-config/templates/parasol-images-build.yaml,
# which is now the ONLY BuildConfig for this app. (build-deliver attendees can also build this same source with
# the S2I strategy - see the README; both strategies must work.)
#
# Base images pinned to the highest tag present in BOTH the builder and runtime
# streams (1.24) so the two stages stay matched and the build is reproducible.
#
# The runtime stage runs as numeric non-root UID 185 under OpenShift's
# restricted-v2 SCC (arbitrary UID, GID 0): the app writes nothing outside /tmp,
# and /deployments is owned by group 0 so an injected random UID can still read it.

## --- Build stage: JDK 21 + Maven (UBI9 builder image). Runs as root; discarded. ---
FROM registry.access.redhat.com/ubi9/openjdk-21:1.24 AS build
USER root
WORKDIR /build

COPY pom.xml ./
COPY src ./src

# Produce the Quarkus fast-jar under target/quarkus-app/. Tests are skipped here by
# design: the suite runs in CI (.github/workflows/apps-test.yml) on every push and
# pull request touching apps/, which is what gates the source this stage compiles.
# Optional Maven repository mirror (a corporate Nexus/Artifactory, or the workshop's in-cluster
# one): --build-arg MAVEN_MIRROR_URL=<url>. Empty, the default, resolves from Maven Central.
# An OpenShift Docker-strategy build env var (oc new-app --build-env MAVEN_MIRROR_URL=<url>) works
# too: the builder injects it as ENV after every FROM, and ENV wins over this ARG.
ARG MAVEN_MIRROR_URL=""
RUN if [ -n "$MAVEN_MIRROR_URL" ]; then \
      printf '<settings><mirrors><mirror><id>mirror.default</id><url>%s</url><mirrorOf>central</mirrorOf></mirror></mirrors></settings>' \
        "$MAVEN_MIRROR_URL" > /tmp/settings.xml; \
    else echo '<settings/>' > /tmp/settings.xml; fi && \
    mvn -B -ntp -s /tmp/settings.xml -DskipTests clean package

## --- Runtime stage: JRE-only UBI9 image, non-root. ---
FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.24
ENV LANGUAGE='en_US:en'

# Copy the fast-jar layout in cache-friendly order (libs change least, app most).
# --chown=185:0 + group-readable perms keep the app runnable under any random UID.
COPY --from=build --chown=185:0 /build/target/quarkus-app/lib/      /deployments/lib/
COPY --from=build --chown=185:0 /build/target/quarkus-app/*.jar     /deployments/
COPY --from=build --chown=185:0 /build/target/quarkus-app/app/      /deployments/app/
COPY --from=build --chown=185:0 /build/target/quarkus-app/quarkus/  /deployments/quarkus/

EXPOSE 8080
USER 185

ENTRYPOINT [ "java", "-jar", "/deployments/quarkus-run.jar" ]
