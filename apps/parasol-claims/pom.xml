<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.parasol</groupId>
  <artifactId>parasol-claims</artifactId>
  <version>1.0.0</version>
  <name>parasol-claims</name>
  <description>Parasol Insurance core claims service (REST + PostgreSQL, Quarkus). Star of nearly every module.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Quarkus current LTS: 3.33 (recommended for production; maintained until 2027-03-25).
         Same BOM as parasol-web so both services move in lockstep. -->
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.33.3.1</quarkus.platform.version>

    <compiler-plugin.version>3.13.0</compiler-plugin.version>
    <surefire-plugin.version>3.5.2</surefire-plugin.version>
    <skipITs>true</skipITs>

    <!-- CycloneDX SBOM generation (curriculum: trusted-supply-chain). The build
         emits a CycloneDX 1.6 JSON bill of materials that module's pipeline signs
         and attests with cosign (type cyclonedx) and attendees inspect with jq. -->
    <cyclonedx-plugin.version>2.9.2</cyclonedx-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- REST + JSON: the /api/claims CRUD surface. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <!-- Persistence: Panache active-record over Hibernate ORM (the Claim entity). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm-panache</artifactId>
    </dependency>
    <!-- PostgreSQL JDBC driver: the production datasource (M04/M05 wire it via env). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>
    <!-- Health probes: /q/health/live and /q/health/ready (curriculum: config-multienv teaches them,
         observability-health-scale watches them). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <!-- Prometheus metrics at /q/metrics (curriculum: observability-health-scale). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- Structured logging: one JSON object per log record on stdout (curriculum:
         application-logging). Adding the extension is what SHIPS the capability; the switch
         (quarkus.log.console.json.enabled) stays FALSE in application.properties so every other
         module keeps the human-readable console its captured output was taken against, and that
         module turns it on per deployment with QUARKUS_LOG_CONSOLE_JSON_ENABLED=true. Same
         ships-off-by-default shape as the OpenTelemetry exporter and the OIDC tenant above. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-logging-json</artifactId>
    </dependency>
    <!-- Distributed tracing: OTLP-exported spans across web->claims->db (curriculum: observability-health-scale).
         Instrumentation ships in the image; the exporter is switched on by that module (see README). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-opentelemetry</artifactId>
    </dependency>
    <!-- OIDC: this is a bearer-only resource server (curriculum: securing-apps-keycloak).
         The tenant ships DISABLED (quarkus.oidc.tenant-enabled=false) so every other
         module stays unprotected (module independence); that module enables it and adds
         @RolesAllowed("claims-adjuster") on the guarded method. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc</artifactId>
    </dependency>
    <!-- OIDC client: lets securing-apps-keycloak exchange the caller's user token for a
         token scoped to aud=parasol-fraud (RFC 8693 standard token exchange) before calling
         parasol-fraud. Inert until that module configures a quarkus.oidc-client.* grant. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc-client</artifactId>
    </dependency>

    <!-- Test-only: build-time smoke tests over the seeded API + probes (feeds CI "apps" job).
         H2 keeps tests self-contained so CI never needs a PostgreSQL. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler-plugin.version}</version>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- CycloneDX SBOM: bound to `package`, so `mvn package` (and the in-cluster
           Containerfile build) emits target/parasol-claims-sbom.json describing every
           dependency. trusted-supply-chain signs and attests it; the seeded log4j-core CVE on the
           `seed-vulnerable` branch is what attendees find when they inspect it. -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>${cyclonedx-plugin.version}</version>
        <executions>
          <execution>
            <id>build-sbom</id>
            <phase>package</phase>
            <goals>
              <goal>makeBom</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <projectType>application</projectType>
          <schemaVersion>1.6</schemaVersion>
          <outputFormat>json</outputFormat>
          <outputName>parasol-claims-sbom</outputName>
          <outputDirectory>${project.build.directory}</outputDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
