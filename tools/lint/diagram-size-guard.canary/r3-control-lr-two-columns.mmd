%% CONTROL for rule 3: seven nodes laid out narrow, the honest way. Each box sets direction TB so
%% its children stack into a column, the boxes are joined CONTAINER TO CONTAINER so those direction
%% lines actually survive, and the whole picture is two ranks wide instead of seven.
%% This is the fixed form of the canary next door, and it must not still be a finding — a guard that
%% flags the fix as well as the defect gives an author nowhere to go.
%% EXPECT: none | - — baseline only. Its silence is the longest chain being four, not seven.
flowchart LR
  subgraph A["first column"]
    direction TB
    w1["one"] --> w2["two"] --> w3["three"] --> w4["four"]
  end
  subgraph B["second column"]
    direction TB
    w5["five"] --> w6["six"] --> w7["seven"]
  end
  A --> B
