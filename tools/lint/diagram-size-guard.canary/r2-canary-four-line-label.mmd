%% CANARY for rule 2, the height multiplier. Four lines in one node label.
%% Every extra line raises the tallest box in its rank, and the 900px cap then scales the whole
%% picture by 900/w — so on a narrow diagram a tall label is magnified, not trimmed.
%% EXPECT: tall-label | blind LABEL_BREAK_RE — the rule is a COUNT of line breaks, so blinding the
%% break pattern must take the finding with it. Nothing else in this file can keep it alive.
graph LR
%% MUST-FIRE
  box["line one<br/>line two<br/>line three<br/>line four"] --> ok["two<br/>lines"]
