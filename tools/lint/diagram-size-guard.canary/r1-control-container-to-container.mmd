%% CONTROL for rule 1, and the measured-good shape the rule exists to steer authors toward.
%% Identical to the canary next door except for ONE edge: the boxes are joined container to
%% container, A --> B, so neither membership set is touched, both direction lines survive, and the
%% picture measured 397x284 in a browser instead of 142x689.
%% A naive implementation of rule 1 — "a subgraph that declares direction and has an edge near it" —
%% fires here, which is exactly why this file is kept.
%% EXPECT: none | - — baseline only. Depth tracking is owned by the sibling control that plants a
%% node after the closing end; what this file owns is that a container-to-container join is not a
%% boundary crossing.
flowchart TB
  subgraph A["left box"]
    direction LR
    a1["one"] --> a2["two"]
  end
  subgraph B["right box"]
    direction LR
    b1["three"] --> b2["four"]
  end
  A --> B
