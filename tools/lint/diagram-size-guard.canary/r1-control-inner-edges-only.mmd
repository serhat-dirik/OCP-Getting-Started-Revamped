%% CONTROL for rule 1, the plain good case: a subgraph declares direction and every edge it touches
%% stays inside it, so the direction is honoured and there is nothing to report.
%% EXPECT: none | - — baseline only. This is the file that would catch a rule 1 which had stopped
%% checking the boundary at all and simply flagged every direction line it found.
flowchart TB
  subgraph A["left box"]
    direction LR
    a1["one"] --> a2["two"] --> a3["three"]
  end
  outside["elsewhere"] --> other["and again"]
