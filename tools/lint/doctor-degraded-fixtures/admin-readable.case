# A recorded cluster for `ws doctor` — EVERY ROW GRADED, NOTHING WRONG.
#
# The control for attendee-forbidden.case, and not a formality: the defect that case pins was fixed
# by teaching the verdict to say "this run did not fully check the environment", and the cheapest
# wrong way to do that is to say it always. A caveat printed on a clean run is one people learn to
# ignore, which costs the warning that matters — this repo has already paid that bill once, in
# tools/verify/_lib.sh, where a not-applicable outcome was reported as a skip and told attendees
# whose run was completely and correctly graded that it "did NOT fully verify the lab".
#
# So this case exists to pin the OTHER direction: with nothing ungraded, the report keeps its plain
# green line, the count equals the number of rows, and there is no caveat anywhere.
#
# TRANSCRIBED from a cluster-admin `ws doctor --user user3` on a live cluster, 2026-08-06 (same shim,
# same run shape as the sibling case), scrubbed to example.com and re-pointed at user1. Three
# departures are documented inline: the trimmed Application list, an attendee with no entry state,
# and an idle cluster for the image-drift scan.

argv	doctor --user user1
exit	0

row	cluster login	✅
row	gitops operator	✅
row	argo applications	✅
row	entry verify (strict)	✅
row	gitea	✅
row	mirror (parasol/ocp-getting-started)	✅
row	workshop layer	✅
row	showroom antora image	✅
row	cockpit attributes	✅
row	parasol images	✅
row	running image drift	✅
row	workshop IdP	✅
row	user namespaces	✅
row	workshop cohort size	✅
row	cohort coherence	✅

# No "· ⚠ … NOT GRADED", no "· ➖ … not applicable", no follow-up line: 15 rows, 15 graded, and the
# verdict claims exactly that and nothing more. The count is what makes this assertion worth making —
# "environment looks good" alone was true here before the change too.
verdict	✅ environment looks good — all 15 checks passed

# ── the recording ──────────────────────────────────────────────────────────────────────────────
oc	whoami	0	admin<NL>
oc	whoami --show-server	0	https://api.cluster-fixture.example.com:6443<NL>
oc	get csv -n openshift-gitops-operator -o jsonpath={.items[?(@.spec.displayName=="Red Hat OpenShift GitOps")].status.phase}	0	Succeeded<NL>

# DEPARTURE 1 — trimmed to four Applications, as in the sibling case, and for the same reason.
oc	get applications -n openshift-gitops -o jsonpath={range .items[*]}{.metadata.name}{"\t"}{.status.health.status}{"\t"}{.metadata.labels.workshop\.redhat\.com/user}{"\t"}{.metadata.labels.workshop\.redhat\.com/module}{"\t"}{.metadata.labels.workshop\.redhat\.com/degraded-by-design}{"\n"}{end}	0	entry-agentic-ai-user1<TAB>Healthy<TAB>user1<TAB>agentic-ai<TAB><NL>entry-ai-assisted-development-user8<TAB>Degraded<TAB>user8<TAB>ai-assisted-development<TAB>true<NL>pp-gitea<TAB>Healthy<TAB><TAB><TAB><NL>workshop-config<TAB>Healthy<TAB><TAB><TAB><NL>
# DEPARTURE 2 — no entry state for the scoped attendee, so the row grades n/a and the recording
# never has to model a verify script's own process. See the sibling case for the full reasoning.
oc	get applications -n openshift-gitops -l workshop.redhat.com/user=user1 -o jsonpath={range .items[*]}{.metadata.name}{"\t"}{.metadata.labels.workshop\.redhat\.com/user}{"\t"}{.metadata.labels.workshop\.redhat\.com/module}{"\t"}{.spec.source.helm.parameters[?(@.name=="solve")].value}{"\n"}{end}	0

oc	get route gitea -n ogsr-gitea -o jsonpath={.spec.host}	0	gitea-ogsr-gitea.apps.cluster-fixture.example.com<NL>
oc	get application workshop-config -n openshift-gitops -o jsonpath={.status.health.status}	0	Healthy<NL>

# The build rows: an admin reads them, so they grade ✅ where the attendee got ⚠. Both call sites
# discard stdout and branch on rc alone, so the tables oc prints are elided rather than transcribed.
oc	get bc antora-ext -n ogsr-showroom	0
oc	get istag antora-ext:latest -n ogsr-showroom	0
# The cockpit-attributes row, read by the one identity that can: list this attendee's cockpit
# ConfigMap, then read the two user_data.yml payloads. Both are FULLY WIRED here — a real
# maas_model and a real cluster_ocp_version — which is what makes this row's ✅ mean something.
# The failing direction is not modelled with a recording: the grading is a pure function of the
# body (doctor_cockpit_attr_findings), so an omitted key or a passed-through sentinel is settled
# by feeding it one, not by inventing a second cluster.
oc	get cm -n ogsr-showroom -l workshop.redhat.com/user=user1 -o jsonpath={range .items[*]}{.metadata.name}{"\n"}{end}	0	showroom-userdata-user1<NL>
oc	get cm showroom-userdata-user1 -n ogsr-showroom -o jsonpath={.data.user_data\.yml}	0	user: user1<NL>page-user: user1<NL>cluster_domain: apps.cluster-fixture.example.com<NL>ocp_console_url: https://console-openshift-console.apps.cluster-fixture.example.com<NL>gitea_url: https://gitea-ogsr-gitea.apps.cluster-fixture.example.com<NL>devspaces_url: https://devspaces.apps.cluster-fixture.example.com<NL>mta_url: https://mta-openshift-mta.apps.cluster-fixture.example.com<NL>sonarqube_url: https://sonarqube-sonarqube.apps.cluster-fixture.example.com<NL>acs_console_url: https://central-stackrox.apps.cluster-fixture.example.com<NL>maas_model: "qwen3-14b"<NL>maas_endpoint: "https://maas.apps.cluster-fixture.example.com/v1"<NL>cluster_ocp_version: "4.22.8"<NL>guid: user1<NL>lab_name: OpenShift Application Platform — Getting Started<NL>
oc	get cm showroom-demos-userdata -n ogsr-showroom -o jsonpath={.data.user_data\.yml}	0	cluster_domain: apps.cluster-fixture.example.com<NL>ocp_console_url: https://console-openshift-console.apps.cluster-fixture.example.com<NL>gitea_url: https://gitea-ogsr-gitea.apps.cluster-fixture.example.com<NL>devspaces_url: https://devspaces.apps.cluster-fixture.example.com<NL>cluster_ocp_version: "4.22.8"<NL>maas_model: "qwen3-14b"<NL>maas_endpoint: "https://maas.apps.cluster-fixture.example.com/v1"<NL>guid: sa-demo<NL>lab_name: OpenShift Application Platform — Getting Started — Demo Guide<NL>
oc	get bc parasol-claims -n ogsr-parasol-images	0
oc	get istag parasol-claims:1.0 -n ogsr-parasol-images	0
oc	get istag parasol-claims:1.1 -n ogsr-parasol-images	0
oc	get istag parasol-web:1.0 -n ogsr-parasol-images	0
oc	get istag parasol-web:1.1 -n ogsr-parasol-images	0
oc	get istag parasol-fraud:1.0 -n ogsr-parasol-images	0
oc	get istag parasol-notifications:1.0 -n ogsr-parasol-images	0
oc	get istag parasol-agent:1.0 -n ogsr-parasol-images	0
oc	get istag mcp-agent-cli:1.0 -n ogsr-parasol-images	0
oc	get istag claims-db:1.0 -n ogsr-parasol-images	0
oc	get istag policy-docs:1.0 -n ogsr-parasol-images	0

# DEPARTURE 3 — the drift row's gate opens (the probe answers, empty, as it does for an admin) and
# then scans an IDLE cluster: no workshop workload is running and Knative is not installed, so the
# scan finds no consumers and the row grades n/a. Authored: the live cluster's workload list is every
# Deployment in every namespace, which would bury this file, and the populated scan already has a
# recording of its own — tools/lint/rebuild-scan-fixtures/cluster.yaml, whose whole subject it is.
oc	get deployments -A --field-selector=metadata.name=ws-doctor-drift-probe -o name	0
oc	get ns -l workshop.redhat.com/user -o jsonpath={range .items[*]}{.metadata.name}{"\t"}{.metadata.labels.workshop\.redhat\.com/user}{"\n"}{end}	0	user1-dev<TAB>user1<NL>
oc	get deployments,statefulsets,daemonsets,cronjobs -A -o go-template={{range .items}}{{$k := .kind}}{{$ns := .metadata.namespace}}{{$n := .metadata.name}}{{$s := ""}}{{range $kk, $vv := .spec.selector.matchLabels}}{{$s = printf "%s%s=%s," $s $kk $vv}}{{end}}{{if not $s}}{{$s = "-"}}{{end}}{{range .spec.template.spec.containers}}{{$k}}{{"\t"}}{{$ns}}{{"\t"}}{{$n}}{{"\t"}}{{$s}}{{"\t"}}{{.name}}{{"\t"}}{{.image}}{{"\n"}}{{end}}{{range .spec.jobTemplate.spec.template.spec.containers}}{{$k}}{{"\t"}}{{$ns}}{{"\t"}}{{$n}}{{"\t"}}{{$s}}{{"\t"}}{{.name}}{{"\t"}}{{.image}}{{"\n"}}{{end}}{{end}}	0
oc	get crd services.serving.knative.dev	1		Error from server (NotFound): customresourcedefinitions.apiextensions.k8s.io "services.serving.knative.dev" not found<NL>

oc	get oauth cluster -o jsonpath={.spec.identityProviders[*].name}	0	rhbk workshop-users<NL>
oc	get ns user1-dev	0	NAME        STATUS   AGE<NL>user1-dev   Active   10h<NL>
oc	get group workshop-attendees -o jsonpath={.users[*]}	0	user1 user2 user3 user4 user5 user6 user7 user8<NL>
oc	get application workshop-config -n openshift-gitops	0	NAME              SYNC STATUS   HEALTH STATUS<NL>workshop-config   Synced        Healthy<NL>
oc	get application workshop-config -n openshift-gitops -o jsonpath={.spec.source.helm.parameters[?(@.name=="userCount")].value}	0	8<NL>

# Cohort coherence reaches all four of its sources here, which the attendee run never does — it stops
# at the first Forbidden. The Gitea admin password is a FIXTURE STRING: this file must never carry a
# credential, and the stub does not key on one (the URL is the key).
oc	get users -o jsonpath={.items[*].metadata.name}	0	admin user1 user2 user3 user4 user5 user6 user7 user8<NL>
oc	get gitea gitea -n ogsr-gitea -o jsonpath={.spec.giteaAdminUser}	0	gitea-admin<NL>
oc	get gitea gitea -n ogsr-gitea -o jsonpath={.status.adminPassword}	0	fixture-not-a-credential<NL>

curl	https://gitea-ogsr-gitea.apps.cluster-fixture.example.com/api/v1/version	0
curl	https://gitea-ogsr-gitea.apps.cluster-fixture.example.com/api/v1/repos/parasol/ocp-getting-started	0
# The admin users listing: stdout is the http_code curl is asked for with -w, and the body goes to
# the -o file. Eight accounts, so the pager stops after one page (it pages while a page is full).
curl	https://gitea-ogsr-gitea.apps.cluster-fixture.example.com/api/v1/admin/users?limit=50&page=1	0	200	[{"login":"user1","username":"user1"},{"login":"user2","username":"user2"},{"login":"user3","username":"user3"},{"login":"user4","username":"user4"},{"login":"user5","username":"user5"},{"login":"user6","username":"user6"},{"login":"user7","username":"user7"},{"login":"user8","username":"user8"}]
oc	get deploy showroom-shared -n ogsr-showroom	1
