{{- /*
  Canary cockpit — the define block is NEVER CLOSED at its own depth. One `if` opens, one `end`
  closes it, and the define's own `end` is missing (the shape a bad merge or a deleted line
  produces).

  This is the failure the depth matcher itself can have: if it ran off the end of the file and
  returned everything it had seen, the guard would report keys from outside the block as
  emissions — a verdict built on text that is not part of the cockpit's attribute payload. It must
  come back "I could not locate a depth-matched end", rc 2.
*/ -}}
{{- define "canary.userData" }}
    user: {{ .user }}
    cluster_domain: {{ .domain }}
    {{- if .root.Values.maasModel }}
    maas_model: {{ .root.Values.maasModel | quote }}
    {{- end }}
    rhdh_url: https://backstage-developer-hub-rhdh.{{ .domain }}
apiVersion: v1
kind: ConfigMap
metadata:
  name: canary-userdata
  namespace: canary
