{{- /*
  Canary cockpit — the named template is FOUND and correctly terminated, and yields ZERO keys.

  This separates two failures that look identical from the outside: "the template is not there"
  (cockpit-no-define) and "the template is there and the parser got nothing out of it". The second
  is the one that reads as a normal answer — an empty emitted-key set makes every attribute look
  missing, or, with one comparison flipped, makes nothing look missing at all. The block below is
  all Helm actions and comments, exactly what a broken key regex would reduce a real template to,
  so the guard must say "the parser failed", rc 2, rather than return an empty set as a verdict.
*/ -}}
{{- define "canary.userData" }}
    {{- /* Every line in this body is an action or a comment. No YAML key reaches the payload. */ -}}
    {{- if .root.Values.maasModel }}
    {{- end }}
    {{- range $slug := .disabledModules }}
    {{- end }}
{{- end }}
apiVersion: v1
kind: ConfigMap
metadata:
  name: canary-userdata
  namespace: canary
data:
  user_data.yml: |
{{- include "canary.userData" . }}
