{{- /*
  Canary cockpit — INSTANCE 2, RECONSTRUCTED. Identical to cockpit-complete.yaml.tmpl except that
  `rhdh_url` and `student_argo_url` are not emitted, which is exactly the state both real cockpits
  were in until 2026-08-12: 12 and 8 content references respectively, and every attendee served
  backstage-developer-hub-rhdh.apps.example.com.

  The two attributes ARE named in a `#` comment below, deliberately. That is the realistic way this
  fixture would go wrong: the real templates discuss missing attributes at length in prose right
  beside the keys, and a parser that does not strip `#` comments would find the names, call the
  cockpit complete, and hand back a green tick over the defect it was written for.
*/ -}}
{{- define "canary.userData" }}
    user: {{ .user }}
    page-user: {{ .user }}
    cluster_domain: {{ .domain }}
    ocp_console_url: https://console-openshift-console.{{ .domain }}
    # NOT EMITTED, and named here only in prose — the trap described in the header:
    # rhdh_url: https://backstage-developer-hub-rhdh.{{ .domain }}
    # student_argo_url: https://student-gitops-server-student-gitops.{{ .domain }}
    sonarqube_url: https://sonarqube-sonarqube.{{ .domain }}
    acs_console_url: https://central-stackrox.{{ .domain }}
    mta_url: https://mta-openshift-mta.{{ .domain }}
    real_host_url: https://gitea-ogsr-gitea.{{ .domain }}
    {{- if .root.Values.maasModel }}
    maas_model: {{ .root.Values.maasModel | quote }}
    {{- end }}
    {{- if .root.Values.maasEndpoint }}
    maas_endpoint: {{ .root.Values.maasEndpoint | quote }}
    {{- end }}
    {{- if .root.Values.ocpVersion }}
    cluster_ocp_version: {{ .root.Values.ocpVersion | quote }}
    {{- end }}
    {{- range $slug := .disabledModules }}
    module-{{ $slug }}-hidden: "true"
    {{- end }}
    guid: {{ .user }}
{{- end }}
apiVersion: v1
kind: ConfigMap
metadata:
  name: canary-userdata
  namespace: canary
data:
  user_data.yml: |
{{- include "canary.userData" . }}
