{{- /*
  Canary cockpit — the attribute payload is SPLIT ACROSS TWO named templates. This guard reads the
  define block as text and cannot follow an `include`, so the keys the callee emits are invisible
  to it.

  The dangerous reading is the quiet one: the block parses, four keys come back, and the guard
  reports whichever attributes those four happen to cover as satisfied — a green tick resting on
  keys it never saw. The whole class of this repo's guard failures is "reported success over work
  it did not do", so an include inside the block is rc 2 and the refactor has to teach the guard
  before it lands.

  This is not hypothetical for the shape: showroom.yaml already emits its Deployment checksum from
  `include "workshop-config.showroomUserData"`, so composing named templates is the idiom in this
  chart — it is simply not (yet) used INSIDE the payload template.
*/ -}}
{{- define "canary.userDataTail" }}
    rhdh_url: https://backstage-developer-hub-rhdh.{{ .domain }}
    student_argo_url: https://student-gitops-server-student-gitops.{{ .domain }}
{{- end }}
{{- define "canary.userData" }}
    user: {{ .user }}
    cluster_domain: {{ .domain }}
    ocp_console_url: https://console-openshift-console.{{ .domain }}
{{ include "canary.userDataTail" . }}
    guid: {{ .user }}
{{- end }}
apiVersion: v1
kind: ConfigMap
metadata:
  name: canary-userdata
  namespace: canary
data:
  user_data.yml: |
{{- include "canary.userData" . }}
