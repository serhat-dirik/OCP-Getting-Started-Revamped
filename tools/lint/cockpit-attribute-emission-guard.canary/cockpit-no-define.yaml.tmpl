{{- /*
  Canary cockpit — the named template this guard is told to read DOES NOT EXIST here (renamed, or
  COCKPITS points at the wrong file). The realistic version of this is a refactor that renames the
  template and updates the ConfigMap's `include` but not the guard's declared list.

  What must NOT happen: an empty key set returned as if the cockpit emitted nothing, or — with one
  comparison flipped — as if it emitted everything. Either reading is a verdict about a file the
  guard never actually read, so this is rc 2.

  The define below carries a DIFFERENT name and real keys, so the failure is "the named template
  is not here", not "the file has no templates in it".
*/ -}}
{{- define "canary.someOtherTemplate" }}
    user: {{ .user }}
    cluster_domain: {{ .domain }}
    rhdh_url: https://backstage-developer-hub-rhdh.{{ .domain }}
    student_argo_url: https://student-gitops-server-student-gitops.{{ .domain }}
{{- end }}
apiVersion: v1
kind: ConfigMap
metadata:
  name: canary-userdata
  namespace: canary
data:
  user_data.yml: |
{{- include "canary.someOtherTemplate" . }}
