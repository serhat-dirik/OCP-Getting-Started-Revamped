# cluster-unreachable — nothing can be asked. Every outcome must be ⚠ and NONE may be ❌.
#
# Hotel wifi, a VPN drop, an RHDP environment that went network-dark (it happens: the project has a
# whole incident note about both clusters going dark at once while DNS and the internet stayed fine).
# The attendee may have done the entire lab correctly. A ❌ on any line here accuses them of not
# having, which is the false-red this suite's three-outcome design exists to delete.
#
# It also pins the rc-4 tripwire from the other side. In untouched.case the seven entry passes pad
# PASS+FAIL above zero, so VERIFY_STRICT=1 returns 3 — "a partial but legitimate pass" — even though
# no attendee work was graded at all. Here nothing is graded AND nothing padded it, so the banner has
# to say so outright and strict mode has to return 4. The contrast between the two cases is the
# clearest statement of why F-06 was invisible: the tripwire never fires while entry checks pass.
args	--user	user9

# oc_read's classification vocabulary: "Unable to connect to the server" is a transport failure, not
# the server's answer, so it must reach ⚠ and never the ❌ branch that NotFound takes.
oc	get ns user9-dev	1	@FORBIDDEN	Unable to connect to the server: dial tcp 10.0.0.1:6443: i/o timeout<NL>
oc	get cm ws-entry-devspaces-inner-loop -n user9-dev	1	@FORBIDDEN	Unable to connect to the server: dial tcp 10.0.0.1:6443: i/o timeout<NL>
oc	get resourcequota workshop-quota -n user9-dev	1	@FORBIDDEN	Unable to connect to the server: dial tcp 10.0.0.1:6443: i/o timeout<NL>
oc	get route gitea -n ogsr-gitea -o jsonpath={.spec.host}	1	@FORBIDDEN	Unable to connect to the server: dial tcp 10.0.0.1:6443: i/o timeout<NL>
oc	get ingresses.config.openshift.io cluster -o jsonpath={.spec.domain}	1	@FORBIDDEN	Unable to connect to the server: dial tcp 10.0.0.1:6443: i/o timeout<NL>
oc	get deploy claims-db -n user9-dev -o jsonpath={.status.readyReplicas}	1	@FORBIDDEN	Unable to connect to the server: dial tcp 10.0.0.1:6443: i/o timeout<NL>
oc	get deploy parasol-claims -n user9-dev -o jsonpath={.status.readyReplicas}	1	@FORBIDDEN	Unable to connect to the server: dial tcp 10.0.0.1:6443: i/o timeout<NL>
oc	get route parasol-claims -n user9-dev -o jsonpath={.spec.host}	1	@FORBIDDEN	Unable to connect to the server: dial tcp 10.0.0.1:6443: i/o timeout<NL>
oc	get ns user9-devspaces	1	@FORBIDDEN	Unable to connect to the server: dial tcp 10.0.0.1:6443: i/o timeout<NL>
oc	get devworkspace parasol-claims -n user9-devspaces	1	@FORBIDDEN	Unable to connect to the server: dial tcp 10.0.0.1:6443: i/o timeout<NL>
oc	get devworkspace parasol-claims -o jsonpath={.spec.started}|{.status.phase}|{.status.devworkspaceId} -n user9-devspaces	1	@FORBIDDEN	Unable to connect to the server: dial tcp 10.0.0.1:6443: i/o timeout<NL>
oc	get deployments -l controller.devfile.io/devworkspace_name=parasol-claims -o name -n user9-devspaces	1	@FORBIDDEN	Unable to connect to the server: dial tcp 10.0.0.1:6443: i/o timeout<NL>
oc	get pods -l controller.devfile.io/devworkspace_name=parasol-claims -o name -n user9-devspaces	1	@FORBIDDEN	Unable to connect to the server: dial tcp 10.0.0.1:6443: i/o timeout<NL>
oc	get persistentvolumeclaims -l controller.devfile.io/devworkspace_name=parasol-claims -o name -n user9-devspaces	1	@FORBIDDEN	Unable to connect to the server: dial tcp 10.0.0.1:6443: i/o timeout<NL>

# No curl records at all, deliberately. gitea_host cannot resolve a host from a cluster that will not
# answer, so both Gitea-facing checks return before curl is ever reached — and if one of them DOES
# reach curl, the unmodelled-call log catches it rather than a recording quietly answering for it.

mark	your /ping endpoint is pushed	⚠
mark	the end state is not gradeable from here	⚠
mark	Gitea fork user9/parasol-claims exists	⚠
mark	namespace user9-dev exists	⚠
verdict	⚠ NOTHING was graded · 11 SKIPPED (not graded) — 0 checks were answered, so this run says nothing about the lab
rc	0
strict-rc	4

entry-absent	/ping endpoint is pushed
entry-rc	0
