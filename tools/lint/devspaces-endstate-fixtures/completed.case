# completed — the attendee did the lab.
#
# They signed in to the Dev Spaces dashboard (so Che adopted user9-devspaces and the reads answer),
# started the parasol-claims workspace, wrote the /ping endpoint in exercise 3 and pushed it to their
# fork's main in exercise 5. This is the world the module's ✅ is supposed to mean, and it is the one
# that CANNOT be built on a shared cluster without writing a commit into somebody's Gitea fork — see
# cmd-stub.py's header.
#
# NOTE what is deliberately NOT recorded: the Deployment/Pod/PVC label reads. workspace_started's
# declaration leg answers `true` and returns before the observation leg runs, and an unrecorded call
# is a FINDING here, so this case also pins that short-circuit.
args	--user	user9

oc	get ns user9-dev	0	namespace/user9-dev<NL>
oc	get cm ws-entry-devspaces-inner-loop -n user9-dev	0	configmap/ws-entry-devspaces-inner-loop<NL>
oc	get resourcequota workshop-quota -n user9-dev	0	resourcequota/workshop-quota<NL>
oc	get route gitea -n ogsr-gitea -o jsonpath={.spec.host}	0	gitea-ogsr-gitea.apps.example.com
oc	get deploy claims-db -n user9-dev -o jsonpath={.status.readyReplicas}	0	1
oc	get deploy parasol-claims -n user9-dev -o jsonpath={.status.readyReplicas}	0	1
oc	get route parasol-claims -n user9-dev -o jsonpath={.spec.host}	0	parasol-claims-user9-dev.apps.example.com
oc	get ns user9-devspaces	0	namespace/user9-devspaces<NL>
oc	get devworkspace parasol-claims -n user9-devspaces	0	parasol-claims   Running<NL>
# spec.started | status.phase | status.devworkspaceId — the LITERAL '|' separators the jsonpath emits.
oc	get devworkspace parasol-claims -o jsonpath={.spec.started}|{.status.phase}|{.status.devworkspaceId} -n user9-devspaces	0	true|Running|workspacec8b6ba1e5d3a4f92

curl	https://gitea-ogsr-gitea.apps.example.com/api/v1/repos/user9/parasol-claims	0
curl	http://parasol-claims-user9-dev.apps.example.com/q/health/ready	0	200
# The seed, plus the endpoint exactly as the lab prints it for the attendee to type.
curl	https://gitea-ogsr-gitea.apps.example.com/api/v1/repos/user9/parasol-claims/raw/src/main/java/com/parasol/claims/ClaimResource.java?ref=main	0	200	@WORLD:pushed.java

mark	your /ping endpoint is pushed	✅
mark	the parasol-claims workspace has been started	✅
mark	workspace parasol-claims is declared in user9-devspaces	✅
verdict	✅ all 11 checks passed
rc	0

entry-absent	/ping endpoint is pushed
entry-verdict	✅ all 9 checks passed
entry-rc	0
