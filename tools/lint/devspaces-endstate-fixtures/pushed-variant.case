# pushed-variant — the attendee did the lab and went FURTHER. Must still be ✅.
#
# One variable changes from completed.case: the shape of what they wrote. They typed the annotation
# with the slash dropped and spaces inside the parens (@Path( "ping" ) — JAX-RS treats it identically)
# and they took the lab's own Challenge, which says in as many words: "Change the /ping endpoint to
# return JSON that includes the total number of claims". So the return literal the lab prints is GONE
# from their source.
#
# This is the false-❌ direction, and this suite grades it as hard as the false-✅ one. A check that
# only passes for an attendee who typed the sample byte for byte punishes exactly the people who
# understood it best, and one red line an attendee knows is wrong costs the credibility of every ✅
# beside it. The mutant that tightens the regex onto the return string is caught HERE and nowhere
# else — untouched.case and completed.case both pass with that defect present.
args	--user	user9

oc	get ns user9-dev	0	namespace/user9-dev<NL>
oc	get cm ws-entry-devspaces-inner-loop -n user9-dev	0	configmap/ws-entry-devspaces-inner-loop<NL>
oc	get resourcequota workshop-quota -n user9-dev	0	resourcequota/workshop-quota<NL>
oc	get route gitea -n ogsr-gitea -o jsonpath={.spec.host}	0	gitea-ogsr-gitea.apps.example.com
oc	get deploy claims-db -n user9-dev -o jsonpath={.status.readyReplicas}	0	1
oc	get deploy parasol-claims -n user9-dev -o jsonpath={.status.readyReplicas}	0	1
oc	get route parasol-claims -n user9-dev -o jsonpath={.spec.host}	0	parasol-claims-user9-dev.apps.example.com
oc	get ns user9-devspaces	0	namespace/user9-devspaces<NL>
oc	get devworkspace parasol-claims -n user9-devspaces	0	parasol-claims   Running<NL>
# Idle auto-stop has already put spec.started back to false and scaled the Deployment to zero — an
# attendee who finished half an hour ago. The OBSERVATION leg is what still answers for them, so this
# case exercises the label-scoped read that completed.case short-circuits past.
oc	get devworkspace parasol-claims -o jsonpath={.spec.started}|{.status.phase}|{.status.devworkspaceId} -n user9-devspaces	0	false|Stopped|workspacec8b6ba1e5d3a4f92
oc	get deployments -l controller.devfile.io/devworkspace_name=parasol-claims -o name -n user9-devspaces	0	deployment.apps/workspacec8b6ba1e5d3a4f92<NL>

curl	https://gitea-ogsr-gitea.apps.example.com/api/v1/repos/user9/parasol-claims	0
curl	http://parasol-claims-user9-dev.apps.example.com/q/health/ready	0	200
curl	https://gitea-ogsr-gitea.apps.example.com/api/v1/repos/user9/parasol-claims/raw/src/main/java/com/parasol/claims/ClaimResource.java?ref=main	0	200	@WORLD:variant.java

mark	your /ping endpoint is pushed	✅
mark	the parasol-claims workspace has been started	✅
verdict	✅ all 11 checks passed
rc	0

entry-absent	/ping endpoint is pushed
entry-verdict	✅ all 9 checks passed
entry-rc	0
