# untouched — `ws prep devspaces-inner-loop` ran and the attendee has done NOTHING.
#
# This IS audit F-06's world, transcribed from a live one: measured on user5 and user6 (cluster
# dev cluster, 2026-08-06), both carrying a materialized ws-entry-devspaces-inner-loop, neither having
# opened Dev Spaces or pushed anything. Before the fix this run printed SEVEN ✅ and exited 0 — all
# seven `ws prep` artefacts — because the module's only completion check landed on its ⚠ branch.
# {user}-devspaces is Forbidden to an attendee until Che adopts it at first dashboard sign-in, which
# IS lab exercise 1, so this is the DEFAULT world for anyone who verifies before starting.
#
# Field order: kind, key, rc, stdout, stderr   (curl: kind, url, rc, -w output, body)
args	--user	user9

oc	get ns user9-dev	0	namespace/user9-dev<NL>
oc	get cm ws-entry-devspaces-inner-loop -n user9-dev	0	configmap/ws-entry-devspaces-inner-loop<NL>
oc	get resourcequota workshop-quota -n user9-dev	0	resourcequota/workshop-quota<NL>
oc	get route gitea -n ogsr-gitea -o jsonpath={.spec.host}	0	gitea-ogsr-gitea.apps.example.com
oc	get deploy claims-db -n user9-dev -o jsonpath={.status.readyReplicas}	0	1
oc	get deploy parasol-claims -n user9-dev -o jsonpath={.status.readyReplicas}	0	1
oc	get route parasol-claims -n user9-dev -o jsonpath={.spec.host}	0	parasol-claims-user9-dev.apps.example.com

# Che has not adopted user9-devspaces yet, so every read into it is refused. Verbatim shape of what
# the apiserver actually returns, because oc_read classifies on the word "forbidden".
oc	get ns user9-devspaces	1	@FORBIDDEN	Error from server (Forbidden): namespaces "user9-devspaces" is forbidden: User "user9" cannot get resource "namespaces" in API group "" in the namespace "user9-devspaces"<NL>
oc	get devworkspace parasol-claims -n user9-devspaces	1	@FORBIDDEN	Error from server (Forbidden): devworkspaces.workspace.devfile.io "parasol-claims" is forbidden: User "user9" cannot get resource "devworkspaces" in API group "workspace.devfile.io" in the namespace "user9-devspaces"<NL>
oc	get devworkspace parasol-claims -o jsonpath={.spec.started}|{.status.phase}|{.status.devworkspaceId} -n user9-devspaces	1	@FORBIDDEN	Error from server (Forbidden): devworkspaces.workspace.devfile.io "parasol-claims" is forbidden: User "user9" cannot get resource "devworkspaces" in API group "workspace.devfile.io" in the namespace "user9-devspaces"<NL>
oc	get deployments -l controller.devfile.io/devworkspace_name=parasol-claims -o name -n user9-devspaces	1	@FORBIDDEN	Error from server (Forbidden): deployments.apps is forbidden: User "user9" cannot list resource "deployments" in API group "apps" in the namespace "user9-devspaces"<NL>
oc	get pods -l controller.devfile.io/devworkspace_name=parasol-claims -o name -n user9-devspaces	1	@FORBIDDEN	Error from server (Forbidden): pods is forbidden: User "user9" cannot list resource "pods" in API group "" in the namespace "user9-devspaces"<NL>
oc	get persistentvolumeclaims -l controller.devfile.io/devworkspace_name=parasol-claims -o name -n user9-devspaces	1	@FORBIDDEN	Error from server (Forbidden): persistentvolumeclaims is forbidden: User "user9" cannot list resource "persistentvolumeclaims" in API group "" in the namespace "user9-devspaces"<NL>

curl	https://gitea-ogsr-gitea.apps.example.com/api/v1/repos/user9/parasol-claims	0
curl	http://parasol-claims-user9-dev.apps.example.com/q/health/ready	0	200
# The fork as the seed job leaves it: apps/parasol-claims' own ClaimResource.java, byte for byte.
# Measured against the live upstream repo and the tree, 2026-08-06 — zero occurrences of "/ping",
# and case-insensitively not the substring "ping" anywhere in the file.
curl	https://gitea-ogsr-gitea.apps.example.com/api/v1/repos/user9/parasol-claims/raw/src/main/java/com/parasol/claims/ClaimResource.java?ref=main	0	200	@WORLD:seeded.java

mark	your /ping endpoint is pushed	❌
mark	entry marker ws-entry-devspaces-inner-loop present	✅
mark	Gitea fork user9/parasol-claims exists	✅
# The ⚠ path prints its own sentence rather than $WS_DESC — deliberately, per check()'s note: a
# description written as a positive assertion states the thing as fact when it could not be read.
mark	the end state is not gradeable from here	⚠
verdict	❌ 1 of 8 checks failed · ⚠ 3 SKIPPED (not graded)
rc	1

# The mode split, in the same recording: `ws doctor` and `ws prep` run --entry-only against exactly
# this world, and a completion assertion leaking into that run would red doctor for everyone who
# finished the module (and offer to wipe their world).
entry-absent	/ping endpoint is pushed
entry-verdict	⚠ 7 passed · 2 SKIPPED (not graded) — this run did NOT fully verify the lab
entry-rc	0
