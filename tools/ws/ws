#!/usr/bin/env bash
# ws — workshop state CLI: materialize, verify, and reset per-user module environments.
#
#   ws list                          the module catalog (number · slug · title) from modules.yaml
#   ws prep   <module> [--yes]       ATTENDEE self-service: detect leftovers, offer wipe, prepare
#   ws start  <module> [--user U]    materialize the module's entry state for a user
#   ws verify <module> [--user U]    run the module's verification script
#   ws smoke  <module> [userN]       G1 attendee-cockpit gate: run the attendee path IN the live cockpit
#   ws reset  <module> [--user U]    return the user's world to the module's entry state
#   ws solve  <module> [--user U]    materialize the END state (instructor only)
#   ws git-refresh [--restart-terminals]   re-sync mirror+Argo; opt-in: restart cockpit terminal pods
#   ws doctor [--user U]             environment sanity: login, argo, gitea, operators, image drift
#                                    (--user narrows the cohort-wide rows to one attendee)
#   ws passwd [--user U] [NEWPASS]   SA/admin: rotate the shared workshop login password (cohort-wide)
#   ws cohort-reset [--yes]          SA/admin: wipe ALL per-user state for a fresh cohort (keeps platform)
#   ws scale-users N [--yes]         SA/admin: grow/shrink the workshop cohort to N users
#   ws preflight                     SA/admin: pre-install readiness + adoption forecast (run before install)
#   ws status [--user U]             SA/admin: one-glance cohort health (platform + per-user dashboard)
#   ws diag [--user U] [<module>]    SA/admin: read-only troubleshooting bundle for a stuck attendee
#   ws maas show|set [options]       SA/admin: inspect / change the MaaS model+key (no reinstall)
#   ws rebuild-images [--check]      SA/admin: rebuild workshop images and roll every stale consumer
#
# <module> is a position number (m08) OR a slug (app-security-testing) — both resolve via modules.yaml
# (position → slug); everything internal keys off the slug. `ws list` shows the mapping.
#
# Entry states are Helm charts under gitops/entry-states/<module>/, materialized as
# Argo CD Applications (name: entry-<module>-<user>) sourced from the IN-CLUSTER Gitea
# mirror (git-localize) — the public repo stays the upstream source of truth.
#
# Publishing content to a LIVE session (commit + push) has two freshness paths:
#   • the ws CLI SELF-HEALS: when a module's entry state / verify script is absent from this
#     terminal's pod-local clone, ws pulls the clone up to the mirror and retries once — so a
#     just-published module becomes runnable on the next `ws` command with NO pod restart.
#   • rendered lab PAGES build at pod-init, so they refresh only on a pod restart:
#     ws git-refresh --restart-terminals [--user U | --all] [--exclude U]  (any WS_RESERVED_USERS —
#     empty by default — are never cycled by --all; name one with --user to override).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ENTRY_DIR="${REPO_ROOT}/gitops/entry-states"
VERIFY_DIR="${REPO_ROOT}/tools/verify"
MODULES_YAML="${WS_MODULES_YAML:-${REPO_ROOT}/modules.yaml}"
ARGO_NS="${WS_ARGO_NS:-openshift-gitops}"
ARGO_PROJECT="${WS_ARGO_PROJECT:-workshop-entries}"
GITEA_NS="${WS_GITEA_NS:-ogsr-gitea}"
STUDENT_ARGO_NS="${WS_STUDENT_ARGO_NS:-ogsr-student-gitops}"
MIRROR_ORG="${WS_MIRROR_ORG:-parasol}"
MIRROR_REPO="${WS_MIRROR_REPO:-ocp-getting-started}"
SOURCE_REVISION="${WS_REVISION:-main}"
SHOWROOM_NS="${WS_SHOWROOM_NS:-ogsr-showroom}"
PARASOL_IMAGES_NS="${WS_PARASOL_IMAGES_NS:-ogsr-parasol-images}"

# `ws smoke` targets the LIVE cockpit pod (showroom-<user>) and its ttyd shell container. SMOKE_POD/
# SMOKE_NS are resolved per-run in cmd_smoke; declared here so the pod_i/pod_x exec helpers (dynamic
# scope) reference an assigned global (shellcheck-clean) rather than an unset one.
SMOKE_NS=""
SMOKE_POD=""
SMOKE_CONTAINER="terminal"

ok()   { echo "✅ $*"; }
err()  { echo "❌ $*" >&2; }
# "I could not look", which is NOT "it is broken". `ws doctor` is attendee-runnable, and an
# attendee cannot read cluster-scoped objects like oauths or groups. Reporting ❌ there told
# people their IdP was missing seconds after they had logged in THROUGH it — and a false ❌
# costs trust in every ✅ beside it.
skip() { echo "➖ $*"; }
info() { echo "▶ $*"; }
die()  { err "$*"; exit 1; }

need_oc() {
  command -v oc >/dev/null || die "oc not found in PATH"
  oc whoami >/dev/null 2>&1 || die "not logged in — oc login first (KUBECONFIG=${KUBECONFIG:-~/.kube/config})"
}

# Source repo for entry-state Applications: prefer the local Gitea mirror (git-localize),
# fall back to upstream GitHub when the mirror isn't up (early bootstrap, laptop dev).
# Attendees can't read the gitea Route cross-namespace (rule 10), so derive the host from
# the cluster ingress domain — the same attendee-safe pattern the verify scripts use.
repo_url() {
  local host domain
  host="$(oc get route gitea -n "${GITEA_NS}" -o jsonpath='{.spec.host}' 2>/dev/null || true)"
  if [[ -z "$host" ]]; then
    domain="$(oc get ingresses.config cluster -o jsonpath='{.spec.domain}' 2>/dev/null || true)"
    [[ -n "$domain" ]] && host="gitea-${GITEA_NS}.${domain}"
  fi
  if [[ -n "$host" ]] && curl -ksf --max-time 5 "https://${host}/api/v1/version" >/dev/null 2>&1; then
    echo "https://${host}/${MIRROR_ORG}/${MIRROR_REPO}.git"
    return
  fi
  # Mirror unreachable. Fall back to whatever source THIS install was configured with — read it off
  # a platform Application rather than assuming the upstream project, so a fork/internal-GitLab
  # install does not silently materialize entry states from someone else's repo. Attendees cannot
  # read Applications, so the compiled-in upstream stays as the last resort (and is only ever hit
  # with the mirror already down, i.e. laptop/early-bootstrap use).
  local configured
  configured="$(oc get application pp-core-devtools -n "${ARGO_NS}" \
                  -o jsonpath='{.spec.source.repoURL}' 2>/dev/null || true)"
  case "$configured" in
    ""|*set-by-parent-application.invalid*|https://"${host}"/*) configured="" ;;
  esac
  echo "${configured:-https://github.com/serhat-dirik/OCP-Getting-Started-Revamped}"
}

# ── self-heal: keep this terminal's clone current without a pod restart ───────────────────────
# The attendee terminal runs `ws` from a pod-local clone (~/ocp-getting-started == REPO_ROOT) that
# the showroom terminal-prep initContainer refreshes ONLY at pod start. A module published AFTER the
# pod booted is therefore invisible here — its entry state / verify script is absent and every
# resolver dies "no entry state" (SEV1, M13 G3: `ws prep m13` failed in a live cockpit while the
# module had already reached the cluster via Argo). On a miss we pull the clone up to its origin —
# the in-cluster Gitea mirror that `ws git-refresh` advances — and retry the resolution ONCE.
_ws_healed=0
heal_clone() {  # → 0 if the clone was refreshed; 1 if we must fall back to the on-disk content
  [[ "$_ws_healed" == 0 ]] || return 1                                # at most one fetch per run (retry ONCE)
  _ws_healed=1
  git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1 || return 1 # not a git clone — nothing to heal
  local origin
  origin="$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null || true)"
  # Guard to a MIRROR clone: a laptop dev tree's origin is GitHub and must never be `reset --hard`
  # out from under uncommitted work; only the cockpit clone (origin = ${MIRROR_ORG}/${MIRROR_REPO})
  # is disposable and safe to hard-reset. Also keeps `ws` on a laptop from touching the working tree.
  [[ "$origin" == *"${MIRROR_ORG}/${MIRROR_REPO}"* ]] || return 1
  info "content may be missing from this terminal's clone — refreshing from the mirror…"
  if git -C "$REPO_ROOT" fetch --depth 1 origin "$SOURCE_REVISION" >/dev/null 2>&1 \
     && git -C "$REPO_ROOT" reset --hard "origin/${SOURCE_REVISION}" >/dev/null 2>&1; then
    ok "clone refreshed to $(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo '?')"
    return 0
  fi
  # Network-tolerant: a transient mirror outage must degrade to the normal error, never hard-crash.
  err "could not refresh the clone from the mirror (transient? try: ws git-refresh) — using on-disk content"
  return 1
}

require_entry_dir() {  # module → guarantee its entry-state dir exists, self-healing once on a miss
  local module="$1"
  [[ -d "${ENTRY_DIR}/${module}" ]] && return 0
  heal_clone && [[ -d "${ENTRY_DIR}/${module}" ]] && return 0
  die "no entry state for ${module} (${ENTRY_DIR}/${module})"
}

require_verify_script() {  # module → guarantee its verify script exists, self-healing once on a miss
  local script="${VERIFY_DIR}/${1}.sh"
  [[ -x "$script" ]] && return 0
  heal_clone && [[ -x "$script" ]] && return 0
  die "no verify script for ${1} (${script})"
}

mirror_head() {  # → the SHA the Gitea mirror serves on ${SOURCE_REVISION}, or empty if unreachable
  local host origin
  # Derive the mirror host attendee-safely from the clone's own origin (attendees can't read the
  # gitea Route cross-namespace, rule 10); fall back to the Route for an operator/admin context.
  origin="$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null || true)"
  if [[ "$origin" == *"${MIRROR_ORG}/${MIRROR_REPO}"* ]]; then
    host="${origin#https://}"; host="${host%%/*}"
  else
    host="$(oc get route gitea -n "${GITEA_NS}" -o jsonpath='{.spec.host}' 2>/dev/null || true)"
  fi
  [[ -n "$host" ]] || return 1
  curl -ksf --max-time 5 "https://${host}/api/v1/repos/${MIRROR_ORG}/${MIRROR_REPO}/branches/${SOURCE_REVISION}" 2>/dev/null \
    | sed -n 's/.*"id":"\([a-f0-9]*\)".*/\1/p' | head -1
}

heal_if_behind() {  # `ws list` freshness: refresh the clone ONLY when it is behind the mirror (the
  # "miss" for a command with no module arg), so a just-published module lists without a pod restart.
  # The compare is one lightweight API GET; the git fetch runs only when actually behind.
  git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1 || return 0
  local origin want have
  origin="$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null || true)"
  [[ "$origin" == *"${MIRROR_ORG}/${MIRROR_REPO}"* ]] || return 0     # not a mirror clone → nothing to heal
  want="$(mirror_head || true)"
  [[ -n "$want" ]] || return 0                                        # mirror unreachable → list on-disk
  have="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || true)"
  [[ "$want" == "$have" ]] && return 0                                # already current → no fetch
  heal_clone || true
}

# ── modules.yaml resolution (Gen-4: module NUMBERS are decoupled from SLUGS) ───────────────────────
# modules.yaml (repo root) is the ORDERED catalog: a module's POSITION in the list is its number, and
# its `slug` is its stable identity. Everything downstream keys off the SLUG — the entry dir
# (gitops/entry-states/<slug>), the verify script (<slug>.sh), the Argo app (entry-<slug>-<user>), the
# ws-entry-<slug> marker, the workshop.redhat.com/module=<slug> label. `ws start m08` resolves position
# 8 → its slug; `ws start <slug>` takes the slug directly. Reorder the catalog = reorder modules.yaml
# (+ the nav); nothing here changes.
#
# yq v4 is the parser, with a dependency-free awk fallback: module resolution gates the ATTENDEE path
# (`ws prep`), and ws degrades gracefully everywhere else (mirror down, Argo unreachable), so a cockpit
# image that happens to ship without yq must not make module resolution the one hard stop.
_module_rows() {  # → "slug<TAB>title" per module, in catalog order (position = line number)
  [[ -f "$MODULES_YAML" ]] || return 1
  if command -v yq >/dev/null 2>&1; then
    yq -r '.modules[] | [.slug, .title] | @tsv' "$MODULES_YAML" 2>/dev/null
  else
    # Flat-list fallback: each entry is `- slug: X` then `title: "Y"` (see modules.yaml).
    awk '
      /^[[:space:]]*-[[:space:]]*slug:[[:space:]]*/ {
        if (s != "") print s "\t" t
        s=$0; sub(/^.*slug:[[:space:]]*/,"",s); gsub(/["'\''[:space:]]/,"",s); t=""; next }
      /^[[:space:]]+title:[[:space:]]*/ {
        t=$0; sub(/^[[:space:]]*title:[[:space:]]*/,"",t); sub(/[[:space:]]*$/,"",t); gsub(/^"|"$/,"",t) }
      END { if (s != "") print s "\t" t }
    ' "$MODULES_YAML"
  fi
}
_module_slugs()    { _module_rows | cut -f1; }                                 # ordered slug list
module_count()     { _module_rows | grep -c . || true; }                      # module total
slug_at_position() { _module_slugs | sed -n "${1}p"; }                         # 1-based position → slug
position_of_slug() { _module_slugs | grep -nxF "$1" | head -1 | cut -d: -f1; } # slug → position ('' if absent)
module_title()     { _module_rows | awk -F'\t' -v s="$1" '$1==s{print $2; exit}'; }

require_modules_yaml() {  # the catalog must exist to resolve any module; self-heal once on a miss
  [[ -f "$MODULES_YAML" ]] && return 0
  heal_clone && [[ -f "$MODULES_YAML" ]] && return 0
  die "modules.yaml not found (${MODULES_YAML}) — the module catalog is missing from this clone"
}

module_arg() {  # mNN (position, zero-padded) OR a slug → the canonical SLUG (the internal module key)
  local raw="${1:-}" n count slug
  [[ -n "$raw" ]] || die "module required — e.g. m08 (position) or a slug like app-security-testing; see: ws list"
  raw="$(echo "$raw" | tr '[:upper:]' '[:lower:]')"
  require_modules_yaml
  if [[ "$raw" =~ ^m0*([0-9]+)$ ]]; then
    n="${BASH_REMATCH[1]}"                                  # mNN → position number (m08 → 8, m10 → 10)
    count="$(module_count)"
    [[ "$n" -ge 1 && "$n" -le "$count" ]] || die "module number out of range: '${raw}' (valid m1–m${count}) — see: ws list"
    slug="$(slug_at_position "$n")"
    [[ -n "$slug" ]] || die "no module at position ${n} — see: ws list"
    echo "$slug"
  else
    [[ -n "$(position_of_slug "$raw")" ]] || die "unknown module '${raw}' — expected mNN (e.g. m08) or a slug (see: ws list)"
    echo "$raw"
  fi
}

# The ONE canonical attendee-identity check, applied to every --user VALUE before it can reach a
# template. `^user[0-9]+$` is not a guessed regex: bootstrap/install.sh provisions the cohort with a
# fixed `user` prefix (its USER_PREFIX constant), the authoritative workshop-attendees group carries
# exactly those names, and every namespace ({user}-dev), label and Argo app name (entry-<module>-<user>)
# is derived from them — an identity outside this shape cannot correspond to anything provisioned.
#
# Task #12 hardened the POSITIONAL userN token but left the --user FLAG VALUE unchecked, and the two
# are equivalent everywhere else. Live cost on ksls5 (2026-07-29): `--user 1` templated user=1, derived
# namespace `1-ai`, and created a permanently-OutOfSync entry-agentic-ai-1 Application whose 17
# resources target a namespace that does not exist. That is worse than an error — a rejected command
# then looks like a broken module, and it drags down the very health signal `ws doctor`/CI read (the
# same signal this repo had to invent expectOutOfSync for). A typo must look like a typo.
# ctx is the "<command> <flag>" the value came from, so the same helper reads correctly for --user
# and --exclude alike.
require_user_token() {  # value [context] → die unless the value is a canonical attendee identity
  local v="${1:-}" ctx="${2:-ws}"
  if [[ "$v" =~ ^user[0-9]+$ ]]; then return 0; fi
  if [[ -z "$v" ]]; then
    die "${ctx}: needs an attendee identity — e.g. user1 (see: ws status)"
  fi
  if [[ "$v" =~ ^[0-9]+$ ]]; then
    die "${ctx}: '${v}' is not an attendee identity — you meant 'user${v}' (attendees are user1, user2, …; see: ws status)"
  fi
  die "${ctx}: '${v}' is not an attendee identity — expected userN, e.g. user1 (see: ws status)"
}

user_arg() {  # $1 = --user value or empty → default from oc whoami (attendee self-service)
  local u="${1:-}"
  if [[ -z "$u" ]]; then
    u="$(oc whoami 2>/dev/null || true)"
    # cluster admins get no implicit identity — they must say who they provision for
    [[ "$u" == system:admin || "$u" == *"kube:admin"* || "$u" == "admin" || -z "$u" ]] && u="user1"
  fi
  echo "$u"
}

app_name() { echo "entry-${1}-${2}"; }

argo_project() {  # workshop-entries once the workshop layer exists; default before that
  if oc get appproject "${ARGO_PROJECT}" -n "${ARGO_NS}" >/dev/null 2>&1; then
    echo "${ARGO_PROJECT}"
  else
    echo "⚠ AppProject ${ARGO_PROJECT} not found — using 'default' (apply the workshop layer for proper scoping)" >&2
    echo "default"
  fi
}

render_app() {  # module user [solve]  → Application manifest on stdout
  local module="$1" user="$2" solve="${3:-false}" url domain project
  url="$(repo_url)"
  domain="$(oc get ingresses.config cluster -o jsonpath='{.spec.domain}' 2>/dev/null || echo apps.example.com)"
  project="$(argo_project)"
  cat <<EOF
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: $(app_name "$module" "$user")
  namespace: ${ARGO_NS}
  labels:
    workshop.redhat.com/module: "${module}"
    workshop.redhat.com/user: "${user}"
    # Owner stamp (non-invasive delivery): ogsr-uninstall.sh deletes entry-* apps by this label.
    workshop.redhat.com/owner: ogsr
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: ${project}
  source:
    repoURL: ${url}
    targetRevision: ${SOURCE_REVISION}
    path: gitops/entry-states/${module}
    helm:
      parameters:
        - name: user
          value: "${user}"
        - name: clusterDomain
          value: "${domain}"
        - name: solve
          value: "${solve}"
  destination:
    server: https://kubernetes.default.svc
  syncPolicy:
    # NO 'automated' block — sync is MANUAL, and every materialize triggers it explicitly.
    #
    # selfHeal was already off by design: attendee edits to chart-owned workloads ARE the lab
    # (G3-M05: selfHeal reverted the attendee's 'oc set volume' within ~1s, so the module's central
    # exercise could never complete). But selfHeal:false only governs drift at a CONSTANT revision.
    # Every one of these apps tracked the same branch, so ANY commit to ANY module bumped the
    # revision for ALL of them, and a revision bump is a normal sync, not drift — selfHeal never
    # entered into it. Result: pushing a fix to one module could revert an attendee's deliberate
    # change mid-exercise, in a different module. Confirmed three times. (Owner decision 2026-07-31.)
    #
    # Manual sync is only safe because ws triggers one itself at every point that used to rely on
    # creation auto-syncing — see sync_app_operation and its callers. If you add a new code path that
    # applies an Application, it MUST call sync_app_operation or the materialize silently does
    # nothing: the object appears, Argo reports OutOfSync, and no workload is ever created.
    syncOptions:
      - CreateNamespace=false
    retry:
      limit: 10
      backoff: {duration: 10s, factor: 2, maxDuration: 2m}
EOF
}

meta_list() {  # file top-level-key → list items (naive block-scoped YAML list read)
  # Block-scoped on purpose: ws-meta.yaml now holds MULTIPLE lists (purgeNamespaces,
  # conflictsWith) — a bare 'grep -- -' would cross-contaminate them.
  awk -v k="$2:" '
    $0 ~ "^"k {f=1; next}
    f && /^[[:space:]]*-[[:space:]]/ {s=$0; sub(/^[[:space:]]*-[[:space:]]*/,"",s); gsub(/"/,"",s); print s; next}
    f && /^[^[:space:]#]/ {f=0}
  ' "$1"
}

meta_namespaces() {  # module user → ws-meta purgeNamespaces with ${USER} resolved
  local meta="${ENTRY_DIR}/${1}/ws-meta.yaml" item
  [[ -f "$meta" ]] || return 0
  meta_list "$meta" purgeNamespaces | while read -r item; do echo "${item//\$\{USER\}/${2}}"; done
}

meta_conflicts() {  # module → ws-meta conflictsWith module list
  local meta="${ENTRY_DIR}/${1}/ws-meta.yaml"
  [[ -f "$meta" ]] || return 0
  meta_list "$meta" conflictsWith
}

meta_rbac() {  # module user → ws-meta purgeRbac entries (ns/kind/name) with ${USER} resolved
  local meta="${ENTRY_DIR}/${1}/ws-meta.yaml" item
  [[ -f "$meta" ]] || return 0
  meta_list "$meta" purgeRbac | while read -r item; do echo "${item//\$\{USER\}/${2}}"; done
}

meta_wait() {  # module → per-module sync-wait seconds (ws-meta waitSeconds); empty = engine default.
  # Modules whose hooks do real work (m07 solve runs a ~9-min pipeline) declare a longer window.
  local meta="${ENTRY_DIR}/${1}/ws-meta.yaml"
  [[ -f "$meta" ]] || return 0
  awk '$1=="waitSeconds:"{print $2; exit}' "$meta"
}

meta_expect_degraded() {  # module → "true" if the module SEEDS AN INTENTIONAL FAULT (ws-meta
  # expectDegraded) so its Argo app is Degraded/OutOfSync BY DESIGN (a broken 0/1 seed + an
  # operator-managed DevWorkspace). ws start/solve then wait for the sync OPERATION to land, not for
  # Healthy/Synced — otherwise set -e would fail every start. `ws verify` is the real correctness gate.
  local meta="${ENTRY_DIR}/${1}/ws-meta.yaml"
  [[ -f "$meta" ]] || return 0
  awk '$1=="expectDegraded:"{print $2; exit}' "$meta"
}

meta_require_sync() {  # module → "false" if the module's app is Healthy but legitimately NEVER Synced
  # (ws-meta expectOutOfSync: true — e.g. it seeds an OpenShift BuildConfig whose server-defaulted spec
  # fields Argo diffs forever, with selfHeal off → permanent OutOfSync). Then wait_healthy gates on
  # Health + a Succeeded op only, not Synced. Default "true" (normal modules must reach Synced/Healthy).
  local meta="${ENTRY_DIR}/${1}/ws-meta.yaml" v
  [[ -f "$meta" ]] || { echo "true"; return 0; }
  v="$(awk '$1=="expectOutOfSync:"{print $2; exit}' "$meta")"
  if [[ "$v" == "true" ]]; then echo "false"; else echo "true"; fi
}

meta_smoke_cmds() {  # module → ws-meta smokeCommands list (OPTIONAL, default empty). Each entry is a
  # representative attendee command a module genuinely leans on (an in-terminal `mvn …`, an `argocd app
  # delete`); `ws smoke` runs each as {user} in the live cockpit and asserts exit 0. ${USER} is resolved
  # by the caller. The generic battery already catches most of the cockpit/identity class — declare only
  # 1–3 load-bearing commands (YAGNI).
  local meta="${ENTRY_DIR}/${1}/ws-meta.yaml"
  [[ -f "$meta" ]] || return 0
  meta_list "$meta" smokeCommands
}

meta_apps() {  # module user → "namespace project" if the module declares attendee-created Argo
  # Application CRs living OUTSIDE its purge namespaces (m09+: the student-gitops control plane —
  # ADR-0002 amendment 5: GitOps 1.21 refuses per-user source namespaces on a namespace-scoped
  # instance, so attendee apps live in the instance ns, isolated by Argo RBAC + AppProjects).
  # ws-meta keys: purgeAppsNamespace + purgeAppsProject (${USER} resolves).
  local meta="${ENTRY_DIR}/${1}/ws-meta.yaml" ns proj
  [[ -f "$meta" ]] || return 0
  ns="$(awk '$1=="purgeAppsNamespace:"{print $2; exit}' "$meta")"
  proj="$(awk '$1=="purgeAppsProject:"{print $2; exit}' "$meta")"
  [[ -n "$ns" && -n "$proj" ]] || return 0
  echo "${ns} ${proj//\$\{USER\}/${2}}"
}

purge_ns() {  # ns [keep-module] — delete user workloads/leftovers; preserve system objects
  # and ONLY the keep-module's entry marker. Preserving ALL ws-entry-* markers let stale
  # markers of long-gone modules survive every reset and false-green marker checks (G4-F9).
  local ns="$1" keep="${2:-}" kind name
  oc get ns "$ns" >/dev/null 2>&1 || return 0
  info "purging user workloads in ${ns}…"
  oc delete all,pvc --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  # CRs 'oc delete all' misses: workspaces (M03+), Tekton runs (M07+), ImagePolicies (M08+) — extend
  # as modules add types. PipelineRuns cascade to their TaskRuns; deleting them also releases per-run
  # workspace PVCs. A leftover M08 ImagePolicy (block-unsigned) would otherwise block the next module's
  # image pulls in this namespace, so purge it too.
  oc delete devworkspaces.workspace.devfile.io --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  oc delete pipelineruns.tekton.dev --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  oc delete imagepolicies.config.openshift.io --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  # PodDisruptionBudgets aren't in `oc delete all`; an attendee's leftover M12 PDB survives reset and
  # then trips the next start's entry verify (found at M12 G1, 2026-07-11).
  oc delete poddisruptionbudgets.policy --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  # Same for the M12 attendee-created PrometheusRule — not in `oc delete all`, survives reset and red-
  # fails the next entry verify ("no PrometheusRule yet") (M12 G3, 2026-07-11 — sibling of the PDB gap).
  oc delete prometheusrules.monitoring.coreos.com --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  # NetworkPolicies aren't in `oc delete all` either; M15's whole lab is attendee-authored netpols
  # (default-deny + precise allows), which survive reset and red-fail the next entry verify ("no
  # default-deny yet") — the exact sibling of the PDB/PrometheusRule gaps above (found at M15 G1,
  # 2026-07-13). Any chart-owned entry netpol is re-created by re-materialize, so this is safe.
  oc delete networkpolicy --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  # Namespaced Templates aren't in `oc delete all` either; M17's catalog-governance beat adds a Template
  # to the attendee's own namespace (and `ws solve m17` renders one), which survives reset and red-fails
  # the next entry verify ("no custom Template yet") — the exact sibling of the PDB/NetworkPolicy gaps
  # above (found at M17 build, 2026-07-13). Any chart-owned entry Template is re-created by re-materialize.
  oc delete templates.template.openshift.io --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  # Istio config CRs the M18 attendee creates in a mesh namespace aren't in `oc delete all`; a leftover
  # VirtualService/DestinationRule/AuthorizationPolicy/PeerAuthentication/Gateway/EnvoyFilter survives reset
  # and red-fails the next entry verify ("no mesh config yet") — the exact sibling of the PDB/NetworkPolicy/
  # Template gaps above (M18 build, 2026-07-13). No-op on non-mesh clusters (the istio CRDs are absent).
  oc delete virtualservices.networking.istio.io,destinationrules.networking.istio.io,gateways.networking.istio.io,serviceentries.networking.istio.io,sidecars.networking.istio.io,envoyfilters.networking.istio.io --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  oc delete authorizationpolicies.security.istio.io,peerauthentications.security.istio.io,requestauthentications.security.istio.io --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  # Knative Serving/Eventing CRs the M19 attendee creates in {user}-dev aren't in `oc delete all`; a
  # leftover ksvc (Service→Configuration/Revision/Route cascade), Broker, Trigger or PingSource survives
  # reset and red-fails the next entry verify ("a ksvc already exists / eventing already wired") — the
  # exact sibling of the PDB/NetworkPolicy/Template/istio purge gaps above (M19 build, 2026-07-13). Deleting
  # the ksvc Service cascades to its Configuration/Revision/Route via owner refs. No-op on clusters without
  # Serverless installed (the serving/eventing CRDs are absent).
  oc delete services.serving.knative.dev --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  oc delete triggers.eventing.knative.dev,brokers.eventing.knative.dev,pingsources.sources.knative.dev --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  # Velero (OADP) Backup/Restore CRs the M21 lab creates in a resilience namespace aren't in `oc delete all`;
  # a leftover backup/restore/schedule.velero.io — plus the Tech-Preview NonAdmin* self-service CRs
  # (nonadmin{backups,restores,backupstoragelocations}.oadp.openshift.io) — survives reset and red-fails the
  # next entry verify ("a backup already exists"). No-op on clusters without OADP (the CRDs are absent).
  oc delete backups.velero.io,restores.velero.io,schedules.velero.io,podvolumebackups.velero.io,podvolumerestores.velero.io --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  oc delete nonadminbackups.oadp.openshift.io,nonadminrestores.oadp.openshift.io,nonadminbackupstoragelocations.oadp.openshift.io --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  # Skupper v2 (RHSI) CRs the M21 attendee creates to link sites aren't in `oc delete all`; a leftover Site/
  # Link/Listener/Connector/AccessGrant/AccessToken survives reset and red-fails the next entry verify — the
  # sibling of the istio/knative purge gaps above. No-op on clusters without RHSI (the skupper.io CRDs absent).
  oc delete sites.skupper.io,links.skupper.io,listeners.skupper.io,connectors.skupper.io,accessgrants.skupper.io,accesstokens.skupper.io --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  # MTA/Tackle namespaced CRs the M22 attendee could drop in {user}-modernize aren't in `oc delete all`.
  # MTA's portfolio state (Applications, assessments, analyses) lives in the shared Tackle Hub DB — NOT
  # as per-user k8s CRs — so today this is defensive: it purges any namespaced tackle.konveyor.io Task/
  # Addon/Extension a future lab beat might create in the user namespace, matching the istio/knative
  # idiom above. No-op on clusters without MTA installed (the tackle CRDs are absent) or on non-M22
  # namespaces (nothing of these kinds is present).
  oc delete tasks.tackle.konveyor.io,addons.tackle.konveyor.io,extensions.tackle.konveyor.io --all -n "$ns" --wait=false >/dev/null 2>&1 || true
  # And STRIP the sidecar-injection labels the M18 attendee added when enrolling. The {user}-mesh namespace
  # is workshop-layer (survives reset) and keeps its STABLE istio-discovery label, but a leftover
  # istio-injection / istio.io/rev would inject sidecars into the re-materialized "un-meshed" app and
  # red-fail the next entry verify. Harmless no-op on namespaces that never carried them.
  oc label ns "$ns" istio-injection- istio.io/rev- >/dev/null 2>&1 || true
  # Secrets/ConfigMaps the user created (e.g. template-instantiated DB creds) leak past
  # 'oc delete all' — purge them EXCEPT system objects and the current module's marker.
  for kind in secret configmap; do
    for name in $(oc get "$kind" -n "$ns" -o name 2>/dev/null); do
      case "$name" in
        */builder-dockercfg-*|*/default-dockercfg-*|*/deployer-dockercfg-*|*/builder-token-*|*/default-token-*|*/deployer-token-*|*/kube-root-ca.crt|*/openshift-service-ca.crt) ;;
        */ws-entry-${keep}) [[ -n "$keep" ]] || oc delete "$name" -n "$ns" --wait=false >/dev/null 2>&1 || true;;
        */ws-entry-*) oc delete "$name" -n "$ns" --wait=false >/dev/null 2>&1 || true;;
        *) oc delete "$name" -n "$ns" --wait=false >/dev/null 2>&1 || true;;
      esac
    done
  done
  # Dangling ServiceAccount secret links aren't in `oc delete all` either: M18's Ex4 links the sample
  # pull Secret into the default SA (`oc secrets link … --for=pull`); the loop above deletes the Secret
  # but the SA's imagePullSecrets/secrets entries survive reset and red-fail the next entry verify
  # ("sample pull Secret is NOT referenced yet") — the exact sibling of the PDB/NetworkPolicy/Template
  # purge gaps above (M18 full G3, 2026-07-19). Unlink every non-system reference: system dockercfg/
  # token links match the same preserve patterns as the purge loop, so they stay; anything else points
  # at a secret the purge just deleted and must go with it.
  local sa refname
  for sa in default builder deployer; do
    for refname in $(oc get sa "$sa" -n "$ns" -o jsonpath='{range .imagePullSecrets[*]}{.name}{"\n"}{end}{range .secrets[*]}{.name}{"\n"}{end}' 2>/dev/null | sort -u); do
      case "$refname" in
        builder-dockercfg-*|default-dockercfg-*|deployer-dockercfg-*|builder-token-*|default-token-*|deployer-token-*) ;;
        *) oc secrets unlink "$sa" "$refname" -n "$ns" >/dev/null 2>&1 || true;;
      esac
    done
  done
  # Roles/RoleBindings the attendee CREATED during a lab aren't in `oc delete all` and survive reset —
  # e.g. ai-assisted-development Ex3's mcp-agent-deployer Role+RoleBinding granting the agent SA write.
  # An RBAC-teaching module that leaves RBAC behind red-fails the next entry verify (scoped_write_absent)
  # AND leaves a stale write grant live. Delete every Role/RoleBinding that is NOT platform-owned; PRESERVE:
  #   • workshop.redhat.com/owner=ogsr → workshop-config per-user grants ({user}-admin/-monitoring-edit)
  #                                       + entry-state grants (maas-copy-*); re-created on materialize.
  #   • app.kubernetes.io/managed-by   → operator/controller-managed (student-gitops argocd-* Role+RB).
  #   • ownerReferences present        → controller-owned (Tekton InstallerSet: openshift-pipelines-edit,
  #                                       pipelines-scc-rolebinding).
  #   • system:* default names         → openshift-controller-manager defaults (system:image-pullers/
  #                                       deployers/builders — deleting these breaks cross-ns image pulls).
  # GROUNDED live (C2 user8-dev, 2026-07-19): only {user}-admin/-monitoring-edit carry owner=ogsr; the
  # system/operator grants do NOT — an owner-label-only filter would delete them, hence the broader
  # preserve-set. Field delimiter is '|' NOT tab: IFS tab is whitespace and COALESCES empty fields, which
  # would shift a managed-by/ownerRef value into the owner slot and mis-preserve. Sibling of the SA-unlink gap.
  local rbname rbowner rbmgr rbref
  for kind in role rolebinding; do
    while IFS='|' read -r rbname rbowner rbmgr rbref; do
      [[ -n "$rbname" ]] || continue
      [[ "$rbowner" == "ogsr" ]] && continue
      [[ -n "$rbmgr" ]] && continue
      [[ -n "$rbref" ]] && continue
      case "$rbname" in system:*) continue;; esac
      oc delete "$kind" "$rbname" -n "$ns" --wait=false >/dev/null 2>&1 || true
    done < <(oc get "$kind" -n "$ns" -o jsonpath='{range .items[*]}{.metadata.name}{"|"}{.metadata.labels.workshop\.redhat\.com/owner}{"|"}{.metadata.labels.app\.kubernetes\.io/managed-by}{"|"}{.metadata.ownerReferences[0].kind}{"\n"}{end}' 2>/dev/null)
  done
  ok "purge requested in ${ns}"
}

purge_meta_rbac() {  # module user — delete the RBAC a module's lab teaches attendees to CREATE
  # RoleBindings/Roles are the one leftover class purge_ns deliberately does not sweep with `--all`,
  # and the reason is not squeamishness: a workshop namespace legitimately carries nine RoleBindings
  # it must keep (system:deployers/image-builders/image-pullers, openshift-pipelines-edit,
  # pipelines-scc-rolebinding, two student-gitops ones, plus the chart-owned {user}-admin that IS the
  # attendee's own access to the namespace). Enumerated on a clean {user}-dev, 2026-07-31.
  #
  # So the usual `oc delete <kind> --all` idiom is inverted here: a keep-list FAILS OPEN — the next
  # operator that ships a namespaced RoleBinding gets purged by a list written today, and the failure
  # is silent. Modules instead DECLARE what their lab creates (ws-meta purgeRbac: ns/kind/name), which
  # FAILS CLOSED: anything undeclared is preserved, so an unknown object is never collateral.
  #
  # Found via multi-tenancy-workload-security, the first module whose lab's core exercise IS authoring
  # RBAC: its `view` binding in {user}-prod survived every reset (that namespace was not even in
  # purgeNamespaces), leaving payments-ci still able to read pods in prod on the next run — while entry
  # verify passed 10/10, because its "ungoverned" assertions only ever looked at {user}-dev.
  local module="$1" user="$2" entry ns kind name
  for entry in $(meta_rbac "$module" "$user"); do
    ns="${entry%%/*}"; kind="${entry#*/}"; name="${kind#*/}"; kind="${kind%%/*}"
    [[ -n "$ns" && -n "$kind" && -n "$name" ]] || continue
    oc get ns "$ns" >/dev/null 2>&1 || continue
    oc delete "$kind" "$name" -n "$ns" --wait=false >/dev/null 2>&1 || true
  done
}

# ── student-gitops attendee-app cleanup (SEV1-A) ──────────────────────────────────────────────────
# Attendee-created apps live in the student-gitops CONTROL PLANE, where attendees have ZERO k8s RBAC
# (only ARGO RBAC via proj-{user}, ADR-0002). So `oc delete application -n ogsr-student-gitops` as an
# attendee is Forbidden and the old `2>/dev/null` swallowed it into a silent no-op — a selfHeal
# survivor (m09/m10 claims-*) then re-deployed into the just-purged namespace and prep/reset never
# converged (SEV1-A). We instead delete through the STUDENT ARGO API as the attendee: the per-user
# local account's token maps to role:{user} → proj-{user}, so Argo RBAC bounds every delete to the
# user's OWN apps (a cross-project delete returns permission denied — the SAME boundary M10's negative
# test proves). A namespace-wide k8s `delete applications` grant would be a cross-tenant hole and is
# deliberately NOT used. Admin/instructor keep the direct k8s path (they can delete cross-namespace).
_student_argo_host() {  # → student Argo server route host, derived from the ingress domain (attendee-
  # safe: attendees cannot read the student-gitops route cross-namespace — the verify scripts' idiom).
  local domain
  domain="$(oc get ingresses.config cluster -o jsonpath='{.spec.domain}' 2>/dev/null || true)"
  [[ -n "$domain" ]] || return 1
  # Route host is PINNED to its old value (student-argocd.yaml spec.server.host), so it is decoupled
  # from ${STUDENT_ARGO_NS}: the instance name stays 'student-gitops' and the host must not change
  # under the ogsr- namespace rename. Do NOT reintroduce ${STUDENT_ARGO_NS} here — it would drift to
  # student-gitops-server-ogsr-student-gitops.<domain> and miss the actual (pinned) route.
  echo "student-gitops-server-student-gitops.${domain}"
}
_shared_password() {  # → the SHARED workshop password (non-secret). WS_WORKSHOP_PASSWORD overrides
  # for CI; otherwise the gitea workshop-user-creds secret (workshop-config grants attendees a
  # resourceName-scoped read on JUST that secret — attendee-argo-password-read.yaml).
  if [[ -n "${WS_WORKSHOP_PASSWORD:-}" ]]; then printf '%s' "$WS_WORKSHOP_PASSWORD"; return 0; fi
  oc get secret workshop-user-creds -n "${GITEA_NS}" -o jsonpath='{.data.password}' 2>/dev/null | base64 -d
}
_json_escape() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '%s' "$s"; }
_argo_token() {  # user → a student-Argo session JWT for the per-user local account, or empty on failure
  local user="$1" host pw
  host="$(_student_argo_host)" || return 1
  pw="$(_shared_password)"; [[ -n "$pw" ]] || return 1
  curl -ksf --max-time 15 -X POST "https://${host}/api/v1/session" \
    -H 'Content-Type: application/json' \
    -d "{\"username\":\"$(_json_escape "$user")\",\"password\":\"$(_json_escape "$pw")\"}" 2>/dev/null \
    | sed -n 's/.*"token":"\([^"]*\)".*/\1/p' | head -1
}
_argo_list() {  # host token kind proj → "name<TAB>module-label" per item in proj (Argo RBAC also filters)
  curl -ksf --max-time 15 "https://${1}/api/v1/${3}" -H "Authorization: Bearer ${2}" 2>/dev/null \
    | WS_PROJ="$4" python3 -c '
import json, os, sys
proj = os.environ["WS_PROJ"]
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for it in (d.get("items") or []):
    spec = it.get("spec", {}) or {}
    p = spec.get("project") or ((spec.get("template", {}) or {}).get("spec", {}) or {}).get("project")
    if p != proj:
        continue
    md = it.get("metadata", {}) or {}
    lbl = (md.get("labels") or {}).get("workshop.redhat.com/module", "")
    print((md.get("name") or "") + "\t" + lbl)
' 2>/dev/null
}
argo_purge_apps() {  # user proj [keep] — delete the user's OWN proj apps/appsets via the student Argo
  # API. appsets FIRST (they regenerate deleted apps — M10 G1 flag #2). keep = a module label to
  # preserve (the TARGET's own chart apps on a bare re-start). Best-effort + non-fatal: a token or
  # reachability failure warns and returns (the k8s entry-app deletion still runs). Isolation is
  # enforced by Argo — this token cannot see, let alone delete, another user's apps.
  local user="$1" proj="$2" keep="${3:-}" host token name mod t=0
  host="$(_student_argo_host)" || { info "student Argo host unknown — skipping attendee-app cleanup (${proj})"; return 0; }
  curl -ksf --max-time 5 "https://${host}/healthz" >/dev/null 2>&1 \
    || { info "student Argo unreachable — skipping attendee-app cleanup (${proj})"; return 0; }
  token="$(_argo_token "$user")"
  [[ -n "$token" ]] || { err "could not authenticate ${user} to student Argo — attendee apps in ${proj} NOT cleaned"; \
    echo "   fix: workshop-config must grant attendees read on ogsr-gitea/workshop-user-creds, or set WS_WORKSHOP_PASSWORD"; return 0; }
  while IFS=$'\t' read -r name mod; do
    [[ -n "$name" ]] || continue
    [[ -n "$keep" && "$mod" == "$keep" ]] && continue
    info "deleting attendee ApplicationSet ${name} (project ${proj}) via student Argo…"
    # Content-Type is REQUIRED even on a body-less DELETE — the Argo gRPC-gateway 415s without it
    # (the delete then silently no-ops and the survivor lives on — the exact SEV1-A failure mode).
    curl -ksf --max-time 30 -X DELETE "https://${host}/api/v1/applicationsets/${name}" \
      -H "Authorization: Bearer ${token}" -H 'Content-Type: application/json' >/dev/null 2>&1 || true
  done < <(_argo_list "$host" "$token" applicationsets "$proj")
  while IFS=$'\t' read -r name mod; do
    [[ -n "$name" ]] || continue
    [[ -n "$keep" && "$mod" == "$keep" ]] && continue
    info "deleting attendee Argo app ${name} (project ${proj}) via student Argo…"
    curl -ksf --max-time 30 -X DELETE "https://${host}/api/v1/applications/${name}?cascade=true" \
      -H "Authorization: Bearer ${token}" -H 'Content-Type: application/json' >/dev/null 2>&1 || true
  done < <(_argo_list "$host" "$token" applications "$proj")
  # Wait until the user's apps clear (cascade prune honors the resources-finalizer) so the caller's
  # namespace purge does not race a still-selfHealing app. Bounded + non-fatal: issuing the DELETE
  # already stops selfHeal; the wait just lets the finalizer prune claims before purge_ns runs.
  while (( t < 90 )); do
    [[ -n "$(_argo_list "$host" "$token" applications "$proj")" ]] || break
    sleep 5; t=$((t+5))
  done
}

purge_apps() {  # module user [keep-module] — delete the user's Application/ApplicationSet CRs for this
  # module's control plane (ws-meta purgeApps*). These live OUTSIDE the module's purge namespaces, so
  # purge_ns never sees them; selected by .spec.project (proj-{user}). keep-module (M10 G1 engine flag
  # #1): a module's OWN chart apps carry workshop.redhat.com/module=<module> and share proj-{user} with
  # a conflicting module's — on a bare re-start gc must not purge the TARGET's own world. Admin/
  # instructor delete via k8s directly; attendees (no k8s RBAC here) delete via the student Argo API,
  # bounded to proj-{user} by Argo RBAC (SEV1-A — see argo_purge_apps).
  local module="$1" user="$2" keep="${3:-}" pair ns proj name mod
  pair="$(meta_apps "$module" "$user")"
  [[ -n "$pair" ]] || return 0
  ns="${pair%% *}"; proj="${pair##* }"
  if ! oc auth can-i delete applications.argoproj.io -n "$ns" >/dev/null 2>&1; then
    # Attendee: no k8s delete in the control plane → go through Argo (proj-scoped, isolation-safe).
    argo_purge_apps "$user" "$proj" "$keep"
    return 0
  fi
  # Privileged (admin/instructor) k8s path. ApplicationSets FIRST: an attendee's appset (M10 beat 1)
  # re-generates any Application we delete, so purging apps before their generator is self-defeating.
  for name in $(oc get applicationsets.argoproj.io -n "$ns" \
      -o jsonpath="{range .items[?(@.spec.template.spec.project==\"${proj}\")]}{.metadata.name}{\"\n\"}{end}" 2>/dev/null); do
    if [[ -n "$keep" ]]; then
      mod="$(oc get applicationset "$name" -n "$ns" -o jsonpath='{.metadata.labels.workshop\.redhat\.com/module}' 2>/dev/null || true)"
      [[ "$mod" == "$keep" ]] && continue
    fi
    info "deleting attendee ApplicationSet ${ns}/${name} (project ${proj})…"
    oc delete applicationset "$name" -n "$ns" --wait=true --timeout=120s >/dev/null 2>&1 || true
  done
  for name in $(oc get applications.argoproj.io -n "$ns" \
      -o jsonpath="{range .items[?(@.spec.project==\"${proj}\")]}{.metadata.name}{\"\n\"}{end}" 2>/dev/null); do
    if [[ -n "$keep" ]]; then
      mod="$(oc get application "$name" -n "$ns" -o jsonpath='{.metadata.labels.workshop\.redhat\.com/module}' 2>/dev/null || true)"
      [[ "$mod" == "$keep" ]] && continue
    fi
    info "deleting attendee Argo app ${ns}/${name} (project ${proj})…"
    oc delete application "$name" -n "$ns" --wait=true --timeout=120s >/dev/null 2>&1 \
      || oc patch application "$name" -n "$ns" --type merge -p '{"metadata":{"finalizers":null}}' >/dev/null 2>&1 || true
  done
}

gc_conflicts() {  # user module — evict conflicting modules' entry apps before materializing
  # Module independence (rule 2): entry charts that materialize the SAME named workloads
  # (declared in ws-meta conflictsWith) deadlock when their Argo apps coexist — both go
  # OutOfSync on SharedResourceWarning and the attendee gets a silently wrong world while
  # the marker check stays green (G3-M04, m03+m04 on user3). Starting a module therefore
  # evicts the conflicting app and purges this module's namespaces (= reset semantics).
  # Disjoint modules (platform-orientation's parasol-web, jobs-batch-kueue's {user}-batch) still coexist untouched.
  local user="$1" module="$2" evicted=0 c app ns
  for c in $(meta_conflicts "$module"); do
    app="$(app_name "$c" "$user")"
    if oc get application "$app" -n "$ARGO_NS" >/dev/null 2>&1; then
      info "evicting conflicting entry app ${app} (shares workloads with ${module})…"
      oc delete application "$app" -n "$ARGO_NS" --wait=true --timeout=180s || true
      evicted=1
    else
      # The conflicting module's app may be long gone while its ORPHANED leftovers still
      # squat in our namespaces (bare 'oc delete application' skips the purge — G4-F3:
      # start over such leftovers produced a wrong entry state behind partly-green checks).
      # A surviving marker is the tell — trigger the purge path even with no app to evict.
      for ns in $(meta_namespaces "$module" "$user"); do
        if oc get cm "ws-entry-${c}" -n "$ns" >/dev/null 2>&1; then
          info "found orphaned ${c} leftovers in ${ns} (marker, no app) — reclaiming…"
          evicted=1; break
        fi
      done
    fi
    # The conflicting module's attendee-created Argo apps (ws-meta purgeApps*) live in a
    # control-plane ns and would keep selfHeal-ing its world back — purge them regardless
    # of whether the entry app itself was still present. Keep the TARGET module's own
    # chart-labeled apps: on a bare re-start nothing recycles the entry app, so purging
    # its world would wipe it permanently (M10 G1 flag #1).
    purge_apps "$c" "$user" "$module"
  done
  if [[ "$evicted" == 1 ]]; then
    for ns in $(meta_namespaces "$module" "$user"); do purge_ns "$ns" "$module"; done
    purge_meta_rbac "$module" "$user"
    # The purge also removed THIS module's chart-owned resources if its app pre-existed.
    # With selfHeal off, re-applying an UNCHANGED app never re-syncs them — recycle the
    # app so the fresh apply is a creation, which always auto-syncs.
    app="$(app_name "$module" "$user")"
    oc delete application "$app" -n "$ARGO_NS" --wait=true --timeout=180s >/dev/null 2>&1 || true
  fi
}

wait_healthy() {  # appname [timeout_s] [require_sync]
  # require_sync (default true): also require the app to read Synced. Pass "false" for a module whose app
  # is genuinely Healthy but never reaches Synced — an entry state that seeds an OpenShift BuildConfig
  # drifts forever because the build API defaults spec fields (runPolicy, {successful,failed}Builds-
  # HistoryLimit, postCommit, nodeSelector:null) that Argo diffs, and selfHeal is off (m25, ws-meta
  # expectOutOfSync). Health + a Succeeded op still gate readiness, so a genuine failure is still caught;
  # `ws verify` is the correctness gate regardless.
  local app="$1" timeout="${2:-300}" require_sync="${3:-true}" t=0 health sync phase empty_ok=0 sync_ok
  info "waiting for ${app} to sync (up to ${timeout}s)…"
  while (( t < timeout )); do
    health="$(oc get application "$app" -n "$ARGO_NS" -o jsonpath='{.status.health.status}' 2>/dev/null || true)"
    sync="$(oc get application "$app" -n "$ARGO_NS" -o jsonpath='{.status.sync.status}' 2>/dev/null || true)"
    # Hooks keep the sync OPERATION Running after the app already reads Synced/Healthy — and a
    # solve hook that does real work (m07: runs the whole pipeline) is exactly the point. Ready
    # means the operation finished too, or "demo-ready" prints while the namespace is still empty.
    phase="$(oc get application "$app" -n "$ARGO_NS" -o jsonpath='{.status.operationState.phase}' 2>/dev/null || true)"
    sync_ok="true"; [[ "$require_sync" == "true" && "$sync" != "Synced" ]] && sync_ok="false"
    if [[ "$health" == "Healthy" && "$sync_ok" == "true" ]]; then
      if [[ "$phase" == "Succeeded" ]]; then
        ok "entry state ready (${sync}/Healthy)"
        return 0
      fi
      # Empty phase can be a transient window BETWEEN hook retries (M10 G1 flag #3: a failing
      # PostSync hook briefly reads Synced/Healthy/no-op) — accept it only after it HOLDS.
      if [[ -z "$phase" ]]; then
        empty_ok=$((empty_ok+1))
        if (( empty_ok >= 3 )); then
          ok "entry state ready (${sync}/Healthy)"
          return 0
        fi
      else
        empty_ok=0
      fi
    else
      empty_ok=0
    fi
    sleep 5; t=$((t+5))
  done
  err "entry state not ready after ${timeout}s (health=${health:-?} sync=${sync:-?} op=${phase:-?})"
  echo "   inspect: oc describe application ${app} -n ${ARGO_NS}"
  return 1
}

wait_materialized() {  # app [timeout] — for expectDegraded modules whose Argo app is Degraded/OutOfSync
  # by design (intentional-fault seed + operator-managed DevWorkspace): wait for the sync OPERATION to
  # reach a terminal phase (manifests landed + hooks ran), then return. NEVER fails ws start — the app is
  # unhealthy on PURPOSE; `ws verify` confirms the world is actually up.
  local app="$1" timeout="${2:-180}" t=0 phase
  info "materializing ${app} (Degraded-by-design; up to ${timeout}s)…"
  while (( t < timeout )); do
    phase="$(oc get application "$app" -n "$ARGO_NS" -o jsonpath='{.status.operationState.phase}' 2>/dev/null || true)"
    if [[ "$phase" == "Succeeded" || "$phase" == "Failed" || "$phase" == "Error" ]]; then
      ok "entry state materialized (sync ${phase}; app stays Degraded by design — confirm: ws verify)"
      return 0
    fi
    sleep 5; t=$((t+5))
  done
  info "still settling after ${timeout}s (op=${phase:-none}) — app is Degraded by design; confirm with ws verify"
  return 0
}

cmd_list() {
  heal_if_behind   # a just-published module should list here without a pod restart (mirror-clone only)
  require_modules_yaml
  echo "Modules (number = catalog position; entry state keyed by slug):"
  local i=0 slug title
  while IFS=$'\t' read -r slug title; do
    [[ -n "$slug" ]] || continue
    i=$((i+1))
    if [[ -d "${ENTRY_DIR}/${slug}" ]]; then
      printf "  %2d  %-34s %s\n" "$i" "$slug" "${title:-—}"
    else
      printf "  %2d  %-34s %s  (no entry state yet)\n" "$i" "$slug" "${title:-—}"
    fi
  done < <(_module_rows)
  [[ "$i" -gt 0 ]] || echo "  (catalog is empty — check ${MODULES_YAML})"
  echo
  echo "  Use:  ws start <number|slug>   e.g.  ws start m08   or   ws start app-security-testing"
}

cmd_start() {
  local module user="$1" ; module="$2"
  need_oc
  require_entry_dir "$module"
  # --all-users: instructor convenience — bulk-provision every attendee's entry state at once.
  #
  # This used to claim "attendees lack Application-create rights on the platform Argo instance by
  # design, ADR-0002". That is FALSE and was false when written: attendees hold unscoped `create`
  # on applications (per-user-argo-rbac.yaml), which they need, because `ws prep` -> cmd_reset ->
  # `render_app | oc apply` is a CREATE whenever the app is absent. ADR-0002's admin-only-writes
  # line was superseded by the 2026-07-10 attendee-self-service directive and never amended.
  if [[ "$user" == "--all-users" || "$user" == "all" ]]; then
    local n
    n="$(oc get group workshop-attendees -o jsonpath='{.users[*]}' 2>/dev/null | wc -w | xargs)"
    [[ "$n" -gt 0 ]] || die "cannot enumerate workshop-attendees group"
    info "materializing ${module} for all ${n} attendees…"
    local bulk_apps=()
    for u in $(oc get group workshop-attendees -o jsonpath='{.users[*]}'); do
      gc_conflicts "$u" "$module"
      render_app "$module" "$u" | oc apply -f - >/dev/null
      bulk_apps+=("$(app_name "$module" "$u")")
      echo "  ✓ ${u}"
    done
    # Sync is MANUAL (see render_app), so this path can no longer rely on creation auto-syncing —
    # without an explicit operation every one of these apps would sit OutOfSync with no workloads,
    # and the only symptom would be a "successful" command that materialized nothing.
    #
    # Batched deliberately rather than calling sync_app_operation per user: that helper sleeps 10s
    # between refresh and operation, which for eight attendees would be ~80s of dead time. Refresh
    # them all, pay the settle once, then start every operation.
    info "starting sync operations for ${n} entry apps…"
    for a in "${bulk_apps[@]}"; do
      oc annotate application "$a" -n "$ARGO_NS" argocd.argoproj.io/refresh=hard --overwrite >/dev/null 2>&1 || true
    done
    sleep 10
    local started=0
    # if/then, NOT `patch && started=… || warn`: that shape is SC2015, and inside a function under
    # `set -e` an && chain whose left side fails takes the whole script down with it.
    for a in "${bulk_apps[@]}"; do
      if oc patch application "$a" -n "$ARGO_NS" --type merge \
           -p '{"operation":{"initiatedBy":{"username":"ws"},"sync":{"revision":"'"${SOURCE_REVISION}"'","prune":true}}}' >/dev/null 2>&1; then
        started=$((started+1))
      else
        warn "could not start a sync on ${a} — retry with: ws start ${module} --user ${a##*-}"
      fi
    done
    ok "entry apps applied and ${started}/${n} sync operations started (watch: oc get applications -n ${ARGO_NS})"
    return 0
  fi
  gc_conflicts "$user" "$module"
  info "materializing ${module} entry state for ${user}…"
  render_app "$module" "$user" | oc apply -f -
  # Spec changes on an EXISTING app (e.g. solve->start) can serve Argo's cached manifests;
  # force a re-render + real operation (M11 G1: solve materialized only after refresh+sync).
  sync_app_operation "$(app_name "$module" "$user")"
  if [[ "$(meta_expect_degraded "$module")" == "true" ]]; then
    wait_materialized "$(app_name "$module" "$user")" "$(meta_wait "$module")"
  else
    wait_healthy "$(app_name "$module" "$user")" "$(meta_wait "$module")" "$(meta_require_sync "$module")"
  fi
  echo
  ok "${user} can start ${module}."
}

cmd_prep() {  # ATTENDEE self-service (project directive 2026-07-10): attendees forget to wipe the
  # previous module before starting the next, and prep must never depend on an instructor.
  # Detect what's in the user's world, say it plainly, ask consent, then run the proven
  # purge-first reset path. Requires the per-user Argo RBAC from the workshop layer
  # (gitops/workshop-config/templates/per-user-argo-rbac.yaml).
  local module user="$1"; module="$2"; shift 2 || true
  local yes="false"
  [[ "${1:-}" == "--yes" || "${1:-}" == "-y" ]] && yes="true"
  need_oc
  require_entry_dir "$module"
  local app; app="$(app_name "$module" "$user")"

  info "checking your ${module} environment (${user})…"
  local findings=() ns c capp
  # 1. Leftovers from OTHER modules in the namespaces this module owns/purges.
  for ns in $(meta_namespaces "$module" "$user"); do
    oc get ns "$ns" >/dev/null 2>&1 || continue
    local foreign
    foreign="$(oc get cm -n "$ns" -o name 2>/dev/null | sed -n 's|configmap/ws-entry-||p' | grep -v "^${module}\$" || true)"
    [[ -n "$foreign" ]] && findings+=("${ns} still holds state from module(s): $(echo "$foreign" | tr '\n' ' ')")
    local workloads
    workloads="$(oc get deploy,statefulsets,jobs,cronjobs -n "$ns" --no-headers 2>/dev/null | wc -l | tr -d ' ')"
    [[ "$workloads" -gt 0 && -z "$(oc get cm "ws-entry-${module}" -n "$ns" -o name 2>/dev/null)" ]] \
      && findings+=("${ns} has ${workloads} workload(s) but no ${module} marker")
  done
  # 2. Conflicting modules' entry apps still live (would deadlock this module's world).
  for c in $(meta_conflicts "$module"); do
    capp="$(app_name "$c" "$user")"
    oc get application "$capp" -n "$ARGO_NS" >/dev/null 2>&1 && findings+=("conflicting module ${c} is still provisioned (${capp})")
  done
  # 3. The module's own state: app + marker + entry verify.
  local have_app="false"
  oc get application "$app" -n "$ARGO_NS" >/dev/null 2>&1 && have_app="true"
  if [[ "$have_app" == "true" && ${#findings[@]} -eq 0 ]]; then
    local script="${VERIFY_DIR}/${module}.sh"
    if [[ -x "$script" ]] && "$script" --user "$user" --entry-only >/dev/null 2>&1; then
      ok "your ${module} environment is already prepared — nothing to do."
      echo "   (want a factory-fresh copy anyway? re-run with: ws prep ${module} --yes)"
      [[ "$yes" != "true" ]] && return 0
      findings+=("re-prep requested with --yes")
    else
      findings+=("${module} is provisioned but its entry checks are not passing")
    fi
  fi
  [[ "$have_app" == "false" ]] && findings+=("${module} is not provisioned for ${user} yet")

  echo
  echo "Found:"
  local f; for f in "${findings[@]}"; do echo "  • $f"; done
  echo
  echo "Preparing ${module} will WIPE the leftovers above (your namespaces are purged and"
  echo "re-materialized; anything you built in them is deleted) and set up a clean ${module} world."
  if [[ "$yes" != "true" ]]; then
    if [[ -t 0 ]]; then
      local reply
      read -r -p "Wipe and prepare ${module} now? [y/N] " reply
      [[ "$reply" =~ ^[Yy]([Ee][Ss])?$ ]] || { info "nothing changed. Re-run when ready (or use --yes)."; return 0; }
    else
      die "not a terminal and no --yes given — re-run: ws prep ${module} --yes"
    fi
  fi

  cmd_reset "$user" "$module"
  echo
  local script="${VERIFY_DIR}/${module}.sh"
  if [[ -x "$script" ]]; then
    if "$script" --user "$user" --entry-only; then
      ok "${module} is ready — start the lab."
    else
      info "setup hooks may still be settling (seeding data takes up to ~1 min) — re-check with: ws verify ${module}"
    fi
  fi
}

cmd_verify() {
  local module user="$1"; module="$2"; shift 2 || true
  need_oc
  require_verify_script "$module"
  local script="${VERIFY_DIR}/${module}.sh"
  "$script" --user "$user" "$@"
}

# ── ws smoke — the G1 attendee-cockpit gate ───────────────────────────────────────────────────────
# Runs the attendee path FROM the real cockpit terminal as {user} (never the admin kubeconfig), to
# catch the recurring cockpit/identity defect class (ws-not-on-PATH, HOME=/data, JVM user.home,
# isolation leaks, stale-pod, prep/verify RBAC) at the CHEAPEST gate. See docs/plans/2026-07-12-
# cockpit-smoke-gate-design.md.
smoke_pod() {  # user ns → newest Running showroom terminal pod name (bare, no pod/ prefix), or empty
  local p
  p="$(oc get pods -n "$2" -l "app.kubernetes.io/name=showroom,workshop.redhat.com/user=${1}" \
        --field-selector=status.phase=Running --sort-by=.metadata.creationTimestamp -o name 2>/dev/null | tail -1)"
  echo "${p#pod/}"
}
# pod_i: run a command EXACTLY as the attendee does — an INTERACTIVE ttyd shell that sources ~/.bashrc,
# so `ws` is on PATH and the oc identity is {user}. A bare (non-interactive) exec would MISS the PATH
# export (skel .bashrc early-returns for non-interactive shells) — that is a test artifact, not the
# attendee's reality; the whole point of the gate is to test the interactive path. The greeting/MOTD
# .bashrc prints lands on stdout but never enters a command's pipeline, and `check` discards stdout.
pod_i() { oc exec "$SMOKE_POD" -n "$SMOKE_NS" -c "$SMOKE_CONTAINER" -- bash -ic "$1"; }
# pod_x: bare (non-interactive) exec — no ~/.bashrc, no greeting; for CLEAN captures (e.g. clone HEAD).
pod_x() { oc exec "$SMOKE_POD" -n "$SMOKE_NS" -c "$SMOKE_CONTAINER" -- bash -c "$1"; }

# SC2016 is disabled for this whole function ON PURPOSE: the single-quoted $HOME/$uh/$(…) inside the
# pod_i/pod_x command strings must stay UNEXPANDED host-side and evaluate in the attendee's pod shell.
# shellcheck disable=SC2016
cmd_smoke() {
  local module user="$1"; module="$2"; shift 2 || true
  # Accept a positional userN (ws smoke m09 user1) in addition to --user, resolved like other verbs.
  local a
  for a in "$@"; do [[ "$a" =~ ^user[0-9]+$ ]] && user="$a"; done
  need_oc
  # Reuse the verify scripts' ✅/❌ + hint idiom verbatim (check/hint/VERIFY_PASS/VERIFY_FAIL).
  # shellcheck disable=SC1091  # _lib.sh is linted standalone; its path is runtime-derived
  source "${VERIFY_DIR}/_lib.sh"

  SMOKE_NS="$SHOWROOM_NS"
  SMOKE_POD="$(smoke_pod "$user" "$SMOKE_NS")"
  [[ -n "$SMOKE_POD" ]] || die "no Running showroom cockpit for ${user} in ns ${SMOKE_NS} — provision the session first (oc get pods -n ${SMOKE_NS} -l workshop.redhat.com/user=${user})"
  info "smoke ${module} from ${user}'s cockpit (pod ${SMOKE_POD}) — running the attendee path as ${user}…"
  echo

  # ── identity & environment (the cockpit-identity class) ─────────────────────────────────────────
  check "ws is on the attendee's interactive PATH (as typed in ttyd)" pod_i 'command -v ws' \
    || hint "ws missing from the interactive PATH — check the WS_WORKSHOP_PROFILE block in ~/.bashrc (showroom terminal-prep)"
  check "\$HOME is /home/lab-user (persistent PVC, not /data)" pod_i '[[ "$HOME" == /home/lab-user ]]' \
    || hint "terminal HOME wrong — the showroom terminal container needs env HOME=/home/lab-user"
  check "JVM user.home == \$HOME (Maven/.m2 not stranded on /data)" pod_i 'uh=$(java -XshowSettings:properties 2>&1 | sed -n "s/^.*user\.home = //p" | tr -d "[:space:]"); [[ -n "$uh" && "$uh" == "$HOME" ]]' \
    || hint "passwd home != \$HOME — the terminal postStart must rewrite /etc/passwd home to /home/lab-user (the JVM reads user.home from passwd, not \$HOME)"
  check "shell identity is ${user} (not the showroom ServiceAccount)" pod_i "[[ \"\$(oc whoami 2>/dev/null)\" == \"${user}\" ]]" \
    || hint "terminal is not logged in as ${user} — terminal-prep's oc login failed; inspect the showroom pod"
  check "attendee is NOT cluster-admin (no privileged context reachable)" pod_i '! oc auth can-i "*" "*" --all-namespaces --quiet 2>/dev/null' \
    || hint "attendee has cluster-admin rights — a privileged-context leak; the cockpit must run as the unprivileged {user}"

  # ── isolation (attendee sees ONLY their own world) ──────────────────────────────────────────────
  check "peer projects invisible (own namespaces only)" pod_i "oc get projects -o name 2>/dev/null | sed 's#.*/##' | grep -E '^user[0-9]+-' | grep -vq '^${user}-' && exit 1 ; exit 0" \
    || hint "attendee can see another user's namespaces — a per-user RBAC leak (workshop-config per-user rolebindings)"
  check "system 'openshift' project invisible to the attendee" pod_i '! oc get project openshift >/dev/null 2>&1' \
    || hint "attendee can read the openshift project — namespace isolation leak"
  check "cluster-scope 'oc get namespaces' is Forbidden" pod_i '! oc get namespaces >/dev/null 2>&1' \
    || hint "attendee can list all namespaces cluster-wide — a cluster-scope RBAC leak"

  # ── freshness (the stale-pod class: a cockpit serving content behind the mirror) ────────────────
  local want have
  want="$(mirror_head || true)"
  have="$(pod_x 'git -C "$HOME/ocp-getting-started" rev-parse HEAD 2>/dev/null' 2>/dev/null | tr -d '[:space:]' || true)"
  if [[ -z "$want" ]]; then
    info "mirror HEAD unreadable (gitea down?) — skipping the freshness check"
  else
    check "cockpit clone HEAD matches the mirror (${want:0:8})" test "$have" = "$want" \
      || hint "pod serves ${have:0:8}, mirror ${want:0:8} — a stale cockpit: ws git-refresh --restart-terminals --user ${user}"
  fi

  # ── lifecycle FROM the cockpit (the attendee's real prep/verify entrypoints) ────────────────────
  # --yes is REQUIRED here, not optional: the smoke drives prep through `oc exec` with NO TTY, so prep's
  # destructive-wipe consent (`[[ -t 0 ]]` → prompt, else → die) can never be answered interactively —
  # without --yes any module that must evict a resident conflict/leftover dies "not a terminal and no
  # --yes given" and the gate false-fails (found live: packaging-distributing after ai-assisted-development,
  # 2026-07-16). --yes is the
  # automation-equivalent of the attendee typing "y", AND it forces a real wipe+re-materialize every run
  # instead of prep's "already prepared — nothing to do" fast path — so this check actually exercises
  # materialization (create app → sync → converge) as {user}, not just a pre-existing healthy state.
  check "ws prep ${module} --yes converges from the cockpit (attendee self-service)" pod_i "ws prep ${module} --yes" \
    || hint "attendee 'ws prep ${module} --yes' did not converge — materialize it first: ws prep ${module} --user ${user} --yes, then re-smoke"
  # --entry-only on purpose: the smoke targets a freshly-materialized ENTRY state; a completed lab's
  # END checks legitimately go red on an entry state (verify scripts are mode-split, template rule 14).
  check "ws verify ${module} --entry-only passes N/N in the cockpit" pod_i "ws verify ${module} --entry-only" \
    || hint "entry checks are red in the cockpit — inspect: ws verify ${module} --user ${user}"

  # ── per-module hook: representative click-to-run blocks (ws-meta smokeCommands, optional) ────────
  local sc had_sc=0
  while IFS= read -r sc; do
    [[ -n "$sc" ]] || continue
    had_sc=1
    sc="${sc//\$\{USER\}/${user}}"
    check "smokeCommand: ${sc}" pod_i "$sc" \
      || hint "a representative attendee command failed in the cockpit — run it in ${user}'s terminal to debug"
  done < <(meta_smoke_cmds "$module")
  [[ "$had_sc" == 1 ]] || info "(no ws-meta smokeCommands for ${module} — generic battery only)"

  # ── summary (N/N, non-zero exit on any failure so the gate can fail CI/agent briefs) ────────────
  echo
  local total=$((VERIFY_PASS + VERIFY_FAIL))
  if (( VERIFY_FAIL == 0 )); then
    ok "smoke ${module} @ ${user}: ${VERIFY_PASS}/${total} attendee-cockpit checks passed"
  else
    err "smoke ${module} @ ${user}: ${VERIFY_FAIL} of ${total} attendee-cockpit checks FAILED — do not pass G1 until green"
    exit 1
  fi
}

cmd_reset() {
  local module user="$1"; module="$2"
  need_oc
  local app; app="$(app_name "$module" "$user")"
  info "resetting ${module} for ${user} (purge + delete + re-materialize)…"

  # Purge FIRST — this ordering is load-bearing (G3-M06 SEV1). Attendee-created workloads (Jobs/
  # pods the entry app does NOT own) can pin a chart-owned PVC through kubernetes.io/pvc-protection.
  # If we delete the Application first, its resources-finalizer blocks indefinitely trying to prune
  # that PVC while the pods holding it are never removed (they aren't app-owned), and the purge that
  # WOULD remove them never runs. Purging first deletes those pods (Completed pods drain in ~1s),
  # releases the PVC, and empties the namespace; with selfHeal:false the still-present app never
  # re-creates what we delete (it only marks OutOfSync). This also hardens m05's StatefulSet reset,
  # where volumeClaimTemplate PVCs are pinned the same way.
  # Attendee-created Argo apps FIRST (ws-meta purgeApps*): they live outside the purge namespaces,
  # and a selfHeal app re-deploys its workloads DURING the namespace purge and orphans them if the
  # purge runs first (reproduced live, M09 G1 — gc_conflicts always had this order; reset now matches).
  purge_apps "$module" "$user"
  local ns
  for ns in $(meta_namespaces "$module" "$user"); do purge_ns "$ns" "$module"; done
  purge_meta_rbac "$module" "$user"

  # Now remove the GitOps wrapper. With the namespace already emptied the finalizer has little or
  # nothing left to prune and completes fast; if it still lingers, strip the finalizer rather than
  # fail the reset — the manual purge already did the pruning the finalizer exists to do.
  if oc get application "$app" -n "$ARGO_NS" >/dev/null 2>&1; then
    if ! oc delete application "$app" -n "$ARGO_NS" --wait=true --timeout=120s; then
      info "finalizer still settling — namespace already purged, removing it…"
      oc patch application "$app" -n "$ARGO_NS" --type=json \
        -p '[{"op":"remove","path":"/metadata/finalizers"}]' >/dev/null 2>&1 || true
      local t=0
      while oc get application "$app" -n "$ARGO_NS" >/dev/null 2>&1; do
        (( t >= 60 )) && die "entry app ${app} stuck deleting — inspect: oc get application ${app} -n ${ARGO_NS} -o yaml (finalizers)"
        sleep 3; t=$((t+3))
      done
    fi
    ok "chart-owned state pruned"
  else
    info "no existing entry app — clean start"
  fi
  cmd_start "$user" "$module"
}

cmd_solve() {  # instructor: materialize the module END state (entry chart with solve=true)
  local module user="$1"; module="$2"
  need_oc
  require_entry_dir "$module"
  grep -q '^solve:' "${ENTRY_DIR}/${module}/values.yaml" 2>/dev/null \
    || die "${module}'s chart defines no solve state (values.yaml lacks 'solve:')"
  gc_conflicts "$user" "$module"

  # ENTRY FIRST, then solve. Found 2026-07-31 by running `ws solve serverless-zero-to-hero` against a
  # namespace that had never been started: it produced a ksvc stuck Ready=False / RevisionMissing and
  # still printed "demo-ready".
  #
  # The cause is specific to charts whose solve MORPHS an object rather than adding one. serverless's
  # ksvc names its revision `parasol-claims-v1` at entry and `parasol-claims-v2` under solve, and its
  # solve traffic block splits 80/20 across BOTH names. Knative mints a revision when the template
  # changes, so applying solve to an empty namespace creates v2 and only v2 — v1 never existed, the
  # traffic reference dangles, and the Route never becomes ready. Applying entry first mints v1;
  # revisions are immutable and persist, so the subsequent solve mints v2 alongside it and the split
  # resolves. Verified both ways on a live cluster: solve-alone gives
  # `RevisionMissing: Revision "parasol-claims-v1" referenced in traffic not found`, while
  # start-then-solve gives Ready=True with both revisions present.
  #
  # This is the same principle as the build-deliver fix (d72d3d5): solve must represent the FINISHED
  # lab, and the finished serverless lab has two revisions because the attendee made one and then the
  # other. A solve that skips the intermediate state is not the end state, it is a different state.
  # Additive charts are unaffected — for them the entry apply is what solve would have produced anyway.
  info "materializing ${module} entry state first (solve builds on it)…"
  render_app "$module" "$user" | oc apply -f - >/dev/null
  sync_app_operation "$(app_name "$module" "$user")"
  wait_healthy "$(app_name "$module" "$user")" "$(meta_wait "$module")" "false" || true

  info "materializing ${module} END state for ${user} (instructor solve)…"
  render_app "$module" "$user" "true" | oc apply -f -
  # solve flips a helm parameter on an EXISTING app — without a hard-refresh + operation Argo
  # can serve the cached solve=false render and "solve" becomes a silent no-op (M11 G1 flag #1).
  sync_app_operation "$(app_name "$module" "$user")"
  if [[ "$(meta_expect_degraded "$module")" == "true" ]]; then
    wait_materialized "$(app_name "$module" "$user")" "$(meta_wait "$module")"
  else
    wait_healthy "$(app_name "$module" "$user")" "$(meta_wait "$module")" "$(meta_require_sync "$module")"
  fi
  echo
  ok "${module} solved for ${user} — demo-ready."
}

sync_app_operation() {  # app — start a fresh sync OPERATION (hooks only re-run on operations;
  # a refresh alone re-compares but re-fires nothing — proven painfully 2026-07-10). Waits out a
  # running operation first (patching .operation while one runs is silently swallowed), and
  # hard-refreshes so Argo re-resolves the branch (cached revisions otherwise sync stale).
  local app="$1" t=0 ph
  while (( t < 300 )); do
    ph="$(oc get application "$app" -n "$ARGO_NS" -o jsonpath='{.status.operationState.phase}' 2>/dev/null || true)"
    [[ "$ph" != "Running" && "$ph" != "Terminating" ]] && break
    sleep 5; t=$((t+5))
  done
  oc annotate application "$app" -n "$ARGO_NS" argocd.argoproj.io/refresh=hard --overwrite >/dev/null 2>&1 || true
  sleep 10
  # prune:true is REQUIRED now that syncPolicy has no automated block — pruning used to come from
  # `automated.prune`, and without it here a reset would leave removed resources behind forever.
  # revision follows SOURCE_REVISION rather than a hardcoded "main": ws already supports WS_REVISION,
  # and a hardcoded branch would sync the wrong content the moment anyone used it.
  if oc patch application "$app" -n "$ARGO_NS" --type merge \
    -p '{"operation":{"initiatedBy":{"username":"ws"},"sync":{"revision":"'"${SOURCE_REVISION}"'","prune":true}}}' >/dev/null 2>&1; then
    ok "sync operation started on ${app}"
  else
    err "could not start a sync on ${app} (still busy?) — retry shortly"
  fi
}

# Force the in-cluster Gitea pull-mirror to fetch origin NOW and WAIT until it actually serves the
# pushed HEAD. The mirror-sync hook fires on a pp-git-mirror sync, but Gitea's pull is async and the
# sync op returns before it finishes — so a just-pushed commit can lag minutes and every entry app
# then syncs STALE content (repeatedly cost real time; G3-M11 fix-round find, 2026-07-11). This POSTs
# mirror-sync directly (bootstrap's admin-cred pattern) and polls the mirror branch HEAD to origin's.
force_mirror_sync() {
  local host user pass target mirror
  host="$(oc get route gitea -n "${GITEA_NS}" -o jsonpath='{.spec.host}' 2>/dev/null || true)"
  [[ -n "$host" ]] || { echo "⚠ gitea route not found — skipping mirror-sync (will refresh on interval)"; return 0; }
  user="$(oc get gitea gitea -n "${GITEA_NS}" -o jsonpath='{.spec.giteaAdminUser}' 2>/dev/null || echo gitea-admin)"
  pass="$(oc get gitea gitea -n "${GITEA_NS}" -o jsonpath='{.status.adminPassword}' 2>/dev/null || true)"
  [[ -z "$pass" ]] && pass="$(oc get secret gitea-admin-credentials -n "${GITEA_NS}" -o jsonpath='{.data.password}' 2>/dev/null | base64 -d || true)"
  [[ -n "$pass" ]] || { echo "⚠ no Gitea admin password — mirror will refresh on its own interval"; return 0; }
  curl -ksf -u "${user}:${pass}" -X POST \
    "https://${host}/api/v1/repos/${MIRROR_ORG}/${MIRROR_REPO}/mirror-sync" >/dev/null 2>&1 || true
  # Target = what origin actually serves after your push (the mirror pulls from there).
  target="$(git -C "$REPO_ROOT" rev-parse origin/main 2>/dev/null || true)"
  [[ -n "$target" ]] || { info "mirror-sync triggered (no local origin/main ref to wait on)"; return 0; }
  for _ in $(seq 1 30); do
    mirror="$(curl -ksf "https://${host}/api/v1/repos/${MIRROR_ORG}/${MIRROR_REPO}/branches/main" 2>/dev/null \
      | sed -n 's/.*"id":"\([a-f0-9]*\)".*/\1/p' | head -1)"
    [[ "$mirror" == "$target" ]] && { ok "mirror at ${target:0:8} (matches origin)"; return 0; }
    sleep 4
  done
  echo "⚠ mirror still behind origin after ~2m (at ${mirror:0:8}); entry apps may briefly serve stale content"
}

verify_terminal_head() {  # user ns want-sha — confirm the FRESH pod re-cloned to current content (Part 2c)
  local u="$1" ns="$2" want="$3" pod clone_head
  pod="$(oc get pods -n "$ns" -l "app.kubernetes.io/name=showroom,workshop.redhat.com/user=${u}" \
           --field-selector=status.phase=Running --sort-by=.metadata.creationTimestamp -o name 2>/dev/null | tail -1)"
  pod="${pod#pod/}"
  [[ -n "$pod" ]] || { info "  ${u}: restarted (new pod not resolvable yet to verify clone)"; return 0; }
  clone_head="$(oc exec "$pod" -n "$ns" -c terminal -- git -C /home/lab-user/ocp-getting-started rev-parse HEAD 2>/dev/null || true)"
  if [[ -z "$clone_head" ]]; then
    info "  ${u}: restarted (clone HEAD not readable yet — pod still initializing)"
  elif [[ -n "$want" && "$clone_head" != "$want" ]]; then
    err "  ${u}: pod re-cloned to ${clone_head:0:8} but mirror serves ${want:0:8} — mirror lag? re-check shortly"
  else
    ok "  ${u}: pod re-cloned to ${clone_head:0:8}${want:+ (matches mirror)}"
  fi
}

restart_terminals() {  # target all-flag [exclude...] — opt-in restart of showroom cockpit pods so LIVE
  # attendees get re-rendered pages + re-cloned content. Rendered lab pages build at pod-init from the
  # mirror, so the CLI self-heal can't touch them — only a pod restart re-renders them. WS_RESERVED_USERS
  # (EMPTY by default — set it to a space-separated list ONLY to spare a session that is live mid-demo;
  # every user, incl. user5, is a normal attendee slot) are NEVER cycled by --all; restarting one
  # requires naming it with --user (i.e. with intent).
  local target="$1" all="$2"; shift 2
  local excludes=("$@")
  local ns="${WS_SHOWROOM_NS:-ogsr-showroom}"
  local reserved=" ${WS_RESERVED_USERS:-} "
  local users=() u x skip
  if [[ -n "$target" ]]; then
    users=("$target")
    [[ "$reserved" == *" ${target} "* ]] && err "⚠ ${target} is a RESERVED live session — restarting it because you named it explicitly."
  elif [[ "$all" == true ]]; then
    for u in $(oc get deploy -n "$ns" -l app.kubernetes.io/name=showroom \
                 -o jsonpath='{range .items[*]}{.metadata.labels.workshop\.redhat\.com/user}{"\n"}{end}' 2>/dev/null | sort -u); do
      [[ -n "$u" ]] || continue
      [[ "$reserved" == *" ${u} "* ]] && { info "skipping reserved session ${u} (override with: --user ${u})"; continue; }
      skip=false
      if [[ ${#excludes[@]} -gt 0 ]]; then
        for x in "${excludes[@]}"; do [[ "$u" == "$x" ]] && skip=true; done
      fi
      [[ "$skip" == true ]] && { info "skipping ${u} (excluded)"; continue; }
      users+=("$u")
    done
    [[ ${#users[@]} -gt 0 ]] || die "no showroom sessions to restart in ns ${ns} (after reserved/exclusions)"
  else
    die "restart needs a target: --user <u> (one session) or --all (whole cohort, minus any WS_RESERVED_USERS)"
  fi

  info "restarting showroom terminal(s): ${users[*]}"
  local want; want="$(mirror_head || true)"
  local failed=0 dep
  for u in "${users[@]}"; do
    dep="showroom-${u}"
    if ! oc get deploy "$dep" -n "$ns" >/dev/null 2>&1; then
      err "  ${dep} not found in ${ns} — skipping"; failed=1; continue
    fi
    info "  ${dep}: rollout restart…"
    if ! oc rollout restart "deployment/${dep}" -n "$ns" >/dev/null 2>&1; then
      err "  ${dep}: restart failed (RBAC? this is an operator/admin action)"; failed=1; continue
    fi
    if ! oc rollout status "deployment/${dep}" -n "$ns" --timeout=180s >/dev/null 2>&1; then
      err "  ${dep}: not ready in 180s — check: oc rollout status deployment/${dep} -n ${ns}"; failed=1; continue
    fi
    verify_terminal_head "$u" "$ns" "$want"
  done
  echo
  if (( failed == 0 )); then
    ok "showroom terminal(s) restarted — attendees now see refreshed pages + content."
  else
    err "some restarts had issues — see above"; return 1
  fi
}

cmd_git_refresh() {
  need_oc
  local do_restart=false all=false target="" excludes=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --restart-terminals|--restart) do_restart=true; shift;;
      --all)                         all=true; shift;;
      # git-refresh self-parses, so main()'s --user validation never sees these. Both flags name
      # attendees (restart_terminals resolves them to showroom-<user> Deployments), so both get the
      # canonical check — a typo here silently restarts nothing and reads as "the refresh did not work".
      --user)                        target="${2:-}"; require_user_token "$target" "git-refresh --user"; shift 2;;
      --exclude)                     require_user_token "${2:-}" "git-refresh --exclude"; excludes+=("$2"); shift 2;;
      *) die "git-refresh: unknown option '$1' — see: ws help";;
    esac
  done
  # Three layers pull from git: the Gitea pull-mirror (must fetch origin — force + wait FIRST, else
  # the two apps below sync stale content), then pp-git-mirror and workshop-config (whose Sync hooks
  # re-run the user seed AND the app-repo seed — the parasol/* app repos only refresh through THAT
  # hook). The apps need a real sync operation; no argocd CLI dependence (a stale CLI failed silently).
  info "forcing the Gitea pull-mirror to fetch your latest push…"
  force_mirror_sync
  info "re-running the git-localize mirror sync…"
  sync_app_operation pp-git-mirror
  info "re-running the workshop-config seed hooks (user seed + app-repo seed)…"
  sync_app_operation workshop-config
  echo "   watch: oc get jobs -n ${GITEA_NS} -w"
  # Opt-in ONLY: refresh what attendees READ. Bare `ws git-refresh` stays non-disruptive (mirror+Argo
  # only) — build agents call it constantly, and it must never nuke live sessions. Pods cycle solely
  # when --restart-terminals is given, and even then --all spares reserved sessions.
  if [[ "$do_restart" == true ]]; then
    echo
    if [[ ${#excludes[@]} -gt 0 ]]; then
      restart_terminals "$target" "$all" "${excludes[@]}"
    else
      restart_terminals "$target" "$all"
    fi
  elif [[ "$all" == true || -n "$target" || ${#excludes[@]} -gt 0 ]]; then
    info "note: --user/--all/--exclude take effect only with --restart-terminals (bare git-refresh never restarts pods)."
  fi
}

# ── ws rebuild-images: make a rebuilt image REACH every running consumer ──────────────────────────
# `imagePullPolicy: Always` (4efc931) makes a pod restart LAND a rebuilt image. It does not make a
# rebuild REACH anything: a running container keeps the digest it was started with until something
# rolls it. Between `oc start-build` and a live session, "now roll every consumer in every per-user
# namespace" is the step a human forgets — and that consumer list cannot be written down in advance,
# because WHICH per-user namespaces exist depends on which entry states are materialized right now.
# The hand-run this command was specified from found 9 workloads across 4 namespaces that no static
# list would have predicted, so the enumeration below is dynamic and never a hardcoded namespace set.
#
# The comparison is at the POD — containerStatuses[].imageID — against the ImageStream tag's CURRENT
# digest. A workload's spec says `…/parasol-claims:1.1` before AND after a rebuild, so the spec can
# never answer "is the running container the new build". Only the digest can. That is also what makes
# the write path safe to re-run: a workload already on the current digest is not restarted, so a
# rebuild that changed nothing restarts nothing — restarting an attendee's namespace mid-lab costs
# them their work, and the digest compare is the whole reason this command may run at all.
#
# --check is the read-only half (scan + compare, no build, no restart, exit 1 on drift) — the piece
# `ws doctor` and CI can consume. Deliberately NOT folded into `ws git-refresh`: that command is
# non-disruptive by contract and build agents call it constantly. Same opt-in shape as its
# --restart-terminals, including the "a disruptive scope must be named" rule (--user U or --all).
REBUILD_TIMEOUT="${WS_REBUILD_TIMEOUT:-300}"   # per-workload rollout/readiness budget, seconds
REBUILD_TMP=""                                 # per-run work dir (namespace-owner map + digest cache)
REBUILD_NSMAP=""
REBUILD_DIGESTS=""

rebuild_owned_ns() {  # → "ns<TAB>owner" for every namespace this command recognizes as the workshop's:
  # each attendee-labelled namespace (owner = that attendee) plus the shared images namespace
  # (owner = "shared"). workshop.redhat.com/user is the same label ws status/ws diag already read.
  oc get ns -l workshop.redhat.com/user \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.metadata.labels.workshop\.redhat\.com/user}{"\n"}{end}' 2>/dev/null || true
  printf '%s\tshared\n' "$PARASOL_IMAGES_NS"
}

rebuild_begin() {  # open the per-run caches (namespace-owner map + ImageStreamTag digests). Pair with
  # rebuild_end. This is the whole setup the READ-ONLY core needs, so a future `ws doctor` drift row is
  #   rebuild_begin; rebuild_scan "" "" > "$rows"; rebuild_print_table "$rows"; rebuild_end
  # and inherits none of the build/restart path.
  REBUILD_TMP="$(mktemp -d)"
  REBUILD_NSMAP="${REBUILD_TMP}/nsmap"
  REBUILD_DIGESTS="${REBUILD_TMP}/digests"
  rebuild_owned_ns > "$REBUILD_NSMAP"
  : > "$REBUILD_DIGESTS"
}

rebuild_end() {  # drop the per-run caches; safe to call twice
  if [[ -n "$REBUILD_TMP" && -d "$REBUILD_TMP" ]]; then rm -rf "$REBUILD_TMP"; fi
  REBUILD_TMP=""; REBUILD_NSMAP=""; REBUILD_DIGESTS=""
  return 0
}

rebuild_ns_owner() {  # ns → its owner from the per-run map, or empty when the namespace is not ours
  [[ -n "$REBUILD_NSMAP" && -f "$REBUILD_NSMAP" ]] || return 0
  awk -F'\t' -v n="$1" '$1==n{print $2; exit}' "$REBUILD_NSMAP"
}

rebuild_image_parts() {  # image-ref → "srcns<TAB>name<TAB>tag|digest<TAB>value"; 1 when the ref has no
  # <ns>/<name> shape at all. Splitting from the RIGHT is what keeps the registry's own port out of it:
  # `…svc:5000/ogsr-parasol-images/parasol-claims:1.1` has two colons and only the last one is a tag.
  local ref="$1" last rest ns
  last="${ref##*/}"                  # parasol-claims:1.1  ·  parasol-claims@sha256:…
  rest="${ref%/*}"                   # image-registry…svc:5000/ogsr-parasol-images
  [[ "$rest" == */* ]] || return 1   # no namespace segment (a bare registry/name) → cannot be ours
  ns="${rest##*/}"
  [[ -n "$ns" && -n "$last" ]] || return 1
  if [[ "$last" == *@* ]]; then
    printf '%s\t%s\tdigest\t%s\n' "$ns" "${last%%@*}" "${last#*@}"
  elif [[ "$last" == *:* ]]; then
    printf '%s\t%s\ttag\t%s\n' "$ns" "${last%%:*}" "${last##*:}"
  else
    printf '%s\t%s\ttag\tlatest\n' "$ns" "$last"
  fi
}

istag_digest() {  # ns name tag → that ImageStreamTag's CURRENT digest (sha256:…), empty when absent.
  # Cached per run: the same tag is consumed by many workloads and the answer cannot change mid-scan.
  # NOTE the tags in ogsr-parasol-images (1.0/1.1) TRACK :latest — the BuildConfig writes :latest and
  # every tracking tag moves with it (verified on-cluster 2026-07-29) — so reading the tag the workload
  # actually names, rather than the build output tag, is correct for pinned and tracking tags alike.
  local key="${1}/${2}:${3}" hit digest
  if [[ -n "$REBUILD_DIGESTS" && -f "$REBUILD_DIGESTS" ]]; then
    hit="$(awk -F'\t' -v k="$key" '$1==k{print $2; exit}' "$REBUILD_DIGESTS")"
    if [[ -n "$hit" ]]; then
      [[ "$hit" == "-" ]] && return 0
      echo "$hit"; return 0
    fi
  fi
  digest="$(oc get istag "${2}:${3}" -n "$1" -o jsonpath='{.image.metadata.name}' 2>/dev/null || true)"
  if [[ -n "$REBUILD_DIGESTS" && -f "$REBUILD_DIGESTS" ]]; then
    printf '%s\t%s\n' "$key" "${digest:--}" >> "$REBUILD_DIGESTS"
  fi
  echo "$digest"
}

rebuild_enumerate() {  # → TSV "kind ns workload selector container image" for EVERY workload container
  # on the cluster. The caller filters to ours; enumerating first and filtering on the image's SOURCE
  # namespace is what keeps the command honest when a new entry state invents a namespace nobody listed.
  # go-template (not jq — no jq anywhere in this repo's shell tooling) because only a template can walk
  # the selector MAP into a label query. CronJobs keep their containers one level deeper, under
  # .spec.jobTemplate; ranging over a missing path on unstructured JSON is a no-op, so both paths emit.
  #
  # The selector falls back to a literal "-" rather than the empty string, and that is load-bearing: TAB
  # is IFS *whitespace*, so `IFS=$'\t' read` COLLAPSES a run of tabs and an empty field silently shifts
  # every later field left. A CronJob has no .spec.selector, so emitting "" for it made the reader bind
  # the container name to the image column and drop the row entirely — every CronJob vanished from the
  # scan without a word (caught on ksls5 2026-07-29 with a probe CronJob that never appeared).
  # shellcheck disable=SC2016  # $k/$ns/$n/$s are go-template variables; shell expansion would break it
  local tmpl='{{range .items}}{{$k := .kind}}{{$ns := .metadata.namespace}}{{$n := .metadata.name}}{{$s := ""}}{{range $kk, $vv := .spec.selector.matchLabels}}{{$s = printf "%s%s=%s," $s $kk $vv}}{{end}}{{if not $s}}{{$s = "-"}}{{end}}{{range .spec.template.spec.containers}}{{$k}}{{"\t"}}{{$ns}}{{"\t"}}{{$n}}{{"\t"}}{{$s}}{{"\t"}}{{.name}}{{"\t"}}{{.image}}{{"\n"}}{{end}}{{range .spec.jobTemplate.spec.template.spec.containers}}{{$k}}{{"\t"}}{{$ns}}{{"\t"}}{{$n}}{{"\t"}}{{$s}}{{"\t"}}{{.name}}{{"\t"}}{{.image}}{{"\n"}}{{end}}{{end}}'
  oc get deployments,statefulsets,daemonsets,cronjobs -A -o go-template="$tmpl" 2>/dev/null || true
  # Knative Services are a SEPARATE query on purpose: their kind is the ambiguous "Service", they have no
  # spec selector, and a single-container ksvc usually names no container at all — the pod's container is
  # then Knative's own `user-container`.
  #
  # Their pods are matched by the revisions currently RECEIVING TRAFFIC, not by the service label. Two
  # reasons, both measured on ksls5 2026-07-29: a ksvc that was just given a new Revision keeps the old
  # Revision's pods Running (not Terminating) until they scale down, so a service-wide match reports the
  # freshly-rolled service as still stale; and a solve-state traffic split serves TWO revisions on
  # purpose, so "the latest one" would under-report. .status.traffic is exactly "what a request can hit".
  if oc get crd services.serving.knative.dev >/dev/null 2>&1; then
    # shellcheck disable=SC2016  # $ns/$n/$r/$sel are go-template variables, not shell ones
    local ktmpl='{{range .items}}{{$ns := .metadata.namespace}}{{$n := .metadata.name}}{{$r := ""}}{{range .status.traffic}}{{if .revisionName}}{{if $r}}{{$r = printf "%s,%s" $r .revisionName}}{{else}}{{$r = printf "%s" .revisionName}}{{end}}{{end}}{{end}}{{$sel := printf "serving.knative.dev/service=%s" $n}}{{if $r}}{{$sel = printf "serving.knative.dev/revision in (%s)" $r}}{{end}}{{range .spec.template.spec.containers}}KnativeService{{"\t"}}{{$ns}}{{"\t"}}{{$n}}{{"\t"}}{{$sel}}{{"\t"}}{{if .name}}{{.name}}{{else}}user-container{{end}}{{"\t"}}{{.image}}{{"\n"}}{{end}}{{end}}'
    oc get services.serving.knative.dev -A -o go-template="$ktmpl" 2>/dev/null || true
  fi
}

rebuild_pod_digests() {  # ns selector container → the digest each RUNNING pod's container is ACTUALLY on
  # (one per line). Terminating pods are excluded so a re-verify run immediately after a rollout is not
  # fooled by the outgoing ReplicaSet, and non-Running pods are excluded because they have no imageID yet.
  local ns="$1" sel="${2%,}" cname="$3"
  [[ -n "$sel" && "$sel" != "-" ]] || return 0   # no selector (a CronJob) → no long-lived pod to read
  oc get pods -n "$ns" -l "$sel" \
    -o go-template='{{range .items}}{{if not .metadata.deletionTimestamp}}{{if eq .status.phase "Running"}}{{range .status.containerStatuses}}{{.name}}{{"\t"}}{{.imageID}}{{"\n"}}{{end}}{{end}}{{end}}{{end}}' 2>/dev/null \
    | awk -F'\t' -v c="$cname" '$1==c && $2 ~ /@/ {sub(/^.*@/, "", $2); print $2}'
}

rebuild_scan() {  # scope_user image_filter → one TSV row per workload CONTAINER we own:
  #   kind ns workload container owner module src want running stale state
  # state: current · stale · no-pods · pinned · no-tag.  Pure and read-only — this and rebuild_image_parts
  # are the reusable core `ws doctor` can call later without inheriting any of the write path.
  local scope="$1" filter="$2"
  local kind ns name sel cname image parts src_ns src_name reftype refval
  local wl_owner want module running stale d state
  while IFS=$'\t' read -r kind ns name sel cname image; do
    [[ -n "$kind" && -n "$image" ]] || continue
    # Knative runs each Revision as its OWN Deployment (<revision>-deployment, selector keyed by
    # serving.knative.dev/revisionUID). Reporting that Deployment would double-count the ksvc row below
    # it and invite an `oc rollout restart` against a resource the Serving controller owns — restarting
    # a Revision's pods does not give the ksvc a new Revision, so it would look fixed and not be.
    case "$sel" in *serving.knative.dev/revisionUID*) continue ;; esac
    parts="$(rebuild_image_parts "$image")" || continue
    IFS=$'\t' read -r src_ns src_name reftype refval <<< "$parts"
    # Ours only if the image is BUILT in a namespace the workshop owns: ogsr-parasol-images (the shared
    # images) or an attendee namespace (a per-user pipeline build — on this cluster that is
    # <user>-cicd/parasol-claims:latest, built by the module's own Tekton run, not a <user>-dev build).
    [[ -n "$(rebuild_ns_owner "$src_ns")" ]] || continue
    if [[ -n "$filter" && "$src_name" != "$filter" ]]; then continue; fi
    # Scope is the WORKLOAD's namespace, not the image's: --user user2 must re-roll what user2 runs.
    wl_owner="$(rebuild_ns_owner "$ns")"
    [[ -n "$wl_owner" ]] || wl_owner="shared"
    if [[ -n "$scope" && "$wl_owner" != "$scope" ]]; then continue; fi
    # The module label is read ONLY for the Knative branch, which is the one place a row turns into a
    # `ws reset <module> --user <u>` instruction. Two reasons not to read it for every row: it would be
    # one extra API call per workload on the hot path, and "KnativeService" is this command's OWN label
    # for the kind — `oc get KnativeService` is not a resource, so the lookup has to say `ksvc` anyway.
    module="-"
    if [[ "$kind" == "KnativeService" ]]; then
      module="$(oc get ksvc "$name" -n "$ns" -o jsonpath='{.metadata.labels.workshop\.redhat\.com/module}' 2>/dev/null || true)"
    fi

    if [[ "$reftype" == "digest" ]]; then
      # Already pinned to a digest: it cannot drift from a moving tag, so there is nothing to compare
      # and nothing a restart would change.
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t0\t0\tpinned\n' \
        "$kind" "$ns" "$name" "$cname" "$wl_owner" "${module:--}" "${src_ns}/${src_name}@digest" "$refval"
      continue
    fi
    want="$(istag_digest "$src_ns" "$src_name" "$refval")"
    running=0; stale=0
    while IFS= read -r d; do
      [[ -n "$d" ]] || continue
      running=$((running + 1))
      if [[ -n "$want" && "$d" != "$want" ]]; then stale=$((stale + 1)); fi
    done < <(rebuild_pod_digests "$ns" "$sel" "$cname")
    if [[ -z "$want" ]]; then
      state="no-tag"
    elif [[ "$running" -eq 0 ]]; then
      state="no-pods"
    elif [[ "$stale" -gt 0 ]]; then
      state="stale"
    else
      state="current"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$kind" "$ns" "$name" "$cname" "$wl_owner" "${module:--}" \
      "${src_ns}/${src_name}:${refval}" "${want:--}" "$running" "$stale" "$state"
  done < <(rebuild_enumerate)
}

rebuild_state_mark() {  # state → the ✅/❌/➖ this row prints as (same vocabulary as every other command)
  case "$1" in
    current) echo "✅ current" ;;
    stale)   echo "❌ stale" ;;
    no-pods) echo "➖ no running pod" ;;
    pinned)  echo "➖ digest-pinned" ;;
    no-tag)  echo "❌ tag missing" ;;
    *)       echo "➖ $1" ;;
  esac
}

rebuild_print_table() {  # rows-file → the report; → 0 when nothing needs action, 1 when something does
  local file="$1"
  local kind ns name cname owner module src want running stale state
  local n=0 n_stale=0 n_bad=0
  printf "  %-15s %-18s %-22s %-16s %-40s %-6s %s\n" KIND NAMESPACE WORKLOAD CONTAINER IMAGE PODS STATE
  while IFS=$'\t' read -r kind ns name cname owner module src want running stale state; do
    [[ -n "$kind" ]] || continue
    n=$((n + 1))
    printf "  %-15s %-18s %-22s %-16s %-40s %-6s %s\n" \
      "$kind" "$ns" "$name" "$cname" "$src" "$((running - stale))/${running}" "$(rebuild_state_mark "$state")"
    case "$state" in
      stale)   n_stale=$((n_stale + 1)) ;;
      no-tag)  n_bad=$((n_bad + 1)) ;;
    esac
  done < "$file"
  echo
  if [[ "$n" -eq 0 ]]; then
    info "no workshop-built image consumers found in scope."
    echo "   Nothing consumes ${PARASOL_IMAGES_NS} or a per-user build here — materialize a module first (ws start <module> --user userN)."
    return 0
  fi
  if [[ "$n_stale" -eq 0 && "$n_bad" -eq 0 ]]; then
    ok "${n} consumer(s) — every running pod is on its tag's current digest (no drift)."
    return 0
  fi
  # `cond && cmd` is deliberately avoided here: it is fatal under set -e as a function's last statement
  # when the function is called bare, and this file is all functions (repo rule, measured 2026-07-25).
  if [[ "$n_stale" -gt 0 ]]; then
    err "${n_stale} of ${n} consumer(s) run a digest OLDER than their tag."
  fi
  if [[ "$n_bad" -gt 0 ]]; then
    err "${n_bad} consumer(s) reference a tag that does not exist — those pods will ImagePullBackOff on their next restart (see: ws doctor)."
  fi
  return 1
}

rebuild_row_summary() {  # rows-file → "total<TAB>stale<TAB>no-tag<TAB>offenders" — the ONE-LINE verdict
  # `ws doctor` needs. rebuild_print_table is the full REPORT: it prints a column header, a line per
  # row, a blank line and its own ok/err. Dropping that into doctor would break its one-row-per-check
  # rendering, so this reads the SAME rows file with the SAME field order and state vocabulary and
  # returns counts instead of printing. They must agree; the CI fixture gate asserts they do.
  #
  # The offender list is "-" when empty, NEVER the empty string. TAB is IFS *whitespace*, so a caller
  # doing `IFS=$'\t' read -r a b c d` binds nothing to d and silently keeps whatever it held before —
  # the same collapse that made every CronJob vanish from the scan (see rebuild_enumerate's selector
  # column). Capped at four names because a doctor row is one line: the count stays exact and
  # `ws rebuild-images --check` prints the rest.
  local file="$1"
  local kind ns name cname owner module src want running stale state
  local n=0 n_stale=0 n_bad=0 names="" shown=0 extra=0
  while IFS=$'\t' read -r kind ns name cname owner module src want running stale state; do
    [[ -n "$kind" ]] || continue
    n=$((n + 1))
    case "$state" in
      stale)   n_stale=$((n_stale + 1)) ;;
      no-tag)  n_bad=$((n_bad + 1)) ;;
      *)       continue ;;
    esac
    if [[ "$shown" -lt 4 ]]; then
      names="${names}${names:+ }${ns}/${name}"
      shown=$((shown + 1))
    else
      extra=$((extra + 1))
    fi
  done < "$file"
  if [[ "$extra" -gt 0 ]]; then names="${names} (+${extra} more)"; fi
  printf '%s\t%s\t%s\t%s\n' "$n" "$n_stale" "$n_bad" "${names:--}"
}

rebuild_buildconfigs() {  # [name] → the BuildConfig(s) to rebuild in the shared images namespace
  if [[ -n "${1:-}" ]]; then
    oc get bc "$1" -n "$PARASOL_IMAGES_NS" -o jsonpath='{.metadata.name}' 2>/dev/null || true
  else
    oc get bc -n "$PARASOL_IMAGES_NS" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null || true
  fi
}

rebuild_start_builds() {  # image-filter → build each BuildConfig, reporting its output tag's digest
  # before/after. An UNCHANGED digest means the build produced the same image (or never updated the tag):
  # say so and let the consumer pass below come out a no-op, rather than rolling anything on faith.
  local filter="$1" bcs bc out oname otag before after rc=0 changed=0
  bcs="$(rebuild_buildconfigs "$filter")"
  if [[ -z "${bcs//[[:space:]]/}" ]]; then
    if [[ -n "$filter" ]]; then
      die "no BuildConfig '${filter}' in ${PARASOL_IMAGES_NS} — available: $(rebuild_buildconfigs "" | paste -sd' ' -)"
    fi
    info "no BuildConfigs in ${PARASOL_IMAGES_NS} — skipping the build (the consumer scan still runs)."
    return 0
  fi
  info "Building in ${PARASOL_IMAGES_NS}: $(echo "$bcs" | paste -sd' ' -)"
  echo "   each build is a couple of minutes; narrow with --image <name>, or skip with --no-build"
  echo
  while IFS= read -r bc; do
    [[ -n "$bc" ]] || continue
    out="$(oc get bc "$bc" -n "$PARASOL_IMAGES_NS" -o jsonpath='{.spec.output.to.name}' 2>/dev/null || true)"
    oname="${out%%:*}"; otag="${out##*:}"
    [[ -n "$oname" && "$oname" != "$otag" ]] || { oname="$bc"; otag="latest"; }
    before="$(istag_digest "$PARASOL_IMAGES_NS" "$oname" "$otag")"
    info "  oc start-build ${bc} -n ${PARASOL_IMAGES_NS} --wait --follow"
    # </dev/null is not decoration: this loop's stdin IS the BuildConfig list, and a child that reads
    # stdin eats the remaining names. With one BuildConfig nothing shows; with seven, builds 2..7 would
    # silently never start. Detach the build from the loop's input.
    if ! oc start-build "$bc" -n "$PARASOL_IMAGES_NS" --wait --follow </dev/null; then
      err "  ${bc}: build FAILED — logs: oc logs -f bc/${bc} -n ${PARASOL_IMAGES_NS}"
      rc=1; continue
    fi
    # The digest cache was populated with the PRE-build answer; drop it so `after` is a fresh read.
    if [[ -n "$REBUILD_DIGESTS" && -f "$REBUILD_DIGESTS" ]]; then : > "$REBUILD_DIGESTS"; fi
    after="$(istag_digest "$PARASOL_IMAGES_NS" "$oname" "$otag")"
    if [[ -n "$after" && "$after" != "$before" ]]; then
      ok "  ${oname}:${otag} ${before:0:19}… → ${after:0:19}…  (rebuilt)"
      changed=$((changed + 1))
    else
      skip "  ${oname}:${otag} ${after:0:19}… unchanged — no-op, consumers below stay as they are"
    fi
  done <<< "$bcs"
  echo
  if [[ "$changed" -eq 0 && "$rc" -eq 0 ]]; then
    info "No image digest moved — nothing new to roll out (the consumer pass below will confirm)."
  fi
  return "$rc"
}

rebuild_roll_one() {  # kind ns name owner module → 0 rolled+ready · 1 could not roll · 2 nothing to roll
  local kind="$1" ns="$2" name="$3" owner="$4" module="$5" pinned stamp
  case "$kind" in
    Deployment|StatefulSet|DaemonSet)
      local lk; lk="$(echo "$kind" | tr '[:upper:]' '[:lower:]')"
      if ! oc rollout restart "${lk}/${name}" -n "$ns" >/dev/null 2>&1; then
        err "  ${ns}/${name}: rollout restart failed (RBAC? this is an SA/admin action)"; return 1
      fi
      if ! oc rollout status "${lk}/${name}" -n "$ns" --timeout="${REBUILD_TIMEOUT}s" >/dev/null 2>&1; then
        # Say this out loud: a stalled rollout is NOT an outage. The previous ReplicaSet keeps serving
        # until the new one is ready, so the attendee sees the old image, not a broken app. Measured on
        # ksls5 2026-07-29 — a namespace whose ResourceQuota was exhausted by concurrent PipelineRuns
        # could not create the new pod, and the 85-minute-old pod carried on untouched.
        err "  ${ns}/${name}: new pods not ready in ${REBUILD_TIMEOUT}s — the PREVIOUS pods are still serving (old image), nothing is down."
        err "     why:  oc describe ${lk}/${name} -n ${ns}   ·   oc get events -n ${ns} --sort-by=.lastTimestamp | tail"
        err "     often a full ResourceQuota or an unschedulable node; retry when it clears, or abandon: oc rollout undo ${lk}/${name} -n ${ns}"
        return 1
      fi
      ok "  ${ns}/${name}: rolled"
      return 0 ;;
    CronJob)
      # Nothing to restart: a CronJob has no long-lived pod. Its NEXT run creates a fresh pod, and with
      # imagePullPolicy: Always that pod pulls the new digest on its own.
      skip "  ${ns}/${name}: CronJob — next scheduled run picks the new image up (imagePullPolicy: Always)"
      return 2 ;;
    KnativeService)
      # `oc rollout restart` does not exist for a ksvc: a Knative container image only changes with a NEW
      # Revision. Bumping a template annotation makes one — BUT ONLY when the Revision name is not pinned.
      # Both of this repo's ksvc entry states pin spec.template.metadata.name (parasol-claims-v1/-v2, so
      # the solve traffic split can address revisions by name), and Knative's validating webhook rejects
      # ANY template change that keeps the same revision name. Measured on ksls5 2026-07-29:
      #   admission webhook "validation.webhook.serving.knative.dev" denied the request: validation
      #   failed: Saw the following changes without a name change (-old +new): spec.template.metadata.name
      # So do not attempt the patch there — re-materializing the entry state is the only honest route.
      pinned="$(oc get ksvc "$name" -n "$ns" -o jsonpath='{.spec.template.metadata.name}' 2>/dev/null || true)"
      if [[ -n "$pinned" ]]; then
        err "  ${ns}/${name}: Knative Service with a PINNED revision name (${pinned}) — a new Revision cannot be forced by patch."
        if [[ "$module" != "-" && "$owner" != "shared" ]]; then
          err "     re-materialize it instead:  ws reset ${module} --user ${owner}"
        else
          err "     re-materialize it instead:  ws reset <module> --user <userN>"
        fi
        return 1
      fi
      stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      if ! oc patch ksvc "$name" -n "$ns" --type merge \
             -p "{\"spec\":{\"template\":{\"metadata\":{\"annotations\":{\"workshop.redhat.com/rolledAt\":\"${stamp}\"}}}}}" >/dev/null 2>&1; then
        err "  ${ns}/${name}: could not patch the ksvc template (RBAC? webhook?)"; return 1
      fi
      if ! oc wait "ksvc/${name}" -n "$ns" --for=condition=Ready --timeout="${REBUILD_TIMEOUT}s" >/dev/null 2>&1; then
        err "  ${ns}/${name}: new Revision not Ready in ${REBUILD_TIMEOUT}s — check: oc get revision -n ${ns}"; return 1
      fi
      ok "  ${ns}/${name}: new Revision created"
      return 0 ;;
    *)
      skip "  ${ns}/${name}: ${kind} — no restart verb for this kind"
      return 2 ;;
  esac
}

cmd_rebuild_images() {
  local check=false no_build=false filter="" scope="" all=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --check)     check=true; shift ;;
      --no-build)  no_build=true; shift ;;
      --image)     filter="${2:-}"; shift 2
                   [[ -n "$filter" ]] || die "rebuild-images: --image needs an image name (e.g. --image parasol-claims)" ;;
      # rebuild-images self-parses, so main()'s --user validation never sees this value.
      --user)      scope="${2:-}"; require_user_token "$scope" "rebuild-images --user"; shift 2 ;;
      user[0-9]*)  scope="$1"; require_user_token "$scope" "rebuild-images"; shift ;;
      --all)       all=true; shift ;;
      -h|--help)   grep '^#' "$0" | sed 's/^# \{0,1\}//' | sed -n '2,23p'; return 0 ;;
      *) die "rebuild-images: unknown option '$1' — see: ws help" ;;
    esac
  done
  if [[ -n "$scope" && "$all" == true ]]; then
    die "rebuild-images: pass --user ${scope} OR --all, not both"
  fi
  # A disruptive cohort-wide action must be NAMED, exactly as restart_terminals demands. --check is
  # read-only, so it needs no scope and defaults to the whole cluster.
  if [[ "$check" != true && -z "$scope" && "$all" != true ]]; then
    die "rebuild-images: rolling restarts need a scope: --user <userN> (one attendee) or --all (every attendee). Read-only drift report: ws rebuild-images --check"
  fi
  need_oc

  rebuild_begin; trap 'rm -rf "$REBUILD_TMP"' EXIT

  local who server banner="ws rebuild-images"
  who="$(oc whoami 2>/dev/null || true)"
  server="$(oc whoami --show-server 2>/dev/null || true)"
  # NOT ${check:+ --check}: `check` holds the STRING "false" when the flag is absent, which is non-empty,
  # so :+ would print "--check" on every run and mislabel a write run as read-only.
  if [[ "$check" == true ]]; then banner="ws rebuild-images --check"; fi
  echo "${banner} — do the running pods carry the current image?   (cluster: ${server:-?} as ${who:-?})"
  echo "   scope: ${scope:-every attendee + shared}${filter:+ · image ${filter}}"
  echo

  local build_rc=0
  if [[ "$check" == true ]]; then
    info "Read-only drift report (--check): no build, no restart."
    echo
  elif [[ "$no_build" == true ]]; then
    info "Skipping the build (--no-build) — comparing and rolling against the tags as they stand."
    echo
  else
    rebuild_start_builds "$filter" || build_rc=$?
  fi

  info "Consumers"
  local rows="${REBUILD_TMP}/rows"
  rebuild_scan "$scope" "$filter" > "$rows"
  local drift=0
  rebuild_print_table "$rows" || drift=$?

  if [[ "$check" == true ]]; then
    if [[ "$drift" -ne 0 ]]; then
      local hint_scope="--all"
      if [[ -n "$scope" ]]; then hint_scope="--user ${scope}"; fi
      echo "   roll them:  ws rebuild-images --no-build ${hint_scope}${filter:+ --image ${filter}}"
      rebuild_end; trap - EXIT
      return 1
    fi
    rebuild_end; trap - EXIT
    return 0
  fi

  # ── re-roll ONLY what is stale ──
  local kind ns name cname owner module src want running stale state
  local rolled=0 failed=0 skipped=0 seen=""
  while IFS=$'\t' read -r kind ns name cname owner module src want running stale state; do
    [[ "$state" == "stale" ]] || continue
    # One restart per WORKLOAD even when several of its containers are stale.
    case " ${seen} " in *" ${kind}/${ns}/${name} "*) continue ;; esac
    seen="${seen} ${kind}/${ns}/${name}"
    local rc=0
    rebuild_roll_one "$kind" "$ns" "$name" "$owner" "$module" || rc=$?
    case "$rc" in
      0) rolled=$((rolled + 1)) ;;
      2) skipped=$((skipped + 1)) ;;
      *) failed=$((failed + 1)) ;;
    esac
  done < "$rows"
  if [[ "$rolled" -eq 0 && "$failed" -eq 0 && "$skipped" -eq 0 ]]; then
    echo
    ok "Nothing was stale — no workload was restarted. (Idempotent: re-running this changes nothing.)"
    rebuild_end; trap - EXIT
    if [[ "$build_rc" -ne 0 ]]; then return 1; fi
    return 0
  fi

  # ── re-verify at the pod, the same way ──
  echo
  info "Re-verifying (pod digests again, after the rollouts)"
  : > "$REBUILD_DIGESTS"
  rebuild_scan "$scope" "$filter" > "${rows}.after"
  local after_drift=0
  rebuild_print_table "${rows}.after" || after_drift=$?

  echo "Summary: ${rolled} workload(s) rolled · ${skipped} needed no restart · ${failed} could not be rolled"
  rebuild_end; trap - EXIT
  if [[ "$after_drift" -ne 0 || "$failed" -ne 0 || "$build_rc" -ne 0 ]]; then
    err "some consumers are still off-digest — see the table above"
    return 1
  fi
  ok "every consumer in scope now runs its tag's current digest."
  return 0
}

cmd_doctor() {  # environment sanity. READ-ONLY. [--user U] narrows every COHORT-WIDE row to one attendee;
  # empty = the whole cohort (unchanged default). The platform rows (gitops operator, gitea, mirror,
  # workshop layer, build images, IdP, cohort size) are NOT scoped: when one attendee is broken, the
  # platform is the first thing that explains it, so hiding it would make the scoped report useless.
  # What --user removes is OTHER attendees' state — the entry Applications and running-image drift that
  # an SA debugging user3 has to read past today, on a full cohort ~8x more rows than the ones they want.
  local scope_user="${1:-}"
  need_oc
  # Reuse the ONE canonical identity check rather than write a second one. main() already applies it to
  # the --user FLAG VALUE, so `ws doctor --user 3` dies at the gate — this is the belt-and-braces for a
  # direct cmd_doctor call, worded exactly like cmd_status's. Task #12's phantom `entry-agentic-ai-1`
  # Application is what a bare number costs when a verb skips this.
  if [[ -n "$scope_user" ]]; then
    require_user_token "$scope_user" "doctor --user"
    # Say the scope in the FIRST line. A report that silently omits seven attendees looks exactly like
    # a report that found nothing wrong with them.
    echo "ws doctor — environment sanity   (scoped to ${scope_user}; whole cohort: ws doctor)"
  else
    echo "ws doctor — environment sanity"
  fi
  local fail=0
  printf "  %-28s" "cluster login"
  if oc whoami >/dev/null 2>&1; then ok "$(oc whoami) @ $(oc whoami --show-server)"; else err "not logged in"; fail=1; fi
  printf "  %-28s" "gitops operator"
  local csv
  csv="$(oc get csv -n openshift-gitops-operator -o jsonpath='{.items[?(@.spec.displayName=="Red Hat OpenShift GitOps")].status.phase}' 2>/dev/null || true)"
  if [[ "$csv" == *Succeeded* ]]; then ok "installed"; else err "not ready (${csv:-missing})"; fail=1; fi
  printf "  %-28s" "argo applications"
  # An entry-*-<user> app for a module whose ws-meta.yaml declares expectDegraded (an intentional-fault
  # seed, e.g. ai-assisted-development's broken 0/1 Deployment) is Degraded/OutOfSync BY DESIGN — ws
  # start/solve already know this (meta_expect_degraded, wait_materialized) and never fail on it. This
  # row used to red-flag the same app as unhealthy: a false ❌ on a module that is working exactly as
  # designed destroys attendee/SA trust in every OTHER ✅ (the repo's own rule). Split those out here
  # instead of counting them against the row; genuinely broken apps still fail it.
  #
  # The owner and module LABELS ride along in the same list call that finds the apps. They cost nothing
  # here (the API server is already serving these items) and they replace a per-app `oc get` that only
  # fired on unhealthy entry-* apps — the one round trip this row made per object.
  # "No apps found" is NOT the same answer as "checked N apps, all Healthy" — an Argo CD without the
  # Applications CRD (gitops operator not installed) also returns zero rows here, and `oc get` fails
  # silently into the 2>/dev/null. Verified live (CRC, no workshop installed, 2026-07-31): this row
  # printed "✅ all Healthy" while `applications.argoproj.io` did not exist on the cluster at all — the
  # same "recorded as absent" / "no record at all" conflation as the ogsr-uninstall.sh adoption bug.
  # Gate on the gitops-operator row already computed above so a genuinely-uninstalled Argo reads n/a.
  if [[ "$csv" != *Succeeded* ]]; then
    skip "n/a (gitops operator not installed)"
  else
    local bad="" expect_ok="" name health app_user module
    while IFS=$'\t' read -r name health app_user module; do
      [[ -n "$name" ]] || continue
      # --user scope: drop the OTHER attendees' apps, by LABEL rather than by name shape — the label is
      # what `ws status`/`ws diag` already key off, and an app named outside entry-<module>-<user> still
      # carries it. An app with NO user label is platform (pp-*, workshop-config) and is always kept.
      if [[ -n "$scope_user" && -n "$app_user" && "$app_user" != "$scope_user" ]]; then continue; fi
      [[ "$health" == "Healthy" ]] && continue
      # The `entry-*` guard is kept from the per-app read this replaced. Without it, ANY app carrying a
      # module label could be excused as "Degraded by design", which is a licence to hide a broken
      # platform app behind a module's intentional fault. Only entry states are allowed that excuse.
      if [[ "$name" == entry-* && -n "$module" && "$(meta_expect_degraded "$module")" == "true" ]]; then
        expect_ok="${expect_ok} ${name}=${health}"
      else
        bad="${bad} ${name}=${health}"
      fi
    done < <(oc get applications -n "$ARGO_NS" -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.health.status}{"\t"}{.metadata.labels.workshop\.redhat\.com/user}{"\t"}{.metadata.labels.workshop\.redhat\.com/module}{"\n"}{end}' 2>/dev/null)
    if [[ -z "${bad// }" ]]; then ok "all Healthy${scope_user:+ (platform + ${scope_user})}"; else err "unhealthy:${bad}"; fail=1; fi
    if [[ -n "${expect_ok// }" ]]; then
      printf "  %-28s" ""
      ok "(Degraded by design):${expect_ok}"
    fi
  fi
  printf "  %-28s" "gitea"
  local host
  host="$(oc get route gitea -n "$GITEA_NS" -o jsonpath='{.spec.host}' 2>/dev/null || true)"
  if [[ -n "$host" ]] && curl -ksf "https://${host}/api/v1/version" >/dev/null 2>&1; then ok "https://${host}"; else err "unreachable"; fail=1; fi
  printf "  %-28s" "mirror (${MIRROR_ORG}/${MIRROR_REPO})"
  if [[ -n "$host" ]] && curl -ksf "https://${host}/api/v1/repos/${MIRROR_ORG}/${MIRROR_REPO}" >/dev/null 2>&1; then ok "mirrored"; else err "missing — run: ws git-refresh"; fail=1; fi
  printf "  %-28s" "workshop layer"
  local wsh
  wsh="$(oc get application workshop-config -n "$ARGO_NS" -o jsonpath='{.status.health.status}' 2>/dev/null || true)"
  if [[ "$wsh" == "Healthy" ]]; then ok "workshop-config Healthy"; else err "workshop-config ${wsh:-absent} — run bootstrap/install.sh"; fail=1; fi
  printf "  %-28s" "showroom antora image"
  # The cockpit antora-build initContainers pull antora-ext:latest from the in-cluster registry; the
  # antora-ext BuildConfig (workshop-config) builds it. A missing tag = every cockpit ImagePullBackOff.
  if oc get bc antora-ext -n "$SHOWROOM_NS" >/dev/null 2>&1; then
    if oc get istag antora-ext:latest -n "$SHOWROOM_NS" >/dev/null 2>&1; then
      ok "antora-ext:latest built"
    else
      err "antora-ext:latest not built in ${SHOWROOM_NS} — cockpits Init:ImagePullBackOff until it is; watch: oc logs -f bc/antora-ext -n ${SHOWROOM_NS} · kick idle cockpits: oc rollout restart deploy -n ${SHOWROOM_NS}"; fail=1
    fi
  elif ! oc auth can-i get buildconfigs -n "$SHOWROOM_NS" >/dev/null 2>&1; then
    skip "not checked (needs access to ${SHOWROOM_NS})"
  else
    ok "n/a (showroom build not deployed)"
  fi
  printf "  %-28s" "parasol images"
  # Many entry states pull parasol-claims/parasol-web:1.0|1.1, parasol-fraud:1.0, and the four
  # agentic/MCP images (parasol-agent, mcp-agent-cli, claims-db, policy-docs at 1.0) from
  # PARASOL_IMAGES_NS without building them; the BuildConfigs (workshop-config) build+tag them.
  # A missing istag = that entry state's Deployment ImagePullBackOff the moment someone `ws start`s it.
  # Keep this SET in lockstep with parasol-images-build.yaml's `range` (its header says so explicitly).
  if oc get bc parasol-claims -n "$PARASOL_IMAGES_NS" >/dev/null 2>&1; then
    local missing_tags="" app tag
    for app in parasol-claims parasol-web; do
      for tag in 1.0 1.1; do
        oc get istag "${app}:${tag}" -n "$PARASOL_IMAGES_NS" >/dev/null 2>&1 \
          || missing_tags="${missing_tags} ${app}:${tag}"
      done
    done
    # Single-1.0 apps: parasol-fraud (securing-apps-keycloak/service-mesh-advanced-gateways), the
    # four agentic/MCP images agentic-ai + ai-assisted-development pull by full in-cluster spec, and
    # parasol-notifications (build-deliver's solve end state).
    for app in parasol-fraud parasol-notifications parasol-agent mcp-agent-cli claims-db policy-docs; do
      oc get istag "${app}:1.0" -n "$PARASOL_IMAGES_NS" >/dev/null 2>&1 \
        || missing_tags="${missing_tags} ${app}:1.0"
    done
    if [[ -z "$missing_tags" ]]; then
      ok "parasol-claims/parasol-web 1.0+1.1 + fraud/notifications/agent/mcp-agent-cli/claims-db/policy-docs 1.0 built"
    else
      err "missing:${missing_tags} in ${PARASOL_IMAGES_NS} — watch: oc logs -f bc/parasol-claims -n ${PARASOL_IMAGES_NS} (or bc/<app> for the named app)"; fail=1
    fi
  elif ! oc auth can-i get buildconfigs -n "$PARASOL_IMAGES_NS" >/dev/null 2>&1; then
    skip "not checked (needs access to ${PARASOL_IMAGES_NS})"
  else
    ok "n/a (parasol-images build not deployed)"
  fi
  printf "  %-28s" "running image drift"
  # The row above answers "does the tag exist". This one answers the question that actually bites:
  # is the pod ON it? A rebuilt tag reaches nothing until the workloads consuming it are rolled, and
  # imagePullPolicy: Always only decides what a restart PULLS, never whether one happens. So the
  # workload's spec cannot answer it either — it reads parasol-claims:1.1 before and after a rebuild.
  # Only the digest each RUNNING pod reports can, which is what `ws rebuild-images` compares. This is
  # its read-only core, the four-call contract 6138e8c left ready: begin, scan, summarize, end. None
  # of the build or restart path is reachable from here.
  #
  # ALWAYS ON, not behind a flag, for two reasons that pull the same way. A gate nobody runs is worse
  # than no gate (this repo's own rule) — and the live proof is that user1-cicd/parasol-claims sat
  # stale on ksls5 until someone ran --check by hand. And the cost lands on the identity that can act
  # on it: the scan needs a CLUSTER-WIDE workload list, so an attendee pays one `oc auth can-i` and
  # skips, while an SA pays ~1s per materialized consumer (24s / 11 consumers, ksls5 2026-07-29 —
  # doctor's own fixed ~25 reads already cost 22s, and `ws status` costs 40s, so it stays in band).
  #
  # The can-i is not politeness, it is the difference between a verdict and a guess: every read in
  # the scan is swallowed by `2>/dev/null || true`, so an attendee running it ungated gets zero rows
  # and a clean-looking "no consumers" produced by having looked at nothing.
  if ! oc auth can-i list deployments --all-namespaces >/dev/null 2>&1; then
    skip "not checked (needs cluster-wide read — ask your instructor for: ws rebuild-images --check)"
  else
    local drift_rows d_total d_stale d_bad d_names d_what d_fix
    rebuild_begin
    trap 'rebuild_end' EXIT
    drift_rows="${REBUILD_TMP}/doctor-rows"
    # rebuild_scan's first argument IS the user scope, and it filters on the WORKLOAD's namespace owner
    # (--user user2 means what user2 runs, not what user2's images are called) — exactly the scoping this
    # row needs, already written and already covered by the rebuild fixture gate. Passing it also makes
    # the scoped run cheaper: the scan costs ~1s per materialized consumer, so one attendee's slice of a
    # full cohort is where most of `ws doctor --user`'s wall clock comes back.
    rebuild_scan "$scope_user" "" > "$drift_rows" || true
    IFS=$'\t' read -r d_total d_stale d_bad d_names < <(rebuild_row_summary "$drift_rows")
    rebuild_end; trap - EXIT
    if [[ "${d_total:-0}" -eq 0 ]]; then
      ok "n/a (nothing running consumes a workshop-built image yet)"
    elif [[ "$d_stale" -eq 0 && "$d_bad" -eq 0 ]]; then
      ok "${d_total} consumer(s) — every running pod is on its tag's current digest"
    else
      # Same wording as rebuild_print_table's own verdict, so the row and the full report read as one
      # finding. The two hints are NOT interchangeable and must not be merged: rolling a workload
      # whose tag is missing replaces a working pod with an ImagePullBackOff, so a no-tag row is a
      # BUILD problem and says so.
      d_what=""; d_fix=""
      if [[ "$d_stale" -gt 0 ]]; then
        d_what="${d_stale} of ${d_total} run a digest OLDER than their tag"
        # The hint has to name the SCOPE that was actually measured. Telling an SA who scoped to user3
        # to roll `--all` proposes rolling seven attendees they never looked at.
        d_fix=" · roll them: ws rebuild-images --no-build ${scope_user:+--user ${scope_user}}${scope_user:---all}"
      fi
      if [[ "$d_bad" -gt 0 ]]; then
        d_what="${d_what}${d_what:+; }${d_bad} reference a tag that does not exist"
        d_fix="${d_fix} · build the missing tag(s) first — rolling them only trades a working pod for an ImagePullBackOff"
      fi
      err "${d_what}: ${d_names} — detail: ws rebuild-images --check${d_fix}"; fail=1
    fi
  fi
  printf "  %-28s" "workshop IdP"
  if ! oc auth can-i get oauths.config.openshift.io >/dev/null 2>&1; then
    skip "not checked (needs cluster-admin; you logged in, so it works)"
  elif oc get oauth cluster -o jsonpath='{.spec.identityProviders[*].name}' 2>/dev/null | grep -qw workshop-users; then
    ok "workshop-users present"
  else
    err "IdP missing — bootstrap adds it"; fail=1
  fi
  printf "  %-28s" "user namespaces"
  # Whole-cohort scope keeps probing user1-dev: it is the canary for "workshop-config rendered the
  # per-user namespaces at all". In --user scope the useful question is about THAT attendee, and this
  # row is also where `ws doctor --user user9` on an 8-user cohort tells you user9 was never
  # provisioned — so the fix hint splits: a missing user1-dev is an unsynced platform, a missing
  # userN-dev on a synced platform is a cohort-size problem.
  local ns_probe="${scope_user:-user1}-dev"
  if oc get ns "$ns_probe" >/dev/null 2>&1; then
    ok "${ns_probe} exists"
  elif [[ -n "$scope_user" ]]; then
    err "${ns_probe} missing — is ${scope_user} provisioned? check the cohort: ws status (grow it: ws scale-users N)"; fail=1
  else
    err "missing — workshop-config not synced"; fail=1
  fi
  printf "  %-28s" "workshop cohort size"
  # Honest after a `ws scale-users`: cross-check the LIVE helm parameter against the group it should
  # have converged to. A mismatch usually means a scale is still mid-sync — re-run shortly.
  if ! oc auth can-i get groups.user.openshift.io >/dev/null 2>&1; then
    skip "not checked (needs cluster-admin to read the attendee group)"
  elif ! oc get application workshop-config -n "$ARGO_NS" >/dev/null 2>&1; then
    ok "n/a (workshop layer not installed)"
  else
    local n_live n_group
    n_live="$(live_user_count || true)"
    n_group="$(oc get group workshop-attendees -o jsonpath='{.users[*]}' 2>/dev/null | wc -w | xargs || true)"
    if [[ -n "$n_live" && "$n_live" == "$n_group" ]]; then
      ok "${n_live} user(s) (live userCount + group agree)"
    else
      err "live userCount=${n_live:-?} but workshop-attendees group has ${n_group:-?} — scale still converging? re-run shortly, or: ws status"; fail=1
    fi
  fi
  echo
  if (( fail == 0 )); then ok "environment looks good"; else err "issues found — fix hints above"; exit 1; fi
}

# ── SA/admin cohort operations (ws passwd, ws cohort-reset) ────────────────────────────────────────
# These are cluster-admin recipes an SA runs from the platform kubeconfig, NOT attendee self-service.
# They act on the WORKSHOP LAYER only (per-user creds + per-user module state) and never touch the
# platform portfolio (pp-* stacks, operators, gitea/images/tasks/showroom infra, namespace shells).

workshop_users() {  # → space-separated attendee usernames from the AUTHORITATIVE group; die if none.
  # The workshop-attendees group is what bootstrap populates (user1..userN); it is the source of truth
  # for "who is an attendee", ahead of any repo default — cohort size can differ from values.yaml.
  local u
  u="$(oc get group workshop-attendees -o jsonpath='{.users[*]}' 2>/dev/null || true)"
  [[ -n "$u" ]] || die "cannot enumerate the workshop-attendees group — is the workshop layer installed? (ws doctor)"
  echo "$u"
}

repo_user_count() {  # → workshop-config's INTENDED userCount (repo default), or empty. Soft cross-check
  # only: the live group wins, but a mismatch is a useful "bootstrap ran with a different --users" signal.
  awk '$1=="userCount:"{print $2; exit}' "${REPO_ROOT}/gitops/workshop-config/values.yaml" 2>/dev/null
}

live_user_count() {  # → workshop-config Application's LIVE userCount helm parameter, or empty if
  # absent/unreadable (pre-install, or oc unreachable). This is what Argo will ACTUALLY render on the
  # next sync — the authoritative "target" cohort size. `ws scale-users` is the only thing that moves
  # this value; it never touches the repo's values.yaml default (repo_user_count), so that default goes
  # stale the moment a cluster is ever scaled — callers that need a LIVE, honest count use this instead.
  oc get application workshop-config -n "$ARGO_NS" \
    -o jsonpath='{.spec.source.helm.parameters[?(@.name=="userCount")].value}' 2>/dev/null || true
}

cmd_passwd() {  # SA/admin: rotate the shared workshop login password. Whole-cohort by default; --user U
  # rotates ONLY that user's OpenShift console/CLI (OAuth) login. Grounded mechanism (2026-07-17): the
  # shared password lives in the htpasswd-workshop-users secret (openshift-config, key 'htpasswd', bcrypt)
  # that the 'workshop-users' OAuth IdP already references, AND the gitea workshop-user-creds secret (key
  # 'password', used for Gitea seeding + student-Argo login). We rewrite the secrets with the SAME
  # idempotent create|apply pattern bootstrap uses and leave the IdP wiring intact (bootstrap owns it).
  # The workshop password is NON-SECRET by policy, so we print the new value once — NEVER the bcrypt hash.
  local target_user="" newpass="" generated="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --user)
        [[ $# -ge 2 ]] || die "passwd: --user needs a value (e.g. user3)"
        require_user_token "$2" "passwd --user"
        target_user="$2"; shift 2 ;;
      -*) die "passwd: unknown option '$1' — usage: ws passwd [--user userN] [NEWPASS]" ;;
      *)
        if [[ -z "$newpass" ]]; then newpass="$1"; shift
        else die "passwd: unexpected extra argument '$1' — usage: ws passwd [--user userN] [NEWPASS]"; fi ;;
    esac
  done
  need_oc
  command -v htpasswd >/dev/null || die "htpasswd not found — install httpd-tools (brew install httpd / dnf install httpd-tools)"
  command -v openssl  >/dev/null || die "openssl not found — needed to generate/handle passwords"

  local users_str users_arr
  users_str="$(workshop_users)"
  read -ra users_arr <<< "$users_str"

  # Validate --user against the authoritative group before mutating anything.
  if [[ -n "$target_user" ]]; then
    local found="false" gu
    for gu in "${users_arr[@]}"; do [[ "$gu" == "$target_user" ]] && found="true"; done
    [[ "$found" == "true" ]] || die "passwd: ${target_user} is not in the workshop-attendees group (${users_str})"
  fi

  # Soft cross-check group size vs workshop-config's LIVE userCount helm parameter (the authoritative
  # "what Argo will render" value — the repo's values.yaml default goes stale the moment anyone runs
  # `ws scale-users`, which never touches that file). Falls back to the repo default only if the
  # Application itself can't be read. The live GROUP remains what actually governs this command below.
  local want_n; want_n="$(live_user_count || true)"
  [[ -n "$want_n" ]] || want_n="$(repo_user_count || true)"
  [[ -n "$want_n" && "$want_n" != "${#users_arr[@]}" ]] \
    && info "note: group has ${#users_arr[@]} user(s) but workshop-config's userCount=${want_n} (group wins) — see: ws status"

  # Resolve the new password (generate a strong random one, bootstrap-style, when none was given). The
  # tr/cut pipeline yields up-to-16 JSON-safe alnum chars — identical to bootstrap's generator.
  if [[ -z "$newpass" ]]; then
    newpass="$(openssl rand -base64 12 | tr -dc 'A-Za-z0-9' | cut -c1-16)"
    [[ -n "$newpass" ]] || die "failed to generate a random password (openssl)"
    generated="true"
  fi

  # Build the bcrypt htpasswd file. Whole-cohort: regenerate every user's line with the new password.
  # --user: preserve every OTHER user's EXISTING line verbatim (no plaintext needed) and re-issue ONLY
  # the target's — so a single-user rotate never disturbs the rest of the cohort's console logins.
  local htp; htp="$(mktemp)"; trap 'rm -f "$htp"' EXIT
  if [[ -z "$target_user" ]]; then
    info "rotating the shared workshop password for all ${#users_arr[@]} user(s)…"
    htpasswd -B -b -c "$htp" "${users_arr[0]}" "$newpass" >/dev/null 2>&1 || die "htpasswd failed for ${users_arr[0]}"
    local u
    for u in "${users_arr[@]:1}"; do
      htpasswd -B -b "$htp" "$u" "$newpass" >/dev/null 2>&1 || die "htpasswd failed for $u"
    done
  else
    info "rotating ONLY ${target_user}'s console login (preserving the other users' entries)…"
    local cur line
    cur="$(oc get secret htpasswd-workshop-users -n openshift-config -o jsonpath='{.data.htpasswd}' 2>/dev/null | base64 -d || true)"
    [[ -n "$cur" ]] || die "htpasswd-workshop-users secret not found/empty in openshift-config — run bootstrap first"
    : > "$htp"
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      [[ "$line" == "${target_user}:"* ]] && continue
      printf '%s\n' "$line" >> "$htp"
    done <<< "$cur"
    htpasswd -B -b "$htp" "$target_user" "$newpass" >/dev/null 2>&1 || die "htpasswd failed for $target_user"
  fi

  # Replace the secrets (idempotent create|apply — the exact bootstrap pattern). The OAuth IdP already
  # references htpasswd-workshop-users, so it is deliberately NOT re-patched. Gitea's shared password is
  # updated ONLY on a whole-cohort rotate: a single-user console change must not move the cohort-shared
  # Gitea/student-Argo secret (which has one value for everyone).
  oc create secret generic htpasswd-workshop-users \
    --from-file=htpasswd="$htp" -n openshift-config \
    --dry-run=client -o yaml | oc apply -f - >/dev/null
  ok "htpasswd-workshop-users (openshift-config) updated"
  if [[ -z "$target_user" ]]; then
    oc create secret generic workshop-user-creds \
      --from-literal=password="$newpass" -n "${GITEA_NS}" \
      --dry-run=client -o yaml | oc apply -f - >/dev/null
    ok "workshop-user-creds (ogsr-gitea/password) updated"
  fi

  # Verify wiring (never print hashes): every user present in the secret + the IdP still points at it.
  # We CANNOT test the console login itself — the OAuth browser flow is not scriptable — so this checks
  # the secret contents + IdP reference only, which is what actually gates a successful attendee login.
  echo
  info "verifying…"
  local dec missing="" present=0 vu passwd_verify_bad=0
  dec="$(oc get secret htpasswd-workshop-users -n openshift-config -o jsonpath='{.data.htpasswd}' 2>/dev/null | base64 -d || true)"
  for vu in "${users_arr[@]}"; do
    if grep -q "^${vu}:" <<< "$dec"; then present=$((present+1)); else missing="${missing} ${vu}"; fi
  done
  if [[ -z "$missing" ]]; then ok "htpasswd secret carries all ${present}/${#users_arr[@]} users"; else err "htpasswd secret MISSING:${missing}"; passwd_verify_bad=1; fi
  if oc get oauth cluster -o jsonpath='{.spec.identityProviders[*].name}' 2>/dev/null | grep -qw workshop-users; then
    ok "OAuth IdP 'workshop-users' still wired to the secret"
  else
    err "OAuth IdP 'workshop-users' NOT present — attendees cannot log in (bootstrap adds it)"; passwd_verify_bad=1
  fi

  # Report: surface the oauth-pod roll delay, the verification caveat, and the new (non-secret) password.
  # The banner must not claim more than the checks above proved (the class of bug 'ws solve' had: a
  # success message printing after a step it never confirmed) — a missing user or a detached IdP means
  # some attendees CANNOT log in with this password, so say that instead of "rotated."
  echo
  if [[ "$passwd_verify_bad" == 0 ]]; then
    ok "workshop login password rotated."
  else
    err "password written, but verification above found a problem — do NOT assume every attendee can log in."
  fi
  info "the oauth-openshift pods roll (~1 min) before the new password takes effect (the console login"
  echo "   itself is not scriptable, so only the secret + IdP wiring are verified above)."
  echo "   watch the roll: oc rollout status deploy/oauth-openshift -n openshift-authentication"
  if [[ -n "$target_user" ]]; then
    echo
    info "scope: ONLY ${target_user}'s OpenShift console/CLI (OAuth) login changed."
    echo "   The shared Gitea/student-Argo password (ogsr-gitea/workshop-user-creds) is UNCHANGED — ${target_user}"
    echo "   still uses the shared password there. For a full cohort rotation, run: ws passwd [NEWPASS]"
  fi
  echo
  echo "   new password: ${newpass}"
  [[ "$generated" == "true" ]] && echo "   (randomly generated — record it; the shared workshop password is non-secret by policy)"
  # Clean up + DISARM the EXIT trap: local $htp is out of scope by the time an EXIT trap fires at process
  # exit, so leaving it armed tripped `set -u` ("htp: unbound variable") → ws passwd returned rc 1 on
  # success. die() paths still fire the trap in-scope; this covers the normal return.
  rm -f "$htp"; trap - EXIT
  [[ "$passwd_verify_bad" == 0 ]] || return 1
}

delete_app_with_finalizer() {  # app — delete an entry Argo app in ARGO_NS, stripping a stuck finalizer as
  # a fallback (the same dance as cmd_reset). Safe when the app is already gone. Returns non-zero ONLY if
  # the app is still wedged after the strip, so the caller can flag it without aborting the whole sweep.
  local app="$1" t=0
  oc get application "$app" -n "$ARGO_NS" >/dev/null 2>&1 || return 0
  info "  deleting entry app ${app}…"
  if ! oc delete application "$app" -n "$ARGO_NS" --wait=true --timeout=120s >/dev/null 2>&1; then
    info "  finalizer still settling on ${app} — namespaces already purged, removing it…"
    oc patch application "$app" -n "$ARGO_NS" --type=json \
      -p '[{"op":"remove","path":"/metadata/finalizers"}]' >/dev/null 2>&1 || true
    while oc get application "$app" -n "$ARGO_NS" >/dev/null 2>&1; do
      (( t >= 60 )) && { err "  entry app ${app} stuck deleting — inspect: oc get application ${app} -n ${ARGO_NS} -o yaml"; return 1; }
      sleep 3; t=$((t+3))
    done
  fi
  return 0
}

cohort_purge_student_apps() {  # user — delete ALL the user's apps/appsets in the student-gitops control
  # plane (project proj-<user>), ApplicationSets FIRST (they regenerate deleted apps). cohort-reset is a
  # cluster-admin op, so this uses the direct k8s path (no student-Argo token needed). No-op when
  # student-gitops is absent (pre-M09 clusters) or the user owns nothing there. Mirrors purge_apps' admin
  # path but sweeps the WHOLE per-user project rather than one module's apps.
  local user="$1" name
  local proj="proj-${user}"
  oc get ns "$STUDENT_ARGO_NS" >/dev/null 2>&1 || return 0
  for name in $(oc get applicationsets.argoproj.io -n "$STUDENT_ARGO_NS" \
      -o jsonpath="{range .items[?(@.spec.template.spec.project==\"${proj}\")]}{.metadata.name}{\"\n\"}{end}" 2>/dev/null); do
    info "  deleting attendee ApplicationSet ${name} (project ${proj})…"
    oc delete applicationset "$name" -n "$STUDENT_ARGO_NS" --wait=true --timeout=120s >/dev/null 2>&1 || true
  done
  for name in $(oc get applications.argoproj.io -n "$STUDENT_ARGO_NS" \
      -o jsonpath="{range .items[?(@.spec.project==\"${proj}\")]}{.metadata.name}{\"\n\"}{end}" 2>/dev/null); do
    info "  deleting attendee Argo app ${name} (project ${proj})…"
    oc delete application "$name" -n "$STUDENT_ARGO_NS" --wait=true --timeout=120s >/dev/null 2>&1 \
      || oc patch application "$name" -n "$STUDENT_ARGO_NS" --type merge -p '{"metadata":{"finalizers":null}}' >/dev/null 2>&1 || true
  done
}

user_namespaces() {  # user → newline-separated namespace names carrying workshop.redhat.com/user=<user>
  # Label discovery, NOT a hardcoded suffix list: the per-user world has grown module-scoped extras
  # (ai/batch/gitops/mesh/modernize/partner + resilience's client/site-a/site-b — 13 namespaces total
  # as of Gen-4, up from the original dev/stage/prod/cicd-only 4) since cohort-reset's suffix list was
  # first written. Every per-user Namespace template carries this label
  # (gitops/workshop-config/templates/per-user-*.yaml). cmd_scale_users' shrink path pioneered this
  # idiom; cmd_cohort_reset shares it here rather than keeping its own stale 4-ns list in sync by hand.
  oc get ns -l "workshop.redhat.com/user=${1}" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null
}

cmd_cohort_reset() {  # SA/admin: wipe ALL per-user module state for a FRESH cohort, KEEPING the platform.
  # "Prune namespaces only and leave the components" — reset every attendee's world to pristine so a new
  # group starts clean, WITHOUT uninstalling any operator/stack. Per user, in this order: (1) delete the
  # attendee-created Argo apps in student-gitops (stops selfHeal), (2) purge EVERY per-user namespace's
  # CONTENTS via purge_ns (label-discovered — user_namespaces — keeps each namespace shell + its
  # workshop-owned RBAC/quota/LimitRange), (3) delete the entry-*-<user> apps LAST so the
  # resources-finalizer never deadlocks on a PVC still pinned by an attendee pod (cmd_reset's SEV1
  # ordering). Idempotent + safe to re-run.
  local yes="false" do_restart="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y)                      yes="true"; shift;;
      --restart-terminals|--restart) do_restart="true"; shift;;
      -*) die "cohort-reset: unknown option '$1' — usage: ws cohort-reset [--yes] [--restart-terminals]";;
      *)  die "cohort-reset: unexpected argument '$1' — this is a whole-cohort op (no module/user)";;
    esac
  done
  need_oc

  local users_str users_arr
  users_str="$(workshop_users)"
  read -ra users_arr <<< "$users_str"
  local n="${#users_arr[@]}"

  # Plan first — say exactly what is wiped and what is preserved BEFORE touching anything.
  echo "ws cohort-reset — wipe ALL per-user state for a fresh cohort (platform preserved)"
  echo
  echo "WILL WIPE, for each of ${n} user(s) [${users_arr[*]}]:"
  echo "  • entry-*-<user> Argo apps in ${ARGO_NS} (module state; finalizers handled)"
  echo "  • attendee-created Argo apps/appsets in ${STUDENT_ARGO_NS} (project proj-<user>, if present)"
  echo "  • CONTENTS of every <user>-* namespace (label-discovered via workshop.redhat.com/user=<user>,"
  echo "    currently 13: dev/stage/prod/cicd + ai/batch/gitops/mesh/modernize/partner + resilience's"
  echo "    client/site-a/site-b): workloads, PVCs, user secrets/configmaps, lab CRs"
  echo
  echo "WILL PRESERVE (untouched):"
  echo "  • platform-portfolio stacks (pp-*), operators, workshop-config"
  echo "  • ogsr-gitea, ogsr-parasol-images, ogsr-parasol-tasks, ogsr-showroom infra"
  echo "  • the per-user namespace SHELLS + their workshop-owned RBAC / quota / LimitRange"
  if [[ "$do_restart" == "true" ]]; then
    echo "  • per-user cockpits — RESTARTED at the end (--restart-terminals)"
  else
    echo "  • per-user cockpits (left running; add --restart-terminals to cycle them for the new cohort)"
  fi
  echo

  # Destructive → require an explicit yes (mirror cmd_prep's TTY/--yes guard exactly).
  if [[ "$yes" != "true" ]]; then
    if [[ -t 0 ]]; then
      local reply
      read -r -p "Wipe all per-user state for ${n} user(s) now? [y/N] " reply
      [[ "$reply" =~ ^[Yy]([Ee][Ss])?$ ]] || { info "nothing changed. Re-run when ready (or use --yes)."; return 0; }
    else
      die "not a terminal and no --yes given — re-run: ws cohort-reset --yes"
    fi
  fi

  local u ns app wedged=0
  for u in "${users_arr[@]}"; do
    echo
    info "── ${u} ──"
    # 1. Attendee-created Argo apps FIRST — a selfHeal app would otherwise re-deploy its workloads into a
    #    namespace we are about to purge and orphan them (cmd_reset's load-bearing ordering).
    cohort_purge_student_apps "$u"
    # 2. Purge every per-user namespace's CONTENTS (user_namespaces — label discovery, not a hardcoded
    #    suffix list; matches cmd_scale_users' shrink path). purge_ns keeps the ns shell + RBAC/quota/
    #    LimitRange; with no keep-module every stale ws-entry-* marker is cleared too. No-op on a
    #    missing namespace.
    for ns in $(user_namespaces "$u"); do
      purge_ns "$ns"
    done
    # 3. Delete the entry apps LAST (namespaces already emptied → the resources-finalizer completes fast).
    #    Select by the per-user label, then guard on the entry- name so platform/workshop apps are never
    #    touched even if something else were ever labelled with this user.
    for app in $(oc get applications -n "$ARGO_NS" -l "workshop.redhat.com/user=${u}" -o name 2>/dev/null); do
      app="${app##*/}"
      case "$app" in
        entry-*) delete_app_with_finalizer "$app" || wedged=1 ;;
        *) : ;;
      esac
    done
  done

  echo
  if (( wedged == 0 )); then
    ok "cohort-reset complete — ${n} user(s) wiped to pristine; platform intact."
  else
    err "cohort-reset finished, but one or more entry apps were wedged (see above) — re-run cohort-reset or inspect manually."
  fi
  echo "   verify: oc get applications -n ${ARGO_NS} | grep entry-   (expect none)"
  echo "           oc get all -n ${users_arr[0]}-dev                 (expect empty)"
  echo "   next  : a subsequent 'ws prep <module> <user>' from a cockpit re-materializes any module cleanly."

  if [[ "$do_restart" == "true" ]]; then
    echo
    info "restarting cockpits so the new cohort gets fresh pods…"
    restart_terminals "" true
  fi
  (( wedged == 0 )) || return 1
}

# ── ws scale-users — grow/shrink the workshop cohort ───────────────────────────────────────────────
_gitea_admin_creds() {  # → "host admin-user admin-pass" via oc/the Gitea CR, or empty on failure. Same
  # discovery idiom as force_mirror_sync and the gitea-user-seed hook's own Job script.
  local host user pass
  host="$(oc get route gitea -n "${GITEA_NS}" -o jsonpath='{.spec.host}' 2>/dev/null || true)"
  [[ -n "$host" ]] || return 1
  user="$(oc get gitea gitea -n "${GITEA_NS}" -o jsonpath='{.spec.giteaAdminUser}' 2>/dev/null || echo gitea-admin)"
  pass="$(oc get gitea gitea -n "${GITEA_NS}" -o jsonpath='{.status.adminPassword}' 2>/dev/null || true)"
  [[ -z "$pass" ]] && pass="$(oc get secret gitea-admin-credentials -n "${GITEA_NS}" -o jsonpath='{.data.password}' 2>/dev/null | base64 -d || true)"
  [[ -n "$host" && -n "$pass" ]] || return 1
  echo "${host} ${user} ${pass}"
}

regen_htpasswd() {  # target_n → rebuild htpasswd-workshop-users to cover EXACTLY user1..user<target_n>.
  # Existing users keep their CURRENT bcrypt line VERBATIM — no rotation; `ws passwd` is the only verb
  # that changes the password. A user newly IN range (grow) gets a fresh line with the CURRENT shared
  # password (_shared_password, read from the gitea secret — never a newly generated one). A user no
  # longer in range (shrink) is simply not written back out. One routine serves both directions, the
  # same idiomatic mktemp+trap+htpasswd -b build cmd_passwd uses.
  local target_n="$1" htp cur pass i u line
  htp="$(mktemp)"; trap 'rm -f "$htp"' EXIT
  cur="$(oc get secret htpasswd-workshop-users -n openshift-config -o jsonpath='{.data.htpasswd}' 2>/dev/null | base64 -d || true)"
  [[ -n "$cur" ]] || die "htpasswd-workshop-users secret not found/empty in openshift-config — run bootstrap first"
  pass="$(_shared_password)"
  [[ -n "$pass" ]] || die "could not read the shared workshop password (ogsr-gitea/workshop-user-creds) — run bootstrap first"
  : > "$htp"
  for (( i = 1; i <= target_n; i++ )); do
    u="user${i}"
    line="$(grep "^${u}:" <<< "$cur" || true)"
    if [[ -n "$line" ]]; then
      printf '%s\n' "$line" >> "$htp"
    else
      htpasswd -B -b "$htp" "$u" "$pass" >/dev/null 2>&1 || die "htpasswd failed for ${u}"
    fi
  done
  oc create secret generic htpasswd-workshop-users \
    --from-file=htpasswd="$htp" -n openshift-config \
    --dry-run=client -o yaml | oc apply -f - >/dev/null
  rm -f "$htp"; trap - EXIT
}

wait_gitea_seed() {  # target_n [timeout] → confirm Gitea has an account for user<target_n>. The
  # gitea-user-seed Sync hook (chart wave 2) is what actually creates it; this just gives scale-users a
  # specific, visible proof point instead of trusting Argo Health alone. Best-effort: an unreachable
  # Gitea admin API degrades to a non-fatal note rather than failing the whole command.
  local target_n="$1" timeout="${2:-180}" t=0 creds host user pass code want
  want="user${target_n}"
  info "confirming Gitea has an account for ${want} (gitea-user-seed hook)…"
  creds="$(_gitea_admin_creds || true)"
  if [[ -z "$creds" ]]; then
    info "could not reach the Gitea admin API to confirm — check: oc logs -n ${GITEA_NS} job/gitea-user-seed"
    return 0
  fi
  read -r host user pass <<< "$creds"
  while (( t < timeout )); do
    code="$(curl -ks -o /dev/null -w '%{http_code}' -u "${user}:${pass}" "https://${host}/api/v1/users/${want}" 2>/dev/null || true)"
    [[ "$code" == "200" ]] && { ok "Gitea account ${want} confirmed (HTTP 200)"; return 0; }
    sleep 5; t=$((t+5))
  done
  err "Gitea account ${want} not confirmed after ${timeout}s (last HTTP ${code:-?}) — check: oc logs -n ${GITEA_NS} job/gitea-user-seed"
  return 1
}

confirm_cockpit() {  # user grow|shrink [timeout] → confirm the cockpit matches the new count's
  # expectation: Running (grow) or gone (shrink). Best-effort visibility layered on top of wait_healthy
  # — a Deployment can read Argo-Healthy slightly before kubelet actually reports readyReplicas.
  local user="$1" direction="$2" timeout="${3:-300}" t=0 ready desired
  if [[ "$direction" == "grow" ]]; then
    info "confirming ${user}'s cockpit (showroom-${user}) comes up Running…"
    while (( t < timeout )); do
      if oc get deploy "showroom-${user}" -n "$SHOWROOM_NS" >/dev/null 2>&1; then
        ready="$(oc get deploy "showroom-${user}" -n "$SHOWROOM_NS" -o jsonpath='{.status.readyReplicas}' 2>/dev/null || true)"
        desired="$(oc get deploy "showroom-${user}" -n "$SHOWROOM_NS" -o jsonpath='{.spec.replicas}' 2>/dev/null || true)"
        [[ "${ready:-0}" -ge 1 && "$ready" == "${desired:-1}" ]] && { ok "cockpit showroom-${user} Running (${ready}/${desired})"; return 0; }
      fi
      sleep 10; t=$((t+10))
    done
    err "cockpit showroom-${user} not Running after ${timeout}s — inspect: oc get pods -n ${SHOWROOM_NS} -l workshop.redhat.com/user=${user}"
    return 1
  else
    info "confirming ${user}'s cockpit (showroom-${user}) is gone…"
    while (( t < timeout )); do
      oc get deploy "showroom-${user}" -n "$SHOWROOM_NS" >/dev/null 2>&1 || { ok "cockpit showroom-${user} removed"; return 0; }
      sleep 10; t=$((t+10))
    done
    err "cockpit showroom-${user} still present after ${timeout}s — inspect: oc get deploy showroom-${user} -n ${SHOWROOM_NS}"
    return 1
  fi
}

cmd_scale_users() {  # SA/admin: grow or shrink the workshop cohort. ws scale-users N [--yes]
  # Mechanism: patch workshop-config's userCount helm parameter (a scalar JSON-patch replace — leaves
  # clusterDomain/sso.enabled/consolePlugins.enabled untouched) → hard refresh → sync → wait Healthy →
  # regenerate htpasswd → confirm the gitea-user-seed hook + cockpits for the new count. SHRINK
  # additionally cleans the removed users' world FIRST, in cohort-reset's exact SEV1 order (student-
  # gitops apps → namespace CONTENTS purge → entry-*-<user> apps deleted) — all BEFORE the userCount
  # patch, so the sync's namespace prune never races a still-tracked entry Application or an attendee-
  # pinned PVC. Namespaces come from the shared user_namespaces() helper (label discovery via
  # workshop.redhat.com/user=<u>) — cmd_cohort_reset uses the same helper, so the two SA-destructive
  # paths can't drift out of sync with the chart's per-user namespace fan-out again.
  local target="" yes="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes|-y) yes="true"; shift;;
      -*) die "scale-users: unknown option '$1' — usage: ws scale-users N [--yes]";;
      *)
        if [[ -z "$target" ]]; then target="$1"; shift
        else die "scale-users: unexpected extra argument '$1' — usage: ws scale-users N [--yes]"; fi ;;
    esac
  done
  [[ -n "$target" ]] || die "scale-users: N required — usage: ws scale-users N [--yes]"
  [[ "$target" =~ ^[0-9]+$ && "$target" -ge 1 ]] || die "scale-users: N must be a positive integer, got '${target}'"
  need_oc
  command -v htpasswd >/dev/null || die "htpasswd not found — install httpd-tools (brew install httpd / dnf install httpd-tools)"

  oc get application workshop-config -n "$ARGO_NS" >/dev/null 2>&1 \
    || die "workshop-config Application not found in ${ARGO_NS} — is the workshop layer installed? (ws doctor)"
  local current
  current="$(oc get application workshop-config -n "$ARGO_NS" \
    -o jsonpath='{.spec.source.helm.parameters[?(@.name=="userCount")].value}' 2>/dev/null || true)"
  [[ "$current" =~ ^[0-9]+$ ]] \
    || die "could not read workshop-config's userCount helm parameter (got '${current}') — inspect: oc get application workshop-config -n ${ARGO_NS} -o yaml"

  local users_str users_arr
  users_str="$(workshop_users)"
  read -ra users_arr <<< "$users_str"
  [[ "${#users_arr[@]}" != "$current" ]] \
    && info "note: workshop-attendees group has ${#users_arr[@]} user(s) but workshop-config's live userCount=${current} — a prior scale may still be converging (the Application value wins below)"

  echo "ws scale-users — grow/shrink the workshop cohort"
  echo
  echo "Current: ${current} user(s) (user1..user${current})"
  echo "Target : ${target} user(s)"
  echo

  if [[ "$target" == "$current" ]]; then
    ok "already at ${current} user(s) — nothing to do."
    return 0
  fi

  local direction
  if (( target > current )); then
    direction="grow"
    echo "WILL GROW — materialize user$((current+1))..user${target}:"
    echo "  • namespaces + RBAC + quotas (per-user-namespaces/rbac/limits + module-scoped extras)"
    echo "  • Kueue ClusterQueue cq-user<N>, student-gitops AppProject + Argo RBAC"
    echo "  • Gitea account (gitea-user-seed hook) — SAME shared workshop password"
    echo "  • Showroom cockpit (Deployment/Route showroom-user<N>)"
    echo "  • htpasswd login for the new user(s) — SAME shared workshop password (not rotated)"
    echo
    echo "PRESERVED: all of user1..user${current}, and the platform (pp-*) — untouched."
  else
    direction="shrink"
    echo "WILL SHRINK — DESTRUCTIVE for user$((target+1))..user${current}:"
    echo "  • their entry-*-<user> Argo apps deleted (every module, in ${ARGO_NS})"
    echo "  • their attendee-created Argo apps/appsets deleted (student-gitops, if present)"
    echo "  • CONTENTS of every one of their workshop namespaces purged, THEN the namespace"
    echo "    SHELLS themselves pruned (the chart stops rendering them once userCount drops)"
    echo "  • their Showroom cockpit + Kueue ClusterQueue cq-<user> + student AppProject (pruned by sync)"
    echo "  • their htpasswd login entry removed"
    echo "  • NOT removed today: their Gitea account, and their student-Argo local-account password"
    echo "    hash in argocd-secret — gitea-user-seed/student-argo-accounts only ADD, never delete"
    echo "    (harmless orphaned credentials for a user with no cluster identity left to use them)"
    echo
    echo "PRESERVED: the platform, and user1..user${target} — UNTOUCHED."
  fi
  echo

  if [[ "$yes" != "true" ]]; then
    if [[ -t 0 ]]; then
      local reply
      read -r -p "Proceed to ${direction} the cohort to ${target} user(s) now? [y/N] " reply
      [[ "$reply" =~ ^[Yy]([Ee][Ss])?$ ]] || { info "nothing changed. Re-run when ready (or use --yes)."; return 0; }
    else
      die "not a terminal and no --yes given — re-run: ws scale-users ${target} --yes"
    fi
  fi

  local removed=() i u ns app wedged=0 confirm_failed=0
  if [[ "$direction" == "shrink" ]]; then
    for (( i = target + 1; i <= current; i++ )); do
      u="user${i}"
      removed+=("$u")
      echo
      info "── removing ${u} (before the userCount sync prunes their namespaces) ──"
      cohort_purge_student_apps "$u"
      for ns in $(user_namespaces "$u"); do
        purge_ns "$ns"
      done
      for app in $(oc get applications -n "$ARGO_NS" -l "workshop.redhat.com/user=${u}" -o name 2>/dev/null); do
        app="${app##*/}"
        case "$app" in
          entry-*) delete_app_with_finalizer "$app" || wedged=1 ;;
          *) : ;;
        esac
      done
    done
    echo
  fi

  info "patching workshop-config's userCount helm parameter: ${current} → ${target}…"
  local idx
  idx="$(oc get application workshop-config -n "$ARGO_NS" \
    -o jsonpath='{range .spec.source.helm.parameters[*]}{.name}{"\n"}{end}' 2>/dev/null \
    | grep -nx 'userCount' | head -1 | cut -d: -f1)"
  [[ -n "$idx" ]] || die "workshop-config Application has no 'userCount' helm parameter — inspect: oc get application workshop-config -n ${ARGO_NS} -o yaml"
  idx=$((idx - 1))
  oc patch application workshop-config -n "$ARGO_NS" --type=json \
    -p "[{\"op\":\"replace\",\"path\":\"/spec/source/helm/parameters/${idx}/value\",\"value\":\"${target}\"}]" >/dev/null \
    || die "failed to patch workshop-config's userCount — inspect: oc get application workshop-config -n ${ARGO_NS} -o yaml"
  ok "userCount patched to ${target}"

  info "hard-refreshing + syncing workshop-config…"
  sync_app_operation workshop-config

  # htpasswd is regenerated BEFORE waiting for workshop-config to go Healthy — deliberately ahead of
  # where a surface reading of "sync -> wait Healthy -> regenerate htpasswd" would put it. On GROW, the
  # new user's Showroom cockpit is rendered by THIS SAME Application, and its terminal-prep init
  # container must `oc login` as that user during pod startup; the overall Application can never read
  # Healthy while that Deployment isn't Ready. Regenerating htpasswd only after "wait Healthy" is a
  # deadlock — live-reproduced on C1 2026-07-18 (grow 8->9: the cockpit's login retried 20x/6s, exhausted,
  # crash-looped, and wait_healthy ran out its full 600s with no way to ever succeed). Moving it here is
  # safe in both directions: regen_htpasswd only rewrites the openshift-config secret directly and has no
  # dependency on the Argo sync having completed.
  info "regenerating htpasswd for user1..user${target} (existing hashes kept; new lines use the current shared password)…"
  regen_htpasswd "$target"
  ok "htpasswd-workshop-users (openshift-config) updated for ${target} user(s)"
  info "the oauth-openshift pods roll (~1 min) before login changes take effect: oc rollout status deploy/oauth-openshift -n openshift-authentication"

  wait_healthy workshop-config 600 true

  wait_gitea_seed "$target" || confirm_failed=1

  echo
  if [[ "$direction" == "grow" ]]; then
    for (( i = current + 1; i <= target; i++ )); do
      confirm_cockpit "user${i}" grow || confirm_failed=1
    done
  else
    for u in "${removed[@]}"; do
      confirm_cockpit "$u" shrink || confirm_failed=1
    done
  fi

  echo
  if [[ "$direction" == "shrink" && "$wedged" == 1 ]]; then
    err "scale-users finished, but one or more entry apps were wedged (see above) — re-run scale-users or inspect manually."
  elif [[ "$confirm_failed" == 1 ]]; then
    err "scale-users finished, but a post-check above did not settle in time — sync/hooks may still be converging; re-check: ws status"
  else
    ok "scale-users complete — cohort is now ${target} user(s)."
  fi
  echo "   verify: ws status"
  [[ "$direction" == "shrink" ]] && echo "           oc get ns -l workshop.redhat.com/owner=ogsr   (confirm the removed user(s)' namespaces are gone)"
  (( wedged == 0 && confirm_failed == 0 )) || return 1
}

# ── SA/admin read-only recipes (ws preflight, ws status, ws diag) ────────────────────────────────────
# Preparation + troubleshooting the installing org's SAs run against a customer/BYO cluster. STRICTLY
# READ-ONLY by contract: they inspect and report, and NEVER mutate (no delete/patch/apply/create/label) —
# that is the safety guarantee, kept absolute. Every oc read below was run against a live cluster on
# 2026-07-26 (OCP 4.22.5): preflight, status, status --user and diag --user all returned clean.

pf_row() {  # STATUS label [detail] — print one preflight row; bump PF_WARN/PF_FAIL (globals set in cmd_preflight)
  local status="$1" label="$2" detail="${3:-}" icon
  case "$status" in
    PASS) icon="✅" ;;
    WARN) icon="⚠" ; PF_WARN=$((PF_WARN + 1)) ;;
    FAIL) icon="❌"; PF_FAIL=$((PF_FAIL + 1)) ;;
    *)    icon="•" ;;                                  # INFO / adoption-forecast rows never move the verdict
  esac
  printf "  %s %-32s %s\n" "$icon" "$label" "$detail"
}

cmd_preflight() {  # SA pre-install readiness check — run BEFORE bootstrap/install.sh on a customer/BYO cluster.
  # Reports PASS/WARN/FAIL per check plus a non-invasive "adoption forecast" (what install will ADOPT vs
  # CREATE — derived exactly as bootstrap/install.sh + ogsr-uninstall.sh decide it), then a verdict + the
  # exact next command. Exits non-zero if any check FAILs. READ-ONLY. Deliberately does NOT need_oc: a
  # missing login is a reported check, not a hard abort. Verified live 2026-07-26 on OCP 4.22.5.
  PF_WARN=0; PF_FAIL=0
  echo "ws preflight — is this cluster ready to install the workshop on?"
  echo

  info "Local tooling (bootstrap/install.sh prereqs)"
  local t
  for t in oc yq htpasswd openssl git; do
    if command -v "$t" >/dev/null 2>&1; then
      pf_row PASS "$t" "$(command -v "$t")"
    else
      pf_row FAIL "$t" "not found in PATH — install before bootstrap/install.sh"
    fi
  done
  if command -v yq >/dev/null 2>&1; then
    local yqv; yqv="$(yq --version 2>/dev/null || true)"
    case "$yqv" in
      *"version v4"*|*"version 4."*) : ;;
      "") pf_row WARN "yq is mikefarah v4" "could not read 'yq --version'" ;;
      *)  pf_row WARN "yq is mikefarah v4" "got: ${yqv} (install.sh uses go-yq v4 syntax)" ;;
    esac
  fi
  echo

  info "Cluster access"
  local reachable="false" who server
  who="$(oc whoami 2>/dev/null || true)"
  server="$(oc whoami --show-server 2>/dev/null || true)"
  if [[ -n "$who" ]]; then
    reachable="true"
    pf_row PASS "cluster reachable" "as ${who} @ ${server:-?}"
  else
    pf_row FAIL "cluster reachable" "not logged in — run: oc login <api-url>, then re-run ws preflight"
  fi

  if [[ "$reachable" == "true" ]]; then
    if oc auth can-i '*' '*' --all-namespaces >/dev/null 2>&1; then
      pf_row PASS "cluster-admin" "have '*' '*' on all namespaces"
    else
      pf_row FAIL "cluster-admin" "install requires cluster-admin (oc auth can-i '*' '*' failed)"
    fi

    local ver maj min
    ver="$(oc get clusterversion version -o jsonpath='{.status.desired.version}' 2>/dev/null || true)"
    if [[ "$ver" =~ ^([0-9]+)\.([0-9]+) ]]; then
      maj="${BASH_REMATCH[1]}"; min="${BASH_REMATCH[2]}"
      if (( maj > 4 || (maj == 4 && min >= 20) )); then
        pf_row PASS "OpenShift >= 4.20" "cluster is ${ver}"
      else
        pf_row FAIL "OpenShift >= 4.20" "cluster is ${ver} — the workshop targets 4.20+"
      fi
    else
      pf_row WARN "OpenShift >= 4.20" "could not read clusterversion (got '${ver}') — verify manually"
    fi

    # default StorageClass — the workshop provisions RWO (and some RWX) PVCs dynamically. The escaped-dot
    # annotation jsonpath prints '<name>=true' for the default SC — verified live 2026-07-26 (resolved
    # ocs-external-storagecluster-ceph-rbd). Both the GA and the legacy beta annotation are read, since
    # older StorageClasses still carry only the beta one.
    local scs default_sc
    scs="$(oc get storageclass -o jsonpath='{range .items[*]}{.metadata.name}={.metadata.annotations.storageclass\.kubernetes\.io/is-default-class}{.metadata.annotations.storageclass\.beta\.kubernetes\.io/is-default-class}{"\n"}{end}' 2>/dev/null || true)"
    default_sc="$(printf '%s\n' "$scs" | awk -F= '$2 ~ /true/ {print $1; exit}' || true)"
    if [[ -n "$default_sc" ]]; then
      pf_row PASS "default StorageClass" "${default_sc}"
    elif [[ -n "$scs" ]]; then
      pf_row FAIL "default StorageClass" "StorageClasses exist but none is default — oc annotate sc <name> storageclass.kubernetes.io/is-default-class=true"
    else
      pf_row FAIL "default StorageClass" "no StorageClass found — dynamic RWO storage is required"
    fi
  else
    pf_row WARN "cluster checks skipped" "log in, then re-run for admin / version / storage / adoption checks"
  fi
  echo

  if [[ "$reachable" == "true" ]]; then
    info "Adoption forecast (preview only — nothing is changed)"
    if oc get subscriptions.operators.coreos.com openshift-gitops-operator -n openshift-gitops-operator >/dev/null 2>&1; then
      pf_row INFO "OpenShift GitOps" "ADOPT — operator present; install reuses it, uninstall preserves it"
    else
      pf_row INFO "OpenShift GitOps" "CREATE — argocd-bootstrap installs it; uninstall removes it"
    fi
    if oc get olsconfig cluster >/dev/null 2>&1; then
      pf_row INFO "OpenShift Lightspeed" "ADOPT — OLSConfig present; ai-assist skipped, existing provider reused"
    else
      pf_row INFO "OpenShift Lightspeed" "CREATE — ai-assist installs it when lightspeed:true + a MaaS key are set"
    fi
    if oc get configmap cluster-monitoring-config -n openshift-monitoring >/dev/null 2>&1; then
      local uwm; uwm="$(oc get configmap cluster-monitoring-config -n openshift-monitoring -o jsonpath='{.data.config\.yaml}' 2>/dev/null || true)"
      if printf '%s' "$uwm" | grep -qE 'enableUserWorkload:[[:space:]]*true'; then
        pf_row INFO "user-workload monitoring" "ADOPT — enableUserWorkload already true; left as-is"
      else
        pf_row INFO "user-workload monitoring" "MODIFY — CM exists; install sets enableUserWorkload=true (prior value recorded for restore)"
      fi
    else
      pf_row INFO "user-workload monitoring" "CREATE — install adds cluster-monitoring-config; uninstall removes it"
    fi
    if oc get gatewayclass openshift-default >/dev/null 2>&1; then
      pf_row INFO "GatewayClass openshift-default" "ADOPT — present (a cluster istiod is already active); mesh stack reuses it"
    else
      pf_row INFO "GatewayClass openshift-default" "CREATE — added by the mesh stack; uninstall removes it only if ours"
    fi
    if oc get oauth cluster -o jsonpath='{.spec.identityProviders[*].name}' 2>/dev/null | grep -qw workshop-users; then
      pf_row INFO "OAuth IdP workshop-users" "PRESENT — install reuses it (prior install or a name clash — review)"
    else
      pf_row INFO "OAuth IdP workshop-users" "CREATE — appended to oauth/cluster; all existing IdPs preserved"
    fi
    if oc get configmap ogsr-uninstall-state -n ogsr-system >/dev/null 2>&1; then
      pf_row WARN "prior install detected" "ogsr-system/ogsr-uninstall-state exists — this cluster already ran install (re-run is idempotent; or ./bootstrap/ogsr-uninstall.sh first)"
      local existing_n; existing_n="$(live_user_count || true)"
      [[ -n "$existing_n" ]] && pf_row INFO "existing cohort size" "${existing_n} user(s) (live workshop-config userCount) — ws scale-users grows/shrinks it"
    fi
    echo
  fi

  if (( PF_FAIL > 0 )); then
    err "NOT ready — ${PF_FAIL} check(s) FAILED (and ${PF_WARN} warning(s)). Resolve the ❌ rows, then re-run: ws preflight"
    exit 1
  fi
  if (( PF_WARN > 0 )); then
    ok "ready to install, with ${PF_WARN} warning(s) — review the ⚠ rows above."
  else
    ok "ready to install — all checks passed."
  fi
  echo "   next: cp bootstrap/vars.example.yaml bootstrap/vars.yaml    # then edit users / cluster_domain / maas.api_key / workshop_user_password"
  echo "         ./bootstrap/install.sh                                 # reads vars.yaml; idempotent"
}

ns_pods_ready() {  # ns → "R/T" ready/total pods · "none" if the ns has no pods · "absent" if no such ns.
  # Read-only. Completed/Succeeded pods (seed Jobs) count as ready; a Running pod counts only when all its
  # containers are ready (the READY column numerator == denominator).
  local ns="$1"
  oc get ns "$ns" >/dev/null 2>&1 || { echo "absent"; return 0; }
  oc get pods -n "$ns" --no-headers 2>/dev/null | awk '
    { total++; split($2, a, "/"); st = $3
      if (st == "Completed" || st == "Succeeded" || (a[2] + 0 > 0 && a[1] == a[2])) ready++ }
    END { if (total + 0 == 0) print "none"; else printf "%d/%d", ready + 0, total + 0 }'
}

entry_apps_for() {  # user → TSV "name<TAB>sync<TAB>health" for every Application labelled with this user
  # (the caller filters to entry-* names). Read-only; empty output when none / CRD or label absent.
  oc get applications -n "$ARGO_NS" -l "workshop.redhat.com/user=${1}" \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.sync.status}{"\t"}{.status.health.status}{"\n"}{end}' 2>/dev/null || true
}

entry_app_ok() {  # module sync health → exit 0 if the entry app is "healthy enough". Respects ws-meta
  # expectDegraded / expectOutOfSync so a fault-by-design module (whose Argo app is Degraded/OutOfSync ON
  # PURPOSE — see meta_expect_degraded / meta_require_sync) is not falsely flagged. Falls back to strict
  # Synced/Healthy when the module's entry dir is not present locally.
  local module="$1" sync="$2" health="$3" exp_deg exp_sync
  exp_deg="$(meta_expect_degraded "$module" 2>/dev/null || true)"
  exp_sync="$(meta_require_sync "$module" 2>/dev/null || echo true)"
  if [[ "$health" != "Healthy" && "$exp_deg" != "true" ]]; then return 1; fi
  if [[ "$sync" != "Synced" && "$exp_sync" != "false" && "$exp_deg" != "true" ]]; then return 1; fi
  return 0
}

status_user_detail() {  # user — single-user deep view: workshop-owned namespaces + workshop-quota headroom.
  # Read-only. Shown only in --user scope (too deep for the cohort table).
  local user="$1" ns nslist q
  info "Detail — ${user}"
  nslist="$(oc get ns -l "workshop.redhat.com/user=${user}" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null || true)"
  if [[ -z "$nslist" ]]; then
    echo "  (no namespaces labelled workshop.redhat.com/user=${user} — is ${user} provisioned?)"
    return 0
  fi
  echo "  Namespaces + quota headroom (ResourceQuota 'workshop-quota', used/hard):"
  # Quota keys pods / requests.cpu / requests.memory verified live 2026-07-26 — rendered
  # 'pods 0/50 · cpu 0/4 · mem 0/8Gi' across all 13 per-user namespaces.
  while IFS= read -r ns; do
    [[ -n "$ns" ]] || continue
    if oc get resourcequota workshop-quota -n "$ns" >/dev/null 2>&1; then
      q="$(oc get resourcequota workshop-quota -n "$ns" \
            -o jsonpath='pods {.status.used.pods}/{.status.hard.pods} · cpu {.status.used.requests\.cpu}/{.status.hard.requests\.cpu} · mem {.status.used.requests\.memory}/{.status.hard.requests\.memory}' 2>/dev/null || true)"
      printf "    %-22s %s\n" "$ns" "${q:-(unreadable)}"
    else
      printf "    %-22s %s\n" "$ns" "(no workshop-quota in this namespace)"
    fi
  done <<< "$nslist"
}

cmd_status() {  # SA everyday cohort-health dashboard. READ-ONLY. [--user U] scopes to one attendee; empty =
  # every attendee. ALWAYS exits 0 (it is a report). Every oc read verified live 2026-07-26.
  local scope_user="${1:-}"
  need_oc
  if [[ -n "$scope_user" ]]; then
    require_user_token "$scope_user" "status --user"
  fi

  local who server
  who="$(oc whoami 2>/dev/null || true)"
  server="$(oc whoami --show-server 2>/dev/null || true)"
  echo "ws status — workshop cohort health   (cluster: ${server:-?} as ${who:-?})"
  echo

  # ── platform: pp-* + workshop-config app health, shared-infra pod readiness, install marker ──
  info "Platform"
  printf "  %-26s %-12s %-10s\n" "App" "Sync" "Health"
  local name sync health plat_bad=0 plat_seen=0
  while IFS=$'\t' read -r name sync health; do
    [[ -n "$name" ]] || continue
    plat_seen=$((plat_seen + 1))
    printf "  %-26s %-12s %-10s\n" "$name" "${sync:-?}" "${health:-?}"
    [[ "$sync" == "Synced" && "$health" == "Healthy" ]] || plat_bad=$((plat_bad + 1))
  done < <(oc get applications -n "$ARGO_NS" \
             -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.sync.status}{"\t"}{.status.health.status}{"\n"}{end}' 2>/dev/null \
           | grep -E '^(pp-|workshop-config)' || true)
  (( plat_seen == 0 )) && echo "  (none found — is the platform installed? see: ws preflight)"

  local infra="" ns rt
  for ns in ogsr-gitea ogsr-showroom ogsr-parasol-tasks ogsr-parasol-images ogsr-student-gitops; do
    rt="$(ns_pods_ready "$ns")"
    infra="${infra}${infra:+ · }${ns} ${rt}"
  done
  echo "  Infra pods: ${infra}"
  if oc get configmap ogsr-uninstall-state -n ogsr-system >/dev/null 2>&1; then
    echo "  Install:    ogsr-uninstall-state present (install completed; uninstall available)"
  else
    echo "  Install:    ⚠ ogsr-uninstall-state absent (install incomplete, or a pre-hardening build)"
  fi
  echo

  # ── attendees: one row per user (cockpit · active modules · entry-app health) ──
  local users_str users_arr
  users_str="$(workshop_users)"
  read -ra users_arr <<< "$users_str"
  local group_n="${#users_arr[@]}"
  if [[ -n "$scope_user" ]]; then users_arr=("$scope_user"); fi

  info "Attendees"
  # Live-vs-group cohort size (honest after a `ws scale-users`): only in whole-cohort scope — in
  # --user scope users_arr is deliberately singleton and would always "mismatch" a live_n > 1.
  local live_n; live_n="$(live_user_count || true)"
  [[ -z "$scope_user" && -n "$live_n" && "$live_n" != "$group_n" ]] \
    && echo "  note: workshop-config userCount=${live_n} (live) but the workshop-attendees group has ${group_n} — a scale may still be converging"
  printf "  %-8s %-9s %-24s %-10s\n" "User" "Cockpit" "Modules active" "Entries"
  local u cockpit modules entries entries_total entries_ok mods m ready desired
  local sum_cockpit_ready=0 sum_entries=0 sum_entries_ok=0
  local attention=() a
  for u in "${users_arr[@]}"; do
    if ! oc get deploy "showroom-${u}" -n "$SHOWROOM_NS" >/dev/null 2>&1; then
      cockpit="— none"
    else
      ready="$(oc get deploy "showroom-${u}" -n "$SHOWROOM_NS" -o jsonpath='{.status.readyReplicas}' 2>/dev/null || true)"
      desired="$(oc get deploy "showroom-${u}" -n "$SHOWROOM_NS" -o jsonpath='{.spec.replicas}' 2>/dev/null || true)"
      ready="${ready:-0}"; desired="${desired:-0}"
      if [[ "$ready" -ge 1 && "$ready" == "$desired" ]]; then
        cockpit="✅ ${ready}/${desired}"; sum_cockpit_ready=$((sum_cockpit_ready + 1))
      else
        cockpit="❌ ${ready}/${desired}"
        attention+=("${u}: cockpit showroom-${u} not ready (${ready}/${desired})")
      fi
    fi

    entries_total=0; entries_ok=0; mods=""
    while IFS=$'\t' read -r name sync health; do
      [[ "$name" == entry-*-"$u" ]] || continue
      m="${name#entry-}"; m="${m%-"$u"}"
      mods="${mods}${mods:+,}${m}"
      entries_total=$((entries_total + 1))
      if entry_app_ok "$m" "$sync" "$health"; then
        entries_ok=$((entries_ok + 1))
      else
        attention+=("entry ${name}: ${sync:-?}/${health:-?} — ws diag --user ${u} ${m}")
      fi
    done < <(entry_apps_for "$u")
    sum_entries=$((sum_entries + entries_total))
    sum_entries_ok=$((sum_entries_ok + entries_ok))

    if [[ "$entries_total" -eq 0 ]]; then
      modules="—"; entries="—"
    else
      modules="$mods"
      if [[ "$entries_ok" -eq "$entries_total" ]]; then entries="${entries_ok}/${entries_total} ✅"; else entries="${entries_ok}/${entries_total} ⚠"; fi
    fi
    printf "  %-8s %-9s %-24s %-10s\n" "$u" "$cockpit" "$modules" "$entries"
  done
  echo

  if [[ -n "$scope_user" ]]; then status_user_detail "$scope_user"; echo; fi

  if [[ ${#attention[@]} -gt 0 ]]; then
    err "Needs attention:"
    for a in "${attention[@]}"; do echo "   • $a"; done
    echo
  fi

  local nusers="${#users_arr[@]}" plat_state
  if [[ "$plat_seen" -eq 0 ]]; then
    plat_state="no platform apps found"
  elif [[ "$plat_bad" -eq 0 ]]; then
    plat_state="all-Synced ✅"
  else
    plat_state="${plat_bad} app(s) need attention ❌"
  fi
  echo "Summary: ${nusers} user(s) · ${sum_cockpit_ready}/${nusers} cockpit(s) ready · ${sum_entries} entry app(s) (${sum_entries_ok} healthy, $((sum_entries - sum_entries_ok)) need attention) · platform ${plat_state}"
  echo "   drill in: ws status --user <userN>   ·   ws diag --user <userN> [<module>]"
  return 0
}

diag_entry_app() {  # app — print one entry app's sync/health/op-phase + .status.conditions + operationState
  # message. Read-only; tolerant of an absent app.
  local app="$1" sync health phase msg conds cline
  if ! oc get application "$app" -n "$ARGO_NS" >/dev/null 2>&1; then
    echo "  ${app}: absent (not materialized — ws start/prep it, or re-check the user/module)"
    return 0
  fi
  sync="$(oc get application "$app" -n "$ARGO_NS" -o jsonpath='{.status.sync.status}' 2>/dev/null || true)"
  health="$(oc get application "$app" -n "$ARGO_NS" -o jsonpath='{.status.health.status}' 2>/dev/null || true)"
  phase="$(oc get application "$app" -n "$ARGO_NS" -o jsonpath='{.status.operationState.phase}' 2>/dev/null || true)"
  printf "  %-30s %s / %s   op:%s\n" "$app" "${sync:-?}" "${health:-?}" "${phase:-none}"
  conds="$(oc get application "$app" -n "$ARGO_NS" -o jsonpath='{range .status.conditions[*]}{.type}: {.message}{"\n"}{end}' 2>/dev/null || true)"
  if [[ -n "$conds" ]]; then
    while IFS= read -r cline; do [[ -n "$cline" ]] || continue; echo "     condition: ${cline}"; done <<< "$conds"
  fi
  msg="$(oc get application "$app" -n "$ARGO_NS" -o jsonpath='{.status.operationState.message}' 2>/dev/null || true)"
  if [[ -n "$msg" ]]; then echo "     op-message: ${msg}"; fi
}

cmd_diag() {  # SA troubleshooting bundle for a stuck attendee. READ-ONLY. cmd_diag <user> [module]. Dumps
  # the diagnostic context an SA needs — entry app status + conditions/operationState, per-namespace recent
  # events, not-Ready pods, ws-entry markers, cockpit status + a logs pointer, and the user's student-gitops
  # apps — then prints copy-paste follow-ups (rather than streaming logs). Every oc read verified live
  # 2026-07-26 (ws diag --user user1 across all 13 of that attendee's namespaces).
  local user="$1" module="${2:-}"
  need_oc
  # Optional module scope: accept mNN (position) OR a slug and normalize to the canonical slug —
  # every downstream read (app_name, ws-entry-<slug> marker, verify) keys off the slug.
  [[ -n "$module" ]] && module="$(module_arg "$module")"

  local who server
  who="$(oc whoami 2>/dev/null || true)"
  server="$(oc whoami --show-server 2>/dev/null || true)"
  echo "ws diag — ${user}${module:+ / ${module}}   (cluster: ${server:-?} as ${who:-?})"
  echo

  # ── 1. entry app(s): status + conditions + operationState ──
  info "Entry app(s)"
  local apps app
  if [[ -n "$module" ]]; then
    apps="$(app_name "$module" "$user")"
  else
    apps="$(oc get applications -n "$ARGO_NS" -l "workshop.redhat.com/user=${user}" -o name 2>/dev/null \
             | sed 's|.*/||' | grep '^entry-' || true)"
  fi
  if [[ -z "$apps" ]]; then
    echo "  (no entry-* apps for ${user}${module:+ matching ${module}}) — has ws start/prep run?"
  else
    while IFS= read -r app; do
      [[ -n "$app" ]] || continue
      diag_entry_app "$app"
    done <<< "$apps"
  fi
  echo

  # ── 2. per-namespace: ws-entry markers · not-Ready pods · recent events ──
  local nslist ns markers badpods ev eline
  nslist="$(oc get ns -l "workshop.redhat.com/user=${user}" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null || true)"
  if [[ -z "$nslist" ]]; then
    info "Namespaces"
    echo "  (no namespaces labelled workshop.redhat.com/user=${user} — is ${user} provisioned?)"
  else
    while IFS= read -r ns; do
      [[ -n "$ns" ]] || continue
      info "Namespace ${ns}"
      markers="$(oc get cm -n "$ns" -o name 2>/dev/null | sed -n 's|.*/ws-entry-|ws-entry-|p' | paste -sd' ' - || true)"
      echo "  ws-entry markers: ${markers:-none}"
      badpods="$(oc get pods -n "$ns" --no-headers 2>/dev/null | awk '
        { split($2, a, "/"); st = $3
          if (st != "Running" && st != "Completed" && st != "Succeeded") { print "     " $1 "  " st; next }
          if (a[2] + 0 > 0 && a[1] != a[2]) print "     " $1 "  " st " (" $2 " ready)" }' || true)"
      if [[ -n "$badpods" ]]; then echo "  not-Ready pods:"; echo "$badpods"; else echo "  not-Ready pods: none"; fi
      ev="$(oc get events -n "$ns" --sort-by=.lastTimestamp 2>/dev/null | grep -v '^LAST' | tail -n 6 || true)"
      if [[ -n "$ev" ]]; then
        echo "  recent events:"
        while IFS= read -r eline; do [[ -n "$eline" ]] || continue; echo "     ${eline}"; done <<< "$ev"
      else echo "  recent events: none"; fi
    done <<< "$nslist"
  fi
  echo

  # ── 3. cockpit (showroom-<user>) status + a logs pointer (do NOT stream) ──
  info "Cockpit (showroom-${user})"
  if ! oc get deploy "showroom-${user}" -n "$SHOWROOM_NS" >/dev/null 2>&1; then
    echo "  no showroom-${user} Deployment — cockpit not provisioned for ${user}"
  else
    local cr cd cpod cphase
    cr="$(oc get deploy "showroom-${user}" -n "$SHOWROOM_NS" -o jsonpath='{.status.readyReplicas}' 2>/dev/null || true)"
    cd="$(oc get deploy "showroom-${user}" -n "$SHOWROOM_NS" -o jsonpath='{.spec.replicas}' 2>/dev/null || true)"
    echo "  deployment ready: ${cr:-0}/${cd:-0}"
    cpod="$(oc get pods -n "$SHOWROOM_NS" -l "app.kubernetes.io/name=showroom,workshop.redhat.com/user=${user}" \
             --sort-by=.metadata.creationTimestamp -o name 2>/dev/null | tail -1 | sed 's|.*/||' || true)"
    if [[ -n "$cpod" ]]; then
      cphase="$(oc get pod "$cpod" -n "$SHOWROOM_NS" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
      echo "  newest pod: ${cpod} (${cphase:-?})"
      echo "  logs: oc logs ${cpod} -n ${SHOWROOM_NS} -c terminal --tail=100"
    else
      echo "  no cockpit pod found for ${user}"
    fi
  fi
  echo

  # ── 4. student-gitops apps in the user's project (proj-<user>) ──
  info "Student GitOps (project proj-${user})"
  if ! oc get ns "$STUDENT_ARGO_NS" >/dev/null 2>&1; then
    echo "  (${STUDENT_ARGO_NS} namespace absent — pre-M09 cluster or student-gitops not installed)"
  else
    local sapps n s h
    sapps="$(oc get applications -n "$STUDENT_ARGO_NS" \
      -o jsonpath="{range .items[?(@.spec.project==\"proj-${user}\")]}{.metadata.name}{\"\t\"}{.status.sync.status}{\"\t\"}{.status.health.status}{\"\n\"}{end}" 2>/dev/null || true)"
    if [[ -n "$sapps" ]]; then
      while IFS=$'\t' read -r n s h; do
        [[ -n "$n" ]] || continue
        printf "  %-30s %s / %s\n" "$n" "${s:-?}" "${h:-?}"
      done <<< "$sapps"
    else
      echo "  (no attendee apps in ${STUDENT_ARGO_NS} for proj-${user})"
    fi
  fi
  echo

  # ── 5. copy-paste follow-ups ──
  info "Follow-up (copy-paste)"
  if [[ -n "$module" ]]; then
    echo "  oc describe application $(app_name "$module" "$user") -n ${ARGO_NS}"
    echo "  ws verify ${module} --user ${user}"
    echo "  ws reset  ${module} --user ${user}       # re-materialize the entry state (last resort)"
  else
    echo "  oc get applications -n ${ARGO_NS} -l workshop.redhat.com/user=${user}"
    echo "  ws diag --user ${user} <module>           # focus on one module (mNN or slug)"
  fi
  echo "  oc logs deploy/showroom-${user} -n ${SHOWROOM_NS} -c terminal --tail=100"
  echo "  ws smoke <module> ${user}                     # run the attendee path in the live cockpit"
  return 0
}

# ── ws maas — the MaaS credential as an ADMIN operation, not a reinstall ───────────────────────────
# Nothing about the model is baked: at runtime the AI modules read GENAI_MODEL/GENAI_ENDPOINT from the
# per-namespace `maas-config` ConfigMap and GENAI_API_KEY from the `maas-credentials` Secret, both
# materialized by each entry state's Sync-hook Job from ONE upstream secret — ogsr-system/
# ogsr-maas-credentials. Until this command existed, the only code that wrote that secret lived inside
# bootstrap/install.sh, which takes no flags — so "use a different model" or "the key was rotated" meant
# a full installer re-run (portfolio sync + up to 15m waiting on the Gitea mirror) to change three
# strings. An installer is a bootstrap tool; this is the admin entry point it was missing.
#
# `ws maas set` writes apitoken + model + endpoint TOGETHER, always. A credential from one source paired
# with an endpoint from another is an unvalidated pairing — exactly how cluster ksls5 broke on
# 2026-07-29 — so the three travel as one unit and the whole TRIPLE is proven against the live endpoint
# before anything is staged.
MAAS_NS="${WS_MAAS_NS:-ogsr-system}"
MAAS_SECRET="${WS_MAAS_SECRET:-ogsr-maas-credentials}"
MAAS_LIGHTSPEED_NS="${WS_MAAS_LIGHTSPEED_NS:-openshift-lightspeed}"
MAAS_LIGHTSPEED_SECRET="${WS_MAAS_LIGHTSPEED_SECRET:-credentials}"
# The four modules whose entry states carry a MaaS converge hook (each chart's maas-credentials.yaml).
# Keep in lockstep with `grep -l maasWorkshopSecret gitops/entry-states/*/values.yaml`.
MAAS_MODULES="agentic-ai ai-assisted-development app-modernization jobs-batch-kueue"
MAAS_VARS_DEFAULT="${REPO_ROOT}/bootstrap/vars.yaml"

maas_api_base() {  # endpoint → the OpenAI-compatible base ending in /v1 (same normalization as
  # install.sh's discover_maas_model, so `ws maas` and the installer probe the identical URL).
  local base="${1%/}"
  case "$base" in
    */v1) printf '%s' "$base" ;;
    *)    printf '%s/v1' "$base" ;;
  esac
}

maas_is_placeholder() {  # value → 0 when it is an unfilled vars.example.yaml stand-in rather than a value.
  # vars.example.yaml ships `<your-maas-endpoint>` / `CHANGEME`, and a vars.yaml written for a
  # lightspeed:false cluster carries `<unused-when-lightspeed-false>` — install.sh treats all three as
  # "not configured" and so must we, or `set` stages a literal angle-bracket string as an endpoint.
  case "${1:-}" in
    ""|null|CHANGEME|*"<"*">"*) return 0 ;;
    *) return 1 ;;
  esac
}

maas_is_jwt() {  # token → 0 when it is a 3-segment JSON Web Token.
  # A JWT is a control-plane bearer for SOME OTHER provider (an adopted Azure-OpenAI Lightspeed writes
  # exactly this into its `Bearer` key) and can never be an OpenAI-compatible API key. Rejecting it by
  # shape costs no network round-trip and is the cheap half of the gate the entry-state hooks apply.
  [[ "${1:-}" == eyJ* ]] || return 1
  local dots
  dots="$(printf '%s' "$1" | tr -cd '.' | wc -c | tr -d ' ')"
  [[ "$dots" -ge 2 ]]
}

maas_redact() {  # token → "<N chars, redacted>". The ONLY representation of a key this CLI ever prints.
  printf '<%d chars, redacted>' "${#1}"
}

maas_curl_cfg() {  # token → path of a 0600 curl config carrying the Authorization header.
  # The key never enters argv: a `curl -H "Authorization: Bearer sk-…"` is visible to `ps` for every
  # user on the machine. install.sh's secret write uses --from-literal (same exposure); this does not.
  # Caller removes the file.
  local cfg; cfg="$(mktemp "${TMPDIR:-/tmp}/.ws-maas-probe.XXXXXX")"
  ( umask 077; printf 'header = "Authorization: Bearer %s"\n' "$1" > "$cfg" )
  printf '%s' "$cfg"
}

maas_list_models() {  # cfg base → newline-separated model ids the endpoint offers (empty on failure).
  # OpenAI list-models contract: {"object":"list","data":[{"id":"…"},…]}. Parsed without yq — `ws` runs
  # in the attendee cockpit image too and must not gain a hard dependency the installer can assume.
  curl -sS --max-time 30 --config "$1" -H 'Accept: application/json' "${2}/models" 2>/dev/null \
    | tr ',' '\n' | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

maas_probe() {  # cfg base model → the HTTP status of ONE 1-token chat/completions call, or 000.
  # STATUS CODE ONLY, deliberately: LiteLLM's 401 body echoes the whole token back, so capturing the
  # body would put the credential in this terminal's scrollback. Same discipline as the hook Jobs.
  curl -sS -o /dev/null -w '%{http_code}' --max-time 25 \
    --config "$1" -H 'content-type: application/json' -X POST "${2}/chat/completions" \
    -d "{\"model\":\"${3}\",\"max_tokens\":1,\"messages\":[{\"role\":\"user\",\"content\":\"ping\"}]}" \
    2>/dev/null || echo 000
}

maas_secret_field() {  # key → one field of the workshop credential as plaintext, or empty.
  oc get secret "$MAAS_SECRET" -n "$MAAS_NS" -o jsonpath="{.data.${1}}" 2>/dev/null | base64 -d 2>/dev/null || true
}

maas_configs() {  # → TSV "ns<TAB>user<TAB>module<TAB>model<TAB>endpoint<TAB>avail<TAB>reason<TAB>source"
  # for every per-namespace maas-config across the cluster. This is the AI modules' RUNTIME truth: what
  # the converge hook actually resolved, not what anyone intended. Absent optional fields print as "-".
  oc get cm -A -l workshop.redhat.com/owner=ogsr --field-selector metadata.name=maas-config \
    -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.labels.workshop\.redhat\.com/user}{"\t"}{.metadata.labels.workshop\.redhat\.com/module}{"\t"}{.data.model}{"\t"}{.data.endpoint}{"\t"}{.data.aiPathAvailable}{"\t"}{.data.aiPathReason}{"\t"}{.data.credentialSource}{"\n"}{end}' 2>/dev/null \
    | awk -F'\t' 'NF{for(i=1;i<=8;i++) if($i=="") $i="-"; print $1"\t"$2"\t"$3"\t"$4"\t"$5"\t"$6"\t"$7"\t"$8}' OFS='\t'
}

cmd_maas_show() {  # READ-ONLY. [user] scopes the verdict block to one attendee. Always exits 0 (a report).
  local scope_user="${1:-}"
  need_oc
  local who server
  who="$(oc whoami 2>/dev/null || true)"
  server="$(oc whoami --show-server 2>/dev/null || true)"
  echo "ws maas — MaaS credential + AI-path state   (cluster: ${server:-?} as ${who:-?})"
  echo

  # ── 1. the upstream credential every AI module resolves from ──
  info "Workshop credential (${MAAS_NS}/${MAAS_SECRET})"
  local s_model="" s_endpoint="" s_token=""
  if oc get secret "$MAAS_SECRET" -n "$MAAS_NS" >/dev/null 2>&1; then
    s_model="$(maas_secret_field model)"
    s_endpoint="$(maas_secret_field endpoint)"
    s_token="$(maas_secret_field apitoken)"
    ok "present"
    printf "     %-10s %s\n" "model"    "${s_model:-(unset — the entry charts fall back to their maasModel default)}"
    printf "     %-10s %s\n" "endpoint" "${s_endpoint:-(unset — the entry charts fall back to their maasEndpoint default)}"
    if [[ -z "$s_token" ]]; then
      printf "     %-10s %s\n" "apitoken" "(unset — this credential cannot authenticate anything)"
    elif maas_is_jwt "$s_token"; then
      printf "     %-10s %s\n" "apitoken" "$(maas_redact "$s_token") ❌ a 3-segment JWT — never an OpenAI-compatible key; re-stage: ws maas set --key-file <file>"
    else
      printf "     %-10s %s\n" "apitoken" "$(maas_redact "$s_token")"
    fi
  elif ! oc auth can-i get secrets -n "$MAAS_NS" >/dev/null 2>&1; then
    skip "not checked (reading ${MAAS_NS} secrets needs cluster-admin — run this from the SA kubeconfig)"
  else
    err "absent — nothing staged"
    if oc get secret "$MAAS_LIGHTSPEED_SECRET" -n "$MAAS_LIGHTSPEED_NS" >/dev/null 2>&1; then
      echo "     the converge hooks will FALL BACK to ${MAAS_LIGHTSPEED_NS}/${MAAS_LIGHTSPEED_SECRET} (an adopted"
      echo "     OpenShift Lightspeed provider secret) — a guess, not a workshop credential. Stage ours: ws maas set"
    else
      echo "     stage one: ws maas set   (sources bootstrap/vars.yaml; see: ws maas set --help)"
    fi
  fi
  echo

  # ── 2. per-namespace runtime state ──
  info "Per-namespace maas-config (what the AI modules actually run on)"
  # `|| true` on both collectors: an empty/failed read is a REPORT state ("nothing materialized"), not
  # a reason for set -e to kill a read-only command mid-page.
  local rows; rows="$(maas_configs || true)"
  if [[ -z "${rows//[[:space:]]/}" ]]; then
    echo "  (none — no AI module entry state is materialized on this cluster yet)"
    echo
    echo "Summary: nothing to report — materialize one with: ws start agentic-ai --user user1"
    return 0
  fi
  printf "  %-18s %-26s %-18s %-9s %s\n" "NAMESPACE" "MODULE" "MODEL" "AI PATH" "SOURCE"
  local ns u m model ep avail reason src
  local endpoints="" broken=""
  while IFS=$'\t' read -r ns u m model ep avail reason src; do
    [[ -n "$ns" ]] || continue
    printf "  %-18s %-26s %-18s %-9s %s\n" "$ns" "$m" "$model" "$avail" "$src"
    case "$endpoints" in *"|${ep}|"*) : ;; *) endpoints="${endpoints}|${ep}|" ;; esac
    if [[ "$avail" != "true" ]]; then
      broken="${broken}${ns}"$'\t'"${avail}"$'\t'"${reason}"$'\t'"${ep}"$'\n'
    fi
  done <<< "$rows"
  echo
  # Endpoint agreement: every namespace disagreeing with the staged credential's endpoint is a module
  # talking to a host the credential was never proven against — the ksls5 failure shape.
  local n_ep; n_ep="$(printf '%s' "$endpoints" | tr '|' '\n' | grep -c . || true)"
  if [[ "$n_ep" == "1" ]]; then
    local only_ep="${endpoints//|/}"
    if [[ -n "$s_endpoint" && "$only_ep" != "$s_endpoint" ]]; then
      err "  every namespace points at ${only_ep} but the staged credential names ${s_endpoint} — re-converge: ws maas set"
    else
      echo "  All namespaces point at ${only_ep}"
    fi
  else
    err "  namespaces disagree on the endpoint ($(printf '%s' "$endpoints" | tr '|' ' ' | xargs)) — re-converge: ws maas set"
  fi
  if [[ -n "$broken" ]]; then
    echo
    info "Why the non-working namespaces are down"
    while IFS=$'\t' read -r ns avail reason ep; do
      [[ -n "$ns" ]] || continue
      if [[ "$avail" == "-" ]]; then
        printf "  %-18s %s\n" "$ns" "the converge hook recorded NO verdict — it never completed; check: oc get jobs -n ${ns}"
      else
        printf "  %-18s aiPathAvailable=%s · %s · %s\n" "$ns" "$avail" "$reason" "$ep"
      fi
    done <<< "$broken"
  fi
  echo

  # ── 3. one verdict per attendee ──
  info "Verdict per attendee"
  local users u2
  users="$(printf '%s\n' "$rows" | cut -f2 | grep -v '^-$' | sort -u | grep . || true)"
  if [[ -n "$scope_user" ]]; then users="$scope_user"; fi
  local n_work=0 n_deg=0 n_unk=0
  # Degraded and unknown are tracked SEPARATELY, each carrying its own module's reason. Folding them
  # into one reason list reads as "app-modernization is broken because no-verdict-recorded", which
  # names the wrong module for the wrong cause — the kind of near-miss that sends an SA down a blind
  # alley. Each module is named next to the reason that is actually its own.
  for u2 in $users; do
    local bad="" unk="" n_mod=0 why
    while IFS=$'\t' read -r ns u m model ep avail reason src; do
      [[ "$u" == "$u2" ]] || continue
      n_mod=$((n_mod + 1))
      case "$avail" in
        true) : ;;
        false)
          why="${reason}"
          if [[ "$why" == "-" ]]; then why="no reason recorded"; fi
          bad="${bad}${bad:+, }${m} (${why})" ;;
        *)
          if [[ "$avail" == "-" ]]; then
            why="the converge hook never recorded a verdict"
          else
            why="${avail}: ${reason}"
          fi
          unk="${unk}${unk:+, }${m} (${why})" ;;
      esac
    done <<< "$rows"
    if [[ "$n_mod" -eq 0 ]]; then
      skip "${u2} — unknown: no AI module materialized for this attendee"
      n_unk=$((n_unk + 1))
    elif [[ -n "$bad" ]]; then
      err "${u2} — degraded: ${bad}${unk:+ · unknown: ${unk}}"
      n_deg=$((n_deg + 1))
    elif [[ -n "$unk" ]]; then
      echo "⚠ ${u2} — unknown: ${unk}"
      n_unk=$((n_unk + 1))
    else
      ok "${u2} — working (${n_mod} AI module(s))"
      n_work=$((n_work + 1))
    fi
  done
  echo
  echo "Summary: ${n_work} working · ${n_deg} degraded · ${n_unk} unknown"
  if [[ "$n_deg" -gt 0 || "$n_unk" -gt 0 ]]; then
    echo "   fix without a reinstall:  ws maas set [--model <name>] [--key-file <file>]"
  fi
  return 0
}

maas_converge_targets() {  # [user] → TSV "module<TAB>user<TAB>app" for every LIVE AI entry app.
  # Derived from the Applications that exist, never from an assumed cohort: converging a module a user
  # never started would create nothing and only muddy the report.
  local want_user="${1:-}" m apps name u
  for m in $MAAS_MODULES; do
    apps="$(oc get applications -n "$ARGO_NS" -l "workshop.redhat.com/module=${m}" \
              -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.metadata.labels.workshop\.redhat\.com/user}{"\n"}{end}' 2>/dev/null || true)"
    [[ -n "$apps" ]] || continue
    while IFS=$'\t' read -r name u; do
      [[ -n "$name" && -n "$u" ]] || continue
      [[ "$name" == entry-* ]] || continue
      # Skip an app whose user label is not a real attendee identity. require_user_token now stops
      # `--user 1` at the gate, but apps created BEFORE that fix still sit on live clusters (ksls5 has
      # entry-agentic-ai-1, targeting a namespace `1-ai` that does not exist). Enumerating by label
      # would pick it up, and the converge wait would then block its full 4m timeout on a namespace
      # that can never report a verdict — measured, it did exactly that. Litter must not cost time.
      [[ "$u" =~ ^user[0-9]+$ ]] || continue
      if [[ -n "$want_user" && "$u" != "$want_user" ]]; then continue; fi
      printf '%s\t%s\t%s\n' "$m" "$u" "$name"
    done <<< "$apps"
  done
}

maas_converge() {  # module user app — re-run the module's MaaS converge hook for one attendee.
  # WHY THIS AND NOT `ws reset`: reset purges the attendee's namespaces before re-materializing, so
  # rotating a key mid-session would cost every attendee their lab work. The converge hook is
  # idempotent and touches exactly two objects (maas-config + maas-credentials), so re-running it
  # alone is the surgical equivalent. The Job delete matters because the hook is a SYNC-phase hook:
  # Argo re-runs Sync hooks on a sync OPERATION but auto-heal will not fire one when nothing drifted,
  # and a completed Job left in place is what a stale reconcile sees. Delete it, then drive a real
  # operation through sync_app_operation (which already waits out a running op and hard-refreshes).
  local module="$1" user="$2" app="$3" jobs ns job
  jobs="$(oc get jobs -A -l "workshop.redhat.com/module=${module},workshop.redhat.com/user=${user}" \
            -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\n"}{end}' 2>/dev/null || true)"
  while IFS=$'\t' read -r ns job; do
    [[ -n "$ns" && "$job" == maas-copy-* ]] || continue
    # --wait: the delete must COMPLETE before the sync recreates the hook, because that is what makes
    # "a maas-copy Job exists and is Complete" a fresh-run signal for maas_await_converge below.
    # Deleting an already-finished Job is quick; the timeout only guards a stuck finalizer.
    oc delete job "$job" -n "$ns" --ignore-not-found --wait=true --timeout=60s >/dev/null 2>&1 || true
    info "  ${module}/${user}: deleted the previous hook Job ${ns}/${job}"
  done <<< "$jobs"
  sync_app_operation "$app"
}

maas_cm_field() {  # module user field → one maas-config value for this module instance, or empty.
  oc get cm -A -l "workshop.redhat.com/owner=ogsr,workshop.redhat.com/module=${1},workshop.redhat.com/user=${2}" \
    --field-selector metadata.name=maas-config \
    -o jsonpath="{.items[0].data.${3}}" 2>/dev/null || true
}

maas_await_converge() {  # module user want-model timeout → 0 once a FRESH hook run has recorded
  # aiPathAvailable=true FOR THE MODEL WE JUST STAGED. All three conditions are load-bearing:
  #
  #   Job Complete — `ws maas set` must be safe to re-run, so the common case is a cluster where
  #     aiPathAvailable is ALREADY true. Polling that flag alone would return instantly and report
  #     success for work that had not started yet — a green ✅ for nothing, which is the one failure
  #     mode this repo treats as worse than a red ❌. We delete the hook Job with --wait before
  #     syncing, so a maas-copy Job that exists and is Complete is necessarily the new run.
  #   model match — proves the value that actually landed is the one we staged, which is the whole
  #     point of a model change (the owner's question: why should that need a reinstall?).
  #   aiPathAvailable — the hook's own verdict, re-probed from INSIDE the cluster.
  local module="$1" user="$2" want="$3" timeout="$4" t=0 jobs_done
  while [[ "$t" -lt "$timeout" ]]; do
    jobs_done="$(oc get jobs -A -l "workshop.redhat.com/module=${module},workshop.redhat.com/user=${user}" \
                   -o jsonpath='{range .items[*]}{.metadata.name}{"="}{.status.succeeded}{"\n"}{end}' 2>/dev/null \
                 | grep '^maas-copy-' || true)"
    if [[ "$jobs_done" == *"=1"* ]]; then
      if [[ "$(maas_cm_field "$module" "$user" aiPathAvailable)" == "true" \
         && "$(maas_cm_field "$module" "$user" model)" == "$want" ]]; then
        return 0
      fi
    fi
    sleep 5; t=$((t + 5))
  done
  return 1
}

cmd_maas_set() {  # SA/admin: stage the workshop MaaS credential + re-converge the AI modules. WRITES.
  local vars_file="$MAAS_VARS_DEFAULT" key_file="" key_stdin="false"
  local opt_model="" opt_endpoint="" scope_user="" converge="true" force="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vars)     vars_file="${2:-}"; shift 2 ;;
      --key-file) key_file="${2:-}"; shift 2 ;;
      --key-stdin) key_stdin="true"; shift ;;
      --model)    opt_model="${2:-}"; shift 2 ;;
      --endpoint) opt_endpoint="${2:-}"; shift 2 ;;
      --user)     scope_user="${2:-}"; shift 2 ;;
      user[0-9]*) scope_user="$1"; shift ;;
      --no-converge) converge="false"; shift ;;
      --force)    force="true"; shift ;;
      -h|--help)  maas_usage; return 0 ;;
      # There is deliberately no --key <value>: an API key in argv is readable by every user on the
      # box through `ps`. --key-file / --key-stdin / vars.yaml are the three ways in.
      --key)      die "maas set: --key is refused on purpose — an API key in argv is visible to \`ps\`. Use --key-file <file>, --key-stdin, or bootstrap/vars.yaml" ;;
      *)          die "maas set: unknown argument '$1' — see: ws maas --help" ;;
    esac
  done
  if [[ -n "$scope_user" ]]; then require_user_token "$scope_user" "maas set --user"; fi
  need_oc
  oc get namespace "$MAAS_NS" >/dev/null 2>&1 \
    || die "namespace ${MAAS_NS} does not exist — the workshop layer is not installed here (run ./bootstrap/install.sh first)"
  oc auth can-i create secrets -n "$MAAS_NS" >/dev/null 2>&1 \
    || die "cannot write secrets in ${MAAS_NS} as $(oc whoami 2>/dev/null || echo '?') — ws maas set is an SA/admin operation; log in with the platform kubeconfig"

  echo "ws maas set — stage the workshop MaaS credential (no reinstall required)"
  echo

  # ── 1. resolve the triple, recording where each part came from ──
  # Precedence per field: explicit flag → vars.yaml → the credential already on the cluster. The last
  # step is what makes "just change the model" a one-flag command; it is safe because NOTHING is staged
  # until the assembled triple has been proven end-to-end against the live endpoint below.
  info "Sources"
  local key="" key_from="" model="" model_from="" endpoint="" endpoint_from=""
  if [[ -n "$key_file" ]]; then
    [[ -r "$key_file" ]] || die "maas set: --key-file ${key_file} is not readable"
    key="$(tr -d '\r\n' < "$key_file")"
    key_from="--key-file ${key_file}"
  elif [[ "$key_stdin" == "true" ]]; then
    IFS= read -r key || true
    key="$(printf '%s' "$key" | tr -d '\r\n')"
    key_from="stdin"
  fi
  local have_vars="false"
  if [[ -f "$vars_file" ]] && command -v yq >/dev/null 2>&1; then have_vars="true"; fi
  local v_key="" v_model="" v_endpoint=""
  if [[ "$have_vars" == "true" ]]; then
    v_key="$(yq -r '.maas.api_key' "$vars_file" 2>/dev/null || true)"
    v_model="$(yq -r '.maas.model' "$vars_file" 2>/dev/null || true)"
    v_endpoint="$(yq -r '.maas.endpoint' "$vars_file" 2>/dev/null || true)"
  fi
  if [[ -z "$key" && "$have_vars" == "true" ]] && ! maas_is_placeholder "$v_key"; then
    key="$v_key"; key_from="${vars_file} (.maas.api_key)"
  fi
  if [[ -n "$opt_model" ]]; then
    model="$opt_model"; model_from="--model"
  elif [[ "$have_vars" == "true" ]] && ! maas_is_placeholder "$v_model"; then
    model="$v_model"; model_from="${vars_file} (.maas.model)"
  fi
  if [[ -n "$opt_endpoint" ]]; then
    endpoint="$opt_endpoint"; endpoint_from="--endpoint"
  elif [[ "$have_vars" == "true" ]] && ! maas_is_placeholder "$v_endpoint"; then
    endpoint="$v_endpoint"; endpoint_from="${vars_file} (.maas.endpoint)"
  fi
  # Fall back to what is already staged, per field, so a model-only or key-only change needs one flag.
  local cur_key cur_model cur_endpoint
  cur_key="$(maas_secret_field apitoken)"
  cur_model="$(maas_secret_field model)"
  cur_endpoint="$(maas_secret_field endpoint)"
  if [[ -z "$key" && -n "$cur_key" ]]; then key="$cur_key"; key_from="${MAAS_NS}/${MAAS_SECRET} (reused)"; fi
  if [[ -z "$model" && -n "$cur_model" ]]; then model="$cur_model"; model_from="${MAAS_NS}/${MAAS_SECRET} (reused)"; fi
  if [[ -z "$endpoint" && -n "$cur_endpoint" ]]; then endpoint="$cur_endpoint"; endpoint_from="${MAAS_NS}/${MAAS_SECRET} (reused)"; fi

  if [[ -z "$key" ]]; then
    err "no MaaS API key to stage."
    if [[ "$have_vars" == "true" ]] && maas_is_placeholder "$v_key"; then
      err "   ${vars_file} still has the placeholder .maas.api_key: ${v_key} — that is not a credential."
    elif [[ "$have_vars" != "true" ]]; then
      err "   ${vars_file} is missing or yq is not installed, so no key could be read from it."
    fi
    die "supply one: ws maas set --key-file <file>   ·   pbpaste | ws maas set --key-stdin   ·   or fill .maas.api_key in ${vars_file}"
  fi
  if [[ -z "$endpoint" ]]; then
    die "no MaaS endpoint to stage — pass --endpoint https://<host>/v1, or fill .maas.endpoint in ${vars_file} (the placeholder value does not count)"
  fi
  printf "  %-10s %s\n" "key"      "${key_from} → $(maas_redact "$key")"
  printf "  %-10s %s\n" "endpoint" "${endpoint_from} → ${endpoint}"
  if [[ -n "$model" ]]; then
    printf "  %-10s %s\n" "model"  "${model_from} → ${model}"
  else
    printf "  %-10s %s\n" "model"  "(none given — will be discovered from the endpoint)"
  fi
  echo

  # ── 2. validate the WHOLE triple before staging anything ──
  info "Validating before staging (the key travels in a 0600 file, never in argv, never printed)"
  if maas_is_jwt "$key"; then
    err "shape — this is a 3-segment JSON Web Token, not an OpenAI-compatible API key."
    err "   A JWT is a control-plane bearer for another provider; an adopted Azure-OpenAI OpenShift"
    err "   Lightspeed writes exactly one into its secret. Staging it would 401 every attendee."
    die "refusing to stage it (cluster ksls5 lost a session to this exact value on 2026-07-29)"
  fi
  ok "shape — not a JWT ($(maas_redact "$key"))"

  local base cfg
  base="$(maas_api_base "$endpoint")"
  cfg="$(maas_curl_cfg "$key")"
  local ids count
  ids="$(maas_list_models "$cfg" "$base" || true)"
  # count is only meaningful once we know $ids is non-empty — compute it AFTER the empty check below,
  # not before: `grep -c .` on an empty $ids exits 1 (no matching lines), and under pipefail that took
  # down the whole pipeline (tr -d exits 0 but pipefail still surfaces grep's failure), killing the
  # script one line before the handler written to catch exactly this case. Verified with a bash -c repro.
  if [[ -z "${ids//[[:space:]]/}" ]]; then
    rm -f "$cfg"
    err "catalog — GET ${base}/models returned no model list."
    err "   401/403 → the key is wrong, expired, or not entitled on this endpoint"
    err "   404     → --endpoint is not an OpenAI-compatible base (it should end in /v1)"
    err "   000     → the endpoint is unreachable from THIS machine (DNS / proxy / TLS)"
    die "refusing to stage an unvalidated credential"
  fi
  # $ids is confirmed non-empty past this point, so `grep -c .` always has at least one match — safe now.
  count="$(printf '%s\n' "$ids" | grep -c . | tr -d ' ')"
  if [[ -z "$model" ]]; then
    model="$(printf '%s\n' "$ids" | head -1)"
    model_from="discovered from ${base}/models"
    if [[ "$count" == "1" ]]; then
      ok "catalog — ${count} model offered; using it: ${model}"
    else
      ok "catalog — ${count} models offered; using the first: ${model} ($(printf '%s' "$ids" | tr '\n' ' '))"
      info "   pin a different one with --model if your key is scoped elsewhere"
    fi
  elif printf '%s\n' "$ids" | grep -qxF "$model"; then
    ok "catalog — ${base}/models offers '${model}' (${count} model(s) available)"
  else
    # Not fatal on its own: /models is a catalogue, the chat call below is the honest gate. But say it
    # loudly — on this endpoint the chart default llama-scout-17b is absent and 401s, which is exactly
    # the failure an operator would otherwise chase inside the modules.
    echo "⚠ catalog — '${model}' is NOT among the ${count} model(s) ${base}/models offers: $(printf '%s' "$ids" | tr '\n' ' ')"
  fi

  local code; code="$(maas_probe "$cfg" "$base" "$model")"
  rm -f "$cfg"
  case "$code" in
    2*)
      ok "live probe — HTTP ${code}: the endpoint accepted this key for model '${model}'" ;;
    401|403)
      err "live probe — HTTP ${code}: the endpoint REJECTED this key for model '${model}'."
      err "   MaaS keys are MODEL-SCOPED, so this is as likely a wrong MODEL as a wrong key."
      err "   models this key can list: $(printf '%s' "$ids" | tr '\n' ' ')"
      die "refusing to stage a credential the endpoint will not honour (--force cannot override a 401/403)" ;;
    *)
      err "live probe — HTTP ${code}: inconclusive (no verdict from the endpoint)."
      err "   The cluster may still reach it while this machine cannot (proxy / split DNS)."
      if [[ "$force" != "true" ]]; then
        die "refusing to stage an unproven credential — re-run with --force if you know the cluster can reach ${base}"
      fi
      echo "⚠ --force given: staging UNPROVEN. The entry-state hooks re-probe from inside the cluster and will record the real verdict in maas-config." ;;
  esac
  echo

  # ── 3. stage all three keys together, from a 0600 file ──
  info "Staging ${MAAS_NS}/${MAAS_SECRET}"
  local manifest; manifest="$(mktemp "${TMPDIR:-/tmp}/.ws-maas-secret.XXXXXX")"
  # The key reaches the cluster as base64 inside a 0600 file that `oc apply -f` reads — never as an
  # `--from-literal` argument (install.sh's shape), which puts the plaintext in this process's argv.
  ( umask 077
    cat > "$manifest" <<YAML
apiVersion: v1
kind: Secret
metadata:
  name: ${MAAS_SECRET}
  namespace: ${MAAS_NS}
  labels:
    workshop.redhat.com/owner: ogsr
type: Opaque
data:
  apitoken: $(printf '%s' "$key" | base64 | tr -d '\n')
  model: $(printf '%s' "$model" | base64 | tr -d '\n')
  endpoint: $(printf '%s' "$endpoint" | base64 | tr -d '\n')
YAML
  )
  local applied=0
  oc apply -f "$manifest" >/dev/null 2>&1 || applied=$?
  rm -f "$manifest"
  if [[ "$applied" -ne 0 ]]; then
    die "could not apply ${MAAS_NS}/${MAAS_SECRET} — check: oc auth can-i create secrets -n ${MAAS_NS}"
  fi
  ok "apitoken + model=${model} + endpoint=${endpoint} written together (idempotent — safe to re-run)"
  echo

  # ── 4. re-converge the AI modules ──
  if [[ "$converge" != "true" ]]; then
    info "Skipping the re-converge (--no-converge)."
    echo "   The AI modules keep their OLD model/key until their hook re-runs:"
    echo "     ws maas set${scope_user:+ --user ${scope_user}}     # re-run without --no-converge"
    echo "   Check what they run on now:  ws maas show"
    return 0
  fi
  local targets; targets="$(maas_converge_targets "$scope_user" || true)"
  if [[ -z "${targets//[[:space:]]/}" ]]; then
    info "No AI module entry states are materialized${scope_user:+ for ${scope_user}} — nothing to re-converge."
    echo "   The next \`ws start <ai-module>\` picks the new credential up automatically."
    echo "   Check: ws maas show"
    return 0
  fi
  info "Re-converging the AI modules (delete the Sync hook Job, then drive a fresh sync operation)"
  local m u app pairs=""
  while IFS=$'\t' read -r m u app; do
    [[ -n "$m" ]] || continue
    maas_converge "$m" "$u" "$app"
    pairs="${pairs}${m}"$'\t'"${u}"$'\n'
  done <<< "$targets"
  echo

  info "Waiting for each module to record aiPathAvailable=true in maas-config (up to 4m each)"
  local n_ok=0 n_bad=0 reason
  while IFS=$'\t' read -r m u; do
    [[ -n "$m" ]] || continue
    if maas_await_converge "$m" "$u" "$model" 240; then
      ok "  ${u}/${m} — AI path available (model ${model})"
      n_ok=$((n_ok + 1))
    else
      reason="$(maas_cm_field "$m" "$u" aiPathReason)"
      err "  ${u}/${m} — still not available (${reason:-no verdict recorded}) — ws diag --user ${u} ${m}"
      n_bad=$((n_bad + 1))
    fi
  done <<< "$pairs"
  echo
  if [[ "$n_bad" -eq 0 ]]; then
    ok "MaaS credential staged and ${n_ok} module instance(s) converged — no reinstall was needed."
  else
    err "${n_ok} converged, ${n_bad} did not — the credential IS staged; inspect the stragglers above."
  fi
  echo "   confirm: ws maas show"
  if [[ "$n_bad" -ne 0 ]]; then return 1; fi
  return 0
}

maas_usage() {
  cat <<'USAGE'
ws maas — inspect and change the MaaS credential WITHOUT reinstalling the workshop

  ws maas show [--user userN]      read-only: staged credential + per-namespace AI-path state
  ws maas set  [options]           validate, stage, and re-converge the AI modules

The model is not baked into anything: the AI modules read it from a per-namespace ConfigMap at
runtime. `ws maas set` rewrites the one upstream Secret (ogsr-system/ogsr-maas-credentials) and
re-runs each AI module's converge hook. bootstrap/install.sh is NOT needed for this.

set options
  --key-file <file>    read the API key from a file (never from argv — `ps` is public)
  --key-stdin          read the API key from stdin   (e.g. pbpaste | ws maas set --key-stdin)
  --model <name>       model to stage; default: bootstrap/vars.yaml, else the one already staged,
                       else discovered from the endpoint's /models
  --endpoint <url>     OpenAI-compatible base ending in /v1
  --vars <file>        alternate vars file (default: bootstrap/vars.yaml)
  --user userN         re-converge only this attendee (default: every attendee with an AI module)
  --no-converge        stage the Secret only; leave the modules on their current values
  --force              stage despite an INCONCLUSIVE probe (never despite a 401/403)

Any field not given falls back to bootstrap/vars.yaml, then to what is already on the cluster — so
"use a different model" is one flag. Nothing is staged until the assembled key+endpoint+model triple
has been proven with a real 1-token call against the live endpoint.

examples
  ws maas show                                  # what are the AI modules actually running on?
  ws maas set --model qwen3-14b                 # same key, different model
  ws maas set --key-file ~/new-maas.key         # rotate the key, keep model + endpoint
  ws maas set --key-stdin --endpoint https://maas.example.com/v1 --model qwen3-14b
USAGE
}

cmd_maas() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    show)
      local u=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --user) u="${2:-}"; shift 2 ;;
          user[0-9]*) u="$1"; shift ;;
          -h|--help) maas_usage; return 0 ;;
          *) die "maas show: unknown argument '$1' — see: ws maas --help" ;;
        esac
      done
      if [[ -n "$u" ]]; then require_user_token "$u" "maas show --user"; fi
      cmd_maas_show "$u" ;;
    set) cmd_maas_set "$@" ;;
    ""|-h|--help|help) maas_usage ;;
    *) die "unknown subcommand 'maas ${sub}' — try: ws maas show | ws maas set (see: ws maas --help)" ;;
  esac
}

main() {
  local cmd="${1:-}"; shift || true
  # git-refresh self-parses its own flags (--restart-terminals/--user/--all/--exclude, where
  # --exclude takes a value); route its raw args straight through so the generic module parser
  # below never mis-bins that value as a module. "$@" is set -u-safe when empty (unlike an array).
  [[ "$cmd" == "git-refresh" ]] && { cmd_git_refresh "$@"; return; }
  # passwd/cohort-reset/scale-users self-parse their own flags (passwd's NEWPASS is a free-form string,
  # not a module; cohort-reset takes no module/user; scale-users' N is a bare integer) — route their
  # raw args straight through, like git-refresh.
  [[ "$cmd" == "passwd" ]] && { cmd_passwd "$@"; return; }
  [[ "$cmd" == "cohort-reset" ]] && { cmd_cohort_reset "$@"; return; }
  [[ "$cmd" == "scale-users" ]] && { cmd_scale_users "$@"; return; }
  # maas has its own SUBCOMMAND (show|set) plus value-taking flags (--model/--endpoint/--key-file/
  # --vars) whose values are free-form strings, not modules — route its raw args straight through.
  [[ "$cmd" == "maas" ]] && { cmd_maas "$@"; return; }
  # rebuild-images self-parses too: --image takes a free-form image NAME (parasol-claims), which the
  # generic parser below would otherwise bin as the module argument.
  [[ "$cmd" == "rebuild-images" ]] && { cmd_rebuild_images "$@"; return; }
  local user="" module="" extra=()
  # collect --user anywhere; a bare userN (e.g. `ws start m07 user2`) is the target user, exactly like
  # --user user2 — the first OTHER bare arg is the module. Honoring positional userN closes a footgun:
  # without it, `ws start m07 user2` silently dropped "user2" and provisioned for whoami's default
  # (admin → user1), spawning stray entry-<module>-user1 state. cmd_smoke already accepted a positional
  # userN; routing it here makes every verb consistent.
  while [[ $# -gt 0 ]]; do
    case "$1" in
      # Validate the FLAG VALUE with the same rule the positional token below already enforces —
      # `--user 1` must die here, not become an Application named entry-<module>-1.
      --user) user="${2:-}"; require_user_token "$user" "${cmd} --user"; shift 2;;
      --all-users) user="--all-users"; shift;;
      user[0-9]*)
        [[ "$1" =~ ^user[0-9]+$ ]] || die "bad user token '$1' — expected userN, e.g. user2"
        [[ -n "$user" && "$user" != "$1" ]] && die "conflicting users: --user ${user} and positional ${1} — pass just one"
        user="$1"; shift;;
      -*) extra+=("$1"); shift;;
      *) [[ -z "$module" ]] && module="$1" || extra+=("$1"); shift;;
    esac
  done
  # --all-users is ONLY meaningful to `ws start` (cmd_start's own instructor-cohort branch, line ~785).
  # Every other verb has no such branch and would treat the literal string "--all-users" as an attendee
  # identity: app_name/meta_namespaces interpolate it straight into an Application name and namespace
  # list (entry-<module>---all-users, "--all-users-dev", …) — garbage that either no-ops silently
  # (cmd_prep/cmd_reset's purge steps find nothing to purge) or, worse, falls through cmd_reset/cmd_prep's
  # trailing `cmd_start "$user" "$module"` call STRAIGHT INTO cmd_start's all-users branch: `ws reset
  # <module> --all-users` materializes (never resets) the module for the WHOLE COHORT — the exact
  # scope-widening this repo's require_user_token was written to stop for `--user 1`, just reached by a
  # different token. Reject it here, before it ever reaches user_arg/module_arg or a cmd_* body.
  if [[ "$user" == "--all-users" && "$cmd" != "start" ]]; then
    die "${cmd}: --all-users is only valid for 'ws start' — for ${cmd}, name one attendee (--user userN) and repeat per user"
  fi
  # Canonicalize <user>/<module> to their internal keys BEFORE dispatch. module_arg/user_arg die
  # (exit 1) on a bad token — but inside a $(…) substitution passed as a command ARGUMENT that exit
  # ends only the SUBSHELL, and set -e does NOT act on a failed substitution in argument position,
  # so cmd_prep/cmd_start would proceed with an EMPTY module and Argo would build a bogus
  # `entry--<user>` Application (bug 2026-07-17: `ws prep m27`, a number past the catalog). Resolve
  # up front into the locals and propagate the failing status so we die before creating any app.
  case "$cmd" in
    prep|start|verify|smoke|reset|solve|diag) user="$(user_arg "$user")"     || exit $?;;
  esac
  case "$cmd" in
    prep|start|verify|smoke|reset|solve)      module="$(module_arg "$module")" || exit $?;;
  esac
  case "$cmd" in
    list)        cmd_list;;
    prep)        cmd_prep "$user" "$module" ${extra[@]:+"${extra[@]}"};;
    start)       cmd_start "$user" "$module";;
    verify)      cmd_verify "$user" "$module" ${extra[@]:+"${extra[@]}"};;
    smoke)       cmd_smoke "$user" "$module" ${extra[@]:+"${extra[@]}"};;
    reset)       cmd_reset "$user" "$module";;
    solve)       cmd_solve "$user" "$module";;
    doctor)      cmd_doctor "$user";;
    preflight)   cmd_preflight;;
    status)      cmd_status "$user";;
    diag)        cmd_diag "$user" "$module";;
    # The range is a LINE COUNT into the header block, so it drifts the moment the block grows — adding
    # doctor's --user line pushed the closing "<module> is a position number…" note out of it. Bumped
    # with that line; anything else added above must bump it again (verify with: ws help | tail -2).
    ""|help|-h|--help) grep '^#' "$0" | sed 's/^# \{0,1\}//' | sed -n '2,24p';;
    *) die "unknown command '$cmd' — try: ws help";;
  esac
}
main "$@"
