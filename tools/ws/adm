#!/usr/bin/env bash
# adm — the SA / operator surface of the workshop CLI.
#
# This is a WRAPPER, not a second copy. It execs tools/ws/ws with WS_AUDIENCE=admin,
# which is the only thing that distinguishes the two surfaces:
#
#   ws   attendee   list · prep · verify · reset            (the workshop itself)
#   adm  operator   those four PLUS doctor, status, diag, preflight, start, solve,
#                   smoke, git-refresh, session-refresh, passwd, cohort-reset,
#                   scale-users, by-design, maas, rebuild-images
#
# WHY A WRAPPER AND NOT A SYMLINK. `ws` decides whether to run main() with
# `[[ "${BASH_SOURCE[0]}" == "${0}" ]]`, the standard "am I being executed rather than
# sourced" test. Exec'ing the real path keeps those two equal, so that guard holds and
# `ws` runs exactly as it does when invoked directly. Dispatching on $0 instead would
# make the two values differ and is the kind of subtlety that fails silently later.
#
# WHY A WRAPPER AND NOT A COPY. The two surfaces share ~5,000 lines — module
# resolution, Argo waits, identity handling, cockpit plumbing. This repo already ships
# copy-drift-guard because duplicated logic here has rotted before. One file cannot
# drift from itself.
#
# WHAT THIS IS NOT. It is not an authorization boundary. Anyone who can reach this file
# can run it, and on the shared cockpit the repo is mounted read-only at
# /showroom/repo, so this path is reachable from an attendee terminal. Every verb below
# still enforces its own privileges against the caller's real credentials, exactly as
# it did when there was one entry point. This split fixes what a workshop attendee is
# SHOWN and told, not what the cluster permits.
set -euo pipefail

WS_AUDIENCE="admin"
export WS_AUDIENCE

exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ws" "$@"
