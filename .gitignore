# Secrets & environment — NEVER commit real endpoints/keys (03-DEV-WORKFLOW §8)
vars.yaml
*.kubeconfig
.env
.env.*
# Workshop bootstrap writes the generated user credentials here (never commit)
bootstrap/.credentials*

# Build outputs
# SA guides (decks + the install/troubleshooting runbook) are maintainer/SA material, not
# public-repo content — distributed via the shared drive (2026-07-25 / 2026-07-26 owner review):
# the decks are shared with Red Hat SAs internally, never committed here.
sa-guides/
content/build/
build/
target/
node_modules/
.cache/
dist/
# Antora rendered sites (content/site-*.yml -> repo-root www/<flavor>)
www/
content/www/

# Local tooling noise
.DS_Store
*.log
.vale-cache/

# Claude Code local settings.
# The old note here claimed "project settings.json IS committed". That has been false since the
# 2026-07-19 owner review added the blanket `.claude/` below: the whole directory is ignored, so
# NOTHING under .claude/ is committed — settings.json and .claude/agents/ included, and
# `git ls-files .claude` returns zero. The two entries below are now redundant and are kept only
# as explicit intent: these two are per-machine regardless of how .claude/ is treated.
.claude/settings.local.json
.claude/launch.json

# kustomize helmCharts inflation pulls charts here at build time (Argo re-pulls on sync)
platform-portfolio/components/*/charts/

# Maintainer-local material (2026-07-19 owner review): present on maintainer machines,
# deliberately not part of the public tree.
.claude/
.vale/
.vale.ini
.yamllint.yaml
docs/
AGENTS.md

# Office lock/temp files (created when a deck is open in PowerPoint)
~$*
tools/slides/
CLAUDE.md

# Python bytecode (tools/media harness)
__pycache__/
*.pyc

# Python virtualenvs (tools/media/README.md tells you to create tools/media/.venv)
.venv/
venv/
