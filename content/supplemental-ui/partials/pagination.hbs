{{!
  Overrides the RHDP theme's stock partials/pagination.hbs. Structurally identical (same
  markup, same CSS classes, same page.attributes.pagination opt-out) — the only change is
  routing previous/next through the pagination-neighbors helper (helpers/pagination-neighbors.js)
  instead of reading page.previous/page.next directly, so a troubleshooting.adoc page listed in
  the sidebar (nav-workshop.adoc, nav-demo.adoc) is never handed out as a Next/Previous stop. See
  that helper's own comment for the full mechanism and why the fix is direction-symmetric.
}}
{{#unless (eq page.attributes.pagination undefined)}}
{{#with (pagination-neighbors page)}}
{{#if (or previous next)}}
<nav class="pagination">
  {{#with previous}}
  <span class="prev"><a href="{{{relativize ./url}}}" class="query-params-link">{{{./content}}}</a></span>
  {{/with}}
  {{#with next}}
  <span class="next"><a href="{{{relativize ./url}}}" class="query-params-link">{{{./content}}}</a></span>
  {{/with}}
</nav>
{{/if}}
{{/with}}
{{/unless}}
