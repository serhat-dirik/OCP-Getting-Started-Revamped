/* ── Click-to-run ▶ button (click-to-run.js adds it to every role=execute block) ──────────────
   Sits at the top-right of the code block, left of the theme's copy button, so attendees run a
   command in the terminal without copy-paste. */
.doc .listingblock.execute { position: relative; }
.run-in-terminal-btn {
  position: absolute; top: 0.35rem; right: 2.6rem; z-index: 3;
  font: 600 0.72rem/1 var(--body-font-family, sans-serif);
