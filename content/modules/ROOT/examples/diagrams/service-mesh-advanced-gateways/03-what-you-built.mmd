%% What you built — Service Mesh 3 & Advanced Gateways.
%% Shows the your-name-mesh namespace after the lab (meshed web/claims/fraud, un-meshed db) and the
%% mesh policy applied to it (VirtualService, DestinationRule, AuthorizationPolicy, Gateway), each
%% pointed at the fraud service or the namespace it governs.
%% Resized 2026-08-22: was 960x622 (rendered 900x583, text at 0.94x); a same-day direction-LR pass
%% made it worse (900x1608, 1.5x) — vs/dr/ap/gw all reached past `policy`'s boundary to fraud or ns,
%% silently disabling both subgraphs' direction LR. Fixed gw->ns at container level (policy->ns,
%% "ingress" — gw is policy's only namespace-wide member, so no meaning is lost) but left
%% vs/dr/ap -> fraud as node-to-node: each names a DIFFERENT policy object scoped specifically to
%% the fraud service, not the namespace (unlike gw) — collapsing to policy->ns would misstate that
%% scoping, and pulling fraud or vs/dr/ap out to standalone nodes only relocates the same crossing
%% (fraud is also the target of the in-`ns` claims->fraud edge). Both subgraphs' direction LR is
%% therefore still disabled by those 3 edges — flagged for a maintainer with scoping context, not
%% forced; see task report.
flowchart TB
  subgraph ns["your-name-mesh namespace — after the lab"]
    direction LR
    web["parasol-web<br/>(meshed)"]
    claims["parasol-claims<br/>(meshed · sa/parasol-claims)"]
    fraud["parasol-fraud v1 + v2<br/>(meshed)"]
    db[("claims-db<br/>un-meshed")]
    web ~~~ claims ~~~ fraud ~~~ db
  end
  subgraph policy["Mesh policy you applied"]
    direction LR
    vs["VirtualService<br/>90/10 + header route"]
    dr["DestinationRule<br/>subsets + circuit breaker"]
    ap["AuthorizationPolicy<br/>only claims -> fraud"]
    gw["Istio Gateway<br/>raw-TCP + rate limit"]
    vs ~~~ dr ~~~ ap ~~~ gw
  end
  web ==>|"mTLS"| claims
  claims ==>|"mTLS · 90/10 · authz"| fraud
  claims --> db
  vs -.->|"routes"| fraud
  dr -.->|"resilience"| fraud
  ap -.->|"guards"| fraud
  policy -.->|"ingress"| ns
  classDef app fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef pol fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef db fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  class web,claims,fraud app; class vs,dr,ap,gw pol; class db db;
