%% The partner gateway — Service Mesh 3 & Advanced Gateways, lab exercise 7 (optional).
%% One Istio gateway proxy, parasol-partner-gw, with two listeners: raw TCP on 9000 routed by the
%% partner-feed VirtualService to partner-tcp-backend, and HTTP on 8080 routed by web-via-gw to
%% parasol-web through an EnvoyFilter local rate limit (5 per minute, then 429).
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  P["partner feed<br/>raw TCP"] -->|"port 9000"| GW["parasol-partner-gw<br/>Istio Gateway"]
  C["HTTP caller"] -->|"port 8080"| GW
  GW -->|"partner-feed"| BE["partner-tcp-backend"]
  GW -->|"5 per minute, then 429"| WEB["parasol-web"]
  classDef caller fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef policy fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class P,C caller;
  class GW policy;
  class BE,WEB good;
