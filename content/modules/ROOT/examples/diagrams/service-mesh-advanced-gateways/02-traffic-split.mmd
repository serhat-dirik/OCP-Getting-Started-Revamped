flowchart LR
  CL["parasol-claims<br/>+ istio-proxy sidecar<br/>(the caller — this is where<br/>the route is programmed)"]
  TEST(["a test user's request<br/>x-parasol-test: true"])
  VS{"VirtualService parasol-fraud<br/>rule 1: header match<br/>rule 2: weighted split"}
  DR["DestinationRule<br/>defines the subsets v1 / v2,<br/>by the version label"]
  V1["parasol-fraud v1<br/>subset: v1"]
  V2["parasol-fraud v2<br/>subset: v2"]
  TEL["measure the REAL split from the<br/>mesh's own telemetry:<br/>istio_requests_total by destination_version"]
  CL --> VS
  TEST --> VS
  VS ==>|"weight: 90"| V1
  VS -->|"weight: 10"| V2
  VS -.->|"header matches — rule 1 wins,<br/>every tagged request goes to v2"| V2
  DR -.->|"names the pools<br/>the weights refer to"| VS
  V1 --> TEL
  V2 --> TEL
  classDef caller fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef policy fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef note fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
  class CL,TEST caller;
  class VS,DR policy;
  class V1,V2 good;
  class TEL note;
