%% A slow dependency, and surviving it — Service Mesh 3 & Advanced Gateways.
%% Drawn for the demo step that injects a 5s fault and applies the resilience policy, so it shows
%% ONLY what those two commands do: every control lives in the CALLER's sidecar; the injected delay
%% is applied ahead of the router, which is why the route's own timeout does not cut it short; and
%% the DestinationRule's outlier detection is what keeps the fast path serving when an endpoint
%% starts failing. The ejection label says "configured" on purpose — the step applies that policy
%% but injects a delay rather than a 5xx, so nothing is ejected in front of the customer, and the
%% picture must not claim otherwise.
%% ---
%% No subgraphs here, deliberately: a `direction` line is silently discarded the moment an edge
%% crosses a subgraph boundary (diagram-size-guard, rule 1), and every edge in this mechanism does
%% cross. Flat LR, longest chain 5 nodes, at most 2 line breaks per label.
%% ---
%% NEVER put an angle-bracket placeholder in a .mmd file: Antora emits mermaid source unescaped, so
%% a word in angle brackets becomes a real DOM element and the diagram dies while the build still
%% exits 0. A bare "%%" line with no text after it breaks the comment stripper the same silent way.
flowchart LR
  CL["parasol-claims + its sidecar<br/>(the caller — every control below<br/>is programmed into this proxy)"]
  FAULT["injected fault<br/>delay 5s on 100% of requests"]
  ROUTE["route policy<br/>timeout 3s · retries 2 x 1s"]
  POOL["DestinationRule pool<br/>outlier detection: 3 consecutive<br/>5xx eject an endpoint for 30s"]
  OK["parasol-fraud v1 + v2<br/>the endpoints still in the pool<br/>keep serving"]
  EJECT["an endpoint that keeps failing<br/>leaves the pool for 30s<br/>(configured, not triggered here)"]
  CL --> FAULT
  FAULT ==>|"the caller waits all 5s — the fault is applied<br/>ahead of the router, so timeout 3s never fires"| ROUTE
  ROUTE --> POOL
  POOL ==>|"the fast path keeps going"| OK
  POOL -.->|"cut off instead of waited on"| EJECT
  classDef caller fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef policy fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class CL caller;
  class ROUTE,POOL policy;
  class FAULT,EJECT bad;
  class OK good;
