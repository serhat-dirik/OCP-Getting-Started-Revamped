%% STRICT mutual TLS — Service Mesh 3 & Advanced Gateways, lab exercise 2 ("You'll end with").
%% istiod issues each sidecar a certificate carrying its SPIFFE identity. Under a STRICT
%% PeerAuthentication the un-meshed demo-client's plaintext call is reset by the web proxy, while
%% claims, whose proxy speaks mutual TLS, still reaches fraud with a 200.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  ISTIOD["istiod"] -->|"cert: sa/parasol-claims"| CL["parasol-claims<br/>+ proxy"]
  CL ==>|"mTLS: 200"| FR["parasol-fraud<br/>+ proxy"]
  DC["demo-client<br/>no proxy"] -.->|"plaintext: reset"| WEB["parasol-web<br/>+ proxy, STRICT"]
  classDef caller fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class ISTIOD caller;
  class CL,FR,WEB good;
  class DC bad;
