%% Mesh architecture — Service Mesh 3 & Advanced Gateways.
%% Shows the control plane (istiod + Kiali, blue) pushing config and mTLS certs out to the sidecar
%% proxies (amber) beside each app container (green: web, claims, fraud) in the data plane, the
%% resulting mTLS chain between proxies, and the un-meshed client (red) that STRICT mode refuses.
%% Resized 2026-08-22: was 2123x738, then a same-day direction-LR-only pass rendered 900x357 at
%% 0.46x — still too wide, because the istiod/kiali/client edges reached past the row subgraphs
%% straight to wsc/csc/fsc, silently disabling their `direction LR`. Re-pointed every one of those
%% at the row/pod containers instead — cp->mesh (x2), webpod->claimspod, meshrow1->fraudpod,
%% client->mesh — so no edge crosses a subgraph boundary at any nesting level and every direction LR
%% now holds: two stacked data-plane rows (web+claims, then fraud), each pod TB-internal (app over
%% proxy).
flowchart TB
  subgraph cp["Control plane — istio-system"]
    direction LR
    istiod["istiod<br/>config + identity (mTLS certs) · OSSM Sail operator"]
    kiali["Kiali console<br/>graph · health · mTLS badges"]
    istiod ~~~ kiali
  end
  subgraph mesh["Data plane — your-name-mesh namespace"]
    subgraph meshrow1["web + claims pods"]
      direction LR
      subgraph webpod["web pod"]
        web["parasol-web"] --- wsc(("proxy"))
      end
      subgraph claimspod["claims pod"]
        claims["parasol-claims"] --- csc(("proxy"))
      end
      webpod ~~~ claimspod
    end
    subgraph fraudpod["fraud pod"]
      fraud["parasol-fraud"] --- fsc(("proxy"))
    end
    meshrow1 ~~~ fraudpod
  end
  client["demo-client<br/>(un-meshed · no proxy)"]
  cp -.->|"pushes config + certs"| mesh
  webpod ==>|"mTLS"| claimspod
  meshrow1 ==>|"mTLS"| fraudpod
  client -.->|"plaintext<br/>(blocked under STRICT)"| mesh
  cp -.->|"reads telemetry"| mesh
  classDef cp fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef app fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef proxy fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef ext fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class istiod,kiali cp; class web,claims,fraud app; class wsc,csc,fsc proxy; class client ext;
