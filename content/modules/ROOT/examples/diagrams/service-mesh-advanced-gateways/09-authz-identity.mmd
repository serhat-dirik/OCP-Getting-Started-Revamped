%% Identity-based authorization — Service Mesh 3 & Advanced Gateways, lab exercise 6.
%% The AuthorizationPolicy on the fraud proxy ALLOWs one principal, sa/parasol-claims; every other
%% caller is denied implicitly: the web tier (a healthy pod with a different identity) and the
%% un-meshed demo-client (no mesh identity at all) both get 403.
%% Shape (diagram-size-guard): LR, chain of 2, no subgraph, labels at most 2 lines.
flowchart LR
  CL["parasol-claims<br/>sa/parasol-claims"] ==>|"200 allowed"| FR["parasol-fraud proxy<br/>ALLOW claims only"]
  WEB["parasol-web<br/>sa/default"] -.->|"403 denied"| FR
  DC["demo-client<br/>no mesh identity"] -.->|"403 denied"| FR
  classDef policy fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class FR policy;
  class CL good;
  class WEB,DC bad;
