%% Where the Kiali graph comes from — Service Mesh 3 & Advanced Gateways, lab exercise 3.
%% The attendee's curl loops pass through the sidecars, which count every request in
%% istio_requests_total; user-workload monitoring scrapes the proxies every 30s, and Kiali draws
%% rates from those scrapes, which is why the traffic has to run for about 45 seconds.
%% Shape (diagram-size-guard): LR, chain of 4, no subgraph, labels at most 2 lines.
flowchart LR
  T["your curl loops<br/>about 45s"] --> SC["sidecars<br/>istio_requests_total"]
  SC -->|"scraped every 30s"| MON["user-workload<br/>monitoring"]
  MON --> K["Kiali<br/>Traffic Graph"]
  classDef caller fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef policy fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class T caller;
  class SC,MON policy;
  class K good;
