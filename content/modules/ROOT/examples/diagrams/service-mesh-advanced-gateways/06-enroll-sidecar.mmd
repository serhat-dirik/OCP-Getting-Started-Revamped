%% Enrolling a workload — Service Mesh 3 & Advanced Gateways, lab exercise 1 ("You'll end with").
%% A namespace tenant cannot label the namespace (Forbidden, dashed); it patches the injection
%% label onto each Deployment's pod template instead. The rollout makes a new Pod, and the istiod
%% injector adds istio-proxy as a native sidecar beside the unchanged app container.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  YOU["you<br/>namespace owner"] -->|"oc patch"| LBL["pod template label<br/>sidecar.istio.io/inject"]
  YOU -.->|"Forbidden"| NSL["namespace label<br/>istio-injection"]
  LBL -->|"rollout"| INJ["istiod<br/>injector"]
  INJ --> POD["new Pod<br/>app + istio-proxy"]
  classDef caller fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef policy fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class YOU caller;
  class LBL,INJ policy;
  class POD good;
  class NSL bad;
