%% The deliberate break — Application Logging, lab exercise 1 ("Break it").
%% An invalid QUARKUS_LOG_LEVEL makes the new pod fail at startup. It never passes its readiness
%% probe, so the rolling update never retires the old pod, and the Service keeps sending traffic
%% to it: the app still answers while the new pod crash-loops.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  ENV["set env<br/>QUARKUS_LOG_LEVEL=VERBOSE"] --> NEW["new pod<br/>Error, never Ready"]
  NEW -->|"readiness probe fails"| RO{{"rollout waits"}}
  RO -->|"keeps"| OLD["old pod<br/>Ready, still serving"]
  SVC["Service and Route"] --> OLD
  classDef wrong fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class ENV,NEW wrong;
  class OLD good;
  class RO,SVC plat;
