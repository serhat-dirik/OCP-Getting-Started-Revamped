%% What you built — Application Logging.
%% Everything the claims service's log gained this module, in the order the lab builds it, plus the
%% one thing that was deliberately taken back OUT (the leaked credential).
%% Sized per house style: `flowchart TB`, `direction LR` inside every subgraph, `~~~` rows, one
%% `<br/>` maximum per label, container-to-container edges only.
flowchart TB
  subgraph emit["what the app now emits"]
    direction LR
    js["one JSON object per record<br/>timestamp · level · loggerName · mdc"]
    biz["writes at INFO, reads at DEBUG"]
    rid["requestId on every record"]
    js ~~~ biz ~~~ rid
  end
  subgraph dial["what you can change without a rebuild"]
    direction LR
    cm["claims-logging ConfigMap"]
    cat["one category up to DEBUG<br/>instead of the whole app"]
    al["access log off again"]
    cm ~~~ cat ~~~ al
  end
  subgraph ask["what you can now ask the log"]
    direction LR
    q1["count by level"]
    q2["one request across three pods"]
    q3["nothing that looks like a credential"]
    q1 ~~~ q2 ~~~ q3
  end
  emit --> dial
  dial --> ask
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class js,biz,rid good;
  class cm,cat,al plat;
  class q1,q2,q3 good;
