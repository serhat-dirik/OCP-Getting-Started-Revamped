%% A ConfigMap consumed as environment variables — Application Logging, lab exercise 3 ("Flip the dial").
%% Environment variables are read when the container starts, so `oc set data` changes the object
%% but not the running process; `oc rollout restart` starts a pod that reads the new value.
%% "No rebuild" is not "no restart".
%% Shape (diagram-size-guard): LR, longest chain 2 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  CM["claims-logging ConfigMap<br/>com.parasol: DEBUG"] -.->|"not re-read"| RUN["running pod<br/>still INFO"]
  CM -->|"read at start"| NEWP["new pod<br/>DEBUG"]
  RR["oc rollout restart"] --> NEWP
  classDef wrong fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class RUN wrong;
  class NEWP good;
  class CM,RR plat;
