%% Where a leaked key goes — Application Logging, lab exercise 4 ("The real fix").
%% A key in the query string is written by the access log's default pattern (the full request
%% line) and from there into every copy of the log, which is append-only: the remediation is a
%% rotation. The same key in a header is not part of the default pattern, so only the path is logged.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  URL["api_key in the URL"] --> AL["access log<br/>full request line"]
  AL --> KEEP["node file · collector · backup<br/>append-only"]
  KEEP --> ROT{{"remediation:<br/>rotate the key"}}
  HDR["key in a header"] -->|"not in the default pattern"| PATH["access log<br/>path only"]
  classDef wrong fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class URL,AL,KEEP wrong;
  class HDR,PATH good;
  class ROT plat;
