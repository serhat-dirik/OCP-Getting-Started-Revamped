%% Truncation is not redaction — Application Logging.
%% The demo's step 3: one access-log line carrying a partner's API key, and the two answers to it.
%% Cutting the line is arithmetic that holds only until a hostname or a message changes length;
%% naming the field is a transformation of the thing, so length stops mattering.
%% Sized per house style: `flowchart TB` at top level, `direction LR` inside every subgraph, `~~~`
%% chaining each subgraph's nodes into ONE row, at most two `<br/>` per label, and every edge joining
%% CONTAINER to CONTAINER so `direction` is honoured (see tools/lint/diagram-size-guard.py).
flowchart TB
  subgraph leak["what got written down"]
    direction LR
    req["a partner appends api_key=… <br/>to every call it makes"]
    log["the HTTP access log writes the whole request line"]
    req ~~~ log
  end
  subgraph cutit["answer 1 · show less of the line"]
    direction LR
    c60["cut -c1-60 — safe by 9 characters"]
    c72["cut -c1-72 — prints part of the key"]
    why["the client IP set that offset, nobody chose it"]
    c60 ~~~ c72 ~~~ why
  end
  subgraph redact["answer 2 · name the field"]
    direction LR
    field["replace the api_key value<br/>wherever it appears"]
    out["api_key=REDACTED, the rest of the line intact"]
    len["length stops mattering"]
    field ~~~ out ~~~ len
  end
  leak -->|"a character count"| cutit
  leak -->|"a transformation of the thing"| redact
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef wrong fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class req,log plat;
  class c60,c72,why wrong;
  class field,out,len good;
