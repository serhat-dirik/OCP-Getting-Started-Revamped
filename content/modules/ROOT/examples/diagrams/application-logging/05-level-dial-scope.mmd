%% What the level dial reaches — Application Logging.
%% The demo's step 2: the same setting, changed without a rebuild, reaches your own classes when it
%% is set on your category and every framework layer underneath when it is set on the root — the ORM
%% included, which at DEBUG writes down every statement it runs. Volume and disclosure both change;
%% only one of them turns up on a bill.
%% Sized per house style: `flowchart TB` at top level, `direction LR` inside every subgraph, `~~~`
%% chaining each subgraph's nodes into ONE row, at most two `<br/>` per label. Every edge joins
%% CONTAINER to CONTAINER — a node-to-node edge across a subgraph boundary silently discards
%% `direction` and turns this into a tall column (see tools/lint/diagram-size-guard.py).
flowchart TB
  subgraph dial["one setting, two places to put it"]
    direction LR
    cfg["claims-logging ConfigMap<br/>changed with no rebuild"]
    cat["com.parasol to DEBUG"]
    root["root to DEBUG"]
    cfg ~~~ cat ~~~ root
  end
  subgraph mine["what the category dial reaches"]
    direction LR
    app["your own classes, and nothing else"]
    cost4["4 records for 4 identical requests"]
    app ~~~ cost4
  end
  subgraph all["what the root dial reaches as well"]
    direction LR
    fw["HTTP metrics, bean container, config"]
    orm["org.hibernate.SQL<br/>every statement the ORM runs"]
    cost90["90 to 110 records for the same 4 requests"]
    fw ~~~ orm ~~~ cost90
  end
  dial -->|"set on your category"| mine
  dial -->|"set on the root"| all
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef wrong fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class cfg,cat plat;
  class root wrong;
  class app,cost4 good;
  class fw,orm,cost90 wrong;
