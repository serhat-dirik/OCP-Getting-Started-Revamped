%% Correlating one request across replicas — Application Logging.
%% The question exercise 1 leaves hanging and exercise 5 answers: three replicas mean three
%% independent log streams, and "which pod served that request" has no answer until the id is a
%% FIELD of the record rather than a sentence in it.
%% Sized per house style — `flowchart TB`, `direction LR` in every subgraph, `~~~` rows, one
%% `<br/>` maximum per label, container-to-container edges only.
flowchart TB
  subgraph action["one user action carries one X-Request-Id"]
    direction LR
    user["adjuster opens claim CLM-1031"]
    hdr["X-Request-Id: parasol-8f3a<br/>sent by the caller, or generated here"]
    user ~~~ hdr
  end
  subgraph pods["three replicas · three separate log streams"]
    direction LR
    p1["pod A logs the list"]
    p2["pod B logs the lookup"]
    p3["pod C logs the status change"]
    p1 ~~~ p2 ~~~ p3
  end
  subgraph findit["one query finds all three"]
    direction LR
    mdc["MDC puts requestId<br/>on every record that thread writes"]
    host["hostName names the pod that wrote it"]
    jq["select(.mdc.requestId == …)"]
    mdc ~~~ host ~~~ jq
  end
  action -->|"the same id on every hop"| pods
  pods -->|"structured, so it is queryable"| findit
  classDef ctx fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class user,hdr ctx;
  class p1,p2,p3 plat;
  class mdc,host,jq good;
