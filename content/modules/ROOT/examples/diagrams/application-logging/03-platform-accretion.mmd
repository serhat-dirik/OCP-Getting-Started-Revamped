%% Platform accretion — Application Logging.
%% ONE cumulative picture of the Parasol platform, with THIS module's layer lit up (red) on
%% everything the attendee has already built (grey) — same convention as the sibling
%% NN-platform-accretion.mmd files in every other module. If you change the grey base here,
%% change it in the siblings too.
%% Sized per house style: `flowchart TB` at top level, `direction LR` inside every subgraph, `~~~`
%% chaining nodes into one row per subgraph, one `<br/>` maximum per label, and every edge joining
%% container to container so `direction` is honoured.
flowchart TB
  subgraph LOG["the log layer (this module)"]
    direction LR
    JSON[structured JSON on stdout]
    LVL["level dial<br/>per category, from config"]
    RID[request id through the MDC]
    RED[no credentials, no PII]
    JSON ~~~ LVL ~~~ RID ~~~ RED
  end
  subgraph PLAT["the Parasol claims platform so far"]
    direction LR
    APP[claims service + db]
    DEL[pipelines + GitOps]
    OBS[metrics + traces + autoscaling]
    APP ~~~ DEL ~~~ OBS
  end
  LOG --> PLAT
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class JSON,LVL,RID,RED hi;
  class APP,DEL,OBS plat;
