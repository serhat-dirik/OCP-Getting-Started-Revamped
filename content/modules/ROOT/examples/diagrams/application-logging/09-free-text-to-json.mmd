%% Free text to structured records — Application Logging, lab exercise 2 ("You'll end with").
%% One environment variable on the same running image switches the Quarkus console handler to one
%% JSON object per record; the named fields are what every query in exercises 2 to 5 filters on.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  TXT["free-text line<br/>jq: parse error"] -->|"one env var, no rebuild"| JSON["one JSON object<br/>per record"]
  JSON --> F["named fields<br/>level · loggerName · hostName"]
  F --> Q["field queries<br/>count by level, filter by logger"]
  classDef wrong fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class TXT wrong;
  class JSON,F,Q good;
