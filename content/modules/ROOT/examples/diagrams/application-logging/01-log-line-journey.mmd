%% Where a log line goes — Application Logging.
%% Three ranks, and the module's whole scope argument in one picture: rank 1 is the half a
%% developer controls, rank 2 is what every OpenShift cluster does for free, rank 3 is the tier a
%% platform team may add and that this module deliberately does NOT build.
%% Sized per house style: `flowchart TB` at top level, `direction LR` inside every subgraph, `~~~`
%% chaining each subgraph's nodes into ONE row, at most one `<br/>` per label. Every edge joins
%% CONTAINER to CONTAINER — a node-to-node edge across a subgraph boundary silently discards
%% `direction` and turns this into a tall column (see tools/lint/diagram-size-guard.py).
flowchart TB
  subgraph writes["1 · what your container writes — the half you control"]
    direction LR
    ok["stdout / stderr<br/>the only stream the platform collects"]
    bad["a file inside the container<br/>nothing reads it; it dies with the pod"]
    ok ~~~ bad
  end
  subgraph node["2 · what the node does with it — free, on every cluster"]
    direction LR
    cri["CRI-O captures the stream"]
    disk["/var/log/pods/… kubelet-rotated"]
    read["oc logs · console Logs tab"]
    cri ~~~ disk ~~~ read
  end
  subgraph tier["3 · the platform team's optional tier — NOT built in this module"]
    direction LR
    clf["ClusterLogForwarder<br/>collect · filter · route"]
    loki["LokiStack<br/>stores it, one tenant per namespace"]
    query["query across every pod, past the rotation"]
    clf ~~~ loki ~~~ query
  end
  writes -->|"stdout only — the file path ends here"| node
  node -->|"once volume outgrows one pod at a time"| tier
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef wrong fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class ok good;
  class bad wrong;
  class cri,disk,read plat;
  class clf,loki,query plat;
