%% How a request id reaches every record — Application Logging, lab exercise 5 ("What just happened").
%% A small filter in the claims service takes the caller's X-Request-Id (or generates one),
%% neutralizes it with LogSafe, puts it in the MDC so every record written on that thread carries it
%% as a field, and echoes it back as a response header.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  IN["X-Request-Id<br/>sent, or generated"] --> FIL["request filter<br/>LogSafe neutralizes it"]
  FIL --> MDC["MDC requestId"]
  MDC --> REC["every record on that thread<br/>a field, on any pod"]
  FIL -->|"echoed back"| RESP["x-request-id<br/>response header"]
  classDef ctx fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class IN,FIL,MDC ctx;
  class REC,RESP good;
