%% Three replicas, three log streams — Application Logging, lab exercise 1 ("You'll end with").
%% Six submissions through the Route land on three pods; `oc logs -l --prefix --tail=-1` concatenates
%% one stream per pod, grouped by pod rather than by time, and nothing in a free-text line ties it
%% to one caller — the question exercise 5 answers.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  RT["Route<br/>six claim submissions"] --> PA["pod A"]
  RT --> PB["pod B"]
  RT --> PC["pod C"]
  PA --> LOG["oc logs -l --prefix<br/>grouped by pod"]
  PB --> LOG
  PC --> LOG
  LOG --> Q{{"which line was Dana's?"}}
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef wrong fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class RT,PA,PB,PC,LOG plat;
  class Q wrong;
