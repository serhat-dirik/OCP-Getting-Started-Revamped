%% A request during the site failure — Resilience, Multi-Cluster & DR, lab exercise 2 ("What just happened").
%% With site A scaled to zero, a request sent there fails; the VirtualService retry may leave the
%% locality (retryRemoteLocalities) and lands on site B with HTTP 200, while outlier detection
%% ejects site A so the following requests go straight to site B.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  REQ["request at<br/>the gateway"] --> A["site A<br/>scaled to 0"]
  A -->|"fails"| RT["retry<br/>may leave locality"]
  RT --> B["site B<br/>HTTP 200"]
  A -->|"fails"| EJ["outlier detection<br/>ejects site A"]
  EJ -->|"next requests"| B
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef down fill:#fff,stroke:#900,color:#900,stroke-dasharray: 4 3;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class REQ plat;
  class A down;
  class RT,EJ hi;
  class B done;
