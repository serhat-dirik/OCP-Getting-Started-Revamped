%% Platform accretion — Resilience, Multi-Cluster & DR.
%% ONE cumulative picture of the Parasol platform, with THIS module's layer lit up (red) on
%% everything the attendee has already built (grey). Authored per module (owner decision
%% 2026-07-28) rather than generated: explicit and readable, at the cost of keeping the grey
%% base in step across all 12 when the platform changes. If you change the base here, change it
%% in the sibling per-module NN-platform-accretion.mmd files too.
%% ---
%% NEVER put an angle-bracket placeholder in a .mmd file. Antora emits mermaid source into the
%% page UNESCAPED, so a word wrapped in angle brackets becomes a REAL DOM element that swallows
%% the rest of the graph, and mermaid then renders "Syntax error in text" on the page while the
%% Antora build still exits 0 and every HTML check still passes (measured 2026-08-06, mermaid
%% 10.9.8). The line-break tag is the only markup safe inside a label. Write placeholders in
%% CAPS - PREV-SLUG, NEW-OBJECT-1 - never in angle brackets.
%% Second trap, same symptom: a BARE "%%" line with no text after it defeats mermaid's comment
%% stripper - the leftover marker merges into the next line ("%%flowchart TB") and the diagram
%% dies exactly the same silent way. Always put text after %% - this file uses "%% ---".
flowchart TB
  subgraph THIS["this module adds"]
    direction LR
    DR1["cross-site failover (mesh)<br/>locality · outlier · retries"]
    DR2["RHSI VAN<br/>Site · Link · Connector"]
    DR3["OADP restore + GitOps<br/>DR safety net"]
    DR1 ~~~ DR2 ~~~ DR3
  end
  subgraph BASE["the Parasol platform you have already built"]
    direction LR
    P1["the Parasol app + its full platform, meshed"]
    P2["serverless: Knative scale-to-zero"]
    P3["eventing: Broker/Trigger + DLQ"]
    P1 ~~~ P2 ~~~ P3
  end
  THIS --> BASE
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class DR1,DR2,DR3 hi;
  class P1,P2,P3 plat;
