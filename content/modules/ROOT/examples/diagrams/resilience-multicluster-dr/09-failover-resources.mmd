%% Failover wiring — Resilience, Multi-Cluster & DR, lab exercise 2 (the three mesh resources).
%% The client's stable endpoint is the ingress gateway; the VirtualService claims-edge routes it,
%% with retries, to the logical host the ServiceEntry claims-global declares; that host's two
%% endpoints are site A (priority 0, the gateway's own locality) and site B (the failover). The
%% DestinationRule claims-global sets the policy on that host: locality preference and outlier ejection.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  GW["ingress gateway<br/>claims-stable"] --> VS["VirtualService<br/>route + retries"]
  VS --> SE["ServiceEntry<br/>claims.parasol.internal"]
  SE ==>|"priority 0"| A["site A<br/>east/site-a"]
  SE -.->|"failover"| B["site B<br/>east/site-b"]
  DR["DestinationRule<br/>prefer local · eject failing"] -.->|"policy"| SE
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef pa fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef pb fill:#fef7e0,stroke:#b06000,color:#7a4100;
  class VS,SE,DR hi;
  class GW plat;
  class A pa;
  class B pb;
