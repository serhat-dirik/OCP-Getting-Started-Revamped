%% Resilience ladder — Resilience, Multi-Cluster & DR concept page.
%% Six-rung chain: pod -> node -> zone -> site -> region -> survives. Kept `flowchart BT` at the
%% top level (not the usual TB) so the two rows still climb low-severity-at-bottom to
%% high-severity-at-top, matching "read the ladder bottom-up" in the concept prose; each row is a
%% subgraph with `direction LR` so its nodes spread sideways instead of stacking into a column, and
%% the real (not invisible) edges already chain them left to right. Row 1 (bottom): pod, node, zone
%% (rungs 1-3, in-site). Row 2 (top): site, region, survives (rungs 4-5). Resized 2026-08-22: was
%% 492x740 intrinsic (900x1354 rendered, text at 1.83x).
%% Follow-up 2026-08-22: `zone->site` crossed from "insite" into "beyond", silently disabling both
%% subgraphs' `direction LR` (900x1421 @1.69x). Re-pointed at the containers (`insite->beyond`).
%% Kept `flowchart BT` — the bottom-up read is unrelated to the crossing-edge bug.
flowchart BT
  subgraph insite["in-site resilience — rungs ①–③"]
    direction LR
    pod["① Pod fails / crashes"]
    node["② Node fails / is drained"]
    zone["③ Zone (AZ) fails"]
    pod -->|"Deployment replicas + readiness/liveness probes<br/>(Platform Orientation, Observability)"| node
    node -->|"PodDisruptionBudget + topologySpreadConstraints<br/>+ anti-affinity + HPA headroom (Deployment Targets & Scheduling)"| zone
  end
  subgraph beyond["failover, then platform DR — rungs ④–⑤"]
    direction LR
    site["④ A whole SITE fails<br/>(data center / cluster / namespace)"]
    region["⑤ Region fails"]
    top["survives"]
    site -->|"cross-site failover: Service Mesh (mesh) · RHSI VAN<br/>(THIS lab — application level)"| region
    region -->|"OADP + GitOps re-materialize · active-active<br/>(platform DR — concept)"| top
  end
  insite -->|"spread across AZs + capacity headroom"| beyond
  classDef inapp fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef failover fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef dr fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
  class pod,node,zone inapp; class site failover; class region dr; class top dr;
