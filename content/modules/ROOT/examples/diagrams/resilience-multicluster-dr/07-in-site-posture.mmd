%% In-site posture — Resilience, Multi-Cluster & DR, lab exercise 1 ("You'll end with").
%% Site A's claims service as the attendee proves it: the HPA holds the Deployment at three
%% replicas or more, the Deployment spreads them one per node, the PodDisruptionBudget keeps two
%% available, and the Terminal 2 request loop ends with 0 failed through a pod kill and two evictions.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  HPA["HPA<br/>floor 3 · ceiling 6"] -->|"scales"| DEP["Deployment<br/>parasol-claims"]
  DEP -->|"spread"| PODS["3 pods<br/>one per node"]
  PDB["PDB<br/>min available 2"] -->|"guards"| PODS
  PODS -->|"kill · evict"| LOOP["request loop<br/>0 failed"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class HPA,DEP,PDB plat;
  class PODS hi;
  class LOOP done;
