%% Linking two sites — Resilience, Multi-Cluster & DR, lab exercise 3 (the token exchange).
%% DC-A, the linkable site, issues an AccessGrant that publishes url, code and ca in its status; the
%% lab's block copies them into an AccessToken in DC-B; the controller redeems it and creates the
%% Link, which turns Ready and puts both sites in one Virtual Application Network.
%% Shape (diagram-size-guard): LR, longest chain 5 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  AG["AccessGrant<br/>in DC-A"] -->|"url · code · ca"| SC["lab block<br/>copies them"]
  SC --> AT["AccessToken<br/>in DC-B"]
  AT -->|"redeemed"| LK["Link<br/>Ready"]
  LK --> VAN["one VAN<br/>2 sites in network"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class AG,AT hi;
  class SC plat;
  class LK,VAN done;
