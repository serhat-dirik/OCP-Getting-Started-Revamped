%% Eviction and the disruption budget — Resilience, Multi-Cluster & DR, lab exercise 1 (eviction beat).
%% What the evict helper (and every node drain) does: post an Eviction to the API, which checks the
%% PodDisruptionBudget's allowed disruptions. One left: 201, the pod goes and the ReplicaSet starts a
%% replacement. None left: 429 TooManyRequests, and the caller waits for the budget, then retries.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  EV["evict helper<br/>or oc adm drain"] --> API["Eviction API"]
  API --> CHK{"PDB: disruptions<br/>allowed?"}
  CHK -->|"1"| OK["201 · pod removed<br/>replacement starts"]
  CHK -->|"0"| NO["429 TooManyRequests<br/>wait, then retry"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef wait fill:#fef7e0,stroke:#b06000,color:#7a4100;
  class EV,API plat;
  class CHK hi;
  class OK done;
  class NO wait;
