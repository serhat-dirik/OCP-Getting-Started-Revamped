%% Platform accretion — Observability, Health & Scale.
%% ONE cumulative picture of the Parasol platform, with THIS module's layer lit up (red) on
%% everything the attendee has already built (grey) — same convention as the sibling
%% NN-platform-accretion.mmd files in every other module.
%% Resized 2026-08-22: was 433x531 intrinsic, rendering 900x1104 at 2.08x text. The subgraphs had
%% no `direction` set, so they inherited the outer `flowchart TB` and stacked their children in a
%% column. Fix: the same `direction LR` + `~~~` idiom already used by every other
%% platform-accretion diagram — each subgraph becomes one short row, the two rows stack.
flowchart TB
  subgraph OBS["observe & steer (this module)"]
    direction LR
    MET[metrics + alerts]
    TRC[traces]
    HPA2[HPA autoscaling]
    PDB2[PDB resilience]
    MET ~~~ TRC ~~~ HPA2 ~~~ PDB2
  end
  subgraph PLAT["the Parasol claims platform so far"]
    APP[claims service + db]
    DEL[pipelines + GitOps]
    APP ~~~ DEL
  end
  OBS --> APP
  OBS --> DEL
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class MET,TRC,HPA2,PDB2 hi;
  class APP,DEL plat;
