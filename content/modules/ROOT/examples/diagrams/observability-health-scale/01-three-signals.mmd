%% The three signals — Observability, Health & Scale.
%% Metrics, logs, and traces, and the one question each answers best; illustrates the "three
%% signals" discussion in concept.adoc.
%% Resized 2026-08-22: was 562x377 intrinsic, rendering 900x604 at 1.6x text. Each answer node
%% carried two `<br/>` breaks (three lines), which drove the height. Direction stays `LR`: this
%% tree's widest content sits in its last rank (the answer nodes), not in its branching, so
%% `flowchart TB` would spread those three wide nodes side by side and make it wider, not shorter.
%% Fix per house style: trim every label to one `<br/>` (two lines) by folding the aside onto the
%% second line — no wording removed.
flowchart LR
  APP[claims request] --> M[metrics]
  APP --> L[logs]
  APP --> T[traces]
  M --> MQ["<b>How much / how fast / how bad?</b><br/>rates, errors, latency, saturation — cheap, always-on, alertable"]
  L --> LQ["<b>What exactly happened?</b><br/>one event, full detail — rich, but noisy at scale"]
  T --> TQ["<b>Where did the time go?</b><br/>one request across services — the path and its slow hop"]
  classDef sig fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef q fill:#f3f3f3,stroke:#888,color:#333;
  class M,L,T sig;
  class MQ,LQ,TQ q;
