graph LR
  IN["Inactive<br/>State: -"] -->|"5xx rate over 0.1/s"| PE["Pending<br/>for: 2m counting"]
  PE -->|"still over after 2m"| FI["Firing<br/>alert sent"]
  PE -.->|"drops back"| IN
  FI -.->|"spike ages out"| IN
  classDef ok fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef warn fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class IN ok;
  class PE warn;
  class FI bad;
