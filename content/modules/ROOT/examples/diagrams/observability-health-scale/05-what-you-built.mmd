%% What you built — Observability, Health & Scale.
%% Everything the claims service gained this module: scraped metrics + a firing alert, a trace,
%% CPU autoscaling, and a disruption budget.
%% Resized 2026-08-22: was 716x445 intrinsic, rendering 900x559 at 1.26x text. Labels were already
%% within the one-`<br/>` budget, so no label trimming was needed; the height came from `LR`
%% stacking APP's four direct children (ServiceMonitor, traces, HPA, PDB) into four rows. Fix:
%% `flowchart TB` at top level — with no subgraph to re-group, TB alone spreads same-rank siblings
%% into a row instead of a column.
flowchart TB
  APP["claims service<br/>/q/metrics + OTel"] --> SM[ServiceMonitor] --> UWM[user-workload<br/>monitoring]
  UWM --> DASH[Observe -> Metrics]
  UWM --> AL["PrometheusRule<br/>-> alert fires"]
  APP --> TR["Observe -> Traces<br/>(Tempo)"]
  APP --> HPA["HPA<br/>2 -> 4 on CPU"]
  APP --> PDB["PDB<br/>survive the drain"]
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class SM,AL,HPA,PDB,TR good;
  class UWM,DASH plat;
