%% The one scoped write — AI-Assisted Development, demo step 2.
%% Draws ONLY what that step's commands do: a Role carrying a single verb set on a single
%% resource, a RoleBinding tying it to mcp-agent in ONE namespace, the one field the agent
%% then patches, and what stays out of reach. No subgraphs (an edge crossing one discards
%% its `direction` line silently — see tools/lint/diagram-size-guard.py), five nodes in the
%% longest chain, at most one line break per label.
%% ---
%% NEVER put an angle-bracket placeholder in a .mmd file. Antora emits mermaid source into the
%% page UNESCAPED, so a word wrapped in angle brackets becomes a REAL DOM element that swallows
%% the rest of the graph, and mermaid then renders "Syntax error in text" while the Antora build
%% still exits 0 and every HTML check still passes. Write placeholders in CAPS.
%% Second trap, same symptom: a BARE "%%" line with no text after it defeats mermaid's comment
%% stripper - the leftover marker merges into the next line and the diagram dies the same silent
%% way. Always put text after %% - this file uses "%% ---".
graph LR
  role["Role 'mcp-agent-deployer'<br/><b>update + patch on deployments</b>, and nothing else"]
  rb["RoleBinding, granted by a human<br/><b>this namespace only</b>"]
  sa["ServiceAccount <b>mcp-agent</b><br/>the identity every agent call is made as"]
  patch["Agent patches ONE field<br/>readinessProbe path to /q/health/ready"]
  dep["Deployment parasol-claims<br/><b>1/1 Ready</b>, writer recorded in managedFields"]
  rest["Secrets, every other resource kind,<br/>every other namespace: <b>403</b>"]
  role --> rb --> sa --> patch --> dep
  sa -.->|"never granted"| rest
  classDef rw fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef id fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef ok fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef deny fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class role,rb,patch rw; class sa id; class dep ok; class rest deny;
