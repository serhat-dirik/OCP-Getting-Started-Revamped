%% Two-phase RBAC model — AI-Assisted Development.
%% Resized 2026-08-22 (before: 574x679 intrinsic, rendered 900x1065 at 1.57x text — a plain `graph TD`
%% chaining node -> subgraph -> node -> subgraph -> {node,node} top to bottom, five levels tall).
%% Now two `direction LR` subgraphs, one per phase: Phase 1 groups the diagnosis with the read-only
%% access it runs under; Phase 2 groups the write grant with its two outcomes (fix / 403). The two
%% phases are joined by a single edge carrying the human-grant text — the same idiom as
%% build-deliver/02-platform-accretion-v2.mmd. `v` and `e` were over the one-<br/> limit; compressed
%% with " · ", no information dropped.
flowchart TB
  subgraph p1["Phase 1 — read-only (eyes)"]
    direction LR
    diag["Agent DIAGNOSES the broken app"]
    v["mcp-agent → ClusterRole 'view' (RoleBinding, namespaced)<br/>list/get pods, events, deployments, logs · <b>no secrets, no writes, one namespace</b>"]
    diag ~~~ v
  end
  subgraph p2["Phase 2 — scoped write (hands)"]
    direction LR
    e["+ a small 'deployer' Role<br/>patch/update deployments in THIS namespace only · <b>still no secrets, still one namespace</b>"]
    fix["Agent FIXES the one field"]
    forbidden["Agent asked to touch another namespace<br/>→ <b>RBAC denies it (403)</b>"]
    e --> fix
    e --> forbidden
  end
  p1 -->|"You grant the scoped write<br/>(a human decision)"| p2
  classDef ro fill:#e8f0fe,stroke:#1967d2,color:#174ea6;
  classDef rw fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef deny fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class v ro; class e rw; class forbidden deny;
