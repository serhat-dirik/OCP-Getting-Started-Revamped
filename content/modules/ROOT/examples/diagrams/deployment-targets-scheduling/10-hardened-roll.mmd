%% The hardened roll — Deployment Targets & Scheduling, lab exercise 5 ("You'll end with").
%% With maxSurge 1 and maxUnavailable 0, each surge pod must be Ready before one old pod retires, so
%% three replicas stay available through the whole roll; with the schema strategy set to none, the
%% booting pod no longer reseeds the shared claims-db, so writes survive the roll.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  NEW["surge pod boots<br/>schema: none"] -->|"Ready first"| OLD["then one old pod<br/>retires"]
  OLD --> FLOOR["3 of 3 available<br/>the whole roll"]
  NEW -.->|"no reseed"| DB[("claims-db<br/>your writes kept")]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef data fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  class NEW hi;
  class OLD,FLOOR done;
  class DB data;
