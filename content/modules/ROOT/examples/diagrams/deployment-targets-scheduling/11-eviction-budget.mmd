%% A drain through the budget — Deployment Targets & Scheduling, lab exercise 6 ("You'll end with").
%% A node drain (or the attendee's own eviction loop) asks the Eviction API for each pod; the API checks
%% the PodDisruptionBudget first. Room left: 201, the pod is evicted and replaced elsewhere. No room:
%% 429 TooManyRequests, and the drain waits 5 seconds and asks again.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  DRAIN["oc adm drain<br/>or your loop"] -->|"Eviction API"| PDB{"budget<br/>room left?"}
  PDB -->|"yes: 201"| GONE["pod evicted<br/>replaced elsewhere"]
  PDB -->|"no: 429"| WAIT["wait 5 s<br/>ask again"]
  WAIT -.-> PDB
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef guard fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef warn fill:#fef7e0,stroke:#b06000,color:#7a4100;
  class DRAIN hi;
  class PDB guard;
  class GONE done;
  class WAIT warn;
