%% What you built — Deployment Targets & Scheduling.
%% The dedicated batch pool (tainted, tolerated by statement-batch) alongside the general pool where
%% parasol-claims spreads across nodes (anti-affinity) next to parasol-web and claims-db, guarded by
%% a PodDisruptionBudget.
%% Resized 2026-08-22: intrinsic 776x568 (h/w 0.73, over the 0.55 band) — the general subgraph's five
%% nodes had no explicit direction and were landing tall. Fix: `direction LR` in each subgraph plus
%% invisible links to hold all five general nodes in one row, per the platform-accretion idiom.
%% Follow-up 2026-08-22: pdb-->c1 crossed the general subgraph's boundary, silently disabling
%% direction LR. Fixed by routing container-to-container: pdb-->general (label "protects" kept as
%% is) — also a better fit, since the PDB protects the whole spread deployment, not one replica.
flowchart TB
  subgraph pool["Dedicated batch pool (tainted)"]
    direction LR
    batch["statement-batch<br/>toleration + nodeSelector"]
  end
  subgraph general["General nodes (spread)"]
    direction LR
    c1["parasol-claims"]
    c2["parasol-claims"]
    c3["parasol-claims"]
    web["parasol-web"]
    db[("claims-db")]
    c1 -.->|"anti-affinity:<br/>distinct nodes"| c2
    c2 -.-> c3
    c3 ~~~ web
    web ~~~ db
  end
  pdb["PodDisruptionBudget<br/>minAvailable 1"]
  pdb -->|"protects"| general
  classDef ok fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef pool fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef guard fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  class c1,c2,c3,web,db ok;
  class batch pool;
  class pdb guard;
