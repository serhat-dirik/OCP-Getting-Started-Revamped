%% Scheduler pipeline — Deployment Targets & Scheduling.
%% Filter, then score, then bind — the two-step pipeline concept.adoc walks node by node, plus the
%% no-survivor branch. Keep the words filter/score/bind, "survivors", Pending and FailedScheduling.
%% Rewrapped 2026-08-23: `filter` and `score` each carried four label lines. The step number and
%% its question now share one line, joined by an em dash. No word changed.
graph LR
  pod["Pending pod<br/>(requests: cpu/mem,<br/>tolerations, selectors)"]
  subgraph sched["kube-scheduler"]
    filter["1 · FILTER — which nodes CAN run it?<br/>enough free requests · taints tolerated ·<br/>nodeSelector/affinity match"]
    score["2 · SCORE — which survivor is BEST?<br/>most room · best spread ·<br/>anti-affinity honoured"]
  end
  bind["BIND to the winning node"]
  fail["no node survives →<br/>Pending + FailedScheduling event"]
  pod --> filter --> score --> bind
  filter -. "0 survive" .-> fail
  classDef p fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef s fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef b fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef f fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class pod p; class filter,score s; class bind b; class fail f;
