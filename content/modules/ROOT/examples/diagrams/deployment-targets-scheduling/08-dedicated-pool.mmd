%% A dedicated pool — Deployment Targets & Scheduling, lab exercise 4 ("You'll end with").
%% statement-batch carries a nodeSelector for the pool label and a toleration for the pool taint, so it
%% is sent to the batch-pool node and permitted onto it; the NoSchedule taint keeps every pod without
%% that toleration off the node.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  BATCH["statement-batch<br/>selector + toleration"] -->|"sent and permitted"| NODE["batch-pool node<br/>label + NoSchedule taint"]
  NODE -.->|"repels"| OTHER["ordinary pods<br/>no toleration"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef pool fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class BATCH hi;
  class NODE pool;
  class OTHER plat;
