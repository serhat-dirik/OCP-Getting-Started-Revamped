%% Selector alone, then the toleration — Deployment Targets & Scheduling, lab exercise 4 ("What just happened").
%% The break-and-fix: a nodeSelector alone sends the batch pod at a tainted pool and it stays Pending on
%% the untolerated taint; adding the toleration lets it run on the batch-pool node. Below the 3-worker
%% floor the pool is untainted, so the selector alone schedules at once and there is no refusal to see.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  SEL["nodeSelector only"] -->|"tainted pool"| PEND["Pending<br/>untolerated taint"]
  PEND -->|"add toleration"| RUN["Running on the<br/>batch-pool node"]
  SEL -.->|"untainted pool"| EARLY["Running at once<br/>no refusal to see"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef gone fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class SEL hi;
  class PEND gone;
  class RUN done;
  class EARLY plat;
