%% The topology key is a knob — Deployment Targets & Scheduling, lab exercise 3 ("You'll end with").
%% One topologySpreadConstraints entry (maxSkew 1, ScheduleAnyway): keyed on kubernetes.io/hostname it
%% spreads the replicas evenly across nodes; keyed on the synthetic workshop zone label it scores them
%% across zones a, b and c, and because ScheduleAnyway is a preference the result can settle skewed
%% and is never rebalanced.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  TSC["topologySpreadConstraints<br/>maxSkew 1"] -->|"key: hostname"| NODES["one replica<br/>per node"]
  TSC -->|"key: zone"| ZONES["scored across<br/>zones a, b, c"]
  ZONES -.->|"ScheduleAnyway"| SKEW["may settle skewed<br/>never rebalanced"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef warn fill:#fef7e0,stroke:#b06000,color:#7a4100;
  class TSC hi;
  class NODES,ZONES done;
  class SKEW warn;
