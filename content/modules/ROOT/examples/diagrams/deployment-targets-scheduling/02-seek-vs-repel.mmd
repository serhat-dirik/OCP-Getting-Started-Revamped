%% Seek vs repel — Deployment Targets & Scheduling.
%% The distinction the whole module turns on: affinity is the POD reaching toward a node (attract);
%% a taint is the NODE pushing pods away (repel) — and a toleration only permits, it never attracts.
%% Resized 2026-08-22: intrinsic 1591x149 (extremely flat, text at 0.57x) — both sides of the contrast
%% were landing in one wide, unstructured row. Fix: each side becomes its own `direction LR`
%% subgraph, the two stacked TB with an invisible link, per the platform-accretion idiom (rule 3 —
%% wrap a too-wide chain onto two rows, one per side of the contrast).
flowchart TB
  subgraph seek["AFFINITY — the POD seeks (attract)"]
    direction LR
    p1["pod: nodeSelector / nodeAffinity<br/>'put me on a node like this'"]
    n1["node with matching label"]
    p1 -->|"pulls toward"| n1
  end
  subgraph repel["TAINT — the NODE repels"]
    direction LR
    n2["node: taint<br/>'keep pods off me'"]
    p2["pod without toleration"]
    p3["pod WITH toleration"]
    n2 -.->|"pushes away"| p2
    p3 -->|"tolerated → permitted<br/>(but not attracted)"| n2
  end
  seek ~~~ repel
  classDef a fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef r fill:#fef7e0,stroke:#b06000,color:#7a4100;
  class p1,n1 a; class n2,p2,p3 r;
