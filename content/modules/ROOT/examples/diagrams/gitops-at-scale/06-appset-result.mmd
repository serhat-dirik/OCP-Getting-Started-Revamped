%% ApplicationSet result — GitOps at Scale, lab exercise 1 ("You'll end with").
%% One list-generator ApplicationSet adopts the two hand-made Applications by name and
%% generates the new prod one, which stands production up as a Rollout.
%% Shape (diagram-size-guard): LR, longest chain 3, labels at most 2 lines, no subgraph.
flowchart LR
  SET["ApplicationSet<br/>list generator"] -->|adopts| DEV["claims-dev<br/>Deployment"]
  SET -->|adopts| STG["claims-stage<br/>Deployment"]
  SET -->|generates| PROD["claims-prod<br/>new Application"]
  PROD --> RO["prod Rollout<br/>Healthy"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class SET hi;
  class PROD,RO done;
  class DEV,STG plat;
