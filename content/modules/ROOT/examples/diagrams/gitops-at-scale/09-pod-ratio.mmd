%% Pod-ratio canary at the analysis step — GitOps at Scale, lab exercise 3 ("What just happened").
%% At step 3 (setWeight 50, four replicas) one Service balances across two stable pods and two
%% canary pods, so about half the requests reach the new version; the analysis Job probes the
%% canary's readiness endpoint. No mesh or traffic router is involved.
%% Shape (diagram-size-guard): LR, longest chain 3, labels at most 2 lines, no subgraph.
flowchart LR
  RT["Route"] --> SVC["Service<br/>parasol-claims"]
  SVC --> STB["stable: 2 pods<br/>version 1.0"]
  SVC --> CAN["canary: 2 pods<br/>version 1.1"]
  JOB["analysis Job"] -.->|probes readiness| CAN
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef gate fill:#fef5e7,stroke:#b7791f,color:#744210;
  class RT,SVC,STB plat;
  class CAN hi;
  class JOB gate;
