%% Canary abort — GitOps at Scale, lab exercise 4 ("What just happened").
%% The knob ConfigMap makes the analysis Job report failure; the AnalysisRun records Failed, the
%% Rollout aborts, scales the canary to zero and leaves the stable pods serving every request.
%% Shape (diagram-size-guard): LR, chain of 5, labels at most 2 lines, no subgraph.
flowchart LR
  CM["ConfigMap<br/>verdict: fail"] -.->|read by| JOB["analysis Job"]
  JOB --> AR["AnalysisRun<br/>Failed"]
  AR --> RO["Rollout<br/>RolloutAborted"]
  RO -->|scaled to 0| CAN["canary pods"]
  RO -->|untouched| STB["stable pods<br/>route answers 200"]
  classDef gate fill:#fef5e7,stroke:#b7791f,color:#744210;
  classDef bad fill:#fde8e8,stroke:#c0392b,color:#7b241c;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class CM,JOB gate;
  class AR,RO,CAN bad;
  class STB done;
