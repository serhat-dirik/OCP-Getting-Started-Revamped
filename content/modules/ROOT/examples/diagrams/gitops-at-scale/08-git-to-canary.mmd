%% Git edit to promoted canary — GitOps at Scale, lab exercise 3 ("You'll end with").
%% A commit in the attendee's claims-config fork changes the image tag; Argo CD syncs it into
%% the prod Rollout, which runs its canary steps and promotes only when the analysis passes.
%% Shape (diagram-size-guard): LR, chain of 5, labels at most 2 lines, no subgraph.
flowchart LR
  EDIT["Gitea commit<br/>image tag 1.1"] --> ARGO["Argo CD<br/>syncs claims-prod"]
  ARGO --> RO["Rollout<br/>canary steps"]
  RO --> AN{"analysis<br/>Job"}
  AN -->|pass| FULL["prod on 1.1<br/>4 of 4 pods"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef gate fill:#fef5e7,stroke:#b7791f,color:#744210;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class EDIT hi;
  class RO,AN gate;
  class FULL done;
