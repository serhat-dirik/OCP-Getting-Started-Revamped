%% Argo CD CLI sign-in — GitOps at Scale, lab exercise 1 ("What just happened").
%% The password is read silently, traded at the Argo CD session API for a short-lived token,
%% and discarded; the CLI carries the token, and RBAC limits it to the attendee's own project.
%% Shape (diagram-size-guard): LR, chain of 5, labels at most 2 lines, no subgraph.
flowchart LR
  PW["your password<br/>read silently"] --> API["Argo CD<br/>session API"]
  API --> TOK["token<br/>this shell only"]
  TOK --> CLI["argocd CLI"]
  CLI -->|your project only| AS["ApplicationSet<br/>created"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class TOK hi;
  class AS done;
  class PW,API,CLI plat;
