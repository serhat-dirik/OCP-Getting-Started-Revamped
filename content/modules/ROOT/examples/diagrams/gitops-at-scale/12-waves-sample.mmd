%% Sync waves and hooks sample — GitOps at Scale, lab exercise 2 ("You'll end with").
%% One Argo CD sync, left to right: the PreSync hook, waves 0-3 (each waits for the previous one to
%% be Healthy), then the PostSync smoke test that deletes itself on success.
%% Shape (diagram-size-guard): LR, chain of 6, labels at most 2 lines, no subgraph.
flowchart LR
  PRE["PreSync hook<br/>preflight Job"] --> DB["wave 0<br/>database"]
  DB --> MIG["wave 1 · Sync hook<br/>migration Job"]
  MIG --> APP["wave 2<br/>app"]
  APP --> RT["wave 3<br/>Route"]
  RT --> SMK["PostSync hook<br/>smoke test, then deleted"]
  classDef hook fill:#fef5e7,stroke:#b7791f,color:#744210;
  classDef wave fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class PRE,MIG,SMK hook;
  class DB,APP,RT wave;
