%% Blue-green — GitOps at Scale, lab exercise 5 ("You'll end with") and the concept page.
%% Two full versions run side by side: users reach blue through the active Service, a
%% pre-flight reaches green through the preview Service, and promotion flips active to green
%% in one cut, behind a manual gate.
%% Shape (diagram-size-guard): LR, longest chain 3, labels at most 2 lines, no subgraph.
flowchart LR
  U(["users"]) --> ACT["active<br/>Service"]
  ACT --> BLUE["blue<br/>live version"]
  ACT -.->|after promote| GREEN["green<br/>new version"]
  QA(["pre-flight"]) --> PREV["preview<br/>Service"]
  PREV --> GREEN
  classDef blue fill:#e8f0fe,stroke:#1a73e8,color:#174ea6;
  classDef green fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class BLUE blue;
  class GREEN green;
  class U,QA,ACT,PREV plat;
