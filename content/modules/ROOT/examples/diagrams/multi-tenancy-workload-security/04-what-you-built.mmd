%% What you built — Multi-Tenancy & Workload Security.
%% COMPACT ON PURPOSE (owner review 2026-08-22: "unnecessarily huge"). The first version was a plain
%% `graph TB`, which stacks every node inside a subgraph vertically — seven nodes of two and three
%% lines each rendered as a column taller than the wrap-up text it illustrates. The fix is the same
%% `direction LR` + `~~~` idiom the platform-accretion diagrams already use: each subgraph becomes one
%% short row, the two rows stack, and the whole picture is two node-heights instead of eight.
%% Keep labels to two lines. A third line is what made this tall the first time.
flowchart TB
  subgraph tenant["Tenant sandbox — dev / stage / prod"]
    direction LR
    sa1["payments-ci<br/>edit@dev · view@prod"]
    sa2["payments-ops<br/>deployer Role · no Secrets"]
    wl["root-demander<br/>restricted-v2 · non-root UID"]
    q["ResourceQuota + LimitRange"]
    sa1 ~~~ sa2 ~~~ wl ~~~ q
  end
  subgraph platform["Platform team — cluster scope"]
    direction LR
    obs["platform-observer<br/>read-only"]
    sp["self-provisioning<br/>+ project template"]
    idp["OAuth IdPs<br/>htpasswd · Keycloak"]
    obs ~~~ sp ~~~ idp
  end
  platform -->|"provisions + governs"| tenant
  classDef t fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef p fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  class sa1,sa2,wl,q t;
  class obs,sp,idp p;
