%% The project request template — Multi-Tenancy & Workload Security, lab exercise 7 ("Read it").
%% With self-provisioning off, only the platform team may send a ProjectRequest. The cluster's
%% projectRequestTemplate (project-request in openshift-config) then stamps OpenShift's two defaults,
%% the Project and an admin RoleBinding, plus the platform team's policy: five NetworkPolicies
%% (deny-by-default and four narrow allows) and starter-quota.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  REQ["ProjectRequest<br/>platform team only"] --> TPL["project-request<br/>template"]
  TPL --> DEF["Project + admin binding<br/>OpenShift default"]
  TPL --> NP["5 NetworkPolicies<br/>deny, then 4 allows"]
  TPL --> Q["starter-quota<br/>caps object counts"]
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef hi fill:#e00,stroke:#900,color:#fff;
  class REQ,TPL,DEF plat;
  class NP,Q hi;
