%% How the attendee was provisioned — Multi-Tenancy & Workload Security, lab exercise 6 ("You'll end with").
%% Three facts the exercise reads: a RoleBinding named after the user grants admin on their own
%% projects; their group, workshop-attendees, is bound cluster-wide to the platform-observer
%% ClusterRole (nodes, storage classes); and nothing grants them a peer's namespace.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  YOU(["you"]) -->|"RoleBinding"| ADM["admin<br/>your own projects"]
  YOU -->|"member of"| GRP["group<br/>workshop-attendees"]
  GRP -->|"ClusterRoleBinding"| OBS["platform-observer<br/>read nodes, storage"]
  YOU -.->|"no binding"| PEER["a peer's namespace<br/>Forbidden"]
  classDef id fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class YOU,GRP id;
  class ADM,OBS good;
  class PEER bad;
