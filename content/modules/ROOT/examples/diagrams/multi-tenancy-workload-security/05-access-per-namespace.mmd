%% Access per namespace — Multi-Tenancy & Workload Security.
%% ONE identity, TWO namespaces, TWO different sets of verbs. This is the step-2 picture on the
%% Demo page: payments-ci is a single ServiceAccount, and what it may do is decided by the
%% RoleBinding in each namespace, not by the account. The diagram exists because the module's other
%% RBAC visuals are summaries — 01-identity-flow is the login-to-permission chain, 04-what-you-built
%% is the end-state recap — and neither shows the per-namespace split that the step turns on.
%% ---
%% NEVER put an angle-bracket placeholder in a .mmd file. Antora emits mermaid source into the page
%% UNESCAPED, so the browser parses it as a real unknown element, which never closes and swallows
%% the rest of the graph — the diagram renders as "Syntax error in text".
%% ---
%% NO SUBGRAPHS ON PURPOSE. A `direction` line is silently discarded the moment an edge crosses a
%% subgraph boundary (diagram-size-guard rule 1), and every edge here would cross one. Three nodes
%% in two ranks is already the short, wide shape a subgraph would have been reaching for.
flowchart LR
  sa["ServiceAccount<br/>payments-ci"]
  sa -->|"RoleBinding: edit"| dev["dev namespace<br/>create · update · delete"]
  sa -->|"RoleBinding: view"| prod["prod namespace<br/>get · list only"]
  classDef id fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef full fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef ro fill:#fef7e0,stroke:#b06000,color:#7a4100;
  class sa id;
  class dev full;
  class prod ro;
