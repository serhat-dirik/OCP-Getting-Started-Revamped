%% Quota and LimitRange at Pod admission — Multi-Tenancy & Workload Security, lab exercise 5 ("You'll end with") and concept "Quota and limits".
%% The LimitRanger admission plugin mutates first, filling in requests and limits a container left
%% out; the ResourceQuota plugin then checks the Pod against the namespace budget. The 8Gi
%% quota-buster fails that check (requests.memory 6Gi), so its ReplicaSet creates no Pod.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  POD["new Pod<br/>from a ReplicaSet"] --> LIM{{"LimitRange<br/>fills missing values"}}
  LIM --> RQ{{"ResourceQuota<br/>fits the budget?"}}
  RQ -->|"yes"| OK["Pod created"]
  RQ -->|"no"| DENY["exceeded quota<br/>0/1, no Pod"]
  classDef gate fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class LIM,RQ gate;
  class OK good;
  class DENY bad;
