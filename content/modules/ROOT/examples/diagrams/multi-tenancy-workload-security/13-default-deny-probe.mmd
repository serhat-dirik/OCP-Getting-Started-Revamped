%% Default-deny, proven by probes — Multi-Tenancy & Workload Security, lab exercise 7 ("You'll end with").
%% After deny-by-default and allow-from-same-namespace are applied in the dev project, a probe Pod in
%% the prod project gets no answer from the web Service within 3 s, while a probe Pod in the dev
%% project still connects. Before the policies, both connected.
%% Shape (diagram-size-guard): LR, longest chain 2 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  PROD["probe Pod<br/>your prod project"] -.->|"blocked"| WEB["web :8080<br/>your dev project"]
  DEV["probe Pod<br/>your dev project"] -->|"connected"| WEB
  POL["deny-by-default<br/>+ allow same namespace"] -.->|"guards"| WEB
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef hi fill:#e00,stroke:#900,color:#fff;
  class PROD bad;
  class DEV,WEB good;
  class POL hi;
