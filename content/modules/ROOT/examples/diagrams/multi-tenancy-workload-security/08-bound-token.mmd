%% A bound ServiceAccount token — Multi-Tenancy & Workload Security, lab exercise 2 ("You'll end with").
%% oc create token mints a short-lived JWT on demand; no token Secret is stored in the namespace.
%% The three claims the lab decodes: exp (now plus the requested 600 s), the namespace, and sub,
%% which names exactly one ServiceAccount in that namespace.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  SA["ServiceAccount<br/>payments-ci"] -->|"oc create token<br/>10 minutes"| TOK["bound token<br/>a signed JWT"]
  TOK --> EXP["exp<br/>now + 600 s"]
  TOK --> NSC["namespace<br/>your dev project"]
  TOK --> SUB["sub<br/>exactly this SA"]
  classDef id fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class SA id;
  class TOK hi;
  class EXP,NSC,SUB done;
