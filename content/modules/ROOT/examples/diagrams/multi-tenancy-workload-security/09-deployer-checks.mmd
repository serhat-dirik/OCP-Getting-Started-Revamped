%% The deployer Role, as the lab proves it — Multi-Tenancy & Workload Security, lab exercise 4 ("You'll end with").
%% Lab twin of 06-deployer-boundary.mmd (the Demo page's picture), with the outcomes the lab's
%% oc auth can-i block actually prints. RBAC is deny-by-default: Secrets and ConfigMaps are refused
%% because no rule in the Role lists them, not because a deny rule exists.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  SA["ServiceAccount<br/>payments-ops"] --> ROLE["deployer Role<br/>deployments · pods/log"]
  ROLE -->|"a rule matches"| OK["create, scale Deployments<br/>yes"]
  ROLE -->|"no rule matches"| DENY["get Secrets, ConfigMaps<br/>no"]
  classDef id fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef rb fill:#e00,stroke:#900,color:#fff;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class SA id;
  class ROLE rb;
  class OK good;
  class DENY bad;
