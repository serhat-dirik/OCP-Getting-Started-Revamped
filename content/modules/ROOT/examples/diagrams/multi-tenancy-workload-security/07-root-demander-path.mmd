%% root-demander's path through admission — Multi-Tenancy & Workload Security, lab exercise 1 ("You'll end with").
%% The seeded Pod spec demands runAsUser 0. restricted-v2 admits only a UID from the namespace's own
%% range (the openshift.io/sa.scc.uid-range annotation), so the ReplicaSet's create is refused: the
%% Deployment sits at 0 of 1 and no Pod exists. The patch drops runAsUser and declares runAsNonRoot,
%% and the same check then assigns the bottom UID of the range.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  BAD["seeded spec<br/>runAsUser: 0"] --> SCC{{"restricted-v2<br/>UID in project range?"}}
  FIX["patched spec<br/>runAsNonRoot: true"] --> SCC
  SCC -->|"0: out of range"| REJ["0 of 1<br/>no Pod created"]
  SCC -->|"UID assigned"| RUN["Pod running<br/>non-root UID"]
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef gate fill:#fef7e0,stroke:#b06000,color:#7a4100;
  class BAD,REJ bad;
  class FIX,RUN good;
  class SCC gate;
