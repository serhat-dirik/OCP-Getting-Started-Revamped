%% SCC admission — Multi-Tenancy & Workload Security.
%% Shows why a Pod demanding runAsUser: 0 is rejected by the restricted-v2 SCC, and the two
%% honest ways to reach Admitted: fix the image, or a scoped SCC exception for one ServiceAccount.
%% Resized 2026-08-22: was 680x635, text at 1.32x. Grouped into three `direction LR` rows
%% (check, outcome, resolve) per the platform-accretion idiom used elsewhere in this module
%% (see 04-what-you-built.mmd), and trimmed node labels to one `<br/>` each.
flowchart TB
  subgraph check["Admission check"]
    direction LR
    pod["Pod spec<br/>runAsUser: 0"] --> gate{"restricted-v2 SCC<br/>UID in namespace range? · e.g. 1000960000–1000969999"}
  end
  subgraph outcome["Outcome"]
    direction LR
    rej["REJECTED at admission<br/>'unable to validate against any security context constraint'"]
    adm["Admitted<br/>runs as e.g. 1000960000 · non-root, no capabilities"]
    rej ~~~ adm
  end
  subgraph resolve["Two ways to reach Admitted"]
    direction LR
    fix["Fix the image<br/>drop runAsUser:0 · runAsNonRoot: true"]
    scc["OR: scoped SCC grant<br/>RoleBinding → nonroot-v2 · for THIS ServiceAccount only"]
    fix ~~~ scc
  end
  gate -->|"0 is not in range"| rej
  gate -->|"UID from range"| adm
  fix --> gate
  scc -.->|"the justified exception"| adm
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef gate fill:#fef7e0,stroke:#b06000,color:#7a4100;
  class rej bad;
  class adm,fix good;
  class gate gate;
  class scc good;
