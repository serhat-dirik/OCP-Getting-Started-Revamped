%% From commit to production — Developer Hub & Golden Paths, concept.
%% Top chain: a push to main runs the build pipeline's gates and writes the verified digest into the
%% dev overlay. Bottom chain: a tag runs the release pipeline, which builds nothing — it checks the
%% SAME digest with Conforma again and promotes it to stage, then to the prod canary.
%% Shape (diagram-size-guard): LR, longest chain 6 nodes (PUSH..PROD via the dotted edge), no
%% subgraph, labels at most 2 lines.
flowchart LR
  PUSH(["push to main"]) --> BUILD["build pipeline<br/>tests, image scan, SBOM"]
  BUILD --> SIGN["Chains signs<br/>Conforma verifies"]
  SIGN --> DEV["dev<br/>digest written to Git"]
  TAG(["tag v1.0.0"]) --> REL["release pipeline<br/>Conforma again"]
  SIGN -.->|"same digest"| REL
  REL --> STG["stage<br/>runs it first"]
  STG --> PROD["prod canary<br/>50%, analysis, 100%"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef env fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class BUILD,SIGN,REL hi;
  class DEV,STG,PROD env;
  class PUSH,TAG plat;
