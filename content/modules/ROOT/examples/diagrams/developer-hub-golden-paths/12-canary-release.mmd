%% A tag releases the SAME digest: release pipeline -> stage -> prod canary -> analysis decides.
%% Developer Hub & Golden Paths, lab exercise 5 and demo step 3. Labels are attribute-free.
%% Shape (diagram-size-guard): LR, longest chain 5 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  TAG["git tag v1.1.0"] --> REL["release pipeline<br/>Conforma again"]
  REL -->|"commit"| STAGE["stage<br/>same digest"]
  STAGE -->|"commit"| CAN["prod canary<br/>half the pods"]
  CAN -->|"analysis passes"| PROD["prod<br/>all pods"]
  CAN -.->|"analysis fails"| BACK["rolled back<br/>stable keeps serving"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef ok fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef bad fill:#fce8e6,stroke:#a50e0e,color:#a50e0e;
  class TAG hi;
  class STAGE,CAN,PROD ok;
  class BACK bad;
