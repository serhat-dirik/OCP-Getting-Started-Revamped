%% What you built — Developer Hub & Golden Paths, wrap-up.
%% The attendee's path through the lab: one form, a change pushed from Dev Spaces, a release tag,
%% and every stage watched from the component's page in Developer Hub.
%% Shape (diagram-size-guard): LR, longest chain 5 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  FORM["one form<br/>in Developer Hub"] --> REPOS[("two repos<br/>app + GitOps")]
  REPOS --> CHANGE["a change<br/>pushed from Dev Spaces"]
  CHANGE --> DEV["dev<br/>signed, verified digest"]
  DEV --> TAG["release tag<br/>stage, then prod canary"]
  HUB["component page<br/>CI, CD, Topology"] -.->|"watches"| TAG
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class FORM,HUB hi;
  class REPOS,CHANGE,DEV,TAG done;
