%% What the golden template generates — Developer Hub & Golden Paths, concept.
%% One form creates two repos and a catalog entity; the platform team's per-team wiring (grey edges'
%% sources) turns the GitOps repo into Argo CD Applications and connects the app repo to
%% Pipelines-as-Code. Labels are attribute-free (the diagram extension mangles {attr}).
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  FORM["Self-service form<br/>name + your team's org"] --> TMPL["golden-path template"]
  TMPL --> APP[("app repo<br/>code, devfile, .tekton/")]
  TMPL --> GIT[("GitOps repo<br/>ci/ + overlays/")]
  TMPL --> CAT["catalog Component<br/>CI, CD, Topology tabs"]
  APP -->|"org webhook"| PAC["Pipelines-as-Code<br/>runs .tekton/"]
  GIT -->|"ApplicationSet"| ARGO["Argo CD Applications<br/>ci, dev, stage, prod"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef gen fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class FORM,TMPL hi;
  class APP,GIT,CAT gen;
  class PAC,ARGO plat;
