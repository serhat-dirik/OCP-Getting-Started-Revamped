%% curls all come from the scaffold's own dependencies, none hand-written.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 3 lines.
flowchart LR
  IST["ImageStream tag<br/>built in exercise 3"] -->|"oc new-app"| DEP["Deployment<br/>+ Service :8080"]
  DEP -->|"edge Route"| RT(["HTTPS<br/>your Route"])
  RT --> EP["/api/info<br/>/q/health/ready<br/>/q/metrics"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class DEP,RT hi;
  class IST plat;
  class EP done;
