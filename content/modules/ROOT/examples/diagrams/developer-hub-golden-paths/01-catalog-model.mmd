%% Catalog model — Developer Hub & Golden Paths.
%% Shows the four Backstage catalog entity kinds this module uses: a System containing
%% Components and the API they provide/consume, owned by a Group.
%% Resized 2026-08-22: was 575x451, text at 1.57x. Subgraph direction changed TB -> LR so the
%% System's four entities lay out as one row instead of stacking, and node labels trimmed to
%% one `<br/>` each.
%% Tuned again 2026-08-22: still 900x913 @1.40x — the standalone GRP node (with no subgraph of its
%% own) ranked on its own row above the SYS row, costing a full extra rank of height. Flipped the
%% top-level `flowchart TB` to `flowchart LR`; SYS keeps its own explicit `direction LR` (subgraph
%% direction is set locally, not inherited), so its 4-node row is unaffected, but GRP's rank now
%% reads to the left of SYS instead of above it — the same cost lands on width instead of height.
%% No edges, node labels, or SYS's internal layout changed.
flowchart LR
  subgraph SYS["System: parasol-insurance"]
    C1[Component<br/>parasol-claims · service]
    C2[Component<br/>parasol-web · website]
    C3[Component<br/>parasol-notifications · service]
    A1[API<br/>parasol-claims-api · openapi]
    C1 ~~~ C2 ~~~ C3 ~~~ A1
    C1 -->|provides| A1
    C2 -->|consumes| A1
  end
  GRP[Group: parasol<br/>owns everything] -.owns.-> C1
  GRP -.owns.-> C2
  GRP -.owns.-> C3
  classDef sys fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef api fill:#fef5e7,stroke:#b7791f,color:#744210;
  classDef grp fill:#eaf1fb,stroke:#1a5fb4,color:#0a3d7a;
  class C1,C2,C3 sys;
  class A1 api;
  class GRP grp;
