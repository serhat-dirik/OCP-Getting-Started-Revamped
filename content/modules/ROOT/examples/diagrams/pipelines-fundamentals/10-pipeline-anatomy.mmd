%% Pipeline anatomy — Tekton's objects on the lab's own pipeline (concept, "Anatomy of a pipeline").
%% Top: the definition. The Pipeline lists five Tasks in order; unit-test (maven-jdk21) has two
%% Steps. Bottom: one run. A PipelineRun creates one TaskRun per Task, each TaskRun runs as one Pod,
%% and each Step runs as one container of that Pod, named step- plus the Step name. Shown for
%% unit-test only, so the picture stays one row.
%% Inputs and outputs are current Tekton: Params in, one Workspace, Results out (the old
%% PipelineResource is gone from Tekton).
%% GROUNDED in gitops/entry-states/pipelines-fundamentals/templates/pipeline.yaml (four params,
%% shared-workspace used by fetch-source, unit-test and build-image only, two Pipeline results),
%% pipelines/tasks/maven-jdk21.yaml (steps generate-settings, mvn-goals), the lab's
%% volumeClaimTemplate workspace binding, and the live-captured `container step-mvn-goals has
%% failed` line in lab.adoc exercise 3 (2026-11-12).
%% Every edge leaving a subgraph starts at the subgraph itself, so both `direction LR` lines hold
%% (diagram-size-guard). No angle brackets anywhere in this file: Antora emits it unescaped.
flowchart TB
  P[/"Params in<br/>git-url · git-revision · image · max-size-mb"/]:::io
  subgraph DEF["Definition: Pipeline parasol-claims-build-test-deploy"]
    direction LR
    T1[fetch-source] --> T2["unit-test<br/>2 Steps"]:::hi --> T3[build-image] --> T4[image-report] --> T5[deploy]
  end
  subgraph RUN["Run: each start creates a PipelineRun, with one TaskRun per Task"]
    direction LR
    TR["TaskRun<br/>unit-test"]:::hi -->|"runs as"| POD["one Pod<br/>one container per Step"]:::hi
    POD --> C1[step-generate-settings]
    POD --> C2[step-mvn-goals]
  end
  W[("Workspace shared-workspace<br/>a new PVC each run")]:::ws
  R[/"Results out<br/>image-size-mb · image-within-budget"/]:::io
  P --> DEF
  DEF --> RUN
  RUN <-.->|"used by fetch-source,<br/>unit-test, build-image"| W
  RUN --> R
  classDef io fill:#f5f5f5,stroke:#6a6e73,color:#151515;
  classDef ws fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef hi fill:#fef5e7,stroke:#b7791f,color:#744210;
