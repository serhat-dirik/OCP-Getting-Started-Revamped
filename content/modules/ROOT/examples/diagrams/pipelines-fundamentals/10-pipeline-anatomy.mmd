%% Pipeline anatomy — the four words the concept page just defined, on the lab's own pipeline:
%% parameters go in, five Tasks run in order, they share one workspace, results come out.
%% Edges attach to the Pipeline box, not to single Tasks, so nothing crosses the Task row.
%% Where each Task comes from is a separate picture (01-anatomy-and-layers).
flowchart TB
  P[/"Parameters in<br/>Git URL · image tag · size budget"/]:::io
  subgraph PIPE["Pipeline: parasol-claims-build-test-deploy — five Tasks, in order"]
    direction LR
    T1[fetch-source] --> T2[unit-test] --> T3[build-image] --> T4[image-report] --> T5[deploy]
  end
  W[("Workspace<br/>one shared copy of the source")]:::ws
  R[/"Results out<br/>image size · within budget"/]:::io
  P --> PIPE
  PIPE <-. "every Task uses the same files" .-> W
  PIPE --> R
  classDef io fill:#f5f5f5,stroke:#6a6e73,color:#151515;
  classDef ws fill:#e6f4ea,stroke:#137333,color:#0d652d;
