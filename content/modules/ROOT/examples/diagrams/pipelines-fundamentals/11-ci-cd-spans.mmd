%% CI, continuous delivery, continuous deployment — concept, "Where a pipeline fits".
%% Top row: continuous integration, every change built, tested, checked and released as an image.
%% Bottom row: both kinds of CD carry the same change on through stage and acceptance tests. The
%% two routes into production are the whole difference: continuous delivery waits for a person to
%% approve; continuous deployment goes on its own.
%% Shape (diagram-size-guard): TB of two LR subgraphs joined container-to-container, so each
%% `direction LR` holds; longest chain 4 nodes; labels at most 2 lines.
flowchart TB
  subgraph CI["Continuous integration (CI)"]
    direction LR
    B[Build] --> T[Test] --> S[Security checks] --> REL[Release an image]
  end
  subgraph CD["Continuous delivery or continuous deployment (CD)"]
    direction LR
    ST[Deploy to stage] --> AT[Acceptance tests]
    AT --> AP{{"Continuous delivery:<br/>a person approves"}}
    AP --> PR[Deploy to production]
    AT -->|"continuous deployment:<br/>no manual step"| PR
  end
  CI --> CD
  classDef ci fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef gate fill:#fef5e7,stroke:#b7791f,color:#744210;
  class B,T,S,REL ci;
  class AP gate;
