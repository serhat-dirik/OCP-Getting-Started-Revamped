%% Anatomy of a pipeline & the three reuse layers it draws from: ① catalog Tasks shipped with
%% OpenShift Pipelines, ② the org's curated task library, and ③ your app's own Pipeline — wired
%% together at run time by the cluster resolver (dashed edges into the matching pipeline step).
%% Resized 2026-08-22: was 1132x697 intrinsic, rendering 900x554 with text at 0.8x. Root cause:
%% CATALOG and LIB were already `direction LR` but had no `~~~` chaining between their own nodes,
%% so they rendered as stacked columns rather than single rows; APP was already fine because its
%% real --> edges already force left-to-right order. Width (1132) was left alone; only height
%% needed correcting.
flowchart TB
  subgraph CATALOG["① Catalog — shipped with OpenShift Pipelines (openshift-pipelines namespace)"]
    direction LR
    GC[git-clone]:::cat
    BAH[buildah]:::cat
    OCL[openshift-client]:::cat
    GC ~~~ BAH ~~~ OCL
  end
  subgraph LIB["② Company library — curated by the platform team (ogsr-parasol-tasks namespace)"]
    direction LR
    MJ[maven-jdk21]:::lib
    ISR[image-size-report]:::lib
    MJ ~~~ ISR
  end
  subgraph APP["③ Your app Pipeline — parasol-claims-build-test-deploy"]
    direction LR
    T1([fetch-source]) --> T2([unit-test]) --> T3([build-image]) --> T4([image-report]) --> T5([deploy])
  end
  GC -. "resolver: cluster" .-> T1
  MJ -. "resolver: cluster" .-> T2
  BAH -. "resolver: cluster" .-> T3
  ISR -. "resolver: cluster" .-> T4
  OCL -. "resolver: cluster" .-> T5
  classDef cat fill:#e6f0ff,stroke:#2b6cb0,color:#1a365d;
  classDef lib fill:#fef5e7,stroke:#b7791f,color:#744210;
  T1:::app
  classDef app fill:#e6f4ea,stroke:#137333,color:#0d652d;
