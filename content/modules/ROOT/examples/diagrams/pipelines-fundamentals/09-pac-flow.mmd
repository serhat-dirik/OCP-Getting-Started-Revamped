%% Pipelines-as-Code, push to run — Pipelines Fundamentals, lab exercise 4 ("You'll end with").
%% A commit to main in the attendee's Gitea fork fires the fork's webhook, which POSTs to the
%% Pipelines-as-Code controller, signed with the webhook secret; the controller finds the
%% Repository resource whose URL matches the fork (it reads gitea-pac-secret for the token and the
%% webhook secret) and starts the PipelineRun defined in the fork's .tekton/pull-request.yaml.
%% Shape (diagram-size-guard): LR, chain of 5, no subgraph, labels at most 2 lines.
flowchart LR
  PUSH["commit to main<br/>in your fork"] --> WH["Gitea webhook<br/>POST + secret"]
  WH --> PAC["PaC controller"]
  PAC -->|"matches URL"| REPO["Repository<br/>gitea-pac-secret"]
  REPO -->|"runs .tekton/ file"| RUN["PipelineRun<br/>pull-request-…"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class WH,REPO hi;
  class RUN done;
