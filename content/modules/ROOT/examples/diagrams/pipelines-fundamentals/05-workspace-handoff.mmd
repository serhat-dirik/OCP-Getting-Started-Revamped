%% One run, one shared workspace — Pipelines Fundamentals, lab exercise 1 ("What you just read").
%% fetch-source clones the source into shared-workspace (this run's PVC, from the
%% VolumeClaimTemplate); unit-test runs Maven against that checkout and, only if it passes,
%% build-image builds the Containerfile out of the same checkout; image-report publishes the size
%% results; deploy rolls out the app and creates its Route.
%% Shape (diagram-size-guard): LR, longest chain 5 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  WS[("shared-workspace<br/>fetch-source clones here")] --> UT["unit-test<br/>mvn test"]
  UT -->|"passes"| BI["build-image<br/>buildah"]
  WS -.->|"same checkout"| BI
  BI --> IR["image-report<br/>publishes results"]
  IR --> DP["deploy<br/>app + Route"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class WS hi;
  class UT,BI,IR,DP done;
