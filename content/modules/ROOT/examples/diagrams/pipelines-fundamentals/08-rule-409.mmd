%% Why the test fails — Pipelines Fundamentals, lab exercise 3 ("What just happened").
%% With the toggle false, ClaimResourceTest opens a claim with no adjuster and asks the running
%% claims API to approve it; ClaimResource.updateStatus enforces Parasol's rule and answers
%% 409 Conflict; the test expected 200, so the assertion fails, Maven reports BUILD FAILURE and the
%% unit-test step goes red.
%% Shape (diagram-size-guard): LR, chain of 4, no subgraph, labels at most 2 lines.
flowchart LR
  T["ClaimResourceTest<br/>claim with no adjuster"] -->|"PUT status Approved"| API["claims API<br/>updateStatus"]
  API -->|"409 Conflict"| F["test expected 200<br/>assertion fails"]
  F --> UT["unit-test step<br/>BUILD FAILURE"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class API hi;
  class F,UT bad;
