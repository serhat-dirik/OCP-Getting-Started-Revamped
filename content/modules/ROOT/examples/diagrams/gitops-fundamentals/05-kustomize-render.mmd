%% Kustomize render — GitOps Fundamentals, lab exercise 1 ("You'll end with").
%% One base, three overlays that change only what differs; `oc kustomize overlays/dev` renders the
%% dev variant to seven objects in the attendee's dev namespace: the desired state an Argo CD
%% Application applies and watches from exercise 2 on (dashed: not done yet in this exercise).
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  BASE["base/<br/>one claims environment"] --> DEV["overlays/dev<br/>namespace, 1 replica"]
  BASE --> OTHER["overlays/stage, prod<br/>2 and 3 replicas"]
  DEV -->|"oc kustomize"| OUT["7 objects<br/>desired state"]
  OUT -.->|"exercise 2"| ARGO["Argo CD<br/>applies and watches"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef wait fill:#fff,stroke:#900,color:#900,stroke-dasharray: 4 3;
  class DEV,OUT hi;
  class BASE,OTHER plat;
  class ARGO wait;
