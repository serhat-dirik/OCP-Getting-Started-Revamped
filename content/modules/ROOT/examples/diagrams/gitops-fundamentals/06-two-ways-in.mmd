%% Two ways to create an Application — GitOps Fundamentals, lab exercise 2 ("What just happened").
%% The attendee's `oc apply` of an Application into the shared Argo CD control-plane namespace is
%% refused by cluster RBAC; signing in to the student Argo CD UI with Log in via OpenShift works,
%% and Argo CD lets the attendee manage only their own AppProject.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph.
flowchart LR
  YOU(["you"]) -->|"oc apply"| RBAC{{"cluster RBAC"}}
  RBAC --> NO["Forbidden"]
  YOU -->|"Log in via OpenShift"| UI["Argo CD UI<br/>your project only"]
  UI --> APP["your Application<br/>claims-dev"]
  classDef gone fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class NO gone;
  class UI,APP done;
