%% Drift, two ways — GitOps Fundamentals, lab exercise 3 ("You'll end with").
%% The same hand edit (replicas 1 to 3) twice. Top: Manual sync, Argo CD reports OutOfSync and waits
%% until the attendee presses Sync. Bottom: self-heal, the watch event triggers a revert in seconds
%% with nobody acting. Either way the Deployment ends at Git's 1 replica.
%% Shape (diagram-size-guard): TB of two LR subgraphs joined only container-to-container (the
%% invisible `~~~` link), so each `direction LR` is honoured; longest chain 3 nodes.
flowchart TB
  subgraph MAN["Manual sync: Argo CD reports"]
    direction LR
    A1["hand edit<br/>replicas 3"] --> A2["OutOfSync<br/>diff shown"]
    A2 -->|"you press Sync"| A3["back to<br/>1 replica"]
  end
  subgraph HEAL["Self-heal: Argo CD enforces"]
    direction LR
    B1["hand edit<br/>replicas 3"] --> B2["watch event<br/>in seconds"]
    B2 -->|"nobody acts"| B3["back to<br/>1 replica"]
  end
  MAN ~~~ HEAL
  classDef gone fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class A1,B1 gone;
  class A3,B3 done;
