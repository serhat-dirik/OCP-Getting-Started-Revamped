%% One allowed path — Networking for Dev & DevOps.
%% The end state of the demo's policy set, from the database's point of view: exactly one pod may
%% open 5432, every other pod in the same namespace is refused by the same policy, and the
%% deliberate DNS egress allow is the only other flow left open.
%% Authored 2026-09-12 for the Demo page's step 4, which needs the narrow picture (one permitted
%% flow, everything else refused) rather than 04-what-you-built's whole-module recap.
%% ---
%% NEVER put an angle-bracket placeholder in a .mmd file. Antora emits mermaid source into the page
%% UNESCAPED, so the browser parses it as a real unknown element, which never closes and swallows
%% the rest of the graph — the diagram renders as "Syntax error in text".
%% No subgraphs here, so nothing can silently discard a `direction`; the longest chain is two nodes.
flowchart LR
  api["parasol-claims<br/>the API"]
  dc["demo-client<br/>the probe pod"]
  other["any other pod<br/>in the namespace"]
  db[("claims-db<br/>Postgres 5432")]
  dns["cluster DNS<br/>Service 53, pods 5353"]
  api -->|"allowed: TCP 5432"| db
  dc -.->|"DENIED"| db
  other -.->|"DENIED"| db
  api -->|"allowed: dns / dns-tcp"| dns
  classDef ok fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef block fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef net fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  class api,db ok;
  class dc,other block;
  class dns net;
