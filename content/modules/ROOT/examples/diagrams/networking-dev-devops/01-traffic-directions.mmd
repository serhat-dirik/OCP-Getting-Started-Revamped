%% Two directions of traffic — Networking for Dev & DevOps.
%% Resized 2026-08-22: was `graph TB` at 509x619 intrinsic (text 1.77x) — the "ns" subgraph
%% stacked web/api/db in a column, and two labels ran three lines. Converted to `flowchart TB`
%% with `direction LR` + `~~~` chaining inside both subgraphs, and folded the north-south edge
%% label and the east-west note down to two lines each (no wording dropped, just the break).
%% Follow-up 2026-08-22: `user->web` and `note->web` crossed into "ns", silently disabling both
%% subgraphs' `direction LR` (900x755 @1.32x). Re-pointed at the containers (`outside->ns`,
%% `note->ns`) — both labels are already about the categories, not those specific nodes.
flowchart TB
  subgraph outside["Outside the cluster"]
    direction LR
    user["Browser / partner system"]
  end
  subgraph ns["Namespace: your app"]
    direction LR
    web["web tier"]
    api["api tier"]
    db[("database")]
    web ~~~ api ~~~ db
  end
  outside -->|"NORTH-SOUTH<br/>(what you expose: Route / Gateway API)"| ns
  web -->|"east-west"| api
  api -->|"east-west"| db
  note["EAST-WEST<br/>(who may talk to whom: NetworkPolicy / UDN)"]
  note -.-> ns
  classDef out fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef app fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef lbl fill:#fef7e0,stroke:#b06000,color:#7a4100;
  class user out;
  class web,api,db app;
  class note lbl;
