%% What you built — Networking for Dev & DevOps.
%% Resized 2026-08-22: was `graph TB` at 482x596 intrinsic (text 1.87x) — the "dev" subgraph
%% stacked all four nodes in a vertical column. Converted to `flowchart TB` with `direction LR`
%% + `~~~` chaining inside both subgraphs so "dev" renders as one row instead of four.
%% Follow-up 2026-08-22: that pass left `router->web` and `pw->web` crossing into "dev", which
%% silently disabled its `direction LR` and made things worse (900x1447 @2.04x). Re-pointed both
%% at the container (`router->dev`, `partner->dev`) so no edge crosses a subgraph boundary.
flowchart TB
  subgraph dev["Namespace: app (NetworkPolicy)"]
    direction LR
    web["parasol-web"]
    api["parasol-claims"]
    db[("claims-db")]
    dc["demo-client<br/>(blocked from db)"]
    web ~~~ api ~~~ db ~~~ dc
  end
  subgraph partner["Namespace: partner (UDN)"]
    direction LR
    pw["partner-workload<br/>ovn-udn1 · 10.20.0.0/16"]
  end
  router["ingress router"] -->|"edge Route"| dev
  web -->|"allow 8080"| api
  api -->|"allow 5432"| db
  dc -.->|"DENIED"| db
  partner -.->|"native isolation<br/>(no policy)"| dev
  classDef ok fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef block fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef net fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  class web,api,db ok;
  class dc,pw block;
  class router net;
