%% Exposure decision tree — Networking for Dev & DevOps.
%% Resized 2026-08-22: was `graph TB` at 955x629 intrinsic (aspect 0.66; text 0.94x already fine,
%% so width was left alone). Three labels ran three lines (now two — no wording dropped, just the
%% break relocated to whichever side keeps the line shorter). The L4 -> LoadBalancer branch is now
%% a `direction LR` subgraph so those two nodes share one row instead of adding a fourth tree rank.
flowchart TB
  q0["Should anything outside the cluster reach it?"]
  q0 -->|no| clusterip["ClusterIP (default)<br/>in-cluster only — most workloads live here"]
  q0 -->|yes| q1{"What kind of traffic?"}
  q1 -->|"HTTP(S) / TLS-SNI"| route["Route → the workhorse · external, wildcard DNS, edge TLS<br/>(Gateway API = the strategic direction)"]
  subgraph l4grp["L4 path"]
    direction LR
    l4["needs a LoadBalancer or the mesh<br/>(L4 — a later module)"]
    lb["LoadBalancer needs a provider (cloud LB / MetalLB);<br/>without one it stays &lt;pending&gt;"]
    l4 -.-> lb
  end
  q1 -->|"raw TCP / UDP / passthrough"| l4
  nodeport["NodePort · a port on every node — learn it once,<br/>reach for it almost never"]
  q1 -.->|"low-level / debugging"| nodeport
  classDef def fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef warn fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class clusterip,route def;
  class nodeport,lb warn;
  class l4 bad;
