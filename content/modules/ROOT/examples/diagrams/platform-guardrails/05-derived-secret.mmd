%% Step 1 of the demo: who owns the Secret the app reads. Flat LR, no subgraphs — the ownership
%% chain IS the picture, and a box around any part of it would only add a dagre rank.
flowchart LR
  bao["OpenBao<br/>parasol/claims-db"]
  es["ExternalSecret<br/>names the path, not the value"]
  sec["Secret/claims-creds<br/>ownerReference: ExternalSecret"]
  pod["parasol-claims Pod<br/>env from secretKeyRef"]
  chart["This module's chart<br/>ships no Secret manifest"]

  bao --> es --> sec --> pod
  chart -.->|"nothing in Git creates it"| sec
