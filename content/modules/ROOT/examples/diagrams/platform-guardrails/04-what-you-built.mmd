%% Wrap-up. Wide rather than tall: the rendered width is pinned at 900px, so a narrow tall graph
%% gets UPSCALED and its text ends up larger than the body copy around it.
flowchart LR
  subgraph secrets["Secrets you did not commit"]
    s1["OpenBao holds the value"]
    s2["ESO mints the Secret"]
    s3["rotation re-syncs in seconds"]
    s1 --> s2 --> s3
  end

  subgraph policy["Rules the cluster enforces for you"]
    p1["read the live policy"]
    p2["break five rules at once"]
    p3["break exactly one"]
    p1 --> p2 --> p3
  end

  secrets --> policy
