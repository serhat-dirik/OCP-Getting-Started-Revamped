%% Two paths to the same env var. No `direction` inside the subgraphs: an edge crosses every
%% boundary here, and mermaid silently discards a subgraph direction the moment one does.
flowchart LR
  subgraph git["The path that leaks"]
    repo["Git repository<br/>application.properties"]
    hist["every clone,<br/>every CI cache,<br/>the whole history"]
    repo --> hist
  end

  subgraph eso["The path that does not"]
    bao["OpenBao<br/>parasol/claims-db"]
    es["ExternalSecret<br/>refreshInterval: 15s"]
    k8s["Secret/claims-creds<br/>created and owned by ESO"]
    bao --> es --> k8s
  end

  pod["Pod<br/>env from secretKeyRef"]

  hist -.->|"revert does not help"| pod
  k8s --> pod
