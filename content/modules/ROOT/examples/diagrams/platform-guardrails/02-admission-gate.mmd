%% The admission path an attendee's own `oc apply` takes. Flat on purpose: the sequence IS the
%% lesson, and a subgraph here would only add a box nobody needs.
flowchart LR
  req["oc apply<br/>Application/entry-m20-user3"]
  auth["Authentication<br/>who are you"]
  rbac["RBAC<br/>may you create this kind"]
  match["ValidatingAdmissionPolicy<br/>matchConditions"]
  cel["CEL validations<br/>four expressions"]
  etcd["stored in etcd"]
  deny["Denied, with the<br/>policy's own message"]

  req --> auth --> rbac --> match
  match -->|"not an attendee"| etcd
  match -->|"in workshop-attendees"| cel
  cel -->|"all true"| etcd
  cel -->|"any false"| deny
