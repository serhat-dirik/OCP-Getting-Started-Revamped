%% ConfigMap wiring — Config, Secrets & Multi-Environment, lab exercise 2 ("You'll end with").
%% `oc set env --from=configmap/claims-config` (console: envFrom) injects the five non-secret keys
%% into the Deployment, replacing the same-named inline values; the database user and password are
%% still inline (dashed) until exercise 3 moves them into a Secret.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  CM["ConfigMap claims-config<br/>5 non-secret keys"] -->|"envFrom"| DEP["Deployment<br/>parasol-claims"]
  IN["still inline<br/>DB user + password"] -.-> DEP
  DEP --> POD["new pod · 1/1<br/>serving claims"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef wait fill:#fff,stroke:#900,color:#900,stroke-dasharray: 4 3;
  class CM hi;
  class DEP,POD done;
  class IN wait;
