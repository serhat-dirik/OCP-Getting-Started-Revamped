%% Two ways to deliver config — Config, Secrets & Multi-Environment, lab exercise 3 ("You'll end with").
%% The ConfigMap and the Secret both reach the container as environment variables (envFrom); the
%% claims-file-config ConfigMap is mounted as a file at /mnt/claims-config, read through
%% QUARKUS_CONFIG_LOCATIONS, then reverted (dashed).
%% Shape (diagram-size-guard): LR, longest chain 2 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  CM["ConfigMap<br/>claims-config"] -->|"env vars"| APP["parasol-claims<br/>container"]
  SEC["Secret<br/>claims-creds"] -->|"env vars"| APP
  FILE["ConfigMap<br/>claims-file-config"] -.->|"mounted file, tried then reverted"| APP
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class SEC hi;
  class CM,FILE plat;
  class APP done;
