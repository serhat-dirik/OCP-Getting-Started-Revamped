%% External Secrets — Config, Secrets & Multi-Environment, lab exercise 7 ("You'll end with").
%% The source of truth stays in an external manager; the External Secrets Operator reads an
%% ExternalSecret, creates and refreshes an ordinary Secret with the same name the app already uses,
%% and the app consumes it unchanged. Not installed on the workshop cluster: read-only exercise.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  V[("Vault or a cloud<br/>secrets manager")] --> ESO["External Secrets Operator<br/>reads your ExternalSecret"]
  ESO -->|"creates and refreshes"| SEC["Secret claims-creds<br/>same name as today"]
  SEC -->|"envFrom, unchanged"| APP["parasol-claims"]
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class V plat;
  class ESO,SEC hi;
  class APP done;
