%% Quota admission — Config, Secrets & Multi-Environment, lab exercise 5 ("You'll end with").
%% The namespace already requests 200m CPU (claims app + its database). claims-hog asks for 4 CPU;
%% the ResourceQuota caps requested CPU at 3, so the Pod is forbidden and the Deployment carries a
%% ReplicaFailure condition with zero pods.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  USED["already requested<br/>200m CPU"] --> Q{{"ResourceQuota<br/>cap: 3 CPU requested"}}
  HOG["claims-hog pod<br/>asks for 4 CPU"] --> Q
  Q -.->|"exceeded quota"| NO["no pod created<br/>ReplicaFailure"]
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class USED plat;
  class Q hi;
  class HOG,NO bad;
