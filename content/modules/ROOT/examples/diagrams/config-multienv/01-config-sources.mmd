%% Config sources — Config, Secrets & Multi-Environment.
%% The four places OpenShift lets you put settings — env vars, ConfigMap, Secret, mounted file —
%% each feeding the same immutable image at startup. Order matches concept.adoc's "increasing
%% order of how they are handled" and the definition list right after this diagram (env vars,
%% ConfigMap, Secret, mounted file).
%% Resized 2026-08-22: graph LR with four ungrouped source nodes (478x427, text at 1.88x) ->
%% flowchart TB with the four sources in one `direction LR` subgraph (chained by `~~~`) stacked
%% over the image/app subgraph — was a single LR rank stacking the 4 sources vertically before
%% they fed sideways into "app"; now the 4 sources sit in one row. Each source keeps its own
%% arrow into `app`; no label or edge changed, source order unchanged.
%% Follow-up 2026-08-22: each of those 4 arrows (env/cm/sec/file --> app) crossed the sources/img
%% boundary, silently disabling `sources`' own direction LR — the actual cause of the too-narrow
%% render. Owner wants the "four independent paths converge on one image" story kept visible, so
%% collapsing to one sources-->img edge was ruled out; instead all 4 now run container-to-container
%% (sources-->img, x4) with each source's own name moved onto its edge label, so 4 distinct arrows
%% still land on the image box and neither subgraph's boundary is crossed.
flowchart TB
  subgraph sources["Four places to put settings"]
    direction LR
    env["Env vars<br/>(inline)"]
    cm["ConfigMap<br/>(non-secret config)"]
    sec["Secret<br/>(credentials)"]
    file["Mounted file<br/>(config as a volume)"]
    env ~~~ cm ~~~ sec ~~~ file
  end
  subgraph img["The image (built once, never changes)"]
    direction LR
    app["parasol-claims<br/>reads config at startup"]
  end
  sources -->|"Env vars"| img
  sources -->|"ConfigMap"| img
  sources -->|"Secret"| img
  sources -->|"Mounted file"| img
  classDef art fill:#e00,stroke:#900,color:#fff;
  classDef cfg fill:#f3f3f3,stroke:#888,color:#333;
  class app art;
  class env,cm,sec,file cfg;
