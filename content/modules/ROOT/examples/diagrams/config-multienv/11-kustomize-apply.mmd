%% Kustomize promotion — Config, Secrets & Multi-Environment, lab exercise 6 ("What just happened").
%% `oc apply -k overlays/stage` merges the stage overlay (namespace, replica count, APP_ENV) onto the
%% shared base (app, config, database) and applies the result into the stage namespace, which gets
%% its own database. prod is the same move with its own overlay.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  BASE["base/<br/>app · config · database"] --> K["oc apply -k<br/>overlay merged on base"]
  OV["overlays/stage<br/>namespace · replicas · APP_ENV"] --> K
  K --> NS[("stage namespace<br/>2 replicas · own database")]
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class BASE plat;
  class OV,K hi;
  class NS done;
