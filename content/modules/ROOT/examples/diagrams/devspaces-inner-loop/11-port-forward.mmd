%% Port-forward from the workspace, optional exercise "Beyond dev mode". The forward runs in the
%% workspace terminal, so localhost:5432 exists in the workspace, where the IDE and its tools are.
%% It tunnels to the internal claims-db Service, which has no Route.
flowchart LR
  TOOL["your tools<br/>in the workspace"] -->|"localhost:5432"| PF["oc port-forward<br/>workspace terminal"]
  PF -->|"tunnel"| SVC["svc/claims-db<br/>no Route"]
  SVC --> DB[("PostgreSQL")]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class PF hi;
  class TOOL,SVC,DB plat;
