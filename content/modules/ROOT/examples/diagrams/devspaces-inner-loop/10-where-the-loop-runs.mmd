%% Where the inner loop can run, lab exercise 6 (take-home). The same shape at three distances from
%% the cluster: a Dev Spaces workspace inside it, OpenShift Local as a single-node cluster on a
%% laptop, Podman Desktop for containers alone on a laptop.
flowchart LR
  DS["Dev Spaces<br/>inside the cluster"] --- OL["OpenShift Local<br/>the platform, on a laptop"] --- PD["Podman Desktop<br/>containers, on a laptop"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class DS hi;
  class OL,PD plat;
