%% Dev mode and its database, lab exercise 2 (the deliberate break-and-fix). With no datasource URL,
%% Quarkus tries Dev Services, a throwaway database container, and fails because a workspace has no
%% container runtime (dashed). With the URL exported, dev mode reaches the real claims-db across
%% namespaces by ordinary service DNS (solid).
flowchart LR
  DM["Quarkus dev mode<br/>in your workspace"] -.->|"no URL: Dev Services"| X["throwaway DB container<br/>no runtime: fails"]
  DM -->|"URL exported"| DB[("claims-db<br/>your-name-dev")]
  classDef fail fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class X fail;
  class DM,DB done;
