%% Hot reload, lab exercise 3 ("You'll end with"). Saving the file restarts nothing; the next request
%% makes dev mode recompile only the changed classes and swap them in, so the new endpoint answers
%% about two seconds later. No image build, no Pod replaced.
flowchart LR
  SAVE["edit + Ctrl+S<br/>ClaimResource.java"] --> REQ["next request<br/>curl /api/claims/ping"]
  REQ --> RC["dev mode recompiles<br/>changed classes only"]
  RC --> LIVE["new endpoint answers<br/>about 2 s"]
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class LIVE done;
