%% From push to a running Deployment, lab exercise 5 ("You'll end with"). git push hands the /ping
%% commit to your fork; oc new-app builds that fork with the java-21 builder (S2I) into
%% parasol-claims-mine, set env wires it to the claims-db Secret, and an edge Route publishes it.
flowchart LR
  WS["workspace<br/>/ping commit"] -->|"git push"| FORK[/"your fork<br/>in Gitea"/]
  FORK -->|"oc new-app"| BLD["S2I build<br/>java-21 builder"]
  BLD --> DEP["parasol-claims-mine<br/>+ claims-db Secret"]
  DEP --> RT(["edge Route<br/>/api/claims/ping"])
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class WS hi;
  class DEP,RT done;
