%% Workspace, gateway, and services — Dev Spaces & the Inner Loop.
%% Shows why the browser IDE never talks to the workspace directly (che-gateway sits in front,
%% terminating HTTPS, per-user auth) and why the workspace's own project reaches the app/database
%% project only by ordinary cross-namespace DNS. Illustrates concept.adoc's "The devfile: your
%% workspace as a contract in Git" section.
%% Resized 2026-08-22: graph TB with no `direction` set on any subgraph (420x729, text at 2.14x)
%% -> flowchart TB with `direction LR` added to every subgraph, so the workspace/app projects sit
%% side by side under "OpenShift cluster" instead of stacking three levels deep. No label, node,
%% or edge changed.
flowchart TB
  subgraph browser["Your browser"]
    direction LR
    ide["che-code IDE<br/>(VS Code in a tab)"]
  end
  subgraph cluster["OpenShift cluster"]
    direction LR
    subgraph wsns["Workspace project (your-name-devspaces)"]
      direction LR
      gw["che-gateway<br/>(HTTPS, per-user auth)"]
      tools["tools container (UDI)<br/>Quarkus dev mode :8080 · debug :5005"]
      gw --- tools
    end
    subgraph devns["App project (your-name-dev)"]
      direction LR
      db[("claims-db<br/>PostgreSQL :5432")]
    end
    tools -->|"cross-namespace DNS<br/>claims-db.your-name-dev.svc:5432"| db
  end
  ide -->|HTTPS| gw
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class tools,gw hi;
  class db plat;
