%% Inner and outer loop — Dev Spaces & the Inner Loop.
%% The red inner loop (this module) against the grey outer loop that follows it. concept.adoc pins
%% both currencies ("seconds" / "minutes to hours") and says "This module lives entirely in the red
%% inner loop" — so the red classDef is prose, not decoration, and must stay on the four inner nodes.
%% Resized 2026-08-23: was `graph LR` with no `direction` on either subgraph, so the two loops
%% chained into eight dagre ranks — around 2000px wide, which the 900px cap then scales DOWN. Now
%% `flowchart TB` with `direction LR` inside each loop and the hand-off joined container-to-container
%% (`inner -.-> outer`), which is what keeps that direction from being silently discarded. The label
%% already read at loop level — "happy? git push" is how you leave the inner loop, not a property of
%% the observe node — so it moved onto the container edge verbatim. Same nodes, labels and classes.
flowchart TB
  subgraph inner["INNER LOOP · seconds · this module"]
    direction LR
    edit["Edit"] --> build["Build"] --> run["Run<br/>dev mode"] --> observe["Observe"] --> edit
  end
  subgraph outer["OUTER LOOP · minutes to hours · later modules"]
    direction LR
    pipeline["Pipeline<br/>build · test · scan"] --> image[("Image")] --> promote["GitOps<br/>promote"] --> prod["Running<br/>in prod"]
  end
  inner -. "happy?<br/>git push" .-> outer
  classDef in fill:#e00,stroke:#900,color:#fff;
  classDef out fill:#f3f3f3,stroke:#888,color:#333;
  class edit,build,run,observe in;
  class pipeline,image,promote,prod out;
