%% A sidecar from the devfile, lab exercise 4 ("You'll end with"). Restarting from the local devfile
%% rebuilds the workspace Pod with a second container, cache (Valkey). The containers share the Pod's
%% network, so the tools terminal reaches Valkey on localhost:6379 with no Service and no Route.
%% Shape (diagram-size-guard): the subgraph declares no direction, and the only crossing edge is
%% container-level.
flowchart LR
  subgraph POD["workspace Pod"]
    TOOLS["tools container<br/>your terminal"] -->|"localhost:6379"| CACHE[("cache container<br/>Valkey")]
  end
  DF[/"devfile.yaml<br/>+ cache component"/] -->|"Restart from<br/>Local Devfile"| POD
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class CACHE hi;
  class DF,TOOLS plat;
