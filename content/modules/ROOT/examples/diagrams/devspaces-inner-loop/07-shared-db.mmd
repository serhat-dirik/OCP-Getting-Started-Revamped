%% One shared database, lab exercise 3 ("What just happened"). The claim POSTed to dev mode in the
%% workspace lands in claims-db; the separately deployed parasol-claims reads the same table, so the
%% Showroom terminal sees it through the deployed Route.
flowchart LR
  WS["dev mode<br/>in your workspace"] -->|"POST a claim"| DB[("claims-db<br/>your-name-dev")]
  SH["Showroom terminal<br/>curl"] -->|"Route"| APP["deployed<br/>parasol-claims"]
  APP -->|"reads claims"| DB
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class WS hi;
  class SH,APP,DB plat;
