%% CronJob on a clock — Jobs, Batch & Queued Workloads, lab exercise 4 ("You'll end with").
%% Each tick of the schedule (every minute in the lab) creates a fresh Job, which runs one Pod and
%% completes; suspend: true stops new ticks without deleting the CronJob or its history.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  CJ["CronJob nightly-statement<br/>every minute, for the lab"] -->|"each tick"| JOB["Job<br/>nightly-statement-N"]
  JOB --> POD(["Pod<br/>200 claims processed"])
  SUS["suspend: true"] -.->|"no new ticks"| CJ
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef wait fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class CJ,JOB hi;
  class SUS wait;
  class POD done;
