%% Preemption — Jobs, Batch & Queued Workloads, lab exercise 5 ("What just happened").
%% A batch-high Job arrives at a full ClusterQueue: Kueue admits it by evicting a running batch-low
%% Workload, which is requeued (not dropped) and re-admitted once quota frees. Which low-priority
%% Workload is evicted is Kueue's choice, so the victim is unnamed here.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  HI["batch-high-1<br/>priority 1000"] -->|"queue is full"| CQ{{"ClusterQueue cq-user<br/>500m CPU · 512Mi"}}
  CQ -->|"Admitted"| RUN(["batch-high-1<br/>runs"])
  CQ -->|"Evicted: Preempted"| LOW["a running batch-low<br/>priority 100"]
  LOW -->|"Requeued"| BACK["back in line<br/>re-admitted when quota frees"]
  classDef q fill:#e00,stroke:#900,color:#fff;
  classDef ok fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef wait fill:#fef7e0,stroke:#b06000,color:#7a4100;
  class CQ q;
  class HI,RUN ok;
  class LOW,BACK wait;
