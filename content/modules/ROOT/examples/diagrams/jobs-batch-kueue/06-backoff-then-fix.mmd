%% Break, read, fix — Jobs, Batch & Queued Workloads, lab exercise 2 ("You'll end with").
%% The broken Job reads a file that does not exist: three attempts (backoffLimit 2) fail with an
%% exponential backoff between them, the Job gives up with BackoffLimitExceeded, the in-place patch
%% is refused because the Pod template is immutable, and delete + re-create is the fix.
%% Shape (diagram-size-guard): LR, longest chain 5 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  BAD["statement-broken<br/>wrong file name"] -->|"3 attempts"| ERR["3 Pods in Error<br/>~10 s, then ~20 s apart"]
  ERR --> STOP["BackoffLimitExceeded<br/>the Job gives up"]
  STOP -->|"oc patch"| IMM{{"field is immutable<br/>edit refused"}}
  IMM -->|"delete + re-create"| OK(["fixed Job<br/>prints 200"])
  classDef gone fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef wait fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class BAD,ERR,STOP gone;
  class IMM wait;
  class OK done;
