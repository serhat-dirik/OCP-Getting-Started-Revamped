%% Kueue admission — Jobs, Batch & Kueue.
%% Shows a Job entering the queue (LocalQueue -> ClusterQueue quota check) and the three
%% possible outcomes: admitted, pending, or preempting a lower-priority Workload.
%% Resized 2026-08-22: was 719x760, text at 1.25x. Split into two `direction LR` rows (the
%% admission pipeline, then the three outcomes) per the platform-accretion idiom, and
%% trimmed node labels to one `<br/>` each.
flowchart TB
  subgraph queue["Job enters the queue"]
    direction LR
    j["Job<br/>label: queue-name=user-queue · priority-class=batch-low|high"] -->|"webhook suspends it,<br/>creates a Workload"| lq["LocalQueue user-queue<br/>(your namespace · no quota)"]
    lq --> cq{"ClusterQueue cq-user<br/>quota: 500m CPU / 512Mi · enough room?"}
  end
  subgraph outcome["Admission outcome"]
    direction LR
    adm["Admitted<br/>Job un-suspended, Pods run"]
    pend["Pending<br/>waits in the queue"]
    pre["Preempt a lower-priority Workload<br/>→ evict + requeue it · admit this one"]
    adm ~~~ pend ~~~ pre
  end
  cq -->|yes| adm
  cq -->|"no, and you're low priority"| pend
  cq -->|"no, but you're high priority"| pre
  classDef q fill:#e00,stroke:#900,color:#fff;
  classDef ok fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef wait fill:#fef7e0,stroke:#b06000,color:#7a4100;
  class lq,cq q;
  class adm ok;
  class pend,pre wait;
