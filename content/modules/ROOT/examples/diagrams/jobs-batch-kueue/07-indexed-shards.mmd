%% Indexed sharding — Jobs, Batch & Queued Workloads, lab exercise 3 ("You'll end with").
%% completionMode Indexed gives each of five Pods a fixed JOB_COMPLETION_INDEX; each Pod keeps the
%% claims whose number maps to its index, so the five slices never overlap and their subtotals add
%% up to the exercise-1 total. No coordinator: the index is the assignment.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  CSV[/"claims.csv<br/>200 claims"/] --> JOB["Indexed Job<br/>completions 5"]
  JOB -->|"index 0"| P0["statement-sharded-0<br/>40 claims"]
  JOB -->|"index 1, 2, 3"| P1["three more shards<br/>40 claims each"]
  JOB -->|"index 4"| P4["statement-sharded-4<br/>40 claims"]
  P0 --> SUM(["subtotals add up to<br/>USD 2,853,700"])
  P1 --> SUM
  P4 --> SUM
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class JOB,P0,P1,P4 hi;
  class CSV plat;
  class SUM done;
