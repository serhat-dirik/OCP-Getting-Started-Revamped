%% AI batch through the same queue — Jobs, Batch & Queued Workloads, lab exercise 6 ("You'll end with").
%% fraud-inference carries the same queue-name label as every other Job, so user-queue admits it;
%% its two Indexed workers read claims from the claims-data ConfigMap, call the cluster's
%% Models-as-a-Service endpoint, and print one fraud-risk verdict per claim to their logs.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  LQ["user-queue<br/>same LocalQueue"] -->|"admits"| JOB["fraud-inference<br/>2 Indexed workers"]
  CM[/"claims-data<br/>ConfigMap"/] --> JOB
  JOB -->|"chat completions"| MAAS(["MaaS endpoint<br/>the configured model"])
  JOB --> LOG["Pod logs<br/>a fraud-risk verdict per claim"]
  classDef q fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class LQ,JOB q;
  class CM,MAAS plat;
  class LOG done;
