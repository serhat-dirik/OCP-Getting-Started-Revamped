%% Two waves — Jobs, Batch & Queued Workloads, lab exercise 1 ("You'll end with").
%% completions 6 at parallelism 3: the Job controller runs three Pods, waits for them, runs three
%% more, then stops at 6/6. Every Pod mounts the same claims-data ConfigMap at /data.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  CM[/"claims-data<br/>ConfigMap"/] --> JOB["Job monthly-statement<br/>completions 6 · parallelism 3"]
  JOB -->|"wave 1"| W1["3 Pods<br/>0/6 to 3/6"]
  W1 -->|"wave 2"| W2["3 Pods<br/>3/6 to 6/6"]
  W2 --> DONE(["Complete<br/>the Job stops"])
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class JOB,W1,W2 hi;
  class CM plat;
  class DONE done;
