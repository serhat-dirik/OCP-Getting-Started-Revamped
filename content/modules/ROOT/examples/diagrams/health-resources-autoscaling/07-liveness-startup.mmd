%% Startup gates the other two; liveness restarts — Health, Resources & Autoscaling, lab exercise 2.
%% Until the startup probe passes, readiness and liveness do not run; once they do, three failed
%% liveness checks make the kubelet restart the container, which starts the cycle again.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  BOOT["container starts<br/>startup probe only"] -->|"startup passes"| RUN["readiness + liveness<br/>start probing"]
  RUN -->|"liveness fails 3 times"| KILL["kubelet restarts<br/>the container"]
  KILL -.->|"RESTARTS + 1"| BOOT
  classDef ok fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class BOOT plat;
  class RUN ok;
  class KILL bad;
