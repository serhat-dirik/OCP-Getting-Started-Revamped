%% A memory limit below what the JVM needs — Health, Resources & Autoscaling, lab exercise 3.
%% The new pod's container passes its limit while starting, the kernel kills it (exit 137,
%% reason OOMKilled), and it restarts into CrashLoopBackOff. It never becomes ready, so the
%% rollout is held and the old pod keeps serving.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  SET["memory limit 128Mi<br/>JVM needs more to start"] --> KERNEL["kernel kills it<br/>exit 137"]
  KERNEL --> CRASH["OOMKilled<br/>CrashLoopBackOff"]
  CRASH -.->|"never ready"| HELD["old pod keeps serving<br/>rollout held"]
  classDef ok fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class SET plat;
  class KERNEL,CRASH bad;
  class HELD ok;
