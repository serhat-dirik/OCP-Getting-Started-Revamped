%% Rolling update held by readiness — Health, Resources & Autoscaling, lab exercise 1.
%% Pointing readiness at a 404 path rolls out a new pod beside the old one. The new pod never
%% passes readiness, so it never joins the Service endpoints; the rollout stalls with the old pod
%% still serving, and the Route keeps answering 200.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  RT["Route<br/>still 200"] --> SVC["Service<br/>endpoints"]
  SVC -->|"traffic"| OLD["old pod · 1/1<br/>readiness passing"]
  SVC -.->|"no endpoint"| NEW["new pod · 0/1<br/>readiness on a 404 path"]
  DEP["Deployment<br/>rollout stalled"] --> OLD
  DEP --> NEW
  classDef ok fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class OLD ok;
  class NEW bad;
  class RT,SVC,DEP plat;
