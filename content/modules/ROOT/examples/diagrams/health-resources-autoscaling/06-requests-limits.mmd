%% Requests and limits — Health, Resources & Autoscaling, concept.
%% The request is what the scheduler reserves and what the HPA measures against; the limit is what
%% the kernel enforces at runtime — CPU over it is throttled, memory over it is killed (OOMKilled).
%% Shape (diagram-size-guard): LR, longest chain 2 nodes, no subgraph, labels at most 3 lines.
flowchart LR
  POD["claims container<br/>requests 200m · 256Mi<br/>limits 500m · 512Mi"]
  POD -->|"request"| SCHED["scheduler<br/>reserves room on a node"]
  POD -->|"request"| HPA["HPA<br/>utilization = use ÷ request"]
  POD -->|"CPU over the limit"| THR["throttled<br/>slower, still running"]
  POD -->|"memory over the limit"| OOM["OOMKilled<br/>killed and restarted"]
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef warn fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class POD,SCHED,HPA plat;
  class THR warn;
  class OOM bad;
