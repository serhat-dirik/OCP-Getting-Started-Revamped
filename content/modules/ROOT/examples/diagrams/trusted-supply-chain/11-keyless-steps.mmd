%% Keyless signing by Tekton Chains, step by step (concept page; lab exercise 2): what happens in the
%% seconds after build-image finishes, then how anyone verifies it. Two rows joined
%% container-to-container, so each row's `direction LR` is honoured
%% (tools/lint/diagram-size-guard.py, rule ignored-direction). 2026-11-15: the signer is the Chains
%% controller (was: the attendee's own pod).
flowchart TB
  subgraph GET["Seconds after build-image finishes"]
    direction LR
    S1["<b>1 · Build finishes</b><br/>the TaskRun reports IMAGE_URL +<br/>IMAGE_DIGEST; Chains picks it up"]
    S2["<b>2 · Who are you?</b><br/>Chains asks SPIRE for a token:<br/>…/sa/tekton-chains-controller"]
    S3["<b>3 · Certificate</b><br/>Fulcio checks the token, issues a<br/>10-minute certificate; the CT log records it"]
    S1 --> S2 --> S3
  end
  subgraph USE["Sign, record, verify"]
    direction LR
    S4["<b>4 · Sign</b><br/>a throwaway key signs the image + provenance;<br/>both pushed next to the image"]
    S5["<b>5 · Record</b><br/>Rekor logs both with their time;<br/>the key is discarded"]
    S6["<b>6 · Verify</b><br/>anyone, with public material only:<br/>Chains' SPIFFE ID + the Rekor entry"]
    S4 --> S5 --> S6
  end
  GET --> USE
  classDef sign fill:#fdf2e6,stroke:#c46a00,color:#3d2200;
  classDef tas fill:#ffffff,stroke:#555555,color:#151515;
  classDef ver fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class S1,S2,S4 sign;
  class S3,S5 tas;
  class S6 ver;
