%% Keyless signing, step by step (concept page): what happens in the seconds your sbom-signer pod
%% signs, then how anyone verifies it. Two rows joined container-to-container, so each row's
%% `direction LR` is honoured (tools/lint/diagram-size-guard.py, rule ignored-direction).
flowchart TB
  subgraph GET["Get an identity and a certificate"]
    direction LR
    S1["<b>1 · Identity</b><br/>SPIRE checks, on the node, the<br/>pod's namespace + service account"]
    S2["<b>2 · Token</b><br/>the pod asks SPIRE for a token:<br/>spiffe://…/ns/‹you›-cicd/sa/pipeline"]
    S3["<b>3 · Certificate</b><br/>Fulcio checks the token, issues a<br/>10-minute certificate; the CT log records it"]
    S1 --> S2 --> S3
  end
  subgraph USE["Sign, record, verify"]
    direction LR
    S4["<b>4 · Sign</b><br/>a key made for this one signature<br/>signs the SBOM, then is discarded"]
    S5["<b>5 · Record</b><br/>Rekor logs the signature and<br/>the certificate, with the time"]
    S6["<b>6 · Verify</b><br/>anyone, with public material only:<br/>the expected SPIFFE ID + the log entry"]
    S4 --> S5 --> S6
  end
  GET --> USE
  classDef sign fill:#fdf2e6,stroke:#c46a00,color:#3d2200;
  classDef tas fill:#ffffff,stroke:#555555,color:#151515;
  classDef ver fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class S1,S2,S4 sign;
  class S3,S5 tas;
  class S6 ver;
