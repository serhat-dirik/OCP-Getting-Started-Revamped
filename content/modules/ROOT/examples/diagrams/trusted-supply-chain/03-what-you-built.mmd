%% What you built — Trusted Software Supply Chain.
%% Two images, one narrative: the live scan-gate demo on the seeded branch (top), then the
%% pre-scanned/signed image's trust chain — verify, provenance, keyless sign+Rekor — through to
%% cluster admission (bottom two rows). Illustrates wrapup.adoc "What you built".
%% Resized 2026-08-22: was one flowchart LR row (intrinsic 1666x347, rendered 900x187, text at
%% 0.54x — too wide, and WARM had a third label line). Wrapped the long chain into two
%% direction-LR subgraphs stacked under the existing scanning subgraph, and compressed WARM to
%% two lines, per the diagram-resize rules.
%% Follow-up 2026-08-22: KEY-->ADM crossed the VERIFY/ADMIT boundary, silently disabling direction
%% for both. Fixed by routing it container-to-container: VERIFY-->ADMIT (no label existed to move).
flowchart TB
  subgraph SCAN["scanning — one beat"]
    direction LR
    SEED([your seeded build]) -. "Log4Shell → red" .-> STOP[/gate refuses<br/>:candidate/]
  end
  subgraph VERIFY["trust checks — the pre-scanned image"]
    direction LR
    WARM[(pre-scanned<br/>signed image · :latest)] --> VER{cosign verify<br/>key signature}
    VER -->|intact + ours| PROV[SLSA provenance<br/>+ SBOM]
    PROV --> KEY[keyless sign-blob<br/>→ Rekor log]
  end
  subgraph ADMIT["cluster admission — run time"]
    direction LR
    ADM{ImagePolicy<br/>admission}
    ADM -->|signed| RUN([pod runs])
    ADM -->|unsigned| DENY[/pull refused/]
  end
  VERIFY --> ADMIT
  classDef g fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef r fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class WARM,RUN,PROV,KEY,VER g;
  class STOP,DENY r;
