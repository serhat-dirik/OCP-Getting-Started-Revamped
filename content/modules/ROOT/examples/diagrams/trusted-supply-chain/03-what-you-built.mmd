%% What you built — Trusted Software Supply Chain (wrapup.adoc "What you built").
%% Three rows, one per part of the lab: the run you started, the checks you repeated by hand, and the
%% admission test. Rows are direction-LR subgraphs joined container-to-container only, so each
%% `direction LR` is honoured (tools/lint/diagram-size-guard.py, ignored-direction).
%% 2026-11-15: redrawn for the one-pipeline design.
flowchart TB
  subgraph RUN["you ran the trusted pipeline"]
    direction LR
    B[build-image<br/>a digest] -.-> CH[[Tekton Chains<br/>signed it, keyless]]
    B --> GATES{scan + SBOM<br/>Conforma}
    GATES --> DEP([deploy<br/>pinned by digest])
  end
  subgraph CHECK["you checked it yourself"]
    direction LR
    V1[cosign verify<br/>Chains' identity + Rekor] --> V2[verify-attestation<br/>which pipeline built it]
    V2 --> V3[SBOM + ec validate<br/>same verdict]
  end
  subgraph ADMIT["admission refused what the pipeline did not build"]
    direction LR
    OUT[/BuildConfig image<br/>:unsigned → refused/]
    IN([pipeline digest<br/>admitted])
  end
  RUN --> CHECK
  CHECK --> ADMIT
  classDef g fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef r fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class CH,DEP,V1,V2,V3,IN g;
  class OUT r;
