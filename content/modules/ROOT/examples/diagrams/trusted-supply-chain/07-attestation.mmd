%% Provenance beside the image — Trusted Software Supply Chain, lab exercise 3.
%% Chains stored a signed SLSA provenance statement as a .att tag derived from the image digest;
%% cosign verify-attestation checks its signature with the same public key, then the decoded
%% payload names the predicate type, the build type and the builder.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  IMG[("parasol-claims-trusted<br/>latest")] --> ATT["sha256-….att<br/>signed attestation"]
  ATT --> VER{"cosign<br/>verify-attestation"}
  VER -->|"key matches"| SLSA["SLSA provenance<br/>builder + buildType"]
  classDef g fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class IMG plat;
  class ATT,VER hi;
  class SLSA g;
