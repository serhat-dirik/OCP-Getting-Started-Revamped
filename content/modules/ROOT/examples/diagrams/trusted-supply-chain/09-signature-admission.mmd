%% Signature admission — Trusted Software Supply Chain, lab exercise 5 ("You'll end with").
%% The install's ClusterImagePolicy makes every node verify before it pulls: an image in a scoped
%% repository (each attendee's parasol-claims-trusted) needs a .sig valid for the trusted key AND the
%% ogsr-supply-chain/parasol-claims identity, or the pull is refused. Dashed: out-of-scope images
%% are pulled without a check.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  RUN["oc run<br/>node pulls the image"] --> SCOPE{"in a policy<br/>scope?"}
  SCOPE -->|"yes"| SIG{".sig valid for<br/>key + identity?"}
  SIG -->|"yes"| OK(["claims-signed<br/>Running"])
  SIG -->|"no"| DENY[/"claims-unsigned<br/>SignatureValidationFailed"/]
  SCOPE -.->|"no"| FREE(["pulled<br/>without a check"])
  classDef g fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef r fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class RUN,FREE plat;
  class OK g;
  class DENY r;
