%% Keyless signing with a workload identity — Trusted Software Supply Chain, lab exercise 4.
%% SPIRE attests the sbom-signer pod's namespace and service account on the node and issues it a
%% five-minute SPIFFE token; cosign trades the token for a short-lived Fulcio certificate whose SAN is
%% that SPIFFE ID, signs the SBOM, and records signature + certificate in the Rekor log;
%% verify-blob then accepts only that pinned identity.
%% Shape (diagram-size-guard): LR, longest chain 5 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  SPIRE["SPIRE on the node<br/>attests ns + sa"] -->|"SPIFFE token"| POD["sbom-signer pod<br/>sa pipeline"]
  POD -->|"5-minute token"| FUL["Fulcio<br/>short-lived cert"]
  FUL -->|"signature + cert"| REK[("Rekor<br/>public log entry")]
  REK --> VER{"verify-blob<br/>your identity only"}
  classDef g fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class SPIRE plat;
  class POD,FUL,REK hi;
  class VER g;
