%% What admission checks (concept page; lab exercise 4; demo step 3): the Red Hat Trusted Artifact
%% Signer policy controller, an admission webhook, on every pod create or update. It enforces only in
%% namespaces labelled policy.rhtas.com/include=true (each attendee's -cicd project), and only for
%% images a ClusterImagePolicy names (no-match-policy=allow admits the rest). A matching image needs
%% Tekton Chains' keyless signature: a Fulcio certificate for Chains' SPIFFE ID and its Rekor entry.
%% Shape (diagram-size-guard): LR, longest chain 5 nodes, no subgraph, labels at most 3 lines.
flowchart LR
  DEP["<b>Any deploy</b><br/>oc, a pipeline, Argo CD:<br/>a pod is created or updated"]
  DEP --> NS{"Namespace labelled<br/>policy.rhtas.com/include?"}
  NS -->|yes| MATCH{"Image named by<br/>a ClusterImagePolicy?"}
  MATCH -->|yes| SIG{"Chains' keyless signature<br/>+ Rekor entry?"}
  SIG -->|yes| RUN(["<b>Admitted</b><br/>the pod starts"])
  SIG -->|no| DENY[/"<b>Denied</b><br/>no signatures found"/]
  NS -.->|no| FREE(["Not enforced"])
  MATCH -.->|no| ALLOW(["Admitted<br/>no-match-policy=allow"])
  classDef ver fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef r fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef sign fill:#fdf2e6,stroke:#c46a00,color:#3d2200;
  classDef plat fill:#f3f3f3,stroke:#888888,color:#333333;
  class RUN ver;
  class DENY r;
  class NS,MATCH,SIG sign;
  class DEP,FREE,ALLOW plat;
