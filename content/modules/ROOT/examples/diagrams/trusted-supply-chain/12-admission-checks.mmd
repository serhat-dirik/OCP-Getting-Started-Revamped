%% What admission checks (concept page): OpenShift's native signature policy. The platform team's
%% ClusterImagePolicy makes every node verify Chains' signature before it pulls an image in one of
%% the policy's scopes; anything outside the scopes is pulled unchecked. Grounded in lab exercise 5
%% (SignatureValidationFailed, "A signature was required, but no signature exists").
flowchart LR
  PULL["<b>Any deploy</b><br/>oc, Argo CD, a pipeline:<br/>the node pulls the image"]
  PULL --> SCOPE{"In a policy<br/>scope?"}
  SCOPE -->|yes| SIG{"Valid Chains<br/>signature?"}
  SIG -->|yes| RUN(["<b>Pod starts</b>"])
  SIG -->|no| DENY[/"<b>Refused at pull</b><br/>SignatureValidationFailed"/]
  SCOPE -.->|no| FREE(["Pulled<br/>without a check"])
  classDef ver fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef r fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef sign fill:#fdf2e6,stroke:#c46a00,color:#3d2200;
  classDef plat fill:#f3f3f3,stroke:#888888,color:#333333;
  class RUN ver;
  class DENY r;
  class SCOPE,SIG sign;
  class PULL,FREE plat;
