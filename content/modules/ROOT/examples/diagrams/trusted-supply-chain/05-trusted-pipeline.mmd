%% The trusted pipeline — Trusted Software Supply Chain, lab exercise 1 and demo step 1.
%% parasol-claims-trusted-build, one run per attendee, in their own -cicd project: clone, build, then scan and SBOM
%% side by side, Conforma, deploy by digest. Tekton Chains is NOT a task: it watches build-image finish
%% and signs outside the pipeline (dashed); verify-conforma checks that signature before deploy.
%% Shape (diagram-size-guard): LR, longest chain 5 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  F["<b>fetch-source</b><br/>git clone"] --> B["<b>build-image</b><br/>buildah build + push"]
  B --> S{"<b>scan</b><br/>RHACS"}
  B --> SB["<b>sbom</b><br/>CycloneDX + sha256"]
  S --> C{"<b>verify-conforma</b><br/>ec validate image"}
  SB --> C
  C --> D(["<b>deploy</b><br/>pinned by digest"])
  B -.->|"outside the pipeline"| CH[["<b>Tekton Chains</b><br/>signs keyless"]]
  CH -.->|"signature + provenance"| C
  classDef g fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef sign fill:#fdf2e6,stroke:#c46a00,color:#3d2200;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class F,B,SB plat;
  class S,C,CH sign;
  class D g;
