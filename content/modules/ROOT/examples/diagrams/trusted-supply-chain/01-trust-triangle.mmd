%% Trust triangle — signature, SLSA provenance, and SBOM: how they get produced (the build
%% pipeline) and enforced (registry + cluster admission). Illustrates concept.adoc "Policy as a
%% gate, and policy as an admission control".
%% Resized 2026-08-22: was one flowchart LR row (intrinsic 1518x443, rendered 900x263, text at
%% 0.59x — too wide). Wrapped the row into two direction-LR subgraphs — the build pipeline and
%% registry/admission — stacked TB, per the diagram-resize rules.
%% Follow-up 2026-08-22: `direction LR` alone didn't hold — SRC-->BUILD and SCAN/SIG-->REG each
%% crossed a subgraph boundary, which silently disables direction for that subgraph. Fixed by
%% routing those 3 edges container-to-container: SRC-->PIPE, and SCAN+SIG collapsed into one
%% PIPE-->ADMIT edge labeled "clean + signed" (REG's own label already says what lands there).
flowchart TB
  SRC[(Source repo<br/>parasol-claims)] --> PIPE
  subgraph PIPE["Supply-chain pipeline (in your-name-cicd namespace)"]
    direction LR
    BUILD[build-image<br/>buildah] --> SBOMT[SBOM report<br/>CycloneDX]
    BUILD --> SCAN{scan gate<br/>RHACS}
    BUILD -. Tekton Chains signs .-> SIG[[signature + SLSA provenance<br/>stored beside the image]]
    SCAN -->|CVE found| STOP[/build fails —<br/>image never ships/]
  end
  subgraph ADMIT["registry + cluster admission — run time"]
    direction LR
    REG[(image + .sig + .att<br/>in the registry)] --> ADM{ImagePolicy<br/>admission}
    ADM -->|signed| RUN([pod runs])
    ADM -->|unsigned| DENY[/pull refused/]
  end
  PIPE -->|"clean + signed"| ADMIT
  classDef g fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef r fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class REG,RUN,SIG g;
  class STOP,DENY r;
