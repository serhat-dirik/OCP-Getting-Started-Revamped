%% How the signing works: who signs, Red Hat Trusted Artifact Signer, who verifies (concept page).
%% Two lanes because this module signs two things two ways: Tekton Chains signs the IMAGE with a
%% key (stored next to it, checked by the node at pull), and the attendee's own workload signs the
%% SBOM keyless (SPIFFE identity -> Fulcio certificate -> Rekor). No edge joins the two lanes, so
%% each lane is laid out on its own and its `direction LR` is honoured; TAS declares none, because
%% edges cross into it (tools/lint/diagram-size-guard.py, rule ignored-direction). The CT log sits
%% inside Fulcio's box and the component table lists it: a fourth TAS box stacked the lane 1085px
%% tall (measured 2026-11-15). Mermaid stacks unjoined lanes last-declared on top, so IMAGE is last.
flowchart LR
  subgraph SBOM["The SBOM: signed keyless, by your workload"]
    direction LR
    SPIRE["<b>SPIRE</b><br/>a 5-minute token naming<br/>the pod's SPIFFE ID"]
    POD["<b>Your signer pod</b><br/>signs with a key made<br/>for one signature"]
    subgraph TAS["Red Hat Trusted Artifact Signer"]
      FUL["<b>Fulcio</b><br/>checks the token, issues a 10-minute<br/>certificate; the CT log records it"]
      REK[("<b>Rekor</b><br/>every keyless signature,<br/>with its time")]
      TUF["<b>TUF</b><br/>trust roots for<br/>signers and verifiers"]
    end
    YOU2["<b>You, with cosign</b><br/>verify-blob: the expected<br/>SPIFFE ID + the log entry"]
  end
  subgraph IMAGE["The image: signed with a key"]
    direction LR
    CH["<b>Tekton Chains</b><br/>signs every image a pipeline<br/>builds, and its provenance"]
    REG[("<b>Image registry</b><br/>image + .sig + .att")]
    NODE["<b>Every node, at pull</b><br/>no valid Chains signature,<br/>no pull"]
    YOU1["<b>You, with cosign</b><br/>verify with Chains'<br/>public key"]
  end
  SPIRE -->|token| POD
  POD -->|token| FUL
  POD -->|signature| REK
  REK --> YOU2
  TUF -.-> YOU2
  CH --> REG
  REG --> NODE
  REG --> YOU1
  classDef sign fill:#fdf2e6,stroke:#c46a00,color:#3d2200;
  classDef tas fill:#ffffff,stroke:#555555,color:#151515;
  classDef ver fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef reg fill:#e8f0fb,stroke:#1a5fb4,color:#0b2e5c;
  classDef plat fill:#f3f3f3,stroke:#888888,color:#333333;
  class CH,POD sign;
  class FUL,REK,TUF tas;
  class NODE,YOU1,YOU2 ver;
  class REG reg;
  class SPIRE plat;
