%% How the signing works: who signs, Red Hat Trusted Artifact Signer, who verifies (concept page).
%% One signer, Tekton Chains, keyless: SPIRE gives the Chains controller its SPIFFE identity, Fulcio
%% certifies it for 10 minutes, Chains pushes the signature and provenance next to the image and Rekor
%% records both. Three verifiers read the same material: Conforma (before deploy), the policy
%% controller (admission), you with cosign. No subgraph declares `direction`, because edges cross into
%% every one of them (tools/lint/diagram-size-guard.py, rule ignored-direction). 2026-11-15.
flowchart LR
  subgraph SIGN["Who signs"]
    SPIRE["<b>SPIRE</b><br/>a short-lived token naming<br/>Chains' SPIFFE ID"]
    CH["<b>Tekton Chains</b><br/>outside the pipeline: signs each<br/>image a build TaskRun reports"]
  end
  subgraph TAS["Red Hat Trusted Artifact Signer, in this cluster"]
    FUL["<b>Fulcio</b><br/>checks the token, issues a 10-minute<br/>certificate; the CT log records it"]
    REK[("<b>Rekor</b><br/>every signature and<br/>attestation, with its time")]
    TUF["<b>TUF</b><br/>trust roots for<br/>signers and verifiers"]
  end
  REG[("<b>Image registry</b><br/>image + .sig + .att")]
  subgraph VER["Who verifies"]
    EC["<b>Conforma</b><br/>before deploy: signature,<br/>provenance, digest"]
    PC["<b>Policy controller</b><br/>admission webhook: Chains'<br/>identity + Rekor entry"]
    YOU["<b>You, with cosign</b><br/>the same checks,<br/>from the terminal"]
  end
  SPIRE -->|identity| CH
  CH -->|token| FUL
  CH -->|signature + provenance| REG
  CH -->|entries| REK
  REG --> EC
  REG --> PC
  REG --> YOU
  TUF -.->|trust roots| VER
  classDef sign fill:#fdf2e6,stroke:#c46a00,color:#3d2200;
  classDef tas fill:#ffffff,stroke:#555555,color:#151515;
  classDef ver fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef reg fill:#e8f0fb,stroke:#1a5fb4,color:#0b2e5c;
  classDef plat fill:#f3f3f3,stroke:#888888,color:#333333;
  class CH sign;
  class FUL,REK,TUF tas;
  class EC,PC,YOU ver;
  class REG reg;
  class SPIRE plat;
