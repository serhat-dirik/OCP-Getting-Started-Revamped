%% The scan stops a vulnerable build — Trusted Software Supply Chain, lab Challenge and demo step 4.
%% The seed-vulnerable branch carries log4j-core 2.14.1 (Log4Shell). The build succeeds and Chains signs
%% it (a signature says who built it, not that it is clean); the scan fails the run, so verify-conforma
%% and deploy never run and the running Deployment keeps its earlier digest.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  F["<b>fetch-source</b><br/>seed-vulnerable"] --> B["<b>build-image</b><br/>built, signed by Chains"]
  B --> S{"<b>scan</b><br/>RHACS"}
  S -->|"Log4Shell found"| RED[/"<b>run Failed</b>"/]
  S -.->|"never reached"| SKIP(["verify-conforma + deploy<br/>do not run"])
  classDef r fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class F,B,SKIP plat;
  class S,RED r;
