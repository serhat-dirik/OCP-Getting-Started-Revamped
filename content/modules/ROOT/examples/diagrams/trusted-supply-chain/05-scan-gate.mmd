%% The scan gate — Trusted Software Supply Chain, lab exercise 1 ("You'll end with").
%% The seeded branch runs the four-task pipeline to the throwaway :candidate tag; the build itself
%% succeeds, then acs-scan (RHACS build-time check) fails the run on Log4Shell. Dashed: the same gate
%% passed the clean main build at install, whose image you hold as parasol-claims-trusted:latest.
%% Shape (diagram-size-guard): LR, longest chain 5 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  FETCH["fetch-source<br/>seed-vulnerable"] --> SBOM["sbom-report<br/>CycloneDX SBOM"]
  SBOM --> BUILD["build-image<br/>:candidate"]
  BUILD --> SCAN{"acs-scan<br/>RHACS gate"}
  SCAN -->|"Log4Shell found"| RED[/"run Failed"/]
  SCAN -.->|"clean main, at install"| GREEN(["parasol-claims-trusted<br/>scan-passed=true"])
  classDef g fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef r fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class FETCH,SBOM,BUILD plat;
  class SCAN,RED r;
  class GREEN g;
