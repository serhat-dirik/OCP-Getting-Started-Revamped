%% Sign in the pipeline, verify anywhere — Trusted Software Supply Chain, lab exercise 2.
%% Tekton Chains watched the install-time build TaskRun in ogsr-supply-chain and signed its image with
%% the cluster's cosign key; prep copied the image and its .sig into your project as
%% parasol-claims-trusted:latest; cosign checks that signature against the public key.
%% Shape (diagram-size-guard): LR, longest chain 5 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  TR["build TaskRun<br/>ogsr-supply-chain"] -->|"Chains watches"| CH["Tekton Chains<br/>signs with its key"]
  CH --> IMG[("your project<br/>image + .sig")]
  IMG --> VER{"cosign verify"}
  KEY["chains-cosign-pub<br/>public key"] --> VER
  VER -->|"intact + ours"| OK(["Verified"])
  classDef g fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class TR,CH plat;
  class IMG,KEY,VER hi;
  class OK g;
