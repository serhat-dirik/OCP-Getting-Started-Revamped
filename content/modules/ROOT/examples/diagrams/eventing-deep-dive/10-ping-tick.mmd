%% A scheduled tick, end to end — Eventing Deep-Dive, lab exercise 6 ("You'll end with").
%% The seeded claim-ticker PingSource fires every five minutes with a claimpriority=high extension.
%% After exercise 4 two triggers match it — the catch-all claims-events and claims-audit — so the
%% consumer displays every tick twice, with the same knativearrivaltime.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  P["PingSource claim-ticker<br/>every 5 min · priority high"] --> BR[("Broker<br/>default")]
  BR --> T1{"claims-events<br/>catch-all"}
  BR --> T3{"claims-audit<br/>claimpriority: high"}
  T1 --> C["claims-consumer<br/>displays each tick twice"]
  T3 --> C
  classDef src fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef hub fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef trig fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef sink fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
  class P src; class BR hub; class T1,T3 trig; class C sink;
