flowchart LR
  SRC["PingSource<br/>claim-ticker"] -->|"every 5 min"| BR[("Broker<br/>default")]
  BR --> TR{"claims-events<br/>no filter"}
  TR --> C["claims-consumer<br/>0 pods while idle"]
  C ~~~ DLQ["claims-dlq<br/>idle until exercise 5"]
  classDef src fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef hub fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef trig fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef sink fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
  class SRC src; class BR hub; class TR trig; class C,DLQ sink;
