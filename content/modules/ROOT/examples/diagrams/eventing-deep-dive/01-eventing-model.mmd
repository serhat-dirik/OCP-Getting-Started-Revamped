%% Eventing model — Eventing Deep-Dive & Serverless Workflows.
%% The four Knative Eventing primitives: source -> broker -> trigger -> sink. Colors carry meaning
%% the concept page prose depends on — amber source/producer, blue broker, green triggers (each
%% filters independently), light-blue sinks. Resized 2026-08-22 (was `graph LR`, 1262x902 — the
%% same-rank sources/triggers/sinks fan out and stacked tall in that direction) into `flowchart TB`
%% with each fan-out tier grouped into its own `direction LR` row, per the direction-LR + ~~~ idiom
%% in build-deliver/02-platform-accretion-v2.mmd. Labels trimmed to two lines; the repeated
%% "Trigger" prefix on each trigger node was dropped since the row title now carries it.
%% Corrected 2026-08-22, same day: the row-to-row edges above were node-to-node (producer/src into
%% broker, broker into t1/t2/t3, t1/t2/t3 into consumer/dlq), and any edge crossing a subgraph
%% boundary silently disables that subgraph's own `direction LR` — which is why this still rendered
%% tall. Re-pointed every crossing edge to its row's container id (sources/broker_box/triggers/sinks);
%% the three broker->trigger edges and three trigger->consumer edges collapsed to one each since they
%% carried no label, the two differently-labeled source edges ("HTTP 202", "every 5 min") and the
%% DLQ preview edge ("on repeated failure") stayed as their own container-level edge so no label text
%% was dropped. Node ids, classDef/class lines, and every label's wording are unchanged.
flowchart TB
  subgraph sources["sources"]
    direction LR
    producer(["you: POST a CloudEvent"])
    src["PingSource claim-ticker<br/>(seeded source)"]
    producer ~~~ src
  end
  subgraph broker_box["Broker: default (in-memory)"]
    direction LR
    broker[("Broker<br/>ingress + channel")]
  end
  subgraph triggers["triggers — filter and route"]
    direction LR
    t1{"claims-events<br/>(no filter)"}
    t2{"claims-fraud-review<br/>filter: type=claim.submitted"}
    t3{"claims-audit<br/>filter: claimpriority=high"}
    t1 ~~~ t2 ~~~ t3
  end
  subgraph sinks["sinks"]
    direction LR
    consumer["claims-consumer (ksvc)<br/>200/204 · displays event · scales 0..N"]
    dlq["claims-dlq (ksvc)<br/>dead-letter sink"]
    consumer ~~~ dlq
  end
  sources -->|"HTTP 202"| broker_box
  sources -->|"every 5 min"| broker_box
  broker_box --> triggers
  triggers --> sinks
  triggers -->|"on repeated failure"| sinks
  classDef src fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef hub fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef trig fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef sink fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
  class src,producer src; class broker hub; class t1,t2,t3 trig; class consumer,dlq sink;
