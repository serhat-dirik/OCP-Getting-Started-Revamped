%% Retry, then dead-letter — Eventing Deep-Dive, lab exercise 5 (the break step).
%% claims-fraud-review now delivers to the /process path, which claims-consumer does not serve: the
%% first attempt and three exponential-backoff retries (1 s, 2 s, 4 s) all get a 404, and the event
%% goes to the claims-dlq dead-letter sink stamped with knativeerrorcode and knativeerrordest.
%% A smaller lab twin of 02-retries-dlq.mmd, which the concept page uses.
%% Shape (diagram-size-guard): LR, three ranks, no subgraph, labels at most 2 lines.
flowchart LR
  BR[("Broker<br/>default")] --> T{"claims-fraud-review<br/>retry 3 · 1 s, 2 s, 4 s"}
  T -.->|"4 tries, all 404"| C["claims-consumer/process<br/>path not served"]
  T ==>|"retries exhausted"| D["claims-dlq<br/>event + knativeerrorcode"]
  classDef hub fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef trig fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef sink fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
  class BR hub; class T trig; class C bad; class D sink;
