%% Broker delivery wakes the consumer — Eventing Deep-Dive, lab exercise 3 ("You'll end with").
%% A CloudEvent POSTed to the broker ingress is routed by the claims-events Trigger to claims-consumer,
%% which sits at zero pods and has to start one first. The in-memory broker delivers synchronously, so
%% the producer's HTTP 202 comes back only after that delivery: ~10-23 s cold, sub-second warm.
%% Shape (diagram-size-guard): LR, longest chain 5 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  YOU(["demo-client<br/>POSTs a CloudEvent"]) --> BR[("Broker<br/>default")]
  BR -->|"claims-events"| UP["claims-consumer at 0<br/>starts a pod"]
  UP --> C["claims-consumer<br/>displays the event"]
  C -.->|"delivered"| OK(["HTTP 202<br/>back to the producer"])
  classDef src fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef hub fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef wait fill:#fff,stroke:#b06000,color:#7a4100,stroke-dasharray: 4 3;
  classDef sink fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
  class YOU,OK src; class BR hub; class UP wait; class C sink;
