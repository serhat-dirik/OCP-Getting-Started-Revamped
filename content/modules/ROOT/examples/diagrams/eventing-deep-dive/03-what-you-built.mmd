%% What you built — Eventing Deep-Dive & Serverless Workflows.
%% Post-lab state of the same source -> broker -> trigger -> sink model as 01-eventing-model.mmd,
%% inside the attendee's namespace, with claims-fraud-review now carrying retry+DLQ delivery.
%% Resized 2026-08-22 (was `graph TB` with all seven nodes listed flat inside one subgraph and no
%% `direction` hint, 1141x785 — the whole namespace stacked into one tall column) into three
%% `direction LR` rows (sources / triggers / sinks) nested inside the namespace subgraph, stacked
%% `TB`, matching the fix in multi-tenancy-workload-security/04-what-you-built.mmd. Labels trimmed
%% to two lines.
%% Corrected 2026-08-22, same day: the edges below were node-to-node (you/src into broker, broker into
%% t1/t2/t3, t1/t2/t3 into consumer/dlq), and any edge crossing a subgraph boundary silently disables
%% that subgraph's own `direction LR` — which is why this still rendered tall. Re-pointed every edge
%% that touched a src_row/trig_row/sink_row member to that row's container id instead; `broker` itself
%% needed no change, since it already sits directly in `ns`, the same level as the three rows. The
%% three broker->trigger and three trigger->consumer edges (all unlabeled) collapsed to one each; the
%% two differently-labeled source edges ("202", "every 5 min") and the dotted DLQ edge
%% ("on exhausted retries") stayed as their own container-level edge so no label text was dropped.
%% Node ids, classDef/class lines, and every label's wording are unchanged.
flowchart TB
  subgraph ns["your-name-dev namespace — after the lab"]
    direction TB
    subgraph src_row["sources"]
      direction LR
      you(["you: POST a CloudEvent"])
      src["PingSource<br/>claim-ticker (seeded)"]
      you ~~~ src
    end
    broker[("Broker: default<br/>in-memory · synchronous")]
    subgraph trig_row["triggers"]
      direction LR
      t1{"claims-events<br/>(catch-all)"}
      t2{"claims-fraud-review<br/>filter type · retry 3 + DLQ"}
      t3{"claims-audit<br/>filter claimpriority=high"}
      t1 ~~~ t2 ~~~ t3
    end
    subgraph sink_row["sinks"]
      direction LR
      consumer["claims-consumer (ksvc)<br/>200/204 · displays envelope · scales 0..N on event"]
      dlq["claims-dlq (ksvc)<br/>dead-letter sink · knativeerrorcode / dest"]
      consumer ~~~ dlq
    end
  end
  src_row -->|"202"| broker
  src_row -->|"every 5 min"| broker
  broker --> trig_row
  trig_row --> sink_row
  trig_row -.->|"on exhausted retries"| sink_row
  classDef src fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef hub fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef trig fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef sink fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
  class src,you src; class broker hub; class t1,t2,t3 trig; class consumer,dlq sink;
