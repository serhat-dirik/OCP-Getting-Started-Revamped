%% Three triggers, one broker — Eventing Deep-Dive, lab exercise 4 ("You'll end with").
%% After exercise 4 the default Broker has the catch-all claims-events Trigger plus two filtered ones:
%% claims-fraud-review on the CloudEvent type, claims-audit on the claimpriority extension attribute.
%% Each filters independently and all three deliver to claims-consumer, so the consumer displays an
%% event once per trigger that matches it — the count the exercise reads.
%% Shape (diagram-size-guard): LR, three ranks, no subgraph, labels at most 2 lines.
flowchart LR
  BR[("Broker<br/>default")] --> T1{"claims-events<br/>no filter"}
  BR --> T2{"claims-fraud-review<br/>type: claim.submitted"}
  BR --> T3{"claims-audit<br/>claimpriority: high"}
  T1 --> C["claims-consumer<br/>one display per match"]
  T2 --> C
  T3 --> C
  classDef hub fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef trig fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef sink fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
  class BR hub; class T1,T2,T3 trig; class C sink;
