%% Red to green — App Security & Testing wrap-up.
%% The five security gates in the order the lab hits them, each with the fix that turned it green.
%% Mirrors wrapup.adoc's five bullets one for one; the seed branch name and the red/green framing
%% are prose, not decoration.
%% Resized 2026-08-23: was one `graph LR` chain of seven (seed + five fixes + green), which is seven
%% dagre ranks — the ~2000px-wide shape the 900px cap then scales DOWN, unreadably. Same seven nodes,
%% same order, same classes: the five fixes now sit in one `direction LR` row with seed above it and
%% green below, joined container-to-container so the row's direction survives. Longest chain is five.
flowchart TB
  seed["seed-appsec branch<br/>5 flaws · every gate RED"]
  subgraph fixes["one fix per gate, in the order you hit them"]
    direction LR
    sast["fix SAST<br/>externalize secret"] --> sca["fix SCA<br/>drop vuln dep"] --> img["fix image<br/>stop baking log4shell"] --> cfg["fix config<br/>harden manifest"] --> dast["fix DAST<br/>add headers"]
  end
  green["every gate GREEN<br/>scanned · signed · deployed"]
  seed --> fixes
  fixes --> green
  classDef r fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef f fill:#e8f0fe,stroke:#1967d2,color:#174ea6;
  classDef g fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class seed r; class sast,sca,img,cfg,dast f; class green g;
