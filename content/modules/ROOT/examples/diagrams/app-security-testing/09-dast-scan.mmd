%% DAST scan — Application Security Testing, lab exercise 6.
%% Why DAST can only run after deploy: the deploy stage starts the app and its Route, ZAP (dast-zap)
%% sends real HTTP requests to the running app and reads the response headers, and with FAIL_ON_WARN
%% a single remaining warning stops the run. With no warnings the run goes on to perf-k6, a short
%% load test against the same running app.
%% Shape (diagram-size-guard): LR, five nodes, longest chain three, labels at most 2 lines.
flowchart LR
  dep["deploy stage<br/>app + Route"] --> app["running<br/>parasol-claims"]
  zap["dast-zap<br/>ZAP baseline scan"] -->|"HTTP requests"| app
  zap -->|"any WARN"| stop["run stops<br/>FAIL_ON_WARN"]
  zap -->|"no WARN"| k6["perf-k6<br/>load test"]
  classDef r fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef g fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef n fill:#f1f3f4,stroke:#5f6368,color:#202124;
  class stop r; class k6 g; class dep,app,zap n;
