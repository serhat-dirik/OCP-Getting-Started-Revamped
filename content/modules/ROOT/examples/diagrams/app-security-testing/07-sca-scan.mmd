%% SCA scan — Application Security Testing, lab exercise 3 ("You'll end with").
%% What sca-trivy reads and what it decides: Trivy reads the dependencies pom.xml declares, writes a
%% CycloneDX SBOM (trivy-sbom.json) into the run's workspace either way, and stops the run on a HIGH
%% or CRITICAL CVE (here commons-collections 3.2.1, CVE-2015-7501). A clean scan lets the run go on to
%% build-image and unit-test, which run side by side.
%% Shape (diagram-size-guard): LR, five nodes, three ranks, no subgraph, labels at most 2 lines.
flowchart LR
  pom["pom.xml<br/>declared dependencies"] --> trivy["sca-trivy<br/>Trivy"]
  trivy --> sbom["trivy-sbom.json<br/>CycloneDX SBOM"]
  trivy -->|"HIGH or CRITICAL CVE"| stop["run stops"]
  trivy -->|"clean"| build["build-image<br/>and unit-test"]
  classDef r fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef f fill:#e8f0fe,stroke:#1967d2,color:#174ea6;
  classDef g fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef n fill:#f1f3f4,stroke:#5f6368,color:#202124;
  class stop r; class sbom f; class build g; class pom,trivy n;
