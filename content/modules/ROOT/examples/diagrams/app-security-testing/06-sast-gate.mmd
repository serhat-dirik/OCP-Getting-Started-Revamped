%% SAST gate — Application Security Testing, lab exercise 2 ("You'll end with").
%% Same shape as 04-config-gate on purpose: the seeded source and the fixed source meet the SAME
%% gate, and the verdict is the pipeline's, not the file's. Names are the module's own: the stage is
%% sast-sonar, the seeded PartnerGateway.java holds the partnerApiPassword literal, SonarQube flags
%% it as rule S2068 (vulnerabilities=1, quality gate failed), and the fix reads the value with
%% @ConfigProperty so the next stage, sca-trivy, runs.
%% Shape (diagram-size-guard): LR, five nodes, three ranks, no subgraph, labels at most 2 lines.
flowchart LR
  seed["PartnerGateway.java<br/>password literal"]
  fix["PartnerGateway.java<br/>@ConfigProperty"]
  gate["sast-sonar<br/>SonarQube quality gate"]
  stop["run stops<br/>rule S2068"]
  next["run moves on<br/>to sca-trivy"]
  seed --> gate
  fix --> gate
  gate -->|"1 vulnerability"| stop
  gate -->|"0 vulnerabilities"| next
  classDef r fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef f fill:#e8f0fe,stroke:#1967d2,color:#174ea6;
  classDef g fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef n fill:#f1f3f4,stroke:#5f6368,color:#202124;
  class seed,stop r; class fix f; class next g; class gate n;
