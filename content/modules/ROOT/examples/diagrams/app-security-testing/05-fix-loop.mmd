%% The fix loop — Application Security Testing, lab introduction.
%% The one rhythm every exercise repeats: run the capstone, a gate fails and the run stops, read the
%% finding in its own console, commit one fix to seed-appsec, re-run. Five turns of the loop (one per
%% seeded flaw) and the run leaves it green.
%% Shape (diagram-size-guard): LR, five nodes, one back edge for the loop, labels at most 2 lines.
flowchart LR
  run["run the<br/>capstone pipeline"] --> red["a gate fails<br/>the run stops"]
  red --> read["read the finding<br/>in its console"]
  read --> fix["commit one fix<br/>to seed-appsec"]
  fix -->|"re-run"| run
  run -->|"after five fixes"| green["every gate green"]
  classDef r fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef f fill:#e8f0fe,stroke:#1967d2,color:#174ea6;
  classDef g fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef n fill:#f1f3f4,stroke:#5f6368,color:#202124;
  class red r; class read,fix f; class green g; class run n;
