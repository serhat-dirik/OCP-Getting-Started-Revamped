%% Five pillars — App Security & Testing.
%% The five gates in concept.adoc's order, split shift-left (SAST, SCA, config) and shift-right
%% (image scan, DAST) exactly as the prose does — cfg belongs to SL even though the pipeline runs
%% it after the build. concept.adoc: "The shape of the pipeline is the lesson".
%% Narrowed 2026-08-23: the chain ran eight dagre ranks, which renders around 2000px wide and is
%% then scaled DOWN by the 900px cap — the shape measured at 0.44x text. `build` and `deploy` are
%% not pillars; they are the transitions BETWEEN pillars, and they were the only two nodes in
%% neither subgraph. They became edge labels, so the pipeline still reads left to right through
%% the same eight moments, in six ranks. Pillar order, membership and classes are untouched.
graph LR
  subgraph SL["Shift LEFT — before build/deploy"]
    src["Source"]
    sast["SAST<br/>SonarQube<br/>(secrets, injection)"]
    sca["SCA<br/>Trivy<br/>(dependency CVEs)"]
    cfg["Config check<br/>RHACS roxctl<br/>(insecure manifest)"]
  end
  subgraph SR["Shift RIGHT — build & run"]
    img["Image scan<br/>RHACS<br/>(image CVEs)"]
    dast["DAST<br/>ZAP<br/>(running app)"]
  end
  src --> sast --> sca -->|"build image"| img --> cfg -->|"deploy"| dast
  classDef l fill:#e8f0fe,stroke:#1967d2,color:#174ea6;
  classDef r fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef n fill:#f1f3f4,stroke:#5f6368,color:#202124;
  class sast,sca,cfg l; class img,dast r; class src n;
