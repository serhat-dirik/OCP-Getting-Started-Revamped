%% Defense in depth — Application Security Testing, lab exercise 4 ("You'll end with").
%% Why the image scan caught what SCA could not: log4j-core 2.14.1 is not in pom.xml, so the Trivy
%% source scan is clean; the seeded Containerfile adds the jar at build time, so it exists only in
%% the assembled image, and only the RHACS image scan (image-scan stage) sees it and blocks the run on
%% the Block Log4Shell (CVE-2021-44228) at build policy.
%% Shape (diagram-size-guard): LR, five nodes, longest chain four, labels at most 2 lines.
flowchart LR
  pom["pom.xml<br/>no log4j"] --> sca["SCA: Trivy<br/>clean"]
  cf["Containerfile<br/>adds log4j-core 2.14.1"] --> img["built image"]
  sca -->|"build"| img
  img --> scan["image scan: RHACS<br/>Log4Shell, CRITICAL"]
  classDef r fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef g fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef n fill:#f1f3f4,stroke:#5f6368,color:#202124;
  class cf,scan r; class sca g; class pom,img n;
