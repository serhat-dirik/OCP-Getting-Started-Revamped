%% Waking from zero — Serverless Zero-to-Hero, lab exercise 2 ("You'll end with").
%% The first request into a scaled-to-zero ksvc is held by the activator while a pod is scheduled and
%% the JVM boots (10-30 s measured on this cluster); the next request lands on that warm pod (~0.1 s).
%% Shape (diagram-size-guard): LR, two chains of at most 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  R1(["first request"]) --> ACT["activator<br/>holds the request"]
  ACT --> POD["new pod<br/>JVM boots"]
  POD --> OK1["HTTP 200<br/>in 10–30 s"]
  R2(["next request"]) --> WARM["warm pod<br/>app + queue-proxy"]
  WARM --> OK2["HTTP 200<br/>in about 0.1 s"]
  classDef wait fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class ACT,POD,OK1 wait;
  class WARM,OK2 good;
  class R1,R2 plat;
