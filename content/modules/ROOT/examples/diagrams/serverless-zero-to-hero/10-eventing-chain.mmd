%% Eventing taste — Serverless Zero-to-Hero, lab exercise 6 ("You'll end with") and the concept page.
%% A PingSource emits an event every minute into the in-memory Broker; the Trigger delivers it as a
%% CloudEvents POST to the parasol-claims ksvc, which wakes from zero and answers 405 because the app
%% has no POST handler yet. Processing the event is the Eventing Deep-Dive module.
%% Shape (diagram-size-guard): LR, longest chain 5 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  PS["PingSource<br/>every minute"] --> BR[("Broker<br/>in-memory")]
  BR --> TR["Trigger<br/>claims-processor"]
  TR -->|"CloudEvent POST"| KS["parasol-claims<br/>wakes from 0"]
  KS -.->|"no POST handler"| R405["HTTP 405"]
  classDef evt fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class PS,BR,TR evt;
  class KS hi;
  class R405 plat;
