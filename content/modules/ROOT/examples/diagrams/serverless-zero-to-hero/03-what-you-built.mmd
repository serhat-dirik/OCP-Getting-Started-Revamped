%% What you built — Serverless Zero-to-Hero.
%% The Parasol claims-processor ksvc (Route + Revisions v1/v2) and its eventing taste
%% (PingSource -> Broker -> Trigger), all living in the attendee namespace after the lab, with
%% the client and the KPA autoscaler as the two outside actors reaching in.
%% Resized 2026-08-22: intrinsic 838x745 (h/w 0.89, rendered 900x800 at a fine 1.07x text — no
%% text-scale problem here). Pure aspect-ratio fix, `graph TB` -> `graph LR`, nothing else
%% touched: this diagram shares its object vocabulary with the sibling
%% 01-request-driven-compute.mmd in this same folder, which already uses top-level `graph LR`
%% (subgraphs inheriting it, no explicit per-subgraph direction) and was not flagged for resize.
graph LR
  subgraph ns["your-name-dev namespace — after the lab"]
    subgraph ksvc["parasol-claims (ksvc)"]
      route["Route<br/>(auto edge, Kourier)<br/>80% stable / 20% candidate"]
      v1["Revision v1<br/>#stable"]
      v2["Revision v2<br/>#candidate · CC=2 · max-scale 3"]
    end
    ping["PingSource<br/>claim-ticker"] --> broker[("Broker<br/>default (in-memory)")]
    broker --> trig["Trigger<br/>claims-processor"]
  end
  client(["client"]) -->|"HTTPS"| route
  route -->|"80%"| v1
  route -->|"20%"| v2
  kpa{{"KPA · scale 0..3<br/>on concurrency"}} -.-> v1
  kpa -.-> v2
  trig -->|"wakes on event -> 404 (Eventing Deep-Dive)"| route
  classDef svc fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef ctl fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef evt fill:#fef7e0,stroke:#b06000,color:#7a4100;
  class v1,v2 svc; class route,kpa ctl; class ping,broker,trig evt;
