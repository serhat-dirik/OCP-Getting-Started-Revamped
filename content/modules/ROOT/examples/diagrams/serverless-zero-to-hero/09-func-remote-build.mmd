%% On-cluster function build — Serverless Zero-to-Hero, lab exercise 5 ("You'll end with").
%% kn func deploy with the remote flag uploads the source to a PVC in the attendee namespace, runs an
%% OpenShift Pipelines run there (scaffold, S2I build, deploy), pushes to the internal registry and
%% creates the premium-calculator ksvc.
%% Shape (diagram-size-guard): LR, longest chain 5 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  SRC["your source<br/>in the terminal"] -->|"upload"| PVC["PVC<br/>in your namespace"]
  PVC --> PR["PipelineRun<br/>scaffold · build · deploy"]
  PR --> IMG["image<br/>internal registry"]
  IMG --> KS["ksvc<br/>premium-calculator"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class PR,KS hi;
  class SRC,PVC,IMG plat;
