%% Tag-based traffic split — Serverless Zero-to-Hero, lab exercise 4 ("You'll end with").
%% The ksvc's main URL splits 80/20 across two immutable revisions; each tag also gets its own
%% sub-route that reaches one revision directly. Rollback is the same split with 100/0.
%% Shape (diagram-size-guard): LR, longest chain 2 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  MAIN(["main URL"]) -->|"80%"| V1["parasol-claims-v1<br/>tag: stable"]
  MAIN -->|"20%"| V2["parasol-claims-v2<br/>tag: candidate"]
  ST(["stable sub-route"]) --> V1
  CA(["candidate sub-route"]) --> V2
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class V1,V2 hi;
  class MAIN,ST,CA plat;
