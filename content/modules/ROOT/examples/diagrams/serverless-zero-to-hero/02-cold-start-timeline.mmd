%% Cold-start timeline — Serverless Zero-to-Hero. Request 1 hits a scaled-to-zero ksvc (amber
%% row, ~15-30s through the activator); request 2 hits the now-warm pod (green row, ~0.1s); then
%% the two ways to avoid paying the cold start on a latency-sensitive path.
%% Resized 2026-08-22: intrinsic 778x565 (h/w 0.73, rendered 900x654 at a fine 1.16x text). Both
%% subgraphs already used `direction LR` — the height driver was three over-long node labels
%% (activator: 3 lines, JVM boot: 3 lines, the fix note: 4 lines) plus a 2-line edge label.
%% Compressed each to the house one-`<br/>` limit; kept the COLD/WARM/FIX stack top-to-bottom.
%% (A full top-level `direction LR` here would put all 9 nodes in one row: COLD's row alone is
%% already ~800px wide, so adding WARM and FIX beside it would sail past the 1500px too-wide
%% line — the "truer timeline" read is not worth a new too-wide diagram.)
flowchart TB
  subgraph COLD["Request 1 — service is at ZERO pods"]
    direction LR
    R1(["request<br/>arrives"]) --> ACT["activator<br/>holds the request · does not fail it"]
    ACT --> SCH["pod<br/>scheduled"]
    SCH --> JVM["JVM boots<br/>+ Hibernate schema check"]
    JVM --> RESP1["response<br/>~15–30 s"]
  end
  subgraph WARM["Request 2 — the pod is now WARM"]
    direction LR
    R2(["request<br/>arrives"]) --> POD["pod already<br/>running"] --> RESP2["response<br/>~0.1 s"]
  end
  COLD -.->|"the pod stays up until the quiet period expires, then scales back to zero"| WARM
  FIX["the two ways out of the cold start<br/>min-scale: 1 (always-warm, no scale-to-zero) · native build (shrinks it)"]
  WARM -.-> FIX
  classDef wait fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef svc fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef note fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
  class R1,R2 svc;
  class ACT,SCH,JVM,RESP1 wait;
  class POD,RESP2 good;
  class FIX note;
