flowchart TB
  subgraph COLD["Request 1 — service is at ZERO pods"]
    direction LR
    R1(["request<br/>arrives"]) --> ACT["activator<br/>holds the request<br/>(it does not fail it)"]
    ACT --> SCH["pod<br/>scheduled"]
    SCH --> JVM["JVM boots<br/>+ Hibernate<br/>schema check"]
    JVM --> RESP1["response<br/>~15–30 s"]
  end
  subgraph WARM["Request 2 — the pod is now WARM"]
    direction LR
    R2(["request<br/>arrives"]) --> POD["pod already<br/>running"] --> RESP2["response<br/>~0.1 s"]
  end
  COLD -.->|"the pod stays up until the quiet<br/>period expires, then scales back to zero"| WARM
  FIX["the two ways out of the cold start<br/>min-scale: 1 — keep one pod always warm<br/>(removes the cold start, gives up scale-to-zero)<br/>a native build — shrinks it instead of removing it"]
  WARM -.-> FIX
  classDef wait fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef svc fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef note fill:#e3f2fd,stroke:#1565c0,color:#0d47a1;
  class R1,R2 svc;
  class ACT,SCH,JVM,RESP1 wait;
  class POD,RESP2 good;
  class FIX note;
