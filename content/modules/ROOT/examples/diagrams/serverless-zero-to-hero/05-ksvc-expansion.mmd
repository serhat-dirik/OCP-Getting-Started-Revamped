%% What one Knative Service expands into — Serverless Zero-to-Hero, lab exercise 1 ("You'll end with").
%% The attendee authors only the ksvc; Knative creates the Configuration, the Revision it mints, the
%% Route it publishes as status.url, and a Deployment per revision that holds zero pods while idle.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  KSVC["Knative Service<br/>parasol-claims"] --> CFG["Configuration<br/>latest desired version"]
  CFG --> REV["Revision<br/>parasol-claims-v1"]
  REV --> DEP["Deployment<br/>0 pods while idle"]
  KSVC --> RT["Route<br/>status.url over HTTPS"]
  RT -->|"100%"| REV
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class KSVC hi;
  class CFG,REV,RT,DEP plat;
