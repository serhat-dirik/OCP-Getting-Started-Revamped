%% Hook and test — Packaging & Distributing Your App, lab exercise 5 ("You'll end with").
%% Two uses of the same helm.sh/hook annotation at different moments: the post-upgrade hook Job
%% runs after the upgrade and seeds CLM-0000; `helm test`, run on demand, starts a test Pod that
%% writes a notification and reads it back from the single notifications pod.
%% Shape (diagram-size-guard): LR, longest chain 4, no subgraph, labels at most 2 lines.
flowchart LR
  UP["helm upgrade --wait<br/>one replica"] --> POD["notifications pod<br/>Ready 1/1"]
  POD -->|"post-upgrade hook"| HK["seed Job<br/>posts CLM-0000"]
  TS["helm test<br/>on demand"] -->|"test hook"| TP["test Pod<br/>notify, then read back"]
  TP --> POD
  classDef act fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef hook fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class UP,TS act; class HK,TP hook; class POD good;
