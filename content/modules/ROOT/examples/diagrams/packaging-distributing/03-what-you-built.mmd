%% What you built — Packaging & Distributing Your App.
%% The two halves of the module's arc — the Helm chain you packaged, then the OLM bundle you
%% dissected — as two short rows instead of one seven-node-wide strip. Same two subgraphs as
%% before, same nodes, same edges, same labels; only the outer direction changed, from LR
%% (side by side) to TB (stacked), with `direction LR` now explicit inside each subgraph so its
%% own nodes still read left to right.
%% Resized 2026-08-22: was 2040x149 intrinsic (rendered 900x66, text at 0.44x — the worst shrink
%% in the catalogue). Node id `direction` renamed to `olmv1`: it collided with the `direction LR`
%% statement this fix requires inside the same subgraph, so it is renamed for parse safety only —
%% its label ("OLM v1 / ClusterCatalog · ClusterExtension") is untouched.
flowchart TB
  subgraph helm["You packaged (Helm)"]
    direction LR
    c["helm create"] --> tmpl["values + templates<br/>image · /health · SITE · Route"]
    tmpl --> rel["install → upgrade →<br/>break → rollback → test"]
    rel --> oci["package + push<br/>OCI artifact (matching digest)"]
  end
  subgraph olm["You dissected (OLM)"]
    direction LR
    sub["Subscription<br/>(channel · catalog)"] --> csv["CSV<br/>owned CRDs + controller"]
    csv --> olmv1["OLM v1<br/>ClusterCatalog · ClusterExtension"]
  end
  helm -.->|"the spectrum: most apps stop at Helm"| olm
  classDef h fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef o fill:#fef7e0,stroke:#b06000,color:#7a4100;
  class c,tmpl,rel,oci h; class sub,csv,olmv1 o;
