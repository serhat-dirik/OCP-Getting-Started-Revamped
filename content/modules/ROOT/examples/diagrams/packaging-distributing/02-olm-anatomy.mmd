%% OLM anatomy — Packaging & Distributing Your App.
%% The classic OLM object chain a click on "Install" in OperatorHub sets in motion, grouped into
%% two phases (you choose -> OLM takes over) so the six nodes lay out as two three-node rows.
%% Same chain, same five edges, same three color classes the diagram already had; only the
%% subgraph boundary moved. No node id here collides with the `direction` keyword (that trap hit
%% the sibling `03-what-you-built.mmd`, not this file).
%% Resized 2026-08-22: was 353x644 intrinsic (rendered 900x1642, text at 2.55x) as one six-node
%% column. First regrouped into three two-node subgraphs (the catalog / you subscribe / it runs),
%% but the two edges joining them (PackageManifest --> Subscription, InstallPlan --> CSV) crossed
%% subgraph boundaries, so `direction LR` was silently ignored and it rendered at 900x1689 (2.13x)
%% — barely improved. Regrouped again into two three-node subgraphs (you choose / OLM takes over):
%% the edge that used to sit inside a subgraph (Subscription --> InstallPlan) now crosses, so it is
%% lifted to container level; the two edges that used to cross (PackageManifest --> Subscription,
%% InstallPlan --> CSV) now sit inside a subgraph instead.
flowchart TB
  subgraph CHOOSE["you choose"]
    direction LR
    cat["CatalogSource<br/>(a catalog index image)"]
    pm["PackageManifest<br/>(the operator's channels)"]
    sub["Subscription<br/>you pick a channel"]
    cat --> pm
    pm --> sub
  end
  subgraph RUNTIME["OLM takes over"]
    direction LR
    ip["InstallPlan<br/>Automatic or Manual approval"]
    csv["ClusterServiceVersion (CSV)<br/>owned CRDs + controller Deployment + RBAC"]
    pod["Operator Pod<br/>reconciles your custom resources"]
    ip --> csv
    csv --> pod
  end
  CHOOSE --> RUNTIME
  classDef cat fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef pick fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef run fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class cat,pm cat; class sub,ip pick; class csv,pod run;
