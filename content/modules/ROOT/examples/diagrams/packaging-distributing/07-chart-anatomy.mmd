%% Chart anatomy — Packaging & Distributing Your App, lab exercise 1 ("You'll end with").
%% What `helm create` scaffolds and how the pieces relate: Chart.yaml and values.yaml feed the
%% templates, a consumer's --set or -f overrides win over the values defaults, and the templates
%% render the manifests Helm applies.
%% Shape (diagram-size-guard): LR, longest chain 4, no subgraph, labels at most 2 lines.
flowchart LR
  CH["Chart.yaml<br/>name · version · appVersion"] --> T["templates/<br/>manifests with placeholders"]
  V["values.yaml<br/>a default for every input"] --> T
  OV["--set or -f<br/>a consumer's overrides"] -.->|"override"| V
  T --> M["rendered manifests<br/>what Helm applies"]
  classDef authored fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef consumer fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef out fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class CH,V,T authored; class OV consumer; class M out;
