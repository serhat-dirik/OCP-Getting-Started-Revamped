%% Release history — Packaging & Distributing Your App, lab exercise 4 ("You'll end with").
%% The four revisions `helm history` records: install, the two-replica upgrade, the upgrade that
%% failed on the /healthz probe, and the rollback, which is a NEW revision 4 carrying a copy of
%% revision 2 (dashed) rather than a deletion of revision 3.
%% Shape (diagram-size-guard): LR, chain of 4, no subgraph, labels at most 2 lines.
flowchart LR
  R1["revision 1<br/>install"] --> R2["revision 2<br/>two replicas"]
  R2 --> R3["revision 3<br/>/healthz · failed"]
  R3 --> R4["revision 4<br/>rollback to 2"]
  R2 -.->|"copied forward"| R4
  classDef old fill:#f3f3f3,stroke:#888,color:#333;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class R1,R2 old; class R3 bad; class R4 good;
