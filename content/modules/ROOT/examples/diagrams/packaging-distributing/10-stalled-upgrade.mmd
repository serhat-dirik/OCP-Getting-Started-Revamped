%% Stalled upgrade — Packaging & Distributing Your App, lab exercise 4 ("What just happened").
%% The lab-side twin of 06-failed-upgrade-rollback.mmd, which the SA demo uses: in the lab the old
%% pods belong to revision 2, not revision 1. The new pod's probe 404s, so it never turns Ready, the
%% rolling update never retires the healthy pods, and Helm's --wait runs out.
%% Shape (diagram-size-guard): LR, longest chain 3, no subgraph, labels at most 2 lines.
flowchart LR
  UP["helm upgrade --wait<br/>probes on /healthz"] --> NEW["new pod 0/1<br/>probe gets 404"]
  UP --> OLD["revision 2 pods 1/1<br/>still serving /health"]
  NEW --> FAIL["rollout stalls<br/>UPGRADE FAILED"]
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef act fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  class NEW,FAIL bad; class OLD good; class UP act;
