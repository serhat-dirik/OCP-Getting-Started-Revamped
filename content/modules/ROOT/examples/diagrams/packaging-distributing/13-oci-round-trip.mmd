%% OCI round-trip — Packaging & Distributing Your App, lab exercise 6 ("You'll end with").
%% helm package turns the chart directory into a versioned archive, helm push stores it in the
%% cluster's integrated registry as tag 0.1.0 of the same repository as the app image (tag 1.0),
%% and helm pull brings back an archive with the same sha256 digest.
%% Shape (diagram-size-guard): LR, chain of 4, no subgraph, labels at most 2 lines.
flowchart LR
  DIR["chart directory<br/>parasol-notifications/"] -->|"helm package"| TGZ["versioned archive<br/>0.1.0.tgz"]
  TGZ -->|"helm push"| REG["integrated registry<br/>tag 0.1.0, image is 1.0"]
  REG -->|"helm pull"| PULL["pulled archive<br/>same sha256 digest"]
  classDef authored fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  classDef release fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class DIR,TGZ authored; class REG release; class PULL good;
