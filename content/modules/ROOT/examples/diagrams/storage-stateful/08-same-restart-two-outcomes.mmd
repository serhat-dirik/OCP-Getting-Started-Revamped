%% Same restart, two outcomes — Storage & Stateful Apps, lab exercise 4 ("You'll end with").
%% Top: exercise 2, the data volume is an emptyDir, so the replacement Pod starts on a fresh empty
%% volume and the claims are gone. Bottom: exercise 4, the data volume is a PersistentVolumeClaim, so
%% the replacement Pod re-attaches the same PersistentVolume and the claims are still there.
%% Shape (diagram-size-guard): TB of two LR subgraphs joined only container-to-container (the
%% invisible link), so each `direction LR` is honoured; longest chain 3 nodes.
flowchart TB
  subgraph EPH["exercise 2: an emptyDir"]
    direction LR
    E1["DB Pod deleted"] --> E2["fresh, empty volume"]
    E2 --> E3["0 claims"]
  end
  subgraph PER["exercise 4: a PersistentVolumeClaim"]
    direction LR
    P1["DB Pod deleted"] --> P2["same PV<br/>re-attached"]
    P2 --> P3["3 claims<br/>no app restart"]
  end
  EPH ~~~ PER
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class E1,E2,E3 bad;
  class P1,P2,P3 done;
