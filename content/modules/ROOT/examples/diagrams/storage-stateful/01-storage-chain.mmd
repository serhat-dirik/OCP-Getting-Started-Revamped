%% The storage abstraction chain — Storage & Stateful Apps.
%% Pod mounts a PVC (what you ask for, your namespace); the PVC is bound to a PV
%% (what the platform gives you, cluster-scoped); the PV is created from a
%% StorageClass (the recipe); the StorageClass carves real disk from the cluster's
%% storage backend. Illustrates the PVC/PV/StorageClass definitions and the concept
%% page's own "you ask / the platform provisions" sentence directly above it.
%% Resized 2026-08-22 (owner-spotted, worst in module): was a plain `graph TB`,
%% a straight 5-node vertical chain, measured 354x648 intrinsic (rendered 900x1647,
%% text at 2.54x). Split into two `direction LR` rows at the namespace-scoped /
%% cluster-scoped boundary the prose already draws — the chain's own labeled arrows
%% (mounts, bound to, created from, carves real disk from) already force
%% left-to-right order, so no extra `~~~` links are needed.
%% Follow-up 2026-08-22 (diagram-brief v2): the `bound to` edge (pvc -> pv) still
%% joined nodes in DIFFERENT subgraphs, which silently disables `direction LR` in
%% both rows no matter what the direction lines above say — moved it to the
%% container edge YOURS --> PLAT (same label, verbatim). It already named this
%% exact namespace/cluster-scoped boundary, so nothing is lost.
flowchart TB
  subgraph YOURS["Your namespace"]
    direction LR
    app["Pod<br/>your database"] -->|mounts| pvc["PersistentVolumeClaim<br/>what you ask for (your namespace)"]
  end
  subgraph PLAT["The platform — cluster-scoped"]
    direction LR
    pv["PersistentVolume<br/>what the platform gives you (cluster-scoped)"] -->|created from| sc["StorageClass<br/>the recipe the platform follows"]
    sc -->|carves real disk from| backend[("Cluster storage backend")]
  end
  YOURS -->|bound to| PLAT
  classDef ask fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class pvc ask;
  class pv,sc,backend plat;
