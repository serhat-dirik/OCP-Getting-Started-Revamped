%% Online volume expansion — Storage & Stateful Apps, lab exercise 8 (the resize).
%% A resize is allowed only where the PVC's StorageClass sets allowVolumeExpansion; otherwise the
%% API server rejects the patch and nothing changes (dashed). Where it is allowed, the PVC shows
%% Resizing while the backend volume grows, FileSystemResizePending while the node grows the
%% mounted filesystem, then reports 3Gi with the database Pod never restarted.
%% Shape (diagram-size-guard): LR, longest chain 5 nodes, labels at most 2 lines, no subgraph.
flowchart LR
  SC{"allowVolumeExpansion<br/>on the class?"} -->|"true"| RES["Resizing<br/>the volume grows"]
  SC -.->|"false"| NO["patch rejected<br/>nothing changes"]
  RES --> FS["FileSystemResizePending<br/>the filesystem grows"]
  FS --> DONE["capacity 3Gi<br/>no Pod restart"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class SC,RES,FS hi;
  class NO plat;
  class DONE done;
