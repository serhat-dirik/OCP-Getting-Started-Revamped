%% WaitForFirstConsumer binding — Storage & Stateful Apps, lab exercise 3 ("You'll end with").
%% The new claim sits Pending until a Pod that mounts it is scheduled. `oc set volume --overwrite`
%% swaps claims-db's data volume to the claim, which rolls a new Pod; that Pod is the first consumer,
%% so the default class provisions a PersistentVolume where it landed and the claim turns Bound.
%% Shape (diagram-size-guard): LR, chain of 4, labels at most 2 lines, no subgraph.
flowchart LR
  PVC["PVC claims-db-data<br/>Pending"] -->|"oc set volume --overwrite"| POD["new claims-db Pod<br/>scheduled to a node"]
  POD -->|"first consumer"| PV[("PersistentVolume<br/>provisioned there")]
  PV --> BOUND["PVC Bound<br/>the database writes here"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef wait fill:#fff,stroke:#900,color:#900,stroke-dasharray: 4 3;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class PVC wait;
  class POD,PV hi;
  class BOUND done;
