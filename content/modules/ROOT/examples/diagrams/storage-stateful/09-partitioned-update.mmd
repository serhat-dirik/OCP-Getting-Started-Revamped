%% Partitioned StatefulSet update — Storage & Stateful Apps, lab exercise 7 ("You'll end with").
%% With rollingUpdate.partition at 1, a template change (ROLLOUT=canary) rolls only the Pods whose
%% ordinal is at or above 1, so pg-sts-1 moves to the new revision while pg-sts-0 waits on the old
%% one (dashed); dropping the partition to 0 then rolls pg-sts-0 as well.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, labels at most 2 lines, no subgraph.
flowchart LR
  CHG["template change<br/>ROLLOUT=canary"] --> PART{"partition: 1"}
  PART -->|"ordinal 1"| S1["pg-sts-1<br/>new revision"]
  PART -.->|"ordinal 0 waits"| S0["pg-sts-0<br/>old revision"]
  S0 -->|"partition: 0"| S0N["pg-sts-0<br/>new revision"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class CHG,PART hi;
  class S0 plat;
  class S1,S0N done;
