%% The ephemeral trap — Storage & Stateful Apps, lab exercise 2 ("You'll end with").
%% Deleting the claims-db Pod makes its Deployment start a replacement with a NEW, empty emptyDir:
%% the claim table is gone, so the API answers 500 until the app is restarted, and then it counts
%% zero claims.
%% Shape (diagram-size-guard): LR, chain of 4, labels at most 2 lines, no subgraph.
flowchart LR
  OLD["claims-db Pod<br/>emptyDir: 3 claims"] -->|"Pod deleted"| NEW["replacement Pod<br/>new, empty emptyDir"]
  NEW --> ERR["no claim table<br/>API answers 500"]
  ERR -->|"app restart"| ZERO["empty schema<br/>x-total-count: 0"]
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class OLD plat;
  class NEW,ERR,ZERO bad;
