%% Where the seeded claims land — Storage & Stateful Apps, lab exercise 1 ("You'll end with").
%% Each curl POST reaches the claims service through its Route; the service writes the claim into
%% PostgreSQL (claims-db), whose data volume is an emptyDir: part of the Pod and deleted with it
%% (dashed, red) — the trap exercise 2 springs.
%% Shape (diagram-size-guard): LR, chain of 5, labels at most 2 lines, no subgraph.
flowchart LR
  YOU["you<br/>curl POST"] --> RT(["Route<br/>parasol-claims"])
  RT --> APP["parasol-claims<br/>Pod"]
  APP -->|"JDBC"| DB[("claims-db<br/>PostgreSQL")]
  DB -->|"writes to"| VOL["emptyDir data<br/>dies with the Pod"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e,stroke-dasharray: 4 3;
  class APP,DB hi;
  class YOU,RT plat;
  class VOL bad;
