%% Registry pull-through — Registry, Images & Catalog Governance, lab exercise 1 ("You'll end with").
%% The seeded parasol-claims stream in your project is tagged from the shared build in
%% ogsr-parasol-images; the tag records the sha256 it resolved to, and referencePolicy Local makes
%% pods pull those bits from the internal registry (svc:5000), which caches them.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  SRC["shared build<br/>ogsr-parasol-images"] -->|"tagged from"| TAG["ImageStream tag<br/>parasol-claims:1.0"]
  TAG -->|"records"| DIG["sha256 digest<br/>immutable"]
  TAG -->|"referencePolicy Local"| REG[("internal registry<br/>svc:5000 caches")]
  REG -->|"pulls locally"| POD["your Pod"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class TAG,DIG hi;
  class SRC,REG plat;
  class POD done;
