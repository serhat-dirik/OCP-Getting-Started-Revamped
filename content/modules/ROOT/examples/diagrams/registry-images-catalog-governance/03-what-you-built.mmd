%% What you built — Registry, Images & Catalog Governance.
%% Resized 2026-08-22 (before: 1622x304 intrinsic, a 169px-tall sliver at 0.55x text — TOO WIDE:
%% plain `graph TB` with no subgraph direction, so all seven "you"/"platform" nodes landed on the
%% same dagre rank, side by side). Fix per rule 3: `direction LR` + an invisible `~~~` chain inside
%% each subgraph (the multi-tenancy/platform-accretion idiom), plus one real edge between the two
%% subgraph containers — `platform` governs the registry and curates the catalog `you` populates —
%% so the clusters stack TB instead of tying at rank 0. `reg`/`dcat` are untouched; they were already
%% a narrower rank below both. No label text changed — every node was already within the one-<br/>
%% limit.
%% Follow-up 2026-08-22: is/ext/allow/prune-->reg and samples/tmpl-->dcat (6 edges) each crossed
%% the you/platform boundary into a plain top-level node, silently disabling direction LR. Fixed by
%% routing container-to-container (you/platform --> reg/dcat) and folding the specific member(s)
%% and their verbs into each edge's label, so no source-node distinction is lost — e.g. tmpl/sec
%% still visibly do NOT reach the registry, and samples still visibly does not.
flowchart TB
  subgraph you["Yours (namespaced)"]
    direction LR
    is["parasol-claims<br/>1.0 → prod (same digest)"]
    ext["ext-ubi<br/>scheduled import"]
    tmpl["namespaced Template<br/>your catalog entry"]
    sec["pull secret<br/>→ SA / pod"]
    is ~~~ ext ~~~ tmpl ~~~ sec
  end
  subgraph platform["Platform (cluster-wide — you read)"]
    direction LR
    allow["allowedRegistriesForImport<br/>IDMS / ITMS"]
    prune["nightly pruner<br/>keep 3 revisions"]
    samples["samples operator<br/>ConsoleSample · catalog sources"]
    allow ~~~ prune ~~~ samples
  end
  platform -->|"governs + curates"| you
  reg[("Internal registry<br/>svc:5000")]
  dcat["Software Catalog"]
  you -->|"is + ext"| reg
  platform -->|"allow governs · prune reclaims"| reg
  platform -->|"samples feeds"| dcat
  you -->|"tmpl feeds (your ns only)"| dcat
  classDef ok fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef gov fill:#fef7e0,stroke:#b06000,color:#7a4100;
  classDef reg fill:#e8eaf6,stroke:#3949ab,color:#1a237e;
  class is,ext,tmpl,sec ok;
  class allow,prune,samples gov;
  class reg,dcat reg;
