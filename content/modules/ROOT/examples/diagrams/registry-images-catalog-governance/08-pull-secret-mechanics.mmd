%% Two ways to attach a pull secret — Registry, Images & Catalog Governance, lab exercise 4.
%% A: oc secrets link puts the Secret on the default ServiceAccount, whose list is injected into
%% every pod it runs that names no pull secret of its own. B: imagePullSecrets on one pod template,
%% which REPLACES the ServiceAccount's list for that pod rather than adding to it.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  SEC["Secret<br/>parasol-registry-creds"] -->|"A: oc secrets link"| SA["ServiceAccount<br/>default"]
  SA -->|"injected"| PODA["every Pod that<br/>names none"]
  SEC -->|"B: imagePullSecrets"| PODB["one Pod template<br/>replaces the SA list"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef warn fill:#fef7e0,stroke:#b06000,color:#7a4100;
  class SEC hi;
  class SA,PODA done;
  class PODB warn;
