%% The nightly image pruner — Registry, Images & Catalog Governance, lab exercise 7.
%% The image-pruner CronJob runs at midnight; it keeps the newest 3 revisions of each tag, anything
%% younger than an hour, and anything still referenced (for example by a running workload), and
%% prunes the rest to reclaim registry storage.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  CRON["image-pruner CronJob<br/>00:00 daily"] --> CHK{"each image<br/>revision"}
  CHK -->|"newest 3, under 1h<br/>or referenced"| KEEP["kept"]
  CHK -->|"older and<br/>unreferenced"| GONE["pruned"]
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class CRON,CHK plat;
  class KEEP done;
  class GONE bad;
