%% Scheduled import and a failed import — Registry, Images & Catalog Governance, lab exercise 3.
%% Top row: ext-ubi re-checks the upstream ubi9/ubi:latest tag on a schedule and records the new
%% digest when it moves. Bottom row: the break-and-fix, a one-off import of a repository that does
%% not exist, whose import status names the cause.
%% Shape (diagram-size-guard): LR, longest chain 3 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  UP["ubi9/ubi:latest<br/>upstream tag moves"] -->|"scheduled re-check"| IS["ImageStream<br/>ext-ubi"]
  IS -->|"records"| NEW["new sha256"]
  BAD["ubi9/does-not-exist"] -.->|"one-off import"| ERR["import status<br/>Repo not found"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  class IS,NEW hi;
  class UP plat;
  class BAD,ERR bad;
