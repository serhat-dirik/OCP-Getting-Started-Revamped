%% A namespaced Template as a catalog entry — Registry, Images & Catalog Governance, lab exercise 5.
%% The Template lives in your project, so only your project's Software Catalog lists it; another
%% project's catalog does not. Instantiating it (console) or oc process (CLI) creates the
%% Deployment and Service it describes.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  T["Template in your project<br/>parasol-claims-quickstart"] -->|"listed in"| CAT["your Software Catalog"]
  T -.->|"not listed"| OTH["another project's<br/>catalog"]
  CAT -->|"Instantiate · oc process"| OBJ["Deployment + Service<br/>claims-quickstart"]
  OBJ --> POD["Pod 1/1 Running<br/>0 restarts"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class T,CAT hi;
  class OTH plat;
  class OBJ,POD done;
