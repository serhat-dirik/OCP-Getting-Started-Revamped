%% How an API trusts a Keycloak token — Securing Apps with Keycloak, lab exercise 1 ("What just happened").
%% The realm signs every access token; the claims an API reads (iss, aud, roles) ride in its payload.
%% The API takes the realm's public keys from jwks_uri and checks each signature itself, so no
%% request needs a call to Keycloak. Shape (diagram-size-guard): LR, chain of 3, no subgraph.
flowchart LR
  KC["your realm<br/>signs the token"] -->|"access token<br/>iss, aud, roles"| CALLER["caller<br/>Authorization: Bearer"]
  CALLER --> API["claims API<br/>checks the signature"]
  KC -.->|"public keys<br/>jwks_uri"| API
  classDef kc fill:#fef7e0,stroke:#f9ab00,color:#b06000;
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class KC kc;
  class API hi;
  class CALLER plat;
