%% The four OAuth/OIDC flows this module uses — Securing Apps with Keycloak.
%% Grouped by whether a human is directly in that leg: auth-code+PKCE (web login) and bearer tokens
%% (API) under HUMAN; client credentials (machine) and token exchange (RFC 8693) under MACHINE.
%% WEB -> BEARER -> TE traces one user's token through the system; client credentials stands alone
%% as a separate, human-free machine-identity flow. Concept page: "The four flows, and when each
%% applies" — flow names/order here match that section's four bullets.
%% Resized 2026-08-22: was 541x645 (rendered 900x1073, text at 1.66x) — each node label was four
%% lines (three `<br/>`), stacked with no `direction LR`. Fix: compressed every label to two lines
%% (rule: at most one `<br/>`, wording preserved) and added `direction LR` + `~~~` per subgraph,
%% same idiom as the build-deliver platform-accretion diagrams.
flowchart TB
  subgraph HUMAN["a human is present"]
    direction LR
    WEB["<b>Auth-code + PKCE</b><br/>browser logs in at Keycloak, app never sees the password — the web frontend"]
    BEARER["<b>Bearer token</b><br/>caller presents a token, API validates + checks role — the claims API"]
  end
  subgraph MACHINE["no human — service to service"]
    direction LR
    CC["<b>Client credentials</b><br/>a service authenticates as ITSELF — the batch job"]
    TE["<b>Token exchange (RFC 8693)</b><br/>one service re-audiences a user's token to call another ON THE USER'S BEHALF"]
    CC ~~~ TE
  end
  WEB -->|"user's token<br/>is then sent to"| BEARER
  BEARER -->|"re-audienced by<br/>exchange into"| TE
  classDef human fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef machine fill:#e8f0fe,stroke:#1a73e8,color:#174ea6;
  class WEB,BEARER human;
  class CC,TE machine;
