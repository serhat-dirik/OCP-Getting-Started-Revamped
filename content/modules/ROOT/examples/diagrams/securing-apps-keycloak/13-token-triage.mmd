%% Debugging a rejected call — Securing Apps with Keycloak, lab exercise 6 ("You'll end with").
%% Three questions in order: is the signature valid, has exp passed, is aud this service? Each "no"
%% is a 401 at a Quarkus API; only a token that clears all three reaches the role check (403).
%% Shape (diagram-size-guard): LR, chain of 5, no subgraph.
flowchart LR
  REJ["call rejected"] --> SIG{"valid?<br/>signature"}
  SIG -->|"yes"| EXP{"expired?<br/>exp vs now"}
  EXP -->|"no"| AUD{"for me?<br/>aud"}
  AUD -->|"yes"| ROLE["role check<br/>403 if missing"]
  SIG -->|"no"| F["401"]
  EXP -->|"yes"| F
  AUD -->|"no"| F
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class F bad;
  class REJ,SIG,EXP,AUD,ROLE plat;
