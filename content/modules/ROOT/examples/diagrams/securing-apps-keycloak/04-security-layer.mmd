%% The security layer over the Parasol platform — Securing Apps with Keycloak.
%% Keycloak backs this module's four identity/access controls (SEC), which sit in front of the
%% Parasol platform built in earlier modules (app + delivery layers, greyed out, PLAT).
%% Resized 2026-08-22: was 535x740 (rendered 900x1245, text at 1.68x) — narrow-tall from stacking
%% subgraph children with no `direction LR`. Fix: `direction LR` + `~~~` per subgraph, same idiom as
%% the build-deliver platform-accretion diagrams.
%% Tuned again 2026-08-22: closest of the batch but still 900x549 @1.12x (aspect 0.61 vs the 0.55
%% target). KC is a standalone node alone on its own rank above SEC, so its own two-line height sets
%% that whole rank's height. Collapsed KC's label to one line (same words, `<br/>` swapped for an
%% em dash) to shave that rank down. No edges, other labels, or subgraph layout touched.
flowchart TB
  subgraph SEC["identity & access (this module)"]
    direction LR
    LOGIN[web login<br/>auth-code + PKCE]
    API[bearer-protected API<br/>+ role checks]
    M2M[machine identity<br/>client credentials]
    EXCH[token exchange<br/>service to service]
    LOGIN ~~~ API ~~~ M2M ~~~ EXCH
  end
  subgraph PLAT["the Parasol claims platform so far"]
    direction LR
    APP[claims + web + db]
    DEL[pipelines + GitOps + observability]
    APP ~~~ DEL
  end
  KC[Red Hat build of Keycloak — per-user realm]
  KC --> SEC
  SEC --> APP
  SEC --> DEL
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef kc fill:#fef7e0,stroke:#f9ab00,color:#b06000;
  class LOGIN,API,M2M,EXCH hi;
  class APP,DEL plat;
  class KC kc;
