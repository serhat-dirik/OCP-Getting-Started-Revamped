%% The redirect_uri trap behind an edge Route — Securing Apps with Keycloak, lab exercise 4.
%% TLS ends at the router, which forwards plain HTTP to the pod; the app, seeing HTTP, builds an
%% http callback that the realm (which registered only the https one) rejects with 400. With
%% QUARKUS_HTTP_PROXY_PROXY_ADDRESS_FORWARDING=true the app reads X-Forwarded-Proto and builds https.
%% Shape (diagram-size-guard): LR, chain of 4, no subgraph.
flowchart LR
  B["browser"] -->|"HTTPS"| RT["edge Route<br/>TLS ends here"]
  RT -->|"plain HTTP"| POD["parasol-web pod<br/>builds redirect_uri"]
  POD -->|"http callback"| KC400["Keycloak<br/>400 redirect_uri"]
  POD -.->|"forwarding on: https"| KC302["Keycloak<br/>login page"]
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class KC400 bad;
  class KC302 good;
  class B,RT,POD plat;
