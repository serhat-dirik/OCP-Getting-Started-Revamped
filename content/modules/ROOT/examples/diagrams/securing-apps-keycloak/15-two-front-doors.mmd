%% Two front doors, one model — Securing Apps with Keycloak, lab exercise 8 ("You'll end with").
%% The same user name signs in to OpenShift through the cluster's identity provider (an OpenID
%% provider backed by the cluster's own Keycloak realm) and to the Parasol apps through the workshop
%% Keycloak's per-user realm. Two instances, one realm/client/role/user model.
%% Shape (diagram-size-guard): LR, chain of 3, no subgraph.
flowchart LR
  YOU["you<br/>one user name"] --> OCP["OpenShift login<br/>OpenID provider"]
  YOU --> APPS["Parasol apps<br/>web, claims, fraud"]
  OCP --> CKC["the cluster's<br/>Keycloak realm"]
  APPS --> WKC["workshop Keycloak<br/>your realm"]
  CKC -.->|"same model"| WKC
  classDef kc fill:#fef7e0,stroke:#f9ab00,color:#b06000;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class CKC,WKC kc;
  class YOU,OCP,APPS plat;
