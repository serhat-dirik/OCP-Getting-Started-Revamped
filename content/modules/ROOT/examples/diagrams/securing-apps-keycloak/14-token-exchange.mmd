%% Standard token exchange (RFC 8693) — Securing Apps with Keycloak, lab exercise 7 ("You'll end with").
%% parasol-claims hands the adjuster's token (aud parasol-claims) to the realm and asks for the
%% parasol-fraud audience; the new token is still the adjuster's and fraud accepts it. Sent as is, the
%% original is refused for its audience; asked for parasol-batch, the realm refuses the exchange.
%% Shape (diagram-size-guard): LR, chain of 4, no subgraph.
flowchart LR
  ADJ["adjuster token<br/>aud: parasol-claims"] -->|"parasol-claims asks<br/>for parasol-fraud"| KC["your realm<br/>token exchange"]
  KC --> NEW["new token, still adjuster<br/>aud: parasol-fraud"]
  NEW --> FR["parasol-fraud<br/>200"]
  ADJ -.->|"sent as is: 401"| FR
  KC -.->|"asked for parasol-batch"| NO["refused<br/>no escalation"]
  classDef kc fill:#fef7e0,stroke:#f9ab00,color:#b06000;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class KC kc;
  class NEW,FR good;
  class NO bad;
  class ADJ plat;
