%% Client credentials — Securing Apps with Keycloak, lab exercise 5 ("You'll end with").
%% The batch job has no human and no browser: it sends its own client id and secret to the realm's
%% token endpoint and gets a token for the client's service account, service-account-parasol-batch.
%% No refresh token: it asks again when the token expires. Shape (diagram-size-guard): LR, chain of 3.
flowchart LR
  JOB["batch job<br/>no human, no browser"] -->|"client id + secret"| KC["your realm<br/>token endpoint"]
  KC -->|"access token"| ID["service-account-<br/>parasol-batch"]
  classDef kc fill:#fef7e0,stroke:#f9ab00,color:#b06000;
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class KC kc;
  class ID hi;
  class JOB plat;
