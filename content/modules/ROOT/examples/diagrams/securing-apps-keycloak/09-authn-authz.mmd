%% Authentication, then authorization — Securing Apps with Keycloak, lab exercise 3 ("You'll end with").
%% What the claims API decides once exercise 3 requires the claims-adjuster role: no valid token is
%% 401 (who are you?); a valid token without the role, viewer's, is 403 (not allowed); adjuster's
%% token carries the role and gets 200. Shape (diagram-size-guard): LR, chain of 4, no subgraph.
flowchart LR
  REQ["GET /api/claims"] --> V{"valid<br/>token?"}
  V -->|"no"| U["401<br/>who are you?"]
  V -->|"yes"| R{"claims-adjuster<br/>in the token?"}
  R -->|"no: viewer"| F["403<br/>not allowed"]
  R -->|"yes: adjuster"| OK["200<br/>the claims"]
  classDef bad fill:#fce8e6,stroke:#c5221f,color:#a50e0e;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class U,F bad;
  class OK good;
  class REQ,V,R plat;
