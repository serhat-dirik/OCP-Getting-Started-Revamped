%% Authorization code + PKCE — Securing Apps with Keycloak, lab exercise 4 ("What just happened").
%% An anonymous visitor is redirected to the realm with a code_challenge (S256), signs in on
%% Keycloak's page, comes back with a one-time code, and the app swaps code plus code_verifier for
%% tokens. The password never reaches the app. Shape (diagram-size-guard): LR, chain of 4.
flowchart LR
  V["visitor<br/>no session"] -->|"302 + code_challenge"| KC["your realm<br/>login page"]
  KC -->|"signs in"| CODE["one-time code<br/>back to the app"]
  CODE -->|"code + verifier"| TOK["tokens<br/>for parasol-web"]
  classDef kc fill:#fef7e0,stroke:#f9ab00,color:#b06000;
  classDef good fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class KC kc;
  class TOK good;
  class V,CODE plat;
