%% Catalog template to database — Ways to Build & Deliver Apps, lab exercise 4 ("You'll end with").
%% Console (Instantiate Template) and CLI (oc process) both fill the same Parasol PostgreSQL
%% template from the shared openshift namespace; it renders three objects named after APP_NAME:
%% a Deployment (no DeploymentConfig), a Service on 5432, and the Secret exercise 5 consumes.
%% Shape (diagram-size-guard): LR, three ranks, no subgraph.
flowchart LR
  UI["Console: Software Catalog<br/>Instantiate Template"] --> TPL
  CLI["CLI: oc process<br/>APP_NAME=claims-db"] --> TPL
  TPL["Parasol PostgreSQL<br/>template, ephemeral"] --> DEP["Deployment claims-db<br/>PostgreSQL"]
  TPL --> SVC["Service claims-db<br/>port 5432"]
  TPL --> SEC["Secret claims-db<br/>four POSTGRESQL_ keys"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  class DEP,SVC,SEC hi;
  class UI,CLI,TPL plat;
