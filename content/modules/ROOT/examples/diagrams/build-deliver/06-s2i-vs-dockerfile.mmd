%% Same source, two build strategies — Ways to Build & Deliver Apps, lab exercise 2 and concept
%% "Build-time images vs runtime images". Top: the Source (S2I) strategy runs the build inside the
%% platform's java-21 builder and commits that container, so the image ships the whole builder.
%% Bottom: the Docker strategy runs the repo's own multi-stage Dockerfile, compiles in a JDK + Maven
%% stage and copies only the app into a JRE-only runtime stage. Green = the platform owns it;
%% red = you own it.
%% Shape (diagram-size-guard): TB of two LR subgraphs joined only container-to-container (the
%% invisible `~~~` link), so each `direction LR` is honoured; longest chain 3 nodes. Stacking the
%% rows, rather than fanning both out of one shared source node, keeps it about 750px wide so the
%% narrow cockpit column can still read it.
flowchart TB
  subgraph S2I["Source strategy (S2I): the platform owns the recipe"]
    direction LR
    A1["java-21 builder<br/>runs mvn package"] --> A2["parasol-claims image<br/>ships the full builder"]
  end
  subgraph DOCKER["Docker strategy: you own the Dockerfile"]
    direction LR
    B1["stage 1: JDK + Maven<br/>compiles the app"] -->|"copies the app only"| B2["stage 2<br/>JRE only"]
    B2 --> B3["claims-docker image<br/>ships the runtime only"]
  end
  S2I ~~~ DOCKER
  classDef plat fill:#e6f4ea,stroke:#137333,color:#0d652d;
  classDef own fill:#e00,stroke:#900,color:#fff;
  class A1,A2 plat;
  class B1,B2,B3 own;
