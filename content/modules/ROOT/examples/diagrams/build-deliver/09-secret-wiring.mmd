%% Secret-to-database wiring — Ways to Build & Deliver Apps, lab exercise 5 ("What just happened").
%% `oc set env --from=secret/claims-db` (console: envFrom) copies every key of the template's
%% Secret (POSTGRESQL_HOST, _DATABASE, _USER, _PASSWORD) into the claims container as an
%% environment variable of the same name; the image already reads exactly those names for its
%% datasource, so it resolves the claims-db Service and connects.
%% Shape (diagram-size-guard): LR, chain of 4, labels at most 2 lines, kept short for the narrow
%% cockpit column.
flowchart LR
  SEC["Secret claims-db<br/>POSTGRESQL_* keys"] -->|"envFrom"| APP["parasol-claims Pod<br/>same-named env vars"]
  APP -->|"JDBC :5432"| SVC["Service<br/>claims-db"]
  SVC --> DB[("PostgreSQL<br/>claims-db")]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef done fill:#e6f4ea,stroke:#137333,color:#0d652d;
  class SEC hi;
  class APP,SVC,DB done;
