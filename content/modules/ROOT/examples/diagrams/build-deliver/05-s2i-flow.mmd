%% Source-to-Image flow — Ways to Build & Deliver Apps, lab exercise 1 ("You'll end with").
%% What `oc new-app java-21~` plus your repo URL (or Import from Git -> Builder Image -> Java 21) sets in motion:
%% the BuildConfig pairs your Git fork with the java-21 builder, a build Pod runs the builder's
%% assemble script (mvn package), the image is pushed and tagged in the project's ImageStream, and
%% the Deployment rolls it out, then crash-loops until exercise 5 hands it a database (dashed).
%% Shape (diagram-size-guard): LR, longest chain 5 nodes, no subgraph, labels at most 2 lines.
flowchart LR
  SRC[/"parasol-claims<br/>Git fork"/] --> BC["BuildConfig<br/>Source strategy"]
  BLD["java-21<br/>builder image"] --> BC
  BC --> RUN["build Pod<br/>mvn package"]
  RUN --> IST["ImageStream<br/>parasol-claims:latest"]
  IST --> DEP["Deployment<br/>no database yet"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef wait fill:#fff,stroke:#900,color:#900,stroke-dasharray: 4 3;
  class BC,RUN,IST hi;
  class SRC,BLD plat;
  class DEP wait;
