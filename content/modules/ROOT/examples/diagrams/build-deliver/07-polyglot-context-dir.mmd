%% Polyglot S2I — Ways to Build & Deliver Apps, lab exercise 3 ("You'll end with").
%% One repo holds the same notifications API twice, in node/ and python/. The context directory
%% picks the subdirectory, the builder picks the language; everything after that is the same S2I
%% flow as exercise 1. Edge labels name the context directory. Solid = the Node.js path the lab walks; dashed = the optional Python path.
%% Shape (diagram-size-guard): LR, longest chain 4 nodes, no subgraph.
flowchart LR
  REPO[/"parasol-notifications<br/>Git fork"/] -->|"node/"| NODE["Node.js<br/>builder"]
  NODE --> APP["parasol-notifications<br/>Deployment"]
  APP --> RT(["edge Route<br/>/health is UP"])
  REPO -.->|"python/<br/>optional"| PY["Python<br/>builder"]
  PY -.-> APP2["notifications-py<br/>Deployment"]
  classDef hi fill:#e00,stroke:#900,color:#fff;
  classDef plat fill:#f3f3f3,stroke:#888,color:#333;
  classDef opt fill:#fff,stroke:#888,color:#555,stroke-dasharray: 4 3;
  class NODE,APP,RT hi;
  class REPO plat;
  class PY,APP2 opt;
